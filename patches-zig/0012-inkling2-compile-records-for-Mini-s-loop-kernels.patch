+    .{ .launch = .{ .name = "inkling2 loop tf_ink2_loop_norm", .symbol = "tf_ink2_loop_norm", .image = "inkling2_loop", .threads = 512, .min_sm = 80 }, .usage = .{ .{ .regs = 17, .static = 128, .bound = 512 }, .{ .regs = 18, .static = 128, .bound = 512 }, .{ .regs = 18, .static = 128, .bound = 512 }, .{ .regs = 22, .static = 128, .bound = 512 }, .{ .regs = 22, .static = 128, .bound = 512 } }, .later_pending = true },
+    .{ .launch = .{ .name = "inkling2 loop tf_ink2_loop_bank", .symbol = "tf_ink2_loop_bank", .image = "inkling2_loop", .threads = 256, .min_sm = 80 }, .usage = .{ .{ .regs = 10, .static = 0, .bound = 256 }, .{ .regs = 10, .static = 0, .bound = 256 }, .{ .regs = 10, .static = 0, .bound = 256 }, .{ .regs = 18, .static = 0, .bound = 256 }, .{ .regs = 18, .static = 0, .bound = 256 } }, .later_pending = true },
+    .{ .launch = .{ .name = "inkling2 loop tf_ink2_loop_rotate", .symbol = "tf_ink2_loop_rotate", .image = "inkling2_loop", .threads = 32, .min_sm = 80 }, .usage = .{ .{ .regs = 26, .static = 0, .bound = 32 }, .{ .regs = 28, .static = 0, .bound = 32 }, .{ .regs = 26, .static = 0, .bound = 32 }, .{ .regs = 20, .static = 0, .bound = 32 }, .{ .regs = 20, .static = 0, .bound = 32 } }, .later_pending = true },
+    .{ .launch = .{ .name = "inkling2 loop tf_ink2_loop_tail", .symbol = "tf_ink2_loop_tail", .image = "inkling2_loop", .threads = 32, .min_sm = 80 }, .usage = .{ .{ .regs = 26, .static = 0, .bound = 32 }, .{ .regs = 30, .static = 0, .bound = 32 }, .{ .regs = 26, .static = 0, .bound = 32 }, .{ .regs = 24, .static = 0, .bound = 32 }, .{ .regs = 24, .static = 0, .bound = 32 } }, .later_pending = true },
