From c872ee252108eee1b3f3ce9bf3f599a6f0f7f8a5 Mon Sep 17 00:00:00 2001
From: ajensenwaud <ajensenwaud@users.noreply.github.com>
Date: Sun, 22 Nov 2026 16:43:10 +1100
Subject: [PATCH 12/24] inkling2: compile records for Mini's loop kernels

The ten launches of the inkling2_loop image (loop.cu: message, the three
gate down projections, blend, mix, norm, bank, and the prompt GEMM's
rotation and epilogue) get nvcc 13.0 records on the five SMs, with
later_pending set; nvcc 13.3's receipts go in measurements/pending_133.zig
and 13.2 stays pending. The image joins the contract runner's image list.
---
 .../core/contract/inkling2_cuda_records.zig   |  7 ++++---
 .../core/contract/inkling2_loop_records.zig   | 20 +++++++++++++++++++
 .../contract/measurements/pending_133.zig     | 10 ++++++++++
 zig/tests/cuda/contract_limits.zig            |  2 +-
 4 files changed, 35 insertions(+), 4 deletions(-)
 create mode 100644 zig/src/core/contract/inkling2_loop_records.zig

diff --git a/zig/src/core/contract/inkling2_cuda_records.zig b/zig/src/core/contract/inkling2_cuda_records.zig
index 94426f828..f30f0b61d 100644
--- a/zig/src/core/contract/inkling2_cuda_records.zig
+++ b/zig/src/core/contract/inkling2_cuda_records.zig
@@ -3,7 +3,8 @@ const attn = @import("inkling2_attn_records.zig");
 const ops = @import("inkling2_ops_records.zig");
 const dspark = @import("inkling2_dspark_records.zig");
 const experts = @import("inkling2_experts_records.zig");
+const loop = @import("inkling2_loop_records.zig");
 
-pub const cuda = attn.cuda ++ ops.cuda ++ dspark.cuda ++ experts.cuda;
-pub const cuda_132 = attn.cuda_132 ++ ops.cuda_132 ++ dspark.cuda_132 ++ experts.cuda_132;
-pub const cuda_133 = attn.cuda_133 ++ ops.cuda_133 ++ dspark.cuda_133 ++ experts.cuda_133;
+pub const cuda = attn.cuda ++ ops.cuda ++ dspark.cuda ++ experts.cuda ++ loop.cuda;
+pub const cuda_132 = attn.cuda_132 ++ ops.cuda_132 ++ dspark.cuda_132 ++ experts.cuda_132 ++ loop.cuda_132;
+pub const cuda_133 = attn.cuda_133 ++ ops.cuda_133 ++ dspark.cuda_133 ++ experts.cuda_133 ++ loop.cuda_133;
