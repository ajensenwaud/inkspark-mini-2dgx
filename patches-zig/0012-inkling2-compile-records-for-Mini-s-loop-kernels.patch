+    .{ .launch = .{ .name = "inkling2 loop tf_ink2_loop_down64", .symbol = "tf_ink2_loop_down64", .image = "inkling2_loop", .threads = 128, .min_sm = 80 }, .usage = .{ .{ .regs = 78, .static = 16388, .bound = 128 }, .{ .regs = 98, .static = 16388, .bound = 128 }, .{ .regs = 98, .static = 16388, .bound = 128 }, .{ .regs = 96, .static = 16388, .bound = 128 }, .{ .regs = 96, .static = 16388, .bound = 128 } }, .later_pending = true },
+    .{ .launch = .{ .name = "inkling2 loop tf_ink2_loop_blend", .symbol = "tf_ink2_loop_blend", .image = "inkling2_loop", .threads = 256, .min_sm = 80 }, .usage = .{ .{ .regs = 39, .static = 8192, .bound = 256 }, .{ .regs = 40, .static = 8192, .bound = 256 }, .{ .regs = 40, .static = 8192, .bound = 256 }, .{ .regs = 40, .static = 8192, .bound = 256 }, .{ .regs = 40, .static = 8192, .bound = 256 } }, .later_pending = true },
