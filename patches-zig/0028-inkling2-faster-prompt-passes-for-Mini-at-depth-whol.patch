diff --git a/zig/src/families/inkling2/engine_prefill.zig b/zig/src/families/inkling2/engine_prefill.zig
new file mode 100644
index 000000000..bd4bc5ad0
--- /dev/null
+++ b/zig/src/families/inkling2/engine_prefill.zig
@@ -0,0 +1,68 @@
+//! tf-inkling2-engine ptiming: one prompt chunk timed at each depth, the slot standing there on zeroed caches.
+const std = @import("std");
+const ink = @import("inkling2");
+
+const Engine = ink.engine.Engine;
+
+/// Each depth (a multiple of prompt_rows): a warm chunk, then `reps` timed; rank 0 prints the median.
+pub fn run(e: *Engine, a: std.mem.Allocator, io: std.Io, texts: anytype, spec: []const u8, reps: usize, r0: bool) !u8 {
+    if (texts.len == 0) return error.NoTexts;
+    const rows = ink.engine.prompt_rows;
+    const src = texts[0].ids;
+    var it = std.mem.tokenizeAny(u8, spec, ",_\\");
+    while (it.next()) |word| {
+        const depth = try std.fmt.parseInt(usize, word, 10);
+        if (depth % rows != 0) return error.DepthNotChunked;
+        const ids = try a.alloc(u32, depth + rows + 1); // one id past the chunk: no draw, the head on the last row
+        for (ids, 0..) |*x, i| x.* = src[i % src.len];
+        const ms = try a.alloc(f64, reps);
+        for (0..reps + 1) |rep| {
+            try e.bind(0);
+            e.begin(null);
+            e.st.?.pos[0] = depth;
+            try e.stream.synchronize();
+            const t0 = std.Io.Clock.awake.now(io).toNanoseconds();
+            if (try e.prefillChunk(ids, depth) != null) return error.ChunkEnded;
+            try e.stream.synchronize();
+            const t1 = std.Io.Clock.awake.now(io).toNanoseconds();
+            if (rep > 0) ms[rep - 1] = @as(f64, @floatFromInt(t1 - t0)) / 1e6;
+        }
+        const nv = e.w.share.vocab.len();
+        const row = try a.alloc(u8, nv * 4);
+        try e.bp.logits.download(lastRow(e, depth) * nv * 4, row); // the last call's last row (the call split by depth)
+        std.debug.print("rank {d} depth {d}: last-row logits hash {x:0>16}\n", .{ e.w.share.rank, depth, std.hash.Wyhash.hash(0, row) });
+        std.mem.sort(f64, ms, {}, std.sort.asc(f64));
+        if (r0) std.debug.print("prompt chunk of {d} rows at depth {d}: {d:.1} ms median of {d} ({d:.0} tok/s), min {d:.1}\n", .{ rows, depth, ms[reps / 2], reps, @as(f64, rows) * 1e3 / ms[reps / 2], ms[0] });
+    }
+    return real(e, a, src, r0);
+}
+
+/// The row index of a chunk's last row in its last call (prefillChunk's split of a deep chunk).
+fn lastRow(e: *Engine, depth: usize) usize {
+    const rows = ink.engine.prompt_rows;
+    const most = @max(1, e.bp.parts.slots / (e.shape_p.heads * ink.forward.stride(&e.c, depth + rows - 1)));
+    const n = @min(rows, most);
+    return (rows - 1) % n;
+}
+
+/// A real prompt of 5 chunks and 777 rows from position 0: each chunk's last-row logits hashed (arms compare bits).
+fn real(e: *Engine, a: std.mem.Allocator, src: []const u32, r0: bool) !u8 {
+    const rows = ink.engine.prompt_rows;
+    const ids = try a.alloc(u32, 5 * rows + 777);
+    for (ids, 0..) |*x, i| x.* = src[(i * 7 + i / src.len) % src.len]; // tiled, shifted each pass: no exact repeats
+    const nv = e.w.share.vocab.len();
+    const row = try a.alloc(u8, nv * 4);
+    try e.bind(0);
+    e.begin(null);
+    var at: usize = 0;
+    while (at < ids.len) : (at += rows) {
+        const t = try e.prefillChunk(ids, at);
+        try e.stream.synchronize();
+        const last = @min(ids.len - at, rows) - 1;
+        try e.bp.logits.download(last * nv * 4, row);
+        const h = std.hash.Wyhash.hash(0, row);
+        std.debug.print("rank {d} chunk at {d}: last-row logits hash {x:0>16}{s}\n", .{ e.w.share.rank, at, h, if (t != null) " (prompt end)" else "" });
+    }
+    _ = r0;
+    return 0;
+}
