+fn widen(k: *const Kernels, s: cuda.Stream, r: Rows, l: Layer, kv: Cache) !void {
+    var a: cuda.Args = .{};
+    for ([_]u64{ kv.k, kv.v, kv.ks, kv.vs }) |v| a.add(v);
+    a.add(r.off);
+    a.add(int(r.kv_heads));
+    a.add(int(l.ring));
+    a.add(int(r.last_pos));
+    for ([_]u64{ kv.wide, kv.wide + kv.wide_half }) |v| a.add(v);
+    try go(k.widen, s, .{ .x = r.last_pos / tile_keys + 1, .y = r.kv_heads, .z = 2 }, 512, &a);
+}
