diff --git a/zig/kernels/cuda/inkling2/prompt_attention.cu b/zig/kernels/cuda/inkling2/prompt_attention.cu
index da1fc3b7f..7d161e85e 100644
--- a/zig/kernels/cuda/inkling2/prompt_attention.cu
+++ b/zig/kernels/cuda/inkling2/prompt_attention.cu
@@ -336,3 +336,20 @@ extern "C" __global__ void __launch_bounds__(ink2p::kThreads, 1)
     ink2p::promptTile<true>(q, kc, vc, tab, segs, part_o, part_ml, heads, kv_heads, ring, chunk, c0, chunks, scale,
                             ksc, vsc, smem);
 }
+
+// One slot's fp8 keys 0..last as bf16 [kv_head][ring][128] (tf_ink2_attn_prompt8's tile values): attn_prompt's input.
+extern "C" __global__ void __launch_bounds__(512) tf_ink2_kv_widen(const uint8_t* __restrict__ kc, const uint8_t* __restrict__ vc,
+                                                                  const float* __restrict__ ksc, const float* __restrict__ vsc,
+                                                                  long long off, int kv_heads, int ring, int last, uint16_t* __restrict__ ko,
+                                                                  uint16_t* __restrict__ vo) {
+    const int key = static_cast<int>(blockIdx.x) * 64 + (threadIdx.x >> 3), piece = threadIdx.x & 7;
+    if (key > last) return;
+    const bool v = blockIdx.z != 0;
+    const size_t row = static_cast<size_t>(key) * kv_heads + blockIdx.y;  // a global ring holds every key: no wrap
+    const uint4 w = *reinterpret_cast<const uint4*>((v ? vc : kc) + off + row * ink2p::kDim + piece * 16);
+    const float sc = (v ? vsc : ksc)[off / ink2p::kDim + row];
+    const uint2 a = ink2p::deq4(w.x, sc), b = ink2p::deq4(w.y, sc), c = ink2p::deq4(w.z, sc), d = ink2p::deq4(w.w, sc);
+    uint16_t* o = (v ? vo : ko) + (static_cast<size_t>(blockIdx.y) * ring + key) * ink2p::kDim + piece * 16;
+    *reinterpret_cast<uint4*>(o) = make_uint4(a.x, a.y, b.x, b.y);
+    *reinterpret_cast<uint4*>(o + 8) = make_uint4(c.x, c.y, d.x, d.y);
+}
