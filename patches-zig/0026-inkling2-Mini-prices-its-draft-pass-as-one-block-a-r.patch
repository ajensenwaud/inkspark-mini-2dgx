+    fixed_block: bool = false, // Mini: the shared allocator prices the pass as one block (fixedBlock)
 
     pub fn deinit(self: *Lanes) void {
         self.lanes.deinit(self.x.e.gpa);
@@ -94,6 +102,7 @@ pub const Lanes = struct {
         const head = self.x.e.drafter != null;
         const mini = self.x.e.c.loop != null;
         return .{
+            .fixed_draft_block = head and mini and self.fixed_block, // Mini's pass costs about the same at any depth
             .copy_drafts = false,
             .exact_width = max_rows,
             .gpu_tokens = false,
