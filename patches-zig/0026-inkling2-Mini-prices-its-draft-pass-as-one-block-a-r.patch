+    .{ .width = 5, .ms = 26.9 }, .{ .width = 6, .ms = 28.9 }, .{ .width = 7, .ms = 30.4 }, .{ .width = 8, .ms = 31.5 },
 };
 const mini_shared_costs = [_]lanes.config.Cost{
-    .{ .width = 1, .ms = 17.1 },  .{ .width = 2, .ms = 20.5 },  .{ .width = 4, .ms = 27.8 },  .{ .width = 8, .ms = 35.4 },
-    .{ .width = 16, .ms = 47.0 }, .{ .width = 32, .ms = 66.1 }, .{ .width = 64, .ms = 87.5 },
+    .{ .width = 1, .ms = 17.0 },  .{ .width = 2, .ms = 20.5 },  .{ .width = 4, .ms = 27.7 },  .{ .width = 8, .ms = 34.2 },
+    .{ .width = 16, .ms = 44.5 }, .{ .width = 32, .ms = 63.1 }, .{ .width = 64, .ms = 81.7 },
 };
 /// Mini's batched draft pass (NVFP4): one stream's block, and each further stream's share of one pass.
-const mini_pass_ms = 7.4;
-const mini_stream_ms = 0.7;
+const mini_pass_ms = 7.1;
+const mini_stream_ms = 0.8;
 
 /// TF_INKLING2_PLAIN_STREAMS, else Small 2 (its per-stream pass lost 5-10 % at 4-8 streams), Mini 4 (verify cost).
 pub fn plainStreams(mini: bool) !u32 {
@@ -44,6 +44,13 @@ pub fn plainStreams(mini: bool) !u32 {
     return @intCast(try env.read(u64, "TF_INKLING2_PLAIN_STREAMS", if (mini) 4 else 2));
 }
 
+/// TF_INKLING2_FIXED_BLOCK: Mini's shared rounds price the draft pass as one block a round (default 1; 0: per step).
+pub fn fixedBlock() !bool {
+    const env = @import("sys").environment;
+    comptime env.registered("TF_INKLING2_FIXED_BLOCK");
+    return try env.read(u64, "TF_INKLING2_FIXED_BLOCK", 1) == 1;
+}
+
