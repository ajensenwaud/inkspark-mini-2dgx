new file mode 100644
index 000000000..155cd9412
--- /dev/null
+++ b/zig/src/families/inkling2/dspark_quant.zig
@@ -0,0 +1,90 @@
+//! The drafter's bf16 projections as NVFP4 at load (TF_INKLING2_DRAFT_WEIGHTS=nvfp4): changes acceptance, never output.
+const std = @import("std");
+const core = @import("core");
+
+const fp8 = core.quant.fp8;
+const fp4 = core.quant.nvfp4;
+
+pub const Quantised = struct {
+    codes: []u8, // [n, k/2], even inputs in the low nibble
+    scales: []u8, // e4m3 [n, k/16]
+    global: f32,
+
+    pub fn deinit(q: *Quantised, gpa: std.mem.Allocator) void {
+        gpa.free(q.codes);
+        gpa.free(q.scales);
+    }
+};
+
+/// The e4m3 byte of a value toE4m3 already rounded (0 <= x <= 448).
+fn e4m3Byte(x: f64) u8 {
+    if (x == 0) return 0;
+    if (x < 1.0 / 64.0) return @intFromFloat(@round(x * 512)); // subnormals: steps of 2^-9
+    const e = std.math.floor(std.math.log2(x));
+    const m: u8 = @intFromFloat(@round((x / std.math.pow(f64, 2, e) - 1) * 8));
+    return @as(u8, @intFromFloat(e + 7)) << 3 | m;
+}
+
+/// The nearest e2m1 nibble to x (ties to the even code), saturating at +-6.
+fn e2m1Code(x: f32) u8 {
+    const mags = [8]f32{ 0, 0.5, 1, 1.5, 2, 3, 4, 6 };
+    const a = @abs(x);
+    var best: u8 = 0;
+    for (mags, 0..) |m, i| {
+        const d = @abs(a - m);
+        const b = @abs(a - mags[best]);
+        if (d < b or (d == b and i % 2 == 0)) best = @intCast(i);
+    }
+    return if (x < 0 and best != 0) best | 8 else best;
+}
+
+fn bf(v: u16) f32 {
+    return @bitCast(@as(u32, v) << 16);
+}
+
+/// bf16 [n, k] (k a multiple of 16) as NVFP4: global = amax / (6 x 448), each block's scale its amax / 6 / global.
+pub fn quantise(gpa: std.mem.Allocator, w: []const u16, n: usize, k: usize) !Quantised {
+    std.debug.assert(w.len == n * k and k % 16 == 0);
+    var amax: f32 = 0;
+    for (w) |v| amax = @max(amax, @abs(bf(v)));
+    const global: f32 = if (amax > 0) amax / (6.0 * 448.0) else 1.0;
+    const codes = try gpa.alloc(u8, n * k / 2);
+    errdefer gpa.free(codes);
+    const scales = try gpa.alloc(u8, n * k / 16);
+    for (0..n * k / 16) |b| {
+        const blk = w[b * 16 ..][0..16];
+        var bmax: f32 = 0;
+        for (blk) |v| bmax = @max(bmax, @abs(bf(v)));
+        const s = fp8.toE4m3(bmax / 6.0 / global);
+        scales[b] = e4m3Byte(s);
+        const step: f32 = @floatCast(fp8.e4m3(scales[b]) * global);
+        for (0..8) |p| {
+            const lo = if (step > 0) e2m1Code(bf(blk[2 * p]) / step) else 0;
+            const hi = if (step > 0) e2m1Code(bf(blk[2 * p + 1]) / step) else 0;
+            codes[b * 8 + p] = lo | hi << 4;
+        }
+    }
+    return .{ .codes = codes, .scales = scales, .global = global };
+}
+
+test "dspark_quant: e4m3 bytes round-trip, e2m1 rounds to nearest, a matrix decodes within half a step" {
+    for (0..0x7f) |b| try std.testing.expectEqual(@as(u8, @intCast(b)), e4m3Byte(fp8.e4m3(@intCast(b))));
+    try std.testing.expectEqual(@as(u8, 0x6), e2m1Code(4.4)); // 4
+    try std.testing.expectEqual(@as(u8, 0x7), e2m1Code(5.1)); // 6
+    try std.testing.expectEqual(@as(u8, 0xb), e2m1Code(-1.4)); // -1.5
+    try std.testing.expectEqual(@as(u8, 0x7), e2m1Code(9.0)); // saturates at 6
+    const n = 3;
+    const k = 64;
+    var w: [n * k]u16 = undefined;
+    var rng = std.Random.DefaultPrng.init(7);
+    for (&w) |*v| v.* = @truncate(@as(u32, @bitCast(rng.random().floatNorm(f32) * 0.02)) >> 16);
+    var q = try quantise(std.testing.allocator, &w, n, k);
+    defer q.deinit(std.testing.allocator);
+    for (0..n * k) |i| {
+        const s = fp8.e4m3(q.scales[i / 16]) * q.global;
+        const nib = (q.codes[i / 2] >> @intCast(4 * (i % 2))) & 0xF;
+        const back = fp4.e2m1(nib) * s;
+        // the widest e2m1 gap is 2 (4 to 6): within one step of the block scale, and a block's largest is kept close
+        try std.testing.expect(@abs(back - bf(w[i])) <= s + 1e-9);
+    }
+}
