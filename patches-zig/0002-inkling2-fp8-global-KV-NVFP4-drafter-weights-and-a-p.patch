diff --git a/zig/src/families/inkling2/profile.zig b/zig/src/families/inkling2/profile.zig
new file mode 100644
index 000000000..e8b6970d1
--- /dev/null
+++ b/zig/src/families/inkling2/profile.zig
@@ -0,0 +1,87 @@
+//! TF_INKLING2_PROFILE=1: wall ms of a round's phases on each rank, a line every 200 rounds (off: no syncs, no cost).
+const std = @import("std");
+
+pub const Phase = enum { verify, forward, draws, keep, draft, send, outside, wait, run };
+const n_phases = 9;
+
+pub const Profile = struct {
+    on: bool = false,
+    io: ?std.Io = null,
+    ns: [n_phases]u64 = @splat(0),
+    calls: [n_phases]u64 = @splat(0),
+    rounds: u64 = 0,
+    rows: u64 = 0,
+    streams: u64 = 0,
+    last_end: ?u64 = null, // rank 0: when the last lanes call returned
+    rank: usize = 0,
+
+    pub fn now(p: *const Profile) u64 {
+        return @intCast(std.Io.Clock.awake.now(p.io.?).toNanoseconds());
+    }
+
+    pub fn add(p: *Profile, ph: Phase, t0: u64) void {
+        if (!p.on) return;
+        p.ns[@backingInt(ph)] += p.now() - t0;
+        p.calls[@backingInt(ph)] += 1;
+    }
+
+    /// A lanes call starts: the time since the last one returned is outside every call.
+    pub fn enter(p: *Profile) u64 {
+        const t = p.now();
+        if (p.last_end) |e| {
+            p.ns[@backingInt(Phase.outside)] += t - e;
+            p.calls[@backingInt(Phase.outside)] += 1;
+        }
+        return t;
+    }
+
+    pub fn leave(p: *Profile, ph: Phase, t0: u64) void {
+        const t = p.now();
+        p.ns[@backingInt(ph)] += t - t0;
+        p.calls[@backingInt(ph)] += 1;
+        p.last_end = t;
+    }
+
+    /// A verify of `streams` windows and `rows` rows ended a round; every 200 rounds one line, then from zero.
+    pub fn round(p: *Profile, streams: usize, rows: usize) void {
+        p.rounds += 1;
+        p.streams += streams;
+        p.rows += rows;
+        if (p.rounds < 200) return;
+        p.print();
+    }
+
+    pub fn print(p: *Profile) void {
+        var buf: [768]u8 = undefined;
+        var w: std.Io.Writer = .fixed(&buf);
+        const n: f64 = @floatFromInt(@max(p.rounds, 1));
+        w.print("inkling2 profile rank {d}: {d} rounds, {d:.2} streams, {d:.2} rows a round; ms a round:", .{ p.rank, p.rounds, @as(f64, @floatFromInt(p.streams)) / n, @as(f64, @floatFromInt(p.rows)) / n }) catch {};
+        for (p.ns, p.calls, 0..) |ns, c, i| {
+            if (c == 0) continue;
+            w.print(" {s} {d:.2} ({d:.1}/round)", .{ @tagName(@as(Phase, @fromBackingInt(@intCast(i)))), @as(f64, @floatFromInt(ns)) / 1e6 / n, @as(f64, @floatFromInt(c)) / n }) catch {};
+        }
+        std.log.info("{s}", .{w.buffered()});
+        const keep_on = p.on;
+        const keep_io = p.io;
+        const keep_rank = p.rank;
+        p.* = .{ .on = keep_on, .io = keep_io, .rank = keep_rank };
+    }
+};
+
+/// The process's profile (the lanes host, the engine and the follower share it).
+pub var global: Profile = .{};
+
+/// Turns the profile on from TF_INKLING2_PROFILE (read once, at engine start).
+pub fn start(io: std.Io, rank: usize) !void {
+    global.io = io;
+    global.rank = rank;
+    comptime @import("sys").environment.registered("TF_INKLING2_PROFILE");
+    global.on = try @import("sys").environment.read(bool, "TF_INKLING2_PROFILE", false);
+    if (global.on) std.log.info("inkling2 profile: on (rank {d}); forwards synced to time draws apart", .{rank});
+}
+
+test "profile: off adds nothing; a round line resets the counters" {
+    var p: Profile = .{};
+    p.add(.forward, 0);
+    try std.testing.expectEqual(@as(u64, 0), p.calls[@backingInt(Phase.forward)]);
+}
