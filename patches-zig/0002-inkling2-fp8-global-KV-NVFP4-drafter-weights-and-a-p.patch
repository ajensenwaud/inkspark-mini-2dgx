     const int row = blockIdx.x, y = blockIdx.y, lane = threadIdx.x;
     const int pos = rpos[row];
@@ -84,6 +161,13 @@ __device__ __forceinline__ void prepRow(const uint16_t* __restrict__ q_raw, cons
         for (int i = 0; i < 4; ++i) x[i] *= r;
     }
     const Seg s = segs[rseg[row]];
+    if (KV8) {  // the bf16 value, as the bf16 cache would hold it, to e4m3
