new file mode 100644
index 000000000..a2c5dd825
--- /dev/null
+++ b/zig/kernels/cuda/inkling2/dspark_many.cuh
@@ -0,0 +1,308 @@
+// Inkling 2's DSpark drafter, every stream of a pass in one launch a step (Mini's batched pass; dspark_many.zig).
+#pragma once
+
+// One stream of a batched pass (dspark_many.zig's Stream): its slot's caches by layer, f_rnn, anchor, keys, race.
+struct DspStream {
+    uint16_t* kc[8];
+    uint16_t* vc[8];
+    const uint16_t* frnn;
+    unsigned long long seed;
+    int p, race;
+    float inv_t;
+    int lo[8];
+    int pad;
+};
+
+namespace ink2m {
+
+__device__ __forceinline__ bool better(float v, int i, float bv, int bi) { return v > bv || (v == bv && i < bi); }
+
+// sample.cu's keys (as ops.cu's tf_ink2_race1)
+__device__ __forceinline__ unsigned long long mix(unsigned long long x) {
+    x ^= x >> 30;
+    x *= 0xBF58476D1CE4E5B9ull;
+    x ^= x >> 27;
+    x *= 0x94D049BB133111EBull;
+    return x ^ (x >> 31);
+}
+
+__device__ __forceinline__ float race_uniform(unsigned long long seed, unsigned pos, unsigned id) {
+    unsigned long long x = mix(seed + 0x9E3779B97F4A7C15ull);
+    x = mix(x ^ (static_cast<unsigned long long>(pos) * 0xD1B54A32D192ED03ull));
+    x = mix(x ^ static_cast<unsigned long long>(id));
+    const float u = (static_cast<float>(static_cast<unsigned>(x >> 40)) + 0.5f) * (1.0f / 16777216.0f);
+    return fminf(u, __uint_as_float(0x3F7FFFFFu));
+}
+
+}  // namespace ink2m
+
+// tf_ink2_dsp_qk over every stream's rows: row r is stream at[2r]'s position at[2r + 1], into that slot's caches.
+extern "C" __global__ void __launch_bounds__(64) tf_ink2_dsp_qk_many(QkArgs a, const DspStream* __restrict__ st,
+                                                                     const int* __restrict__ at, int layer) {
+    using namespace ink2d;
+    __shared__ float sh[32];
+    const int row = blockIdx.x, h = blockIdx.y, i = threadIdx.x;
+    const bool isq = h < a.hq;
+    const uint16_t* x = a.x + row * a.ld + static_cast<long long>(h) * kD;
+    const float x0 = bf(x[i]), x1 = bf(x[i + 64]);
+    const float inv = 1.0f / sqrtf(blockSum(x0 * x0 + x1 * x1, sh) / kD + a.eps);
+    const uint16_t* w = isq ? a.qw : a.kw;
+    const float y0 = bfr(x0 * inv * bf(w[i])), y1 = bfr(x1 * inv * bf(w[i + 64]));
+    const int pos = at[2 * row + 1];
+    const float f = static_cast<float>(pos) * (1.0f / powf(a.theta, static_cast<float>(2 * i) / kD));
+    const float co = cosf(f), si = sinf(f);
+    const uint16_t o0 = tobf(y0 * co - y1 * si), o1 = tobf(y1 * co + y0 * si);
+    if (isq) {
+        uint16_t* q = a.q + (static_cast<size_t>(row) * a.hq + h) * kD;
+        q[i] = o0;
+        q[i + 64] = o1;
+        return;
+    }
+    const DspStream& s = st[at[2 * row]];
+    uint16_t* kc = s.kc[layer];
+    uint16_t* vc = s.vc[layer];
+    const int j = h - a.hq;
+    const size_t o = (static_cast<size_t>(pos % a.ring) * a.hk + j) * kD;
+    kc[o + i] = o0;
+    kc[o + i + 64] = o1;
+    const uint16_t* v = a.x + row * a.ld + static_cast<long long>(a.hq + a.hk + j) * kD;
+    vc[o + i] = v[i];
+    vc[o + i + 64] = v[i + 64];
+}
+
+// tf_ink2_dsp_attn for every stream's block (blockIdx.z): its keys [lo, p + T - 1], partials maxc chunks apart.
+extern "C" __global__ void __launch_bounds__(256) tf_ink2_dsp_attn_many(AttnArgs a, const DspStream* __restrict__ st, int layer,
+                                                                        int maxc) {
+    using namespace ink2d;
+    __shared__ float sq[kMaxQ][kD];
+    __shared__ uint16_t sk[kKT][kD + 8];
+    __shared__ uint16_t sv[kKT][kD];
+    __shared__ float sp[kMaxQ][kKT];
+    __shared__ float sm[kMaxQ], sl[kMaxQ], sa[kMaxQ];
+    const DspStream& S = st[blockIdx.z];
+    const int lo = S.lo[layer], hi = S.p + a.T - 1;
+    if (static_cast<int>(blockIdx.x) > hi / kChunk - lo / kChunk) return;
+    const int j = blockIdx.y, c = lo / kChunk + blockIdx.x, tid = threadIdx.x;
+    const int g = a.hq / a.hk, nq = a.T * g, nqt = a.T * a.hq;
+    const uint16_t* aq = a.q + static_cast<size_t>(blockIdx.z) * nqt * kD;
+    const uint16_t* kc = S.kc[layer];
+    const uint16_t* vc = S.vc[layer];
+    float* po = a.po + static_cast<size_t>(blockIdx.z) * maxc * nqt * kD;
+    float* pml = a.pml + static_cast<size_t>(blockIdx.z) * maxc * nqt * 2;
+    const int k0 = max(lo, c * kChunk), k1 = min(hi + 1, (c + 1) * kChunk);
+    for (int idx = tid; idx < nq * kD; idx += blockDim.x) {
+        const int qi = idx / kD, d = idx % kD;
+        sq[qi][d] = bf(aq[(static_cast<size_t>(qi / g) * a.hq + j * g + qi % g) * kD + d]);
+    }
+    for (int qi = tid; qi < nq; qi += blockDim.x) {
+        sm[qi] = -INFINITY;
+        sl[qi] = 0.0f;
+    }
+    const int d = tid & (kD - 1), half = tid >> 7;
+    float o[kMaxQ / 2];
+    for (int r = 0; r < kMaxQ / 2; ++r) o[r] = 0.0f;
+    __syncthreads();
+    for (int kt = k0; kt < k1; kt += kKT) {
+        const int nk = min(kKT, k1 - kt);
+        for (int idx = tid; idx < nk * kD; idx += blockDim.x) {
+            const int kk = idx / kD, dd = idx % kD;
+            const size_t at = (static_cast<size_t>((kt + kk) % a.ring) * a.hk + j) * kD + dd;
+            sk[kk][dd] = kc[at];
+            sv[kk][dd] = vc[at];
+        }
+        __syncthreads();
+        for (int idx = tid; idx < nq * kKT; idx += blockDim.x) {
+            const int qi = idx / kKT, kk = idx % kKT;
+            float s = -INFINITY;
+            if (kk < nk) {
+                s = 0.0f;
+                for (int dd = 0; dd < kD; ++dd) s += sq[qi][dd] * bf(sk[kk][dd]);
+                s *= a.scale;
+            }
+            sp[qi][kk] = s;
+        }
+        __syncthreads();
+        for (int qi = tid; qi < nq; qi += blockDim.x) {
+            float mx = sm[qi];
+            for (int kk = 0; kk < nk; ++kk) mx = fmaxf(mx, sp[qi][kk]);
+            const float al = expf(sm[qi] - mx);
+            float sum = 0.0f;
+            for (int kk = 0; kk < nk; ++kk) {
+                const float p = expf(sp[qi][kk] - mx);
+                sp[qi][kk] = p;
+                sum += p;
+            }
+            sl[qi] = sl[qi] * al + sum;
+            sm[qi] = mx;
+            sa[qi] = al;
+        }
+        __syncthreads();
+        for (int r = 0; r < kMaxQ / 2; ++r) {
+            const int qi = half * (kMaxQ / 2) + r;
+            if (qi >= nq) break;
+            float acc = o[r] * sa[qi];
+            for (int kk = 0; kk < nk; ++kk) acc += sp[qi][kk] * bf(sv[kk][d]);
+            o[r] = acc;
+        }
+        __syncthreads();
+    }
+    for (int r = 0; r < kMaxQ / 2; ++r) {
+        const int qi = half * (kMaxQ / 2) + r;
+        if (qi >= nq) break;
+        const size_t rh = static_cast<size_t>(blockIdx.x) * nqt + (qi / g) * a.hq + j * g + qi % g;
+        po[rh * kD + d] = o[r];
+        if (d == 0) {
+            pml[rh * 2] = sm[qi];
+            pml[rh * 2 + 1] = sl[qi];
+        }
+    }
+}
+
+// tf_ink2_dsp_merge for every stream (blockIdx.y): its chunks folded in order into its block's rows of out.
+extern "C" __global__ void __launch_bounds__(128) tf_ink2_dsp_merge_many(const float* __restrict__ po, const float* __restrict__ pml,
+                                                                         const DspStream* __restrict__ st, int layer, int T,
+                                                                         int maxc, int nqt, uint16_t* __restrict__ out) {
+    using namespace ink2d;
+    const DspStream& S = st[blockIdx.y];
+    const int chunks = (S.p + T - 1) / kChunk - S.lo[layer] / kChunk + 1;
+    po += static_cast<size_t>(blockIdx.y) * maxc * nqt * kD;
+    pml += static_cast<size_t>(blockIdx.y) * maxc * nqt * 2;
+    out += static_cast<size_t>(blockIdx.y) * nqt * kD;
+    const size_t rh = blockIdx.x;
+    const int d = threadIdx.x;
+    float mx = -INFINITY;
+    for (int c = 0; c < chunks; ++c) mx = fmaxf(mx, pml[(c * nqt + rh) * 2]);
+    float l = 0.0f, acc = 0.0f;
+    for (int c = 0; c < chunks; ++c) {
+        const float m = pml[(c * nqt + rh) * 2];
+        const float wt = m == -INFINITY ? 0.0f : expf(m - mx);
+        l += pml[(c * nqt + rh) * 2 + 1] * wt;
+        acc += po[(c * nqt + rh) * kD + d] * wt;
+    }
+    out[rh * kD + d] = tobf(acc / l);
+}
+
+// tf_ink2_dsp_ctx for every stream (blockIdx.y): its hidden rows hstride elements apart, its slot's f_rnn.
+extern "C" __global__ void __launch_bounds__(256) tf_ink2_dsp_ctx_many(const uint16_t* __restrict__ hidden, long long hstride,
+                                                                       const DspStream* __restrict__ st, const uint16_t* __restrict__ W,
+                                                                       const uint16_t* __restrict__ bias, float* __restrict__ out,
+                                                                       int rows, int C, int R) {
+    using namespace ink2d;
+    const int o = blockIdx.x * (blockDim.x >> 5) + (threadIdx.x >> 5), lane = threadIdx.x & 31;
+    if (o >= 3 * R) return;
+    hidden += blockIdx.y * hstride;
+    out += static_cast<size_t>(blockIdx.y) * rows * 3 * R;
+    const uint16_t* frnn = st[blockIdx.y].frnn;
+    const uint16_t* w = W + static_cast<size_t>(o) * (2 * R + 2 * C) + 2 * R;
+    float acc[kMaxRows];
+    for (int r = 0; r < kMaxRows; ++r) acc[r] = 0.0f;
+    for (int k = lane; k < 2 * C; k += 32) {
+        const float wk = bf(w[k]);
+        if (k < C) {
+            for (int r = 0; r < kMaxRows; ++r)
+                if (r < rows) acc[r] += wk * bf(hidden[static_cast<size_t>(r) * C + k]);
+        } else {
+            const float f = wk * bf(frnn[k - C]);
+            for (int r = 0; r < kMaxRows; ++r) acc[r] += f;
+        }
+    }
+    for (int r = 0; r < kMaxRows; ++r) {
+        const float s = warpSum(acc[r]);
+        if (lane == 0 && r < rows) out[static_cast<size_t>(r) * 3 * R + o] = s + bf(bias[o]);
+    }
+}
+
+// tf_ink2_dsp_rnn for every stream (a block each): ctx rows cstride apart, walks T apart, states and latents R apart.
+extern "C" __global__ void __launch_bounds__(256) tf_ink2_dsp_rnn_many(const float* __restrict__ ctx, long long cstride,
+                                                                       const uint16_t* __restrict__ W, const uint16_t* __restrict__ w1,
+                                                                       const int* __restrict__ walk, int T, int j,
+                                                                       uint16_t* __restrict__ state, uint16_t* __restrict__ latent,
+                                                                       int R, int C) {
+    using namespace ink2d;
+    __shared__ float in[512];
+    __shared__ float raw[768];
+    const int c = threadIdx.x, lane = c & 31, wp = c >> 5, nw = blockDim.x >> 5;
+    ctx += blockIdx.x * cstride;
+    walk += blockIdx.x * T;
+    state += blockIdx.x * R;
+    latent += blockIdx.x * R;
+    const size_t prev = static_cast<size_t>(walk[j]);
+    in[c] = bf(state[c]);
+    in[R + c] = bf(w1[prev * R + c]);
+    __syncthreads();
+    const int ld = 2 * R + 2 * C;
+    for (int o = wp; o < 3 * R; o += nw) {
+        float s = 0.0f;
+        for (int k = lane; k < 2 * R; k += 32) s += bf(W[static_cast<size_t>(o) * ld + k]) * in[k];
+        s = warpSum(s);
+        if (lane == 0) raw[o] = s + ctx[o];
+    }
+    __syncthreads();
+    const float gate = bfr(1.0f / (1.0f + expf(-bfr(raw[c]))));
+    const float cand = bfr(tanhf(bfr(raw[R + c])));
+    const float keep = bfr(gate * in[c]);
+    const float upd = bfr(bfr(1.0f - gate) * cand);
+    state[c] = tobf(keep + upd);
+    latent[c] = tobf(tanhf(bfr(raw[2 * R + c])));
+}
+
+// Each stream's step pick (a block each): greedy over nv columns or its keyed race over valid, into picks 16 B apart.
+extern "C" __global__ void __launch_bounds__(1024) tf_ink2_dsp_pick_many(const float* __restrict__ scores, int nv, int valid,
+                                                                         int base, const DspStream* __restrict__ st, int step,
+                                                                         float* __restrict__ picks) {
+    using namespace ink2d;
+    using ink2m::better;
+    __shared__ float sv[32];
+    __shared__ int si[32];
+    const DspStream& S = st[blockIdx.x];
+    const float* r = scores + static_cast<size_t>(blockIdx.x) * nv;
+    float bv = -INFINITY;
+    int bi = 0x7fffffff;
+    if (S.race) {
+        const unsigned pos = static_cast<unsigned>(S.p + 1 + step);
+        for (int i = threadIdx.x; i < valid; i += blockDim.x) {
+            const float v = bfr(r[i]) * S.inv_t - logf(-logf(ink2m::race_uniform(S.seed, pos, static_cast<unsigned>(base + i))));
+            if (better(v, i, bv, bi)) {
+                bv = v;
+                bi = i;
+            }
+        }
+    } else {
+        for (int i = threadIdx.x; i < nv; i += blockDim.x) {
+            if (better(r[i], i, bv, bi)) {
+                bv = r[i];
+                bi = i;
+            }
+        }
+    }
+    for (int o = 16; o > 0; o >>= 1) {
+        const float ov = __shfl_xor_sync(0xffffffffu, bv, o);
+        const int oi = __shfl_xor_sync(0xffffffffu, bi, o);
+        if (better(ov, oi, bv, bi)) {
+            bv = ov;
+            bi = oi;
+        }
+    }
+    const int warp = threadIdx.x >> 5, lane = threadIdx.x & 31;
+    if (lane == 0) {
+        sv[warp] = bv;
+        si[warp] = bi;
+    }
+    __syncthreads();
+    if (warp != 0) return;
+    const int nw = blockDim.x >> 5;
+    bv = lane < nw ? sv[lane] : -INFINITY;
+    bi = lane < nw ? si[lane] : 0x7fffffff;
+    for (int o = 16; o > 0; o >>= 1) {
+        const float ov = __shfl_xor_sync(0xffffffffu, bv, o);
+        const int oi = __shfl_xor_sync(0xffffffffu, bi, o);
+        if (better(ov, oi, bv, bi)) {
+            bv = ov;
+            bi = oi;
+        }
+    }
+    if (lane == 0) {
+        picks[blockIdx.x * 4] = bv;
+        reinterpret_cast<int*>(picks)[blockIdx.x * 4 + 1] = (bi == 0x7fffffff ? 0 : bi) + base;
+    }
+}
diff --git a/zig/src/families/inkling2/dspark_many.zig b/zig/src/families/inkling2/dspark_many.zig
new file mode 100644
index 000000000..bac13da27
--- /dev/null
+++ b/zig/src/families/inkling2/dspark_many.zig
@@ -0,0 +1,249 @@
+//! Mini's batched draft pass: every stream's absorb and block through each launch once (dspark_many.cuh).
+const std = @import("std");
+const cuda = @import("cuda");
+const fw = @import("forward.zig");
+const ops = @import("ops.zig");
+const ds = @import("dspark.zig");
+const dk = @import("dspark_ops.zig");
+const drun = @import("dspark_run.zig");
+
+const Buf = cuda.DeviceBuffer;
+const T = ds.block;
+const most = drun.max_streams;
+
+/// A stream's kept rows (its slot's stash) absorbed at positions p0.. before any block of the pass.
+pub const Absorb = struct { slot: *drun.Slot, rows: usize, p0: usize };
+
+/// The host table a pass uploads once: streams, rows' (stream, position) for blocks and absorbs, anchors, walks.
+const Table = extern struct {
+    streams: [most]dk.Stream,
+    blk: [most * T][2]i32,
+    abs: [most * T][2]i32,
+    ids: [most]i32,
+    walk: [most * T]i32,
+};
+
+/// What the batched pass adds to a drafter: the table, the absorbed rows' taps, masks for every block, partials.
+pub const Scratch = struct {
+    tab: Buf,
+    taps: Buf, // bf16 [most * T][taps_n][hidden]: the absorbed rows' taps side by side
+    masks: Buf, // bf16 [most][T - 1][hidden]: every block's rows past its anchor
+    anchors: Buf, // bf16 [most][hidden]: the blocks' embedded anchors
+    po: ?Buf = null,
+    pml: ?Buf = null,
+    slots: usize = 0, // streams x chunks the partials hold
+
+    pub fn init(dr: *drun.Drafter, s: cuda.Stream) !Scratch {
+        const h = dr.hidden;
+        var tab = try Buf.alloc(dr.d, @sizeOf(Table));
+        errdefer tab.free();
+        var taps = try Buf.alloc(dr.d, most * T * @as(usize, dr.w.c.taps_n) * h * 2);
+        errdefer taps.free();
+        var masks = try Buf.alloc(dr.d, most * (T - 1) * h * 2);
+        errdefer masks.free();
+        var anchors = try Buf.alloc(dr.d, most * h * 2);
+        errdefer anchors.free();
+        for (0..most * (T - 1)) |r| try dr.copy(s, masks.ptr + r * h * 2, dr.w.mask, h * 2);
+        try s.synchronize();
+        return .{ .tab = tab, .taps = taps, .masks = masks, .anchors = anchors };
+    }
+
+    pub fn deinit(x: *Scratch) void {
+        for ([_]*Buf{ &x.tab, &x.taps, &x.masks, &x.anchors }) |b| b.free();
+        if (x.po) |*b| b.free();
+        if (x.pml) |*b| b.free();
+    }
+
+    /// Partials for `n` (stream, chunk) pairs of T x hq rows (grown, never shrunk; the last pass has synchronised).
+    fn grow(x: *Scratch, d: *const cuda.Driver, n: usize, hq: usize) !void {
+        if (n <= x.slots) return;
+        if (x.po) |*b| b.free();
+        if (x.pml) |*b| b.free();
+        x.po = null;
+        x.pml = null;
+        x.slots = 0;
+        x.po = try Buf.alloc(d, n * T * hq * 128 * 4);
+        x.pml = try Buf.alloc(d, n * T * hq * 2 * 4);
+        x.slots = n;
+    }
+};
+
+fn off(comptime field: []const u8) u64 {
+    return @offsetOf(Table, field);
+}
+
+/// A sliding draft layer keeps its window, the global layer the slot's whole context.
+fn lowKey(c: *const ds.Config, l: usize, slot: *const drun.Slot, p: usize) usize {
+    return if (c.local[l]) @max(slot.from, p -| c.window) else slot.from;
+}
+
+/// Every stream's kept rows absorbed, then every block drafted: each step one launch for all streams.
+pub fn pass(dr: *drun.Drafter, m: *fw.Modules, s: cuda.Stream, ex: fw.Exchange, t: anytype, abs: []const Absorb, bs: []const drun.Block) !void {
+    const x = &(dr.many orelse return error.Inkling2DraftShape);
+    const c = &dr.w.c;
+    const S = bs.len;
+    if (S > dr.streams or abs.len > most) return error.Inkling2DraftShape;
+    var tb: Table = undefined;
+    @memset(std.mem.asBytes(&tb), 0);
+    var n_abs: usize = 0; // absorbed rows
+    var ents: usize = S; // table entries: the blocks' streams, then streams that only absorb
+    for (abs) |a| {
+        if (a.rows == 0 or a.rows > T or n_abs + a.rows > dr.ctx_rows) return error.Inkling2DraftShape;
+        const e = for (bs, 0..) |b, j| {
+            if (b.slot == a.slot) break j;
+        } else blk: {
+            if (ents == most) return error.Inkling2DraftShape;
+            ents += 1;
+            break :blk ents - 1;
+        };
+        fill(&tb.streams[e], c, a.slot);
+        for (0..a.rows) |r| tb.abs[n_abs + r] = .{ @intCast(e), @intCast(a.p0 + r) };
+        n_abs += a.rows;
+        if (a.slot.to != a.p0) a.slot.from = a.p0; // a gap: the context starts again here (absorb's rule)
+        a.slot.to = a.p0 + a.rows;
+    }
+    var maxc: [ds.max_layers]usize = @splat(0);
+    for (bs, 0..) |b, j| {
+        if (b.out.len == 0 or b.out.len > T - 1 or b.p + T > dr.capacity) return error.Inkling2DraftShape;
+        if (b.slot.to != b.p) {
+            b.slot.from = b.p;
+            b.slot.to = b.p;
+        }
+        const st = &tb.streams[j];
+        fill(st, c, b.slot);
+        st.p = @intCast(b.p);
+        if (b.race) |rc| {
+            st.race = 1;
+            st.seed = rc.seed;
+            st.inv_t = rc.inv_t;
+        }
+        for (0..c.layers) |l| {
+            const lo = lowKey(c, l, b.slot, b.p);
+            st.lo[l] = @intCast(lo);
+            maxc[l] = @max(maxc[l], dk.chunks(lo, b.p + T - 1));
+        }
+        for (0..T) |r| tb.blk[j * T + r] = .{ @intCast(j), @intCast(b.p + r) };
+        tb.ids[j] = @intCast(b.anchor);
+        @memset(tb.walk[j * T ..][0..T], @intCast(b.anchor));
+    }
+    var deepest: usize = 0;
+    for (maxc[0..c.layers]) |n| deepest = @max(deepest, n);
+    try x.grow(dr.d, S * deepest, dr.hq);
+    try cuda.copy_source.enqueue(dr.d, x.tab.ptr, std.mem.asBytes(&tb), s);
+    const tab = x.tab.ptr;
+    if (n_abs > 0) try absorbAll(dr, s, abs, n_abs, tab + off("abs"));
+    if (S == 0) return;
+    try blocks(dr, m, s, ex, t, bs, maxc, tab);
+}
+
+fn fill(st: *dk.Stream, c: *const ds.Config, slot: *const drun.Slot) void {
+    for (0..c.layers) |l| {
+        st.kc[l] = slot.keys(l);
+        st.vc[l] = slot.values(l);
+    }
+    st.frnn = slot.frnn;
+}
+
+/// The absorbs' rows side by side: per layer one tap mix, one kv projection, one q/k prep into each slot.
+fn absorbAll(dr: *drun.Drafter, s: cuda.Stream, abs: []const Absorb, rows: usize, at: u64) !void {
+    const x = &dr.many.?;
+    const c = &dr.w.c;
+    const h = dr.hidden;
+    const tn: usize = c.taps_n;
+    const row_bytes = tn * h * 2;
+    var r: usize = 0;
+    for (abs) |a| {
+        try dr.copy(s, x.taps.ptr + r * row_bytes, a.slot.stash, a.rows * row_bytes);
+        r += a.rows;
+    }
+    for (dr.w.layers[0..c.layers], 0..) |l, i| {
+        try dk.mix(&dr.k, s, x.taps.ptr, dr.w.alpha + i * tn * 4, l.dflare, dr.mixed, rows, tn, h, c.eps);
+        try dr.mm(s, l.kv, dr.mixed, rows, dr.ckv, .bf16);
+        const q: dk.QkArgs = .{ .x = dr.ckv, .qw = 0, .kw = l.k_norm_ctx, .q = 0, .kc = 0, .vc = 0, .ld = @intCast(2 * dr.hk * 128), .hq = 0, .hk = @intCast(dr.hk), .ring = @intCast(drun.ring(c, i, dr.capacity)), .pos0 = 0, .eps = c.eps, .theta = c.theta };
+        try dk.qkMany(&dr.k, s, q, x.tab.ptr, at, i, rows);
+    }
+    r = 0;
+    for (abs) |a| {
+        r += a.rows;
+        try dk.mix(&dr.k, s, x.taps.ptr + (r - 1) * row_bytes, dr.w.alpha + c.layers * tn * 4, dr.w.m_norm, a.slot.frnn, 1, tn, h, c.eps);
+    }
+}
+
+/// The blocks: layers and head over every block's rows, each layer's attention one launch, then the walks together.
+fn blocks(dr: *drun.Drafter, m: *fw.Modules, s: cuda.Stream, ex: fw.Exchange, t: anytype, bs: []const drun.Block, maxc: [ds.max_layers]usize, tab: u64) !void {
+    const x = &dr.many.?;
+    const c = &dr.w.c;
+    const h = dr.hidden;
+    const S = bs.len;
+    const rows = S * T;
+    const walk = tab + off("walk");
+    try ops.embed(&m.ops, s, tab + off("ids"), S, t.embed, t.embed_norm, x.anchors.ptr, h, t.config.eps);
+    try copy2d(dr, s, dr.resid, T * h * 2, x.anchors.ptr, h * 2, h * 2, S); // each block's anchor row
+    try copy2d(dr, s, dr.resid + h * 2, T * h * 2, x.masks.ptr, (T - 1) * h * 2, (T - 1) * h * 2, S); // then its masks
+    try dk.addNorm(&dr.k, s, dr.resid, 0, 0, 0, dr.w.layers[0].in_norm, dr.x, rows, h, c.eps);
+    const L = dr.w.layers[0..c.layers];
+    const scale: f32 = 1.0 / @sqrt(128.0);
+    const qkvw = (dr.hq + 2 * dr.hk) * 128;
+    for (L, 0..) |l, i| {
+        try dr.mm(s, l.qkv, dr.x, rows, dr.qkv, .bf16);
+        const r: i32 = @intCast(drun.ring(c, i, dr.capacity));
+        const q: dk.QkArgs = .{ .x = dr.qkv, .qw = l.q_norm, .kw = l.k_norm, .q = dr.q, .kc = 0, .vc = 0, .ld = @intCast(qkvw), .hq = @intCast(dr.hq), .hk = @intCast(dr.hk), .ring = r, .pos0 = 0, .eps = c.eps, .theta = c.theta };
+        try dk.qkMany(&dr.k, s, q, tab, tab + off("blk"), i, rows);
+        const at: dk.AttnArgs = .{ .q = dr.q, .kc = 0, .vc = 0, .po = x.po.?.ptr, .pml = x.pml.?.ptr, .T = T, .hq = @intCast(dr.hq), .hk = @intCast(dr.hk), .ring = r, .lo = 0, .hi = 0, .c0 = 0, .scale = scale };
+        try dk.attendMany(&dr.k, s, at, tab, i, S, maxc[i], dr.att);
+        try dr.mm(s, l.o, dr.att, rows, dr.mySlot(rows), .f32);
+        try dr.gather(s, ex, rows);
+        try dk.addNorm(&dr.k, s, dr.resid, dr.gath, dr.world, rows * h, l.post_norm, dr.x, rows, h, c.eps);
+        try dr.mm(s, l.gu, dr.x, rows, dr.gu, .bf16);
+        try dk.silu(&dr.k, s, dr.gu, dr.act, rows, dr.inter);
+        try dr.mm(s, l.down, dr.act, rows, dr.mySlot(rows), .f32);
+        try dr.gather(s, ex, rows);
+        const next = if (i + 1 < L.len) L[i + 1].in_norm else dr.w.norm;
+        try dk.addNorm(&dr.k, s, dr.resid, dr.gath, dr.world, rows * h, next, dr.x, rows, h, c.eps);
+    }
+    // rows 1..7 of each block: the head's base logits (one block alone keeps its 7-row call), the walks
+    if (S == 1) try m.dense.decode(s, t.head, dr.x + h * 2, .bf16, T - 1, dr.base + dr.nv * 2, .bf16) else try m.dense.decode(s, t.head, dr.x, .bf16, rows, dr.base, .bf16);
+    const R: usize = c.rank;
+    var steps: usize = 0;
+    for (bs) |b| steps = @max(steps, b.out.len);
+    try dk.ctxMany(&dr.k, s, dr.x + h * 2, T * h, tab, dr.w.rnn, dr.w.rnn_bias, dr.mctx, S, T - 1, h, R);
+    try dr.d.check(dr.d.api.cuMemsetD8Async(dr.state, 0, S * R * 2, s.handle), "cuMemsetD8Async");
+    for (0..steps) |st| {
+        try dk.rnnMany(&dr.k, s, dr.mctx + st * 3 * R * 4, (T - 1) * 3 * R, dr.w.rnn, dr.w.w1, walk, T, st, dr.state, dr.latent, S, R, h);
+        try dk.vocabRows(&dr.k, s, dr.base + (1 + st) * dr.nv * 2, T * dr.nv, dr.latent, dr.fold, dr.fbias, dr.cap, dr.valid, dr.nv, S, dr.scores);
+        if (dr.keep_logits != 0 and S == 1) try dr.copy(s, dr.keep_logits + st * dr.nv * 4, dr.scores, dr.nv * 4);
+        const own = dr.picks + dr.rank * S * 16;
+        try dk.pickMany(&dr.k, s, dr.scores, dr.nv, dr.valid, dr.vlo, tab, st, own, S);
+        switch (ex) {
+            .local => {},
+            .nccl => |e| if (e.group) |g| try g.allGather(s, own, dr.picks, S * 16) else try e.lib.check(e.lib.api.ncclAllGather(own, dr.picks, S * 16, .u8, e.comm, s.handle), "ncclAllGather"),
+        }
+        try dk.pickRows(&dr.k, s, dr.picks, dr.world, S, walk, T, st);
+    }
+    try s.synchronize();
+    switch (ex) {
+        .local => {},
+        .nccl => |e| if (e.group) |g| try g.check(),
+    }
+    var host: [most * T]i32 = undefined;
+    try (Buf{ .d = dr.d, .ptr = walk, .len = rows * 4, .borrowed = true }).download(0, std.mem.sliceAsBytes(host[0..rows]));
+    for (bs, 0..) |b, j| for (b.out, host[j * T + 1 ..][0..b.out.len]) |*o, g| {
+        o.* = @intCast(g);
+    };
+}
+
+/// `height` rows of `width` bytes, `sp` bytes apart in src, to `dp` bytes apart in dst.
+fn copy2d(dr: *const drun.Drafter, s: cuda.Stream, dst: u64, dp: usize, src: u64, sp: usize, width: usize, height: usize) !void {
+    const p: cuda.abi.Memcpy2D = .{ .src = src, .src_pitch = sp, .dst = dst, .dst_pitch = dp, .width = width, .height = height };
+    try dr.d.check(dr.d.api.cuMemcpy2DAsync_v2(&p, s.handle), "cuMemcpy2DAsync");
+}
+
+test "dspark many: the table's rows for every stream's block and absorb, uploaded once" {
+    try std.testing.expectEqual(@as(usize, most * 192), @offsetOf(Table, "blk"));
+    try std.testing.expect(@sizeOf(Table) < 8192);
+    var c: ds.Config = .{ .window = 1024 };
+    c.local[0] = true;
+    var slot: drun.Slot = .{ .buf = undefined, .from = 100, .to = 5000 };
+    try std.testing.expectEqual(@as(usize, 3976), lowKey(&c, 0, &slot, 5000));
+    try std.testing.expectEqual(@as(usize, 100), lowKey(&c, 1, &slot, 5000));
+}
