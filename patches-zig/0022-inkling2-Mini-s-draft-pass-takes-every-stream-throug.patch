diff --git a/zig/src/families/inkling2/engine_multi.zig b/zig/src/families/inkling2/engine_multi.zig
new file mode 100644
index 000000000..042bd3def
--- /dev/null
+++ b/zig/src/families/inkling2/engine_multi.zig
@@ -0,0 +1,123 @@
+//! tf-inkling2-engine multi: drafted == plain at 1/2/4/8 streams, and Mini's batched pass == the per-stream pass.
+const std = @import("std");
+const ink = @import("inkling2");
+
+const Engine = ink.engine.Engine;
+const Text = struct { name: []const u8, ids: []u32 };
+const Arm = enum { eager, graphed, oracle, sampled };
+
+/// Every arm at 1/2/4/8 streams, depths varied by stream and window (0 too); per-stream and batched drafts must agree.
+pub fn run(e: *Engine, a: std.mem.Allocator, texts: anytype, new: usize, r0: bool) !u8 {
+    var bad: usize = 0;
+    for ([_]Arm{ .eager, .graphed, .oracle, .sampled }) |arm| {
+        const sampled = arm == .sampled;
+        var plains: [8][]u32 = undefined;
+        for (0..8) |i| {
+            e.graphs.settings.on = false;
+            plains[i] = try plain(e, a, texts[i % texts.len].ids, new + 8, if (sampled) rule(i) else null);
+        }
+        for ([_]usize{ 1, 2, 4, 8 }) |k| {
+            e.graphs.settings.on = arm == .graphed or sampled;
+            const orc = if (arm == .oracle) &plains else null;
+            const many = (e.drafter orelse return error.NoDraftHead).many;
+            e.drafter.?.many = null;
+            const old = drafted(e, a, texts, k, new, orc, sampled);
+            e.drafter.?.many = many;
+            const r = try drafted(e, a, texts, k, new, orc, sampled);
+            const ro = try old;
+            var same: usize = 0;
+            for (0..k) |i| same += @intFromBool(std.mem.eql(u32, plains[i][0..new], r.toks[i][0..new]) and std.mem.eql(u32, plains[i][0..new], ro.toks[i][0..new]));
+            const agree = std.mem.eql(u32, ro.log, r.log);
+            const ok = same == k and agree;
+            bad += @intFromBool(!ok);
+            if (r0) std.debug.print("{d} streams {s}: drafted == plain {d}/{d} {s}; batched == per-stream drafts {s} ({d} drafts, {d} passes); accepted {d}/{d}\n", .{ k, @tagName(arm), same, k, if (ok) "PASS" else "FAIL", if (agree) "yes" else "NO", r.log.len, r.passes, r.acc, r.drafted });
+        }
+    }
+    const st = e.graphs.stats;
+    if (r0) std.debug.print("multi: {s}; graphs captured {d}, replayed {d}, eager {d}\n", .{ if (bad == 0) "ALL PASS" else "FAIL", st.captured, st.replayed, st.eager });
+    return if (bad == 0) 0 else 1;
+}
+
+/// Vendor sampling with stream i's own seed: no top-k/top-p cut, so drafts and draws race on each rank's columns.
+fn rule(i: usize) ink.sampler.Sampling {
+    return .{ .seed = 1234 + i, .temperature = 1.0, .top_k = 0, .top_p = 1.0 };
+}
+
+/// One stream's prompt pass on slot 0 then `n` tokens a decode row at a time (greedy, or sampled with `sm`).
+fn plain(e: *Engine, a: std.mem.Allocator, ids: []const u32, n: usize, sm: ?ink.sampler.Sampling) ![]u32 {
+    try e.bind(0);
+    e.begin(sm);
+    var at: usize = 0;
+    var tok: u32 = while (true) : (at += ink.engine.prompt_rows) {
+        if (try e.prefillChunk(ids, at)) |t| break t;
+    };
+    const toks = try a.alloc(u32, n);
+    for (toks) |*x| {
+        x.* = tok;
+        var o: [1]u32 = undefined;
+        try e.verifyShared(&.{.{ .slot = 0, .ids = &.{tok}, .out = &o }});
+        try e.keep(1);
+        tok = o[0];
+    }
+    return toks;
+}
+
+/// k streams on slots 0..k drafting together until each has `n` tokens; `oracle`: plain's tokens, one spoiled.
+fn drafted(e: *Engine, a: std.mem.Allocator, texts: anytype, k: usize, n: usize, oracle: ?*const [8][]u32, sampled: bool) !struct { toks: [8][]u32, log: []u32, passes: usize, acc: usize, drafted: usize } {
+    var log: std.ArrayList(u32) = .empty;
+    var tok: [8]u32 = undefined;
+    var kept: [8]u32 = @splat(0);
+    var toks: [8]std.ArrayList(u32) = @splat(.empty);
+    for (0..k) |i| {
+        try e.bind(@intCast(i));
+        e.begin(if (sampled) rule(i) else null);
+        var at: usize = 0;
+        const ids = texts[i % texts.len].ids;
+        tok[i] = while (true) : (at += ink.engine.prompt_rows) {
+            if (try e.prefillChunk(ids, at)) |t| break t;
+        };
+    }
+    var passes: usize = 0;
+    var acc: usize = 0;
+    var ndrafted: usize = 0;
+    var window: usize = 0;
+    while (true) : (window += 1) {
+        var done = true;
+        for (0..k) |i| done = done and toks[i].items.len >= n;
+        if (done) break;
+        var w: [8][8]u32 = undefined;
+        var depth: [8]usize = undefined;
+        var reqs: [8]ink.engine.Req = undefined;
+        for (0..k) |i| {
+            depth[i] = (i * 3 + window) % 8; // 0..7: some streams draft none
+            w[i][0] = tok[i];
+            reqs[i] = .{ .slot = @intCast(i), .n = kept[i], .anchor = tok[i], .out = w[i][1 .. 1 + depth[i]] };
+        }
+        try e.draftBlock(reqs[0..k]);
+        passes += 1;
+        for (0..k) |i| try log.appendSlice(a, w[i][1 .. 1 + depth[i]]);
+        if (oracle) |orc| for (0..k) |i| {
+            const m = toks[i].items.len;
+            for (1..1 + depth[i]) |j| w[i][j] = orc[i][m + j];
+            if (depth[i] > 0) w[i][1 + window % depth[i]] ^= 1;
+        };
+        var o: [8][8]u32 = undefined;
+        var parts: [8]ink.engine.Part = undefined;
+        for (0..k) |i| parts[i] = .{ .slot = @intCast(i), .ids = w[i][0 .. 1 + depth[i]], .out = o[i][0 .. 1 + depth[i]] };
+        try e.verifyShared(parts[0..k]);
+        for (0..k) |i| {
+            var c: usize = 1;
+            while (c < 1 + depth[i] and w[i][c] == o[i][c - 1]) c += 1;
+            try e.bind(@intCast(i));
+            try e.keep(c);
+            try toks[i].appendSlice(a, w[i][0..c]);
+            acc += c - 1;
+            ndrafted += depth[i];
+            kept[i] = @intCast(c);
+            tok[i] = o[i][c - 1];
+        }
+    }
+    var out: [8][]u32 = undefined;
+    for (0..k) |i| out[i] = toks[i].items;
+    return .{ .toks = out, .log = log.items, .passes = passes, .acc = acc, .drafted = ndrafted };
+}
