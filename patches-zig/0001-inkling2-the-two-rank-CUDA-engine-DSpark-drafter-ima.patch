@@ -0,0 +1,318 @@
+//! TP over processes: rank 0's Leader sends each step (a header, then ids) by NCCL first; the other ranks `follow`.
+const std = @import("std");
+const cuda = @import("cuda");
+const engine = @import("engine.zig");
+const ops = @import("ops.zig");
+const sampler = @import("sampler.zig");
+const Engine = engine.Engine;
+const image = @import("image.zig");
+const vision = @import("vision.zig");
+const pictures = @import("pictures.zig");
+
+pub const Kind = enum(u32) { begin = 1, chunk, shared, keep, release, idle, end, save, drop, reserve, block, images };
+
+/// One step as it crosses: 64 bytes, then `n` u32 ids. NCCL waits as long as it takes, so a follower idles safely.
+pub const Header = extern struct {
+    kind: u32,
+    n: u32 = 0, // ids that follow
+    depth: u32 = 0, // shared: its parts; chunk: where it starts
+    flags: u32 = 0, // begin: 1 sampled
+    a: u64 = 0, // keep: rows; chunk: the prompt's length; save: the state's id; reserve: slots
+    seed: u64 = 0, // chunk: a kept state's id to resume from (0: none); save: its position
+    temperature: f64 = 0,
+    top_p: f64 = 0,
+    min_p: f64 = 0,
+    top_k: u32 = 0,
+    slot: u32 = 0, // the stream's slot the step runs on
+
+    comptime {
+        std.debug.assert(@sizeOf(Header) == 64);
+    }
+};
+
+pub const put_ids = 96 - 16;
+
+pub const Link = struct {
+    lib: *const cuda.nccl.Library,
+    comm: cuda.nccl.Comm,
+    stream: cuda.Stream,
+    buf: cuda.DeviceBuffer, // header, then ids
+    ids: []u32, // host copy of the last step's ids
+    gpa: std.mem.Allocator,
+    asleep: bool = false, // rank 0: the other ranks sleep on their lines (cuda.tp_watch) until its next step
+
+    pub fn init(gpa: std.mem.Allocator, d: *const cuda.Driver, lib: *const cuda.nccl.Library, comm: cuda.nccl.Comm, stream: cuda.Stream, max_ids: usize) !Link {
+        var buf = try cuda.DeviceBuffer.alloc(d, 64 + max_ids * 4);
+        errdefer buf.free();
+        return .{ .lib = lib, .comm = comm, .stream = stream, .buf = buf, .ids = try gpa.alloc(u32, max_ids), .gpa = gpa };
+    }
+
+    pub fn deinit(l: *Link) void {
+        l.gpa.free(l.ids);
+        l.buf.free();
+    }
+
+    fn post(l: *Link, bytes: usize) !void {
+        try l.lib.check(l.lib.api.ncclBroadcast(l.buf.ptr, l.buf.ptr, bytes, .u8, 0, l.comm, l.stream.handle), "ncclBroadcast");
+    }
+
+    /// Rank 0: the step, then its ids, to every rank in two broadcasts; up to `put_ids` ids by a kernel, unwaited.
+    pub fn send(l: *Link, k: *const ops.Kernels, h: Header, ids: []const u32) !void {
+        if (ids.len > l.ids.len) return error.TooManyIds;
+        var hh = h;
+        hh.n = @intCast(ids.len);
+        if (ids.len <= put_ids) {
+            var w: ops.Words = undefined;
+            @memcpy(w.w[0..16], std.mem.bytesAsSlice(u32, std.mem.asBytes(&hh)));
+            @memcpy(w.w[16..][0..ids.len], ids);
+            try ops.putWords(k, l.stream, l.buf.ptr, 16 + ids.len, w);
+        } else {
+            try l.buf.uploadAsync(0, std.mem.asBytes(&hh), l.stream.handle);
+            try l.buf.uploadAsync(64, std.mem.sliceAsBytes(ids), l.stream.handle);
+        }
+        try l.post(64);
+        if (ids.len > 0) try l.post(64 + ids.len * 4);
+        if (ids.len > put_ids) try l.stream.synchronize(); // the host ids' upload is done before they change
+    }
+
+    /// Other ranks: the next step and its ids (valid until the next receive).
+    pub fn receive(l: *Link) !struct { h: Header, ids: []const u32 } {
+        try l.post(64);
+        try l.stream.synchronize();
+        var h: Header = undefined;
+        try l.buf.download(0, std.mem.asBytes(&h));
+        if (h.n > l.ids.len) return error.TooManyIds;
+        if (h.n > 0) {
+            try l.post(64 + h.n * 4);
+            try l.stream.synchronize();
+            try l.buf.download(64, std.mem.sliceAsBytes(l.ids[0..h.n]));
+        }
+        return .{ .h = h, .ids = l.ids[0..h.n] };
+    }
+};
+
+/// A kept prompt state: its id (the same on every rank) and the position it stands at.
+pub const Kept = struct { id: u64, at: u32 };
+
+/// Rank 0's engine: every step goes to the other ranks first.
+pub const Leader = struct {
+    e: *Engine,
+    link: ?*Link, // null: one rank
+    next_id: u64 = 1,
+    dropped: std.ArrayList(u64) = .empty, // ids dropped since the other ranks last heard
+
+    pub fn deinit(x: *Leader) void {
+        x.dropped.deinit(x.e.gpa);
+    }
+
+    fn send(x: *Leader, h: Header, ids: []const u32) !void {
+        const l = x.link orelse return;
+        if (h.kind != @backingInt(Kind.drop)) try x.flush();
+        var hh = h;
+        hh.slot = x.e.slot;
+        if (l.asleep) {
+            cuda.tp_watch.wake();
+            l.asleep = false;
+        }
+        try l.send(&x.e.m.ops, hh, ids);
+    }
+
+    /// States rank 0 dropped since the last step, so the other ranks free theirs too.
+    fn flush(x: *Leader) anyerror!void {
+        const d = &x.dropped;
+        while (d.items.len > 0) {
+            const n = @min(d.items.len, put_ids / 2);
+            var ids: [put_ids]u32 = undefined;
+            for (d.items[0..n], 0..) |id, i| ids[2 * i ..][0..2].* = .{ @truncate(id), @truncate(id >> 32) };
+            try x.send(.{ .kind = @backingInt(Kind.drop) }, ids[0 .. 2 * n]);
+            d.replaceRangeAssumeCapacity(0, n, &.{});
+        }
+    }
+
+    /// Every rank's caches for `slots` streams.
+    pub fn reserve(x: *Leader, slots: usize) !void {
+        try x.send(.{ .kind = @backingInt(Kind.reserve), .a = slots }, &.{});
+        try x.e.reserve(slots);
+    }
+
+    /// The bound slot's state at `at` kept on every rank under one new id.
+    pub fn save(x: *Leader, at: usize) !Kept {
+        const id = x.next_id;
+        x.next_id += 1; // an id is used once, even when this rank's copy then fails
+        if (at == 0 or at != x.e.pos()) return error.BadKeep;
+        try x.send(.{ .kind = @backingInt(Kind.save), .a = id, .seed = at }, &.{});
+        x.e.keepAs(id, at) catch |err| {
+            x.drop(id);
+            return err;
+        };
+        return .{ .id = id, .at = @intCast(at) };
+    }
+
+    /// A state rank 0's store let go: freed here now, on the other ranks at the next step.
+    pub fn drop(x: *Leader, id: u64) void {
+        x.e.dropState(id);
+        if (x.link != null) x.dropped.append(x.e.gpa, id) catch {};
+    }
+
+    /// No stream is left: the other ranks sleep on their lines until the next step instead of spinning in NCCL.
+    pub fn idle(x: *Leader) !void {
+        const l = x.link orelse return;
+        if (l.asleep or !cuda.tp_watch.open()) return;
+        try x.send(.{ .kind = @backingInt(Kind.idle) }, &.{});
+        l.asleep = true;
+    }
+
+    pub fn bind(x: *Leader, slot: u32) !void {
+        try x.e.bind(slot);
+    }
+
+    pub fn release(x: *Leader, slot: u32) !void {
+        try x.e.bind(slot);
+        try x.send(.{ .kind = @backingInt(Kind.release) }, &.{});
+    }
+
+    pub fn begin(x: *Leader, s: ?sampler.Sampling) !void {
+        const c = sampler.check(s);
+        var h: Header = .{ .kind = @backingInt(Kind.begin) };
+        if (c) |v| {
+            h.flags = 1;
+            h.seed = v.seed;
+            h.temperature = v.temperature;
+            h.top_p = v.top_p;
+            h.min_p = v.min_p;
+            h.top_k = v.top_k;
+        }
+        try x.send(h, &.{});
+        x.e.begin(c);
+    }
+
+    /// A prompt chunk on every rank, kept state `from` restored first; the first token once it ends the prompt.
+    pub fn chunk(x: *Leader, ids: []const u32, start: usize, from: ?u64, cancel: ?engine.Cancel) !?u32 {
+        if (start >= ids.len) return error.BadChunk;
+        const part = ids[start..@min(ids.len, start + engine.prompt_rows)];
+        // rank 0's cancel decides before the step goes out: every rank runs a chunk it is sent
+        if (cancel) |c| if (c.check(c.ptr)) return error.Cancelled;
+        if (from) |id| {
+            const w = x.e.states.where(id) orelse return error.SnapshotStale;
+            if (w.at != start or w.slot != x.e.slot) return error.BadChunk;
+        } else if (start % engine.prompt_rows != 0 or (start != 0 and start != x.e.pos())) return error.BadChunk;
+        try x.send(.{ .kind = @backingInt(Kind.chunk), .depth = @intCast(start), .a = ids.len, .seed = from orelse 0 }, part);
+        if (from) |id| try x.e.restoreState(id);
+        return x.e.prefillChunk(ids, start);
+    }
+
+    /// Several streams' windows in one forward on every rank: parts' slots and rows, then ids.
+    pub fn verifyShared(x: *Leader, parts: []const engine.Part) !void {
+        if (parts.len == 0 or parts.len > engine.max_shared) return error.WindowTooWide;
+        var buf: [2 * engine.max_shared + engine.shared_rows]u32 = undefined;
+        var n: usize = 2 * parts.len;
+        for (parts, 0..) |p, i| {
+            if (n + p.ids.len > buf.len or p.ids.len == 0 or p.ids.len > engine.window_rows) return error.WindowTooWide;
+            for (parts[0..i]) |q| if (q.slot == p.slot) return error.SlotTwice;
+            buf[2 * i] = p.slot;
+            buf[2 * i + 1] = @intCast(p.ids.len);
+            @memcpy(buf[n..][0..p.ids.len], p.ids);
+            n += p.ids.len;
+        }
+        try x.send(.{ .kind = @backingInt(Kind.shared), .depth = @intCast(parts.len) }, buf[0..n]);
+        try x.e.verifyShared(parts);
+    }
+
+    /// The bound slot's pictures on every rank: their spans go out first, then rank 0 encodes and sends the rows.
+    pub fn images(x: *Leader, pics: []const image.Prepared, spans: []const vision.Span) !void {
+        var words: [3 * 64]u32 = undefined;
+        _ = try pictures.checkSpans(spans, x.e.vision orelse return error.NoVision);
+        try x.send(.{ .kind = @backingInt(Kind.images), .depth = @intCast(spans.len) }, try pictures.toWords(spans, &words));
+        try x.e.images(pics, spans);
+    }
+
+    pub fn keep(x: *Leader, n: usize) !void {
+        try x.send(.{ .kind = @backingInt(Kind.keep), .a = n }, &.{});
+        try x.e.keep(n);
+    }
+
+    /// The drafter's round on every rank: each request's slot, kept rows, anchor and drafts wanted.
+    pub fn block(x: *Leader, reqs: []const engine.Req) !void {
+        if (reqs.len == 0 or reqs.len > engine.max_shared) return error.TooManyStreams;
+        var buf: [4 * engine.max_shared]u32 = undefined;
+        for (reqs, 0..) |r, i| buf[4 * i ..][0..4].* = .{ r.slot, r.n, r.anchor, @intCast(r.out.len) };
+        try x.send(.{ .kind = @backingInt(Kind.block), .depth = @intCast(reqs.len) }, buf[0 .. 4 * reqs.len]);
+        try x.e.draftBlock(reqs);
+    }
+
+    pub fn end(x: *Leader) !void {
+        try x.send(.{ .kind = @backingInt(Kind.end) }, &.{});
+    }
+};
+
+/// A rank other than 0 runs rank 0's steps until it ends (rank 0 decides cancels before it sends a step).
+pub fn follow(e: *Engine, link: *Link) !void {
+    cuda.tp_watch.sleep(e.io);
+    while (true) {
+        const step = try link.receive();
+        const h = step.h;
+        const kind: Kind = @fromBackingInt(@intCast(h.kind));
+        if (kind == .begin or kind == .chunk or kind == .keep or kind == .save or kind == .images) try e.bind(h.slot);
+        switch (kind) {
+            .reserve => try e.reserve(@intCast(h.a)),
+            .begin => e.begin(if (h.flags & 1 != 0) .{ .seed = h.seed, .temperature = h.temperature, .top_p = h.top_p, .min_p = h.min_p, .top_k = h.top_k } else null),
+            .chunk => {
+                // the prompt's ids past this chunk are not needed here: the chunk's own rows carry its positions
+                const ids = try e.gpa.alloc(u32, h.a);
+                defer e.gpa.free(ids);
+                @memset(ids, 0);
+                @memcpy(ids[h.depth..][0..step.ids.len], step.ids);
+                if (h.seed != 0) try e.restoreState(h.seed);
+                _ = try e.prefillChunk(ids, h.depth);
+            },
+            .shared => {
+                const k = h.depth;
+                if (k == 0 or k > engine.max_shared or step.ids.len < 2 * k) return error.BadStep;
+                var parts: [engine.max_shared]engine.Part = undefined;
+                var outs: [engine.shared_rows]u32 = undefined;
+                var at: usize = 2 * k;
+                var row: usize = 0;
+                for (parts[0..k], 0..) |*p, i| {
+                    const n = step.ids[2 * i + 1];
+                    if (at + n > step.ids.len or row + n > outs.len) return error.BadStep;
+                    p.* = .{ .slot = step.ids[2 * i], .ids = step.ids[at..][0..n], .out = outs[row..][0..n] };
+                    at += n;
+                    row += n;
+                }
+                try e.verifyShared(parts[0..k]);
+            },
+            .keep => try e.keep(@intCast(h.a)),
+            .images => {
+                var spans: [64]vision.Span = undefined;
+                try e.images(null, try pictures.fromWords(step.ids, &spans));
+            },
+            .block => {
+                const k = h.depth;
+                if (k == 0 or k > engine.max_shared or step.ids.len != 4 * k) return error.BadStep;
+                var reqs: [engine.max_shared]engine.Req = undefined;
+                var outs: [engine.max_shared][engine.window_rows]u32 = undefined;
+                for (reqs[0..k], 0..) |*r, i| {
+                    const v = step.ids[4 * i ..][0..4];
+                    if (v[3] >= engine.window_rows) return error.BadStep;
+                    r.* = .{ .slot = v[0], .n = v[1], .anchor = v[2], .out = outs[i][0..v[3]] };
+                }
+                try e.draftBlock(reqs[0..k]);
+            },
+            .release => {},
+            .save => try e.keepAs(h.a, @intCast(h.seed)),
+            .drop => {
+                var i: usize = 0;
+                while (i + 1 < step.ids.len) : (i += 2) e.dropState(@as(u64, step.ids[i]) | @as(u64, step.ids[i + 1]) << 32);
+            },
+            .idle => cuda.tp_watch.sleep(e.io),
+            .end => return cuda.tp_watch.ended(),
+        }
+    }
+}
+
+test "a step's header is 64 bytes and keeps its fields" {
+    const h: Header = .{ .kind = @backingInt(Kind.shared), .n = 3, .depth = 2, .flags = 1, .a = 7, .seed = 1 << 62, .temperature = 0.6, .top_p = 0.95, .top_k = 20 };
+    var back: Header = undefined;
+    @memcpy(std.mem.asBytes(&back), std.mem.asBytes(&h));
+    try std.testing.expectEqual(h, back);
+}
diff --git a/zig/src/families/inkling2/forward.zig b/zig/src/families/inkling2/forward.zig
new file mode 100644
index 000000000..a82f7feef
--- /dev/null
+++ b/zig/src/families/inkling2/forward.zig
@@ -0,0 +1,553 @@
+//! Inkling 2's decoder forward on one rank: streams' rows (prompt chunks or decode rows) to softcapped logits.
+const std = @import("std");
+const cuda = @import("cuda");
+const cfg = @import("shape.zig");
+const kernels = @import("kernels.zig");
+const ops = @import("ops.zig");
+const experts = @import("experts.zig");
+const weights = @import("weights.zig");
+const vision = @import("vision.zig");
+const prompt_dense = @import("prompt_dense.zig");
+
+const Buf = cuda.DeviceBuffer;
+
+/// The kernels a forward launches: main's dense and grouped EXL3, the family's attention and glue.
+pub const Modules = struct {
+    dense: cuda.exl3.Dense,
+    experts: experts.Kernels,
+    attn: kernels.Kernels,
+    ops: ops.Kernels,
+    side: Side,
+    prompt: ?prompt_dense.Prompt = null, // prompt rows' dense projections (Engine.init sets it once the weights load)
+
+    pub fn load(d: *const cuda.Driver) !Modules {
+        var dense = try cuda.exl3.Dense.load(d);
+        errdefer dense.unload();
+        var ex = try experts.Kernels.load(d);
+        errdefer ex.unload();
+        var attn = try kernels.Kernels.load(d);
+        errdefer attn.unload();
+        var o = try ops.Kernels.load(d);
+        errdefer o.unload();
+        return .{ .dense = dense, .experts = ex, .attn = attn, .ops = o, .side = try Side.init(d) };
+    }
+
+    pub fn deinit(m: *Modules) void {
+        if (m.prompt) |*p| p.deinit();
+        m.side.deinit();
+        m.ops.unload();
+        m.attn.unload();
+        m.experts.unload();
+        m.dense.unload();
+    }
+};
+
+/// A layer's narrow projections (r, k, v, row dots) run here beside q and the gate, on their own EXL3 scratch.
+pub const Side = struct {
+    stream: cuda.Stream,
+    fork: cuda.Event,
+    join: cuda.Event,
+    dense: cuda.exl3.Dense,
+
+    fn init(d: *const cuda.Driver) !Side {
+        var st = try cuda.Stream.init(d, true);
+        errdefer st.deinit();
+        var fork = try cuda.Event.init(d, false);
+        errdefer fork.deinit();
+        var join = try cuda.Event.init(d, false);
+        errdefer join.deinit();
+        return .{ .stream = st, .fork = fork, .join = join, .dense = try cuda.exl3.Dense.load(d) };
+    }
+
+    fn deinit(x: *Side) void {
+        x.dense.unload();
+        x.join.deinit();
+        x.fork.deinit();
+        x.stream.deinit();
+    }
+};
+
+/// The geometry a stream's caches and a call's scratch are sized for.
+pub const Shape = struct {
+    rows: usize, // most rows a call takes
+    context: usize, // most positions a stream reaches
+    heads: usize, // the rank's query heads
+    kv: usize, // the rank's key heads
+    ring_rows: usize = 0, // rows a call may write into a sliding ring (0: rows)
+    hist: bool = false, // the calls keep each row's conv inputs (Buffers.hist), so a short keep needs no forward
+
+    pub fn sliding(s: Shape, c: *const cfg.Config) kernels.Layer {
+        return kernels.Layer.sliding(c.window, @intCast(if (s.ring_rows > 0) s.ring_rows else s.rows));
+    }
+
+    pub fn global(s: Shape) kernels.Layer {
+        return kernels.Layer.global(@intCast(s.context));
+    }
+
+    fn layer(s: Shape, c: *const cfg.Config, i: usize) kernels.Layer {
+        return if (c.layer[i] == .sliding) s.sliding(c) else s.global();
+    }
+};
+
+/// Partials a (row, head) needs for a call whose rows reach `last_pos`: a sliding window's, or the global chunks'.
+pub fn stride(c: *const cfg.Config, last_pos: usize) u32 {
+    const sl = kernels.Layer.sliding(c.window, 1);
+    return @max(kernels.slotsFor(sl, 1), kernels.chunks(last_pos, kernels.global_chunk));
+}
+
+/// Bytes of one cache slot of a stream: K and V rings a layer plus four conv states (the per-stream cost).
+pub fn slotBytes(c: *const cfg.Config, s: Shape) u64 {
+    var total: u64 = 0;
+    for (0..c.layers) |i| {
+        total += 2 * @as(u64, s.layer(c, i).cacheBytes(s.kv));
+        total += 2 * 3 * @as(u64, s.kv) * c.head_dim * 4 + 2 * 3 * @as(u64, c.hidden) * 4;
+    }
+    return total;
+}
+
+fn alloc(d: *const cuda.Driver, list: *std.ArrayList(Buf), gpa: std.mem.Allocator, bytes: usize) !u64 {
+    var b = try Buf.alloc(d, @max(bytes, 256));
+    errdefer b.free();
+    try b.fill8(0, null);
+    try list.append(gpa, b);
+    return b.ptr;
+}
+
+/// `slots` streams' caches and conv states: K and V rings a layer, the last three inputs of each short convolution.
+pub const State = struct {
+    gpa: std.mem.Allocator,
+    bufs: std.ArrayList(Buf) = .empty,
+    kc: []u64 = &.{},
+    vc: []u64 = &.{},
+    conv: [][4]u64 = &.{}, // k, v (fp32 [slots][3][kv * 128]) and attention, MLP (fp32 [slots][3][hidden]) a layer
+    pos: []usize = &.{}, // positions each slot's caches hold
+    ring: [2]usize = .{ 0, 0 }, // sliding and global ring slots a key head
+    kv: usize = 0,
+
+    pub fn init(gpa: std.mem.Allocator, d: *const cuda.Driver, c: *const cfg.Config, s: Shape, slots: usize) !State {
+        var st: State = .{ .gpa = gpa, .kv = s.kv };
+        errdefer st.deinit();
+        st.kc = try gpa.alloc(u64, c.layers);
+        st.vc = try gpa.alloc(u64, c.layers);
+        st.conv = try gpa.alloc([4]u64, c.layers);
+        st.pos = try gpa.alloc(usize, slots);
+        @memset(st.pos, 0);
+        st.ring = .{ s.sliding(c).ring, s.global().ring };
+        for (0..c.layers) |i| {
+            const l = s.layer(c, i);
+            st.kc[i] = try alloc(d, &st.bufs, gpa, slots * l.cacheBytes(s.kv));
+            st.vc[i] = try alloc(d, &st.bufs, gpa, slots * l.cacheBytes(s.kv));
+            for (0..2) |j| st.conv[i][j] = try alloc(d, &st.bufs, gpa, slots * 3 * s.kv * c.head_dim * 4);
+            for (2..4) |j| st.conv[i][j] = try alloc(d, &st.bufs, gpa, slots * 3 * @as(usize, c.hidden) * 4);
+        }
+        return st;
+    }
+
+    pub fn cache(st: *const State, i: usize) kernels.Cache {
+        return .{ .k = st.kc[i], .v = st.vc[i] };
+    }
+
+    /// Back to empty streams: caches and conv states zeroed.
+    pub fn reset(st: *State) !void {
+        for (st.bufs.items) |b| try b.fill8(0, null);
+        @memset(st.pos, 0);
+    }
+
+    /// One slot's conv states zeroed on `s` (a fresh pass; its rings are only read at positions it writes).
+    pub fn clearSlot(st: *State, c: *const cfg.Config, d: *const cuda.Driver, slot: usize, s: cuda.Stream) !void {
+        for (st.conv) |cv| for (cv, 0..) |base, j| {
+            const n = 3 * (if (j < 2) st.kv * c.head_dim else @as(usize, c.hidden)) * 4;
+            const view: Buf = .{ .d = d, .ptr = base + slot * n, .len = n, .borrowed = true };
+            try view.fill8(0, s.handle);
+        };
+        st.pos[slot] = 0;
+    }
+
+    pub fn deinit(st: *State) void {
+        for (st.bufs.items) |*b| b.free();
+        st.bufs.deinit(st.gpa);
+        st.gpa.free(st.kc);
+        st.gpa.free(st.vc);
+        st.gpa.free(st.conv);
+        st.gpa.free(st.pos);
+    }
+};
+
+/// Byte offset of layer `i`'s conv site `j` (k, v, attention, MLP) in a hist of `rows` rows: [rows][C] a site.
+pub fn histAt(c: *const cfg.Config, kv: usize, rows: usize, i: usize, j: usize) usize {
+    const kvw = kv * c.head_dim;
+    const layer = rows * (2 * kvw + 2 * @as(usize, c.hidden)) * 4;
+    const in = if (j < 2) j * rows * kvw * 4 else 2 * rows * kvw * 4 + (j - 2) * rows * @as(usize, c.hidden) * 4;
+    return i * layer + in;
+}
+
+/// Rows a grouped-experts call takes: its grouping kernel holds rows x 8 picks in 64 KiB of shared memory.
+const expert_rows = 2048;
+
+/// Most streams one call takes.
+pub const max_items = 64;
+
+/// One stream's rows in a call: its slot and the ids at its next positions.
+pub const Item = struct { slot: usize, ids: []const i32 };
+
+/// Attention partials a call's rows write: `slots` (row, head, chunk) entries, fp32 sums, each chunk's max and total.
+pub const Partials = struct { o: u64, ml: u64, slots: usize };
+
+/// A call's scratch, sized for Shape.rows rows; the partials may be another Buffers' (one stream runs them in order).
+pub const Buffers = struct {
+    gpa: std.mem.Allocator,
+    bufs: std.ArrayList(Buf) = .empty,
+    ids: Buf = undefined, // int32 rows, then pos, seg_of, the segments and the tiles
+    x: u64 = 0, // bf16 [rows][hidden]: the residual stream between layers
+    resid: u64 = 0, // fp32 [rows][hidden]: the residual inside a layer
+    blocks: u64 = 0, // bf16 [8][rows][hidden]: the completed blocks' inputs of these rows
+    normed: u64 = 0, // bf16 [3][rows][hidden]
+    q: u64 = 0,
+    r: u64 = 0,
+    gate: u64 = 0,
+    kf: u64 = 0,
+    vf: u64 = 0,
+    kraw: u64 = 0,
+    vraw: u64 = 0,
+    dk: u64 = 0,
+    dv: u64 = 0,
+    sink: u64 = 0,
+    qo: u64 = 0,
+    relo: u64 = 0,
+    tab: u64 = 0,
+    parts: Partials = .{ .o = 0, .ml = 0, .slots = 0 },
+    att: u64 = 0,
+    ao: u64 = 0,
+    scores: u64 = 0,
+    pick: u64 = 0,
+    wts: u64 = 0,
+    moe: u64 = 0,
+    gathered: u64 = 0, // fp32 [world][rows][hidden]: every rank's partial of a site (world > 1)
+    exs: cuda.exl3_experts.Scratch = undefined,
+    logits: Buf = undefined, // fp32 [rows][padded vocab of the rank]
+    taps: u64 = 0, // bf16 [rows][8][hidden]: the drafter's taps of these rows (the engine's, with a drafter)
+    hist: u64 = 0, // fp32 conv inputs of these rows, histAt's layout (Shape.hist; else 0)
+
+    /// Scratch for `s.rows` rows; `shared` partials, else its own for every row at the shape's context.
+    pub fn init(gpa: std.mem.Allocator, d: *const cuda.Driver, w: *const weights.Weights, s: Shape, shared: ?Partials) !Buffers {
+        const c = &w.config;
+        var b: Buffers = .{ .gpa = gpa };
+        errdefer b.deinit();
+        const n = s.rows;
+        const h: usize = c.hidden;
+        const hd: usize = c.head_dim;
+        const A = struct {
+            fn f(bb: *Buffers, dd: *const cuda.Driver, bytes: usize) !u64 {
+                return alloc(dd, &bb.bufs, bb.gpa, bytes);
+            }
+        }.f;
+        b.ids = try Buf.alloc(d, stageBytes(n, max_items, kernels.tileCount(n, c.group()) + max_items));
+        b.x = try A(&b, d, n * h * 2);
+        b.resid = try A(&b, d, n * h * 4);
+        b.blocks = try A(&b, d, ops.max_blocks * n * h * 2);
+        b.normed = try A(&b, d, 3 * n * h * 2);
+        b.q = try A(&b, d, n * s.heads * hd * 2);
+        b.r = try A(&b, d, n * s.heads * c.d_rel * 2);
+        b.gate = try A(&b, d, n * s.heads * hd * 2);
+        b.kf = try A(&b, d, n * s.kv * hd * 4);
+        b.vf = try A(&b, d, n * s.kv * hd * 4);
+        b.kraw = try A(&b, d, n * s.kv * hd * 2);
+        b.vraw = try A(&b, d, n * s.kv * hd * 2);
+        b.dk = try A(&b, d, n * s.kv * c.conv * 4);
+        b.dv = try A(&b, d, n * s.kv * c.conv * 4);
+        b.sink = try A(&b, d, n * s.heads * 2);
+        b.qo = try A(&b, d, n * s.heads * hd * 2);
+        b.relo = try A(&b, d, n * s.heads * c.d_rel * 2);
+        b.tab = try A(&b, d, kernels.tableBytes(n, @intCast(s.heads)));
+        b.parts = shared orelse blk: {
+            const slots = n * s.heads * stride(c, s.context - 1);
+            break :blk .{ .o = try A(&b, d, slots * hd * 4), .ml = try A(&b, d, slots * 8), .slots = slots };
+        };
+        b.att = try A(&b, d, n * s.heads * hd * 2);
+        b.ao = try A(&b, d, n * h * 4);
+        b.scores = try A(&b, d, n * @as(usize, c.experts) * 4);
+        b.pick = try A(&b, d, n * c.topk * 4);
+        b.wts = try A(&b, d, n * c.topk * 4);
+        b.moe = try A(&b, d, n * h * 4);
+        if (w.share.world > 1) b.gathered = try A(&b, d, w.share.world * n * h * 4);
+        const el = w.layers[0].experts;
+        b.exs = try cuda.exl3_experts.scratch(try A(&b, d, try experts.scratchBytes(el, @min(n, expert_rows), c.topk)), el, @min(n, expert_rows), c.topk);
+        b.logits = try Buf.alloc(d, n * w.share.vocab.len() * 4);
+        if (s.hist) b.hist = try A(&b, d, histAt(c, s.kv, n, c.layers, 0));
+        return b;
+    }
+
+    pub fn deinit(b: *Buffers) void {
+        for (b.bufs.items) |*x| x.free();
+        b.bufs.deinit(b.gpa);
+        if (b.ids.len != 0) b.ids.free();
+        if (b.logits.len != 0) b.logits.free();
+    }
+};
+
+/// Partials for `rows` rows of `heads` heads at `context`, to share between a rank's Buffers.
+pub fn partialsFor(d: *const cuda.Driver, list: *std.ArrayList(Buf), gpa: std.mem.Allocator, slots: usize) !Partials {
+    return .{ .o = try alloc(d, list, gpa, slots * kernels.head_dim * 4), .ml = try alloc(d, list, gpa, slots * 8), .slots = slots };
+}
+
+/// How the ranks' partials (after o_proj and the experts) meet: one rank alone, or gathered in rank order.
+pub const Exchange = union(enum) {
+    local,
+    nccl: struct { lib: *const cuda.nccl.Library, comm: cuda.nccl.Comm, group: ?*const cuda.tp_group.Group = null },
+};
+
+/// A conv input made of `parts` fp32 rank partials, `stride` elements apart.
+const Parts = struct { x: u64, parts: i32, stride: i64 };
+
+/// Where a call's staged words sit in Buffers.ids: ids, pos, seg_of (int32 a row), then segments and tiles.
+const Layout = struct { segs: [2]usize, conv: usize, tiles: usize, end: usize };
+
+fn layout(n: usize, ni: usize, nt: usize) Layout {
+    const at0 = std.mem.alignForward(usize, n * 12, 16);
+    const seg = ni * @sizeOf(kernels.Seg);
+    return .{ .segs = .{ at0, at0 + seg }, .conv = at0 + 2 * seg, .tiles = at0 + 2 * seg + ni * 16, .end = at0 + 2 * seg + ni * 16 + nt * @sizeOf(kernels.Tile) };
+}
+
+fn stageBytes(n: usize, ni: usize, nt: usize) usize {
+    return layout(n, ni, nt).end + 256;
+}
+
+/// A prompt call's image rows (bf16 [tokens][hidden]) and spans; its rows stand at prompt positions lo, lo + 1, ...
+pub const Images = struct { rows: u64, spans: []const vision.Span, lo: usize };
+
+/// A staged call: its rows, streams, tiles, the latest row's position and the partials' stride.
+pub const Plan = struct { n: usize, ni: usize, nt: usize, last: usize, stride: u32 };
+
+pub const Forward = struct {
+    d: *const cuda.Driver,
+    m: *Modules,
+    w: *const weights.Weights,
+    b: *Buffers,
+    shape: Shape,
+    stream: cuda.Stream,
+    exchange: Exchange = .local,
+    tap_at: ?[7]u32 = null, // the layers whose input (the partial block) the drafter's first seven taps read
+    images: ?Images = null, // a prompt call's pictures: its one stream's rows from prompt position `lo`
+    last_logits: bool = false, // the head on the call's last row only (a prompt chunk draws from it alone)
+
+    /// The drafter's taps of layer `i`'s input (b.x, the running partial block): copies only, the forward unchanged.
+    fn tap(f: Forward, i: usize, n: usize) !void {
+        const at = f.tap_at orelse return;
+        for (at, 0..) |l, t| if (l == i) try f.tapCopy(f.b.x, t, n);
+    }
+
+    fn tapCopy(f: Forward, src: u64, t: usize, n: usize) !void {
+        const h: usize = f.w.config.hidden;
+        const m: cuda.abi.Memcpy2D = .{ .src = src, .src_pitch = h * 2, .dst = f.b.taps + t * h * 2, .dst_pitch = 8 * h * 2, .width = h * 2, .height = n };
+        try f.d.check(f.d.api.cuMemcpy2DAsync_v2(&m, f.stream.handle), "cuMemcpy2DAsync");
+    }
+
+    /// Where a site's fp32 partial of `n` rows goes: this rank's slot of the gathered buffer, or `own` at one rank.
+    fn slot(f: Forward, own: u64, n: usize) u64 {
+        if (f.w.share.world == 1) return own;
+        return f.b.gathered + f.w.share.rank * n * f.w.config.hidden * 4;
+    }
+
+    /// Every rank's partial into every rank's gathered buffer (RoCE writes when they fit); convs add them in order.
+    fn gather(f: Forward, n: usize) !Parts {
+        const h: usize = f.w.config.hidden;
+        switch (f.exchange) {
+            .local => return error.Inkling2NoExchange,
+            .nccl => |x| if (x.group) |g| try g.allGather(f.stream, f.slot(0, n), f.b.gathered, n * h * 4) else try x.lib.check(x.lib.api.ncclAllGather(f.slot(0, n), f.b.gathered, n * h, .f32, x.comm, f.stream.handle), "ncclAllGather"),
+        }
+        return .{ .x = f.b.gathered, .parts = @intCast(f.w.share.world), .stride = @intCast(n * h) };
+    }
+
+    /// The conv input of a partial site: the local buffer at one rank, else the gathered parts.
+    fn summed(f: Forward, own: u64, n: usize) !Parts {
+        if (f.w.share.world == 1) return .{ .x = own, .parts = 1, .stride = 0 };
+        return f.gather(n);
+    }
+
+    /// Where layer `i`'s conv site `j` keeps its rows' inputs (0: this call's buffers keep none).
+    fn hist(f: Forward, i: usize, j: usize) u64 {
+        if (f.b.hist == 0) return 0;
+        return f.b.hist + histAt(&f.w.config, f.shape.kv, f.shape.rows, i, j);
+    }
+
+    fn dense(f: Forward, wt: cuda.exl3.Weight, x: u64, rows: usize, y: u64, dt: cuda.exl3.DType) !void {
+        try f.proj(f.stream, &f.m.dense, wt, x, rows, y, dt);
+    }
+
+    /// A projection of bf16 rows: prompt rows by the GEMM where it takes the weight, else the decode kernels.
+    fn proj(f: Forward, s: cuda.Stream, de: *cuda.exl3.Dense, wt: cuda.exl3.Weight, x: u64, rows: usize, y: u64, dt: cuda.exl3.DType) !void {
+        if (f.m.prompt) |*p| if (dt != .f16 and p.takes(wt, rows)) return p.run(s, wt, x, rows, y, dt == .f32);
+        try de.decode(s, wt, x, .bf16, rows, y, dt);
+    }
+
+    /// Each item's ids at its stream's next positions through every layer; the rows' logits land in b.logits.
+    pub fn run(f: Forward, st: *State, items: []const Item) !void {
+        const p = try f.stage(st, items);
+        try f.launch(st, p);
+        advance(st, items);
+    }
+
+    /// The items' streams stand past their rows.
+    pub fn advance(st: *State, items: []const Item) void {
+        for (items) |it| st.pos[it.slot] += it.ids.len;
+    }
+
+    /// The call's ids, positions, segments and tiles uploaded (after the stream drains); launch runs on them.
+    pub fn stage(f: Forward, st: *const State, items: []const Item) !Plan {
+        const c = &f.w.config;
+        var n: usize = 0;
+        for (items) |it| {
+            if (it.ids.len == 0 or st.pos[it.slot] + it.ids.len > f.shape.context) return error.Inkling2Rows;
+            n += it.ids.len;
+        }
+        if (n == 0 or n > f.shape.rows or items.len > max_items) return error.Inkling2Rows;
+        const gpa = f.w.gpa;
+        var host: std.ArrayList(u8) = .empty;
+        defer host.deinit(gpa);
+        for (items) |it| try host.appendSlice(gpa, std.mem.sliceAsBytes(it.ids));
+        for (items) |it| for (0..it.ids.len) |i| try host.appendSlice(gpa, std.mem.asBytes(&@as(i32, @intCast(st.pos[it.slot] + i))));
+        for (items, 0..) |it, j| for (0..it.ids.len) |_| try host.appendSlice(gpa, std.mem.asBytes(&@as(i32, @intCast(j))));
+        var segs: [2][max_items]kernels.Seg = undefined;
+        var cs: [max_items][4]i32 = undefined;
+        var last: usize = 0;
+        var row0: usize = 0;
+        const per = [2]usize{ f.shape.kv * st.ring[0] * c.head_dim, f.shape.kv * st.ring[1] * c.head_dim };
+        for (items, 0..) |it, j| {
+            const p0 = st.pos[it.slot];
+            for (0..2) |r| segs[r][j] = .{ .row0 = @intCast(row0), .n = @intCast(it.ids.len), .p0 = @intCast(p0), .off = @intCast(it.slot * per[r]) };
+            cs[j] = .{ @intCast(row0), @intCast(it.ids.len), @intCast(it.slot), 0 };
+            last = @max(last, p0 + it.ids.len - 1);
+            row0 += it.ids.len;
+        }
+        const ni = items.len;
+        var tl: [8192]kernels.Tile = undefined;
+        const nt = try kernels.tiles(segs[0][0..ni], c.group(), &tl);
+        const lay = layout(n, ni, nt);
+        try host.appendNTimes(gpa, 0, lay.segs[0] - host.items.len);
+        try host.appendSlice(gpa, std.mem.sliceAsBytes(segs[0][0..ni]));
+        try host.appendSlice(gpa, std.mem.sliceAsBytes(segs[1][0..ni]));
+        try host.appendSlice(gpa, std.mem.sliceAsBytes(cs[0..ni]));
+        try host.appendSlice(gpa, std.mem.sliceAsBytes(tl[0..nt]));
+        std.debug.assert(host.items.len == lay.end);
+        const p: Plan = .{ .n = n, .ni = ni, .nt = nt, .last = last, .stride = stride(c, last) };
+        if (n * f.shape.heads * p.stride > f.b.parts.slots) return error.Inkling2Partials;
+        try f.stream.synchronize(); // the previous call's kernels may still read the staged rows
+        try f.b.ids.upload(0, host.items);
+        return p;
+    }
+
+    /// A staged call's kernels only (no host work): a graph captures exactly this.
+    pub fn launch(f: Forward, st: *const State, p: Plan) !void {
+        const c = &f.w.config;
+        const n = p.n;
+        const h: usize = c.hidden;
+        const s = f.stream;
+        const k = &f.m.ops;
+        const b = f.b;
+        const base = b.ids.ptr;
+        const lay = layout(n, p.ni, p.nt);
+        var rows_by: [2]kernels.Rows = undefined;
+        for (&rows_by, lay.segs) |*r, at| r.* = .{ .rows = @intCast(n), .heads = @intCast(f.shape.heads), .kv_heads = @intCast(f.shape.kv), .pos = base + n * 4, .seg_of = base + n * 8, .segs = base + at, .tiles = base + lay.tiles, .n_tiles = @intCast(p.nt), .last_pos = @intCast(p.last), .streams = @intCast(p.ni) };
+        const conv_segs = base + lay.conv;
+        const streams = p.ni;
+        try ops.embed(k, s, base, n, f.w.embed, f.w.embed_norm, b.x, h, c.eps);
+        if (f.images) |im| try vision.splice(f.d, s, im.rows, im.spans, im.lo, im.lo + n, b.x);
+        var nb: usize = 0;
+        const hd: usize = c.head_dim;
+        const kvw = f.shape.kv * hd;
+        for (f.w.layers, 0..) |*l, i| {
+            try f.tap(i, n);
+            const global = l.kind == .global;
+            var mix: ops.MixArgs = .{ .partial = b.x, .query = l.attn_query, .out = b.normed, .n_blocks = @intCast(nb), .partial_bf16 = 1, .nq = @intCast(l.nq), .rows = @intCast(n), .c = @intCast(h), .eps = c.eps };
+            for (0..nb) |j| mix.blocks[j] = b.blocks + j * n * h * 2;
+            mix.norm = l.norms;
+            try ops.mix(k, s, mix);
+            const xq = b.normed;
+            const xk = if (global) b.normed + n * h * 2 else xq;
+            const xv = if (global) b.normed + 2 * n * h * 2 else xq;
+            const a = &l.attn;
+            const sd = &f.m.side;
+            // prompt rows run the narrow projections on the main stream: one GEMM scratch, and they fill the GPU alone
+            const ss = if (f.m.prompt != null and n >= prompt_dense.min_rows) s else sd.stream;
+            try sd.fork.record(s);
+            try ss.wait(sd.fork);
+            try f.proj(ss, &sd.dense, a.r, xq, n, b.r, .bf16);
+            try f.proj(ss, &sd.dense, a.k, xk, n, b.kf, .f32);
+            try f.proj(ss, &sd.dense, a.v, xv, n, b.vf, .f32);
+            try ops.rowdot(k, ss, xq, a.sink, b.sink, n, f.shape.heads, h, true, false);
+            if (global) {
+                try ops.rowdot(k, ss, xk, a.k_proj, b.dk, n, f.shape.kv * c.conv, h, false, false);
+                try ops.rowdot(k, ss, xv, a.v_proj, b.dv, n, f.shape.kv * c.conv, h, false, false);
+            }
+            try sd.join.record(ss);
+            try f.dense(a.q, xq, n, b.q, .bf16);
+            try f.dense(a.gate, xq, n, b.gate, .bf16);
+            try s.wait(sd.join);
+            const cv = st.conv[i];
+            try ops.conv(k, s, .{ .x = b.kf, .state = cv[0], .w = a.k_conv, .dyn = if (global) b.dk else 0, .heads = @intCast(f.shape.kv), .c = @intCast(kvw), .rows = @intCast(n), .mode = 0, .out = b.kraw, .segs = conv_segs, .hist = f.hist(i, 0), .state_stride = @intCast(3 * kvw) }, streams);
+            try ops.conv(k, s, .{ .x = b.vf, .state = cv[1], .w = a.v_conv, .dyn = if (global) b.dv else 0, .heads = @intCast(f.shape.kv), .c = @intCast(kvw), .rows = @intCast(n), .mode = 0, .out = b.vraw, .segs = conv_segs, .hist = f.hist(i, 1), .state_stride = @intCast(3 * kvw) }, streams);
+            var lay_i = f.shape.layer(c, i);
+            lay_i.ring = @intCast(st.ring[@intFromBool(global)]); // the caches' rings, whatever rows this call's scratch holds
+            const rows = rows_by[@intFromBool(global)];
+            const prep: kernels.Prep = .{ .qk_clip = c.qk_clip, .rel_clip = c.rel_clip, .floor = c.log_floor, .alpha = c.log_alpha, .eps = c.eps };
+            try kernels.prep(&f.m.attn, s, rows, lay_i, prep, .{ b.q, b.kraw, b.vraw, b.r }, .{ a.q_scale, a.rel_scale }, b.qo, b.relo, st.cache(i));
+            try kernels.relTable(&f.m.attn, s, rows, b.relo, a.rel_proj, b.tab);
+            try kernels.attend(&f.m.attn, s, rows, lay_i, p.stride, b.parts.slots, b.qo, st.cache(i), b.tab, b.parts.o, b.parts.ml, b.sink, b.gate, b.att);
+            try f.dense(a.o, b.att, n, f.slot(b.ao, n), .f32);
+            const ao = try f.summed(b.ao, n);
+            const boundary = i % c.block_layers == 0;
+            if (boundary) {
+                if (nb == ops.max_blocks) return error.Inkling2Blocks;
+                try copy(f.d, b.blocks + nb * n * h * 2, b.x, n * h * 2, s);
+                nb += 1;
+            }
+            try ops.conv(k, s, .{ .x = ao.x, .parts = ao.parts, .part_stride = ao.stride, .state = cv[2], .w = l.attn_conv, .base = if (boundary) 0 else b.x, .resid = b.resid, .round_in = 1, .c = @intCast(h), .rows = @intCast(n), .mode = 1, .segs = conv_segs, .hist = f.hist(i, 2), .state_stride = @intCast(3 * h) }, streams);
+            var mm: ops.MixArgs = .{ .partial = b.resid, .query = l.mlp_query, .out = b.normed, .n_blocks = @intCast(nb), .partial_bf16 = 0, .nq = 1, .rows = @intCast(n), .c = @intCast(h), .eps = c.eps };
+            for (0..nb) |j| mm.blocks[j] = b.blocks + j * n * h * 2;
+            mm.norm[0] = l.mlp_norm;
+            try ops.mix(k, s, mm);
+            try ops.rowdot(k, s, b.normed, l.router, b.scores, n, c.experts, h, false, true);
+            try ops.topk(k, s, b.scores, l.bias, b.pick, b.wts, n, c.experts, c.topk, c.route_scale);
+            const out = f.slot(b.moe, n);
+            var r0: usize = 0;
+            while (r0 < n) : (r0 += expert_rows) {
+                const w = @min(expert_rows, n - r0);
+                const caps: experts.Caps = .{ .gate = c.gate_softcap, .up = c.up_softcap };
+                const sel = r0 * c.topk * 4;
+                try experts.run(&f.m.experts, k, s, l.experts, caps, b.normed + r0 * h * 2, h, .bf16, b.pick + sel, b.wts + sel, w, out + r0 * h * 4, b.exs);
+            }
+            const mo = try f.summed(b.moe, n);
+            try ops.conv(k, s, .{ .x = mo.x, .parts = mo.parts, .part_stride = mo.stride, .state = cv[3], .w = l.mlp_conv, .resid = b.resid, .out = b.x, .round_in = 1, .c = @intCast(h), .rows = @intCast(n), .mode = 2, .segs = conv_segs, .hist = f.hist(i, 3), .state_stride = @intCast(3 * h) }, streams);
+        }
+        try f.tap(f.w.layers.len, n); // a truncated pack's taps past its last layer: the partial block at the end
+        var fm: ops.MixArgs = .{ .partial = b.x, .query = f.w.out_query, .out = b.normed, .n_blocks = @intCast(nb), .partial_bf16 = 1, .nq = 1, .rows = @intCast(n), .c = @intCast(h), .eps = c.eps };
+        for (0..nb) |j| fm.blocks[j] = b.blocks + j * n * h * 2;
+        fm.norm[0] = f.w.norm;
+        try ops.mix(k, s, fm);
+        if (f.tap_at != null) try f.tapCopy(b.normed, 7, n); // the last tap: the head's input
+        const nv = f.w.share.vocab.len();
+        const hr: usize = if (f.last_logits) n - 1 else 0; // rows before hr keep no logits
+        try f.dense(f.w.head, b.normed + hr * h * 2, n - hr, b.logits.ptr + hr * nv * 4, .f32);
+        try ops.softcap(k, s, b.logits.ptr + hr * nv * 4, (n - hr) * nv, c.logit_softcap);
+    }
+};
+
+fn copy(d: *const cuda.Driver, dst: u64, src: u64, bytes: usize, s: cuda.Stream) !void {
+    const view: Buf = .{ .d = d, .ptr = dst, .len = bytes, .borrowed = true };
+    try view.copyFrom(0, src, bytes, s.handle);
+}
+
+test "forward: a staged call's words sit where launch reads them" {
+    const l = layout(3, 2, 2);
+    try std.testing.expectEqual(@as(usize, 48), l.segs[0]);
+    try std.testing.expectEqual(@as(usize, 48 + 2 * 2 * 24), l.conv); // two segment arrays (sliding, global)
+    try std.testing.expectEqual(@as(usize, 48 + 2 * 2 * 24 + 2 * 16), l.tiles);
+    try std.testing.expectEqual(@as(usize, 24), @sizeOf(kernels.Seg));
+    const c: cfg.Config = .{};
+    try std.testing.expectEqual(@as(u32, 5), stride(&c, 100));
+    try std.testing.expectEqual(@as(u32, 64), stride(&c, 1048575));
+    // per layer, rows x (k 512 + v 512 + attention 4608 + MLP 4608) fp32 at 4 key heads a rank
+    try std.testing.expectEqual(@as(usize, 2 * 512 * 4), histAt(&c, 4, 2, 0, 1));
+    try std.testing.expectEqual(@as(usize, 2 * (2 * 512 + 4608) * 4), histAt(&c, 4, 2, 0, 3));
+    try std.testing.expectEqual(@as(usize, 2 * 2 * (512 + 4608) * 4), histAt(&c, 4, 2, 1, 0));
+}
diff --git a/zig/src/families/inkling2/image.zig b/zig/src/families/inkling2/image.zig
new file mode 100644
index 000000000..9b62e00d5
--- /dev/null
+++ b/zig/src/families/inkling2/image.zig
@@ -0,0 +1,242 @@
+//! Inkling 2's image processor on the host: Inkling2ImageProcessor's 40-pixel patches and the tower's input tables.
+const std = @import("std");
+const core = @import("core");
+
+const picture = core.picture;
+const b16 = core.bf16_round;
+
+pub const side = 40; // pixels a decoder token covers: the native 20-pixel patch, 2 x 2 merged
+pub const patch = 20;
+pub const merge = 2;
+pub const grid = 32; // the learned position table's side
+pub const patch_width = 3 * patch * patch; // a native patch's inputs: row, column, channel
+pub const pairs = 32; // rotary pairs a 64-wide head: 16 by column, then 16 by row
+const theta: f32 = 10000;
+const pad: f32 = -1; // pixels outside the picture, on the 0-255 scale
+const mean: f32 = 0.5 * 255.0; // the fused mean and std (0.5 each, rescale 1/255) as fp32
+const std_: f32 = 0.5 * 255.0;
+
+/// The release's placeholder: one per decoder image token, its rows replaced by the tower's.
+pub const image_token: u32 = 200054;
+/// The chat template's marker ahead of an image's placeholders.
+pub const image_marker = "<|content_image|>";
+
+/// One picture: its normalized patches ([tokens][40][40][3] fp32, the processor's pixel_values) and its grid.
+pub const Prepared = struct {
+    pixels: []f32,
+    rows: u32,
+    cols: u32,
+
+    pub fn tokens(p: Prepared) u32 {
+        return p.rows * p.cols;
+    }
+
+    pub fn deinit(p: *Prepared, a: std.mem.Allocator) void {
+        a.free(p.pixels);
+        p.* = undefined;
+    }
+};
+
+/// Decoder tokens a picture of `w` x `h` pixels takes: no resize, one per 40-pixel cell of the padded grid.
+pub fn tokensFor(w: usize, h: usize) usize {
+    return ((h + side - 1) / side) * ((w + side - 1) / side);
+}
+
+/// PNG, JPEG or WebP bytes as the processor reads them: EXIF-oriented, alpha over its 8-pixel checkerboard.
+pub fn decode(io: std.Io, a: std.mem.Allocator, bytes: []const u8, limits: picture.Limits) picture.Error!picture.Rgb {
+    const s = switch (picture.sniff(bytes)) {
+        .png => try picture.png.decodeWithLimits(a, bytes, limits),
+        .jpeg => try picture.jpeg.decodeWithLimits(io, a, bytes, limits),
+        .webp => try picture.webp.decodeWithLimits(io, a, bytes, limits),
+        .unknown => return error.Invalid,
+    };
+    defer a.free(s.data);
+    if (s.channels != 4) return picture.finish(a, s);
+    // orient the alpha with the colours (finish on a 4-channel copy keeps it), then composite
+    const rgba = try a.alloc(u8, s.width * s.height * 4);
+    defer a.free(rgba);
+    const turned = orient4(s, rgba);
+    const out = try a.alloc(u8, turned.w * turned.h * 3);
+    for (0..turned.h) |y| for (0..turned.w) |x| {
+        const px = rgba[(y * turned.w + x) * 4 ..][0..4];
+        const bg: u32 = if ((y / 8 + x / 8) % 2 == 0) 204 else 153;
+        for (out[(y * turned.w + x) * 3 ..][0..3], px[0..3]) |*c, v| c.* = over(v, px[3], bg);
+    };
+    return .{ .width = turned.w, .height = turned.h, .pixels = out };
+}
+
+/// The processor's composite: (c * alpha + bg * (255 - alpha) + 127) // 255 in integers.
+pub fn over(c: u8, alpha: u8, bg: u32) u8 {
+    return @intCast((@as(u32, c) * alpha + bg * (255 - alpha) + 127) / 255);
+}
+
+/// picture.finish's transpose of 4-channel samples into `out`.
+fn orient4(s: picture.Samples, out: []u8) struct { w: usize, h: usize } {
+    const o = if (s.orientation >= 2 and s.orientation <= 8) s.orientation else 1;
+    const w, const h = if (o >= 5) .{ s.height, s.width } else .{ s.width, s.height };
+    for (0..h) |y| for (0..w) |x| {
+        const sx, const sy = switch (o) {
+            2 => .{ s.width - 1 - x, y },
+            3 => .{ s.width - 1 - x, s.height - 1 - y },
+            4 => .{ x, s.height - 1 - y },
+            5 => .{ y, x },
+            6 => .{ y, s.height - 1 - x },
+            7 => .{ s.width - 1 - y, s.height - 1 - x },
+            8 => .{ s.width - 1 - y, x },
+            else => .{ x, y },
+        };
+        @memcpy(out[(y * w + x) * 4 ..][0..4], s.data[(sy * s.width + sx) * 4 ..][0..4]);
+    };
+    return .{ .w = w, .h = h };
+}
+
+/// RGB rows to the processor's pixel_values: padded with -1 to the 40-pixel grid, (v - 127.5) / 127.5 in fp32.
+pub fn patches(a: std.mem.Allocator, img: picture.Rgb) !Prepared {
+    const rows: u32 = @intCast((img.height + side - 1) / side);
+    const cols: u32 = @intCast((img.width + side - 1) / side);
+    const px = try a.alloc(f32, @as(usize, rows) * cols * side * side * 3);
+    for (0..rows) |r| for (0..cols) |c| for (0..side) |y| for (0..side) |x| {
+        const iy = r * side + y;
+        const ix = c * side + x;
+        const at = ((((r * cols + c) * side + y) * side) + x) * 3;
+        for (0..3) |ch| {
+            const v: f32 = if (iy < img.height and ix < img.width) @floatFromInt(img.pixels[(iy * img.width + ix) * 3 + ch]) else pad;
+            px[at + ch] = (v - mean) / std_;
+        }
+    };
+    return .{ .pixels = px, .rows = rows, .cols = cols };
+}
+
+/// Bytes to patches: decode, then patches; refuses pictures over `max_tokens`.
+pub fn prepare(io: std.Io, a: std.mem.Allocator, bytes: []const u8, max_tokens: u32) !Prepared {
+    var img = try decode(io, a, bytes, .{});
+    defer img.deinit(a);
+    if (tokensFor(img.width, img.height) > max_tokens) return error.ImageTooLarge;
+    return patches(a, img);
+}
+
+/// The words for a refusal of prepare's own.
+pub fn explain(err: anyerror) ?[]const u8 {
+    return switch (err) {
+        error.ImageTooLarge => "image too large for the tower's limit (one token per 40 x 40 pixels, no resize)",
+        error.Invalid => picture.problem(error.Invalid),
+        error.Oversized => picture.problem(error.Oversized),
+        error.Animated => picture.problem(error.Animated),
+        else => picture.decoderProblem(err),
+    };
+}
+
+/// Native patches a picture holds: 4 a token, in merge order (token raster, then the 2 x 2 block raster).
+pub fn patchCount(p: Prepared) usize {
+    return @as(usize, p.tokens()) * merge * merge;
+}
+
+/// A merge-order patch's (row, column) on the native patch grid.
+pub fn place(i: usize, cols: u32) [2]usize {
+    const t = i / (merge * merge);
+    const in = i % (merge * merge);
+    return .{ t / cols * merge + in / merge, t % cols * merge + in % merge };
+}
+
+/// The patch embedding's input rows as bf16 bits: [patches][row][column][channel] (the tower's reshape).
+pub fn patchRows(p: Prepared, out: []u16) void {
+    for (0..patchCount(p)) |i| {
+        const t = i / (merge * merge);
+        const my = i % (merge * merge) / merge;
+        const mx = i % merge;
+        for (0..patch) |y| for (0..patch) |x| for (0..3) |ch| {
+            const v = p.pixels[((t * side + my * patch + y) * side + mx * patch + x) * 3 + ch];
+            out[i * patch_width + (y * patch + x) * 3 + ch] = b16.bits(v);
+        };
+    }
+}
+
+/// One axis's two bilinear taps and weights (torch's align_corners=False interpolation, edge taps clamped).
+const Taps = struct { t: [2]u32, w: [2]f32 };
+
+fn axis(index: usize, size: usize) Taps {
+    const src = (@as(f32, @floatFromInt(index)) + 0.5) * @as(f32, grid) / @as(f32, @floatFromInt(size)) - 0.5;
+    const fl = @floor(src);
+    var out: Taps = undefined;
+    for (0..2) |o| {
+        const raw = @as(i64, @intFromFloat(fl)) + @as(i64, @intCast(o));
+        out.t[o] = @intCast(std.math.clamp(raw, 0, grid - 1));
+        out.w[o] = @max(1 - @abs(src - fl - @as(f32, @floatFromInt(o))), 0);
+    }
+    return out;
+}
+
+/// Each patch's four position-table rows and fp32 weights (h0 w0, h0 w1, h1 w0, h1 w1), as the tower resamples.
+pub fn positionTaps(p: Prepared, taps: []u32, weights: []f32) void {
+    const H = @as(usize, p.rows) * merge;
+    const W = @as(usize, p.cols) * merge;
+    for (0..patchCount(p)) |i| {
+        const rc = place(i, p.cols);
+        const h = axis(rc[0], H);
+        const w = axis(rc[1], W);
+        for (0..2) |a| for (0..2) |b| {
+            taps[i * 4 + a * 2 + b] = h.t[a] * grid + w.t[b];
+            weights[i * 4 + a * 2 + b] = h.w[a] * w.w[b];
+        };
+    }
+}
+
+/// Rotary cos and sin a sequence row ([rows][32] fp32): row 0 the class token at (0, 0), patch i at its place + 1.
+pub fn rotary(p: Prepared, cs: []f32, sn: []f32, on: bool) void {
+    var inv: [pairs / 2]f32 = undefined;
+    for (&inv, 0..) |*f, i| f.* = 1.0 / std.math.pow(f32, theta, @as(f32, @floatFromInt(2 * i)) / @as(f32, pairs));
+    for (0..patchCount(p) + 1) |r| {
+        const rc: [2]usize = if (r == 0) .{ 0, 0 } else blk: {
+            const q = place(r - 1, p.cols);
+            break :blk .{ q[0] + 1, q[1] + 1 };
+        };
+        for (0..pairs) |j| {
+            const pos: f32 = @floatFromInt(if (j < pairs / 2) rc[1] else rc[0]);
+            const ang = pos * inv[j % (pairs / 2)];
+            cs[r * pairs + j] = if (on) @cos(ang) else 1;
+            sn[r * pairs + j] = if (on) @sin(ang) else 0;
+        }
+    }
+}
+
+test "tokens: one per 40-pixel cell, padded up" {
+    try std.testing.expectEqual(@as(usize, 15), tokensFor(200, 120));
+    try std.testing.expectEqual(@as(usize, 117), tokensFor(333, 517));
+    try std.testing.expectEqual(@as(usize, 2), tokensFor(37, 45));
+}
+
+test "checkerboard composite as the processor rounds it" {
+    try std.testing.expectEqual(@as(u8, 10), over(10, 255, 204));
+    try std.testing.expectEqual(@as(u8, 204), over(10, 0, 204));
+    try std.testing.expectEqual(@as(u8, (100 * 128 + 153 * 127 + 127) / 255), over(100, 128, 153));
+}
+
+test "merge order and bilinear taps against torch's interpolation formula" {
+    try std.testing.expectEqual([2]usize{ 0, 1 }, place(1, 5));
+    try std.testing.expectEqual([2]usize{ 1, 0 }, place(2, 5));
+    try std.testing.expectEqual([2]usize{ 0, 2 }, place(4, 5));
+    try std.testing.expectEqual([2]usize{ 2, 0 }, place(20, 5));
+    // a 6-patch axis on the 32 grid: src = (i + 0.5) * 32 / 6 - 0.5
+    const a0 = axis(0, 6);
+    try std.testing.expectEqual([2]u32{ 2, 3 }, a0.t);
+    try std.testing.expectApproxEqAbs(@as(f32, 0.8333333), a0.w[0], 1e-6);
+    const e = axis(0, 64); // src -0.25: floor -1 clamped to 0 twice, weights 0.25 and 0.75
+    try std.testing.expectEqual([2]u32{ 0, 0 }, e.t);
+    try std.testing.expectEqual([2]f32{ 0.25, 0.75 }, e.w);
+}
+
+test "patches: padding reads -1 on the 0-255 scale, the patch rows reorder by 20-pixel blocks" {
+    const a = std.testing.allocator;
+    var px: [41 * 3]u8 = @splat(0);
+    px[40 * 3] = 255;
+    var p = try patches(a, .{ .width = 41, .height = 1, .pixels = &px });
+    defer p.deinit(a);
+    try std.testing.expectEqual(@as(u32, 2), p.cols);
+    try std.testing.expectEqual(@as(f32, -1), p.pixels[0]);
+    try std.testing.expectEqual(@as(f32, (-1 - 127.5) / 127.5), p.pixels[3 * side]);
+    try std.testing.expectEqual(@as(f32, 1), p.pixels[side * side * 3]);
+    const rows = try a.alloc(u16, patchCount(p) * patch_width);
+    defer a.free(rows);
+    patchRows(p, rows);
+    try std.testing.expectEqual(b16.bits(1), rows[4 * patch_width]); // token 1's first patch, pixel (0, 0)
+}
