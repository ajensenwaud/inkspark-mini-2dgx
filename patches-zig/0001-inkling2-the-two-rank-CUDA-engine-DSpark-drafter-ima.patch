+//! tf_ink2x_rows, tf_ink2x_wide and tf_ink2x_group under the contract: each bit-equal to the main kernel it replaces.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const ink = @import("inkling2");
+const rig_ = @import("contract_rig.zig");
+const ref = @import("contract_inkling2_experts_ref.zig");
+
+const c = core.contract.spec;
+const g = core.contract.gates;
+
+fn i32s(v: usize) i32 {
+    return @intCast(v);
+}
+
+/// One projection as experts.run launches it, on the lists tf_exl3_group writes; the baseline runs tf_exl3_grouped_2.
+pub const Grouped = struct {
+    rig: rig_.Rig,
+    k: *const ink.experts.Kernels,
+    form: ref.Form,
+    fault: ref.Fault = .none,
+    fix: ?ref.Fixture = null,
+    tp: [2]u64 = .{ 0, 0 },
+    k2: [2]u64 = .{ 0, 0 },
+    x: [2]u64 = .{ 0, 0 },
+    uids: u64 = 0,
+    ucount: u64 = 0,
+    members: u64 = 0,
+    items: u64 = 0,
+    nitems: u64 = 0,
+    out: u64 = 0,
+    base: u64 = 0,
+    msg: [160]u8 = undefined,
+
+    pub fn deinit(self: *Grouped) void {
+        self.drop();
+        self.rig.deinit();
+    }
+
+    fn drop(self: *Grouped) void {
+        if (self.fix) |*f| f.deinit();
+        self.fix = null;
+        self.rig.reset();
+    }
+
+    pub fn kernel(self: *Grouped) g.Kernel {
+        return .{ .spec = ref.spec(self.form, self.fault), .ctx = self, .vt = &vt, .control = if (self.fault == .none) null else .shapes };
+    }
+
+    const vt = g.hooks(Grouped);
+
+    fn put(self: *Grouped, x: anytype) !u64 {
+        return self.rig.input(std.mem.sliceAsBytes(x));
+    }
+
+    pub fn prepare(self: *Grouped, shape: c.Shape, fill: g.Fill, seed: u64) !bool {
+        if (!ref.Fixture.valid(shape)) return false;
+        self.drop();
+        const a = self.rig.gpu.gpa;
+        self.fix = try ref.Fixture.init(a, shape, fill, seed);
+        const f = &self.fix.?;
+        var pool: [f.trellis.len]u64 = undefined;
+        for (&pool, f.trellis) |*p, t| p.* = try self.put(t);
+        const m = ref.mats(shape);
+        for (0..2) |mat| {
+            var tp: [ref.experts]u64 = undefined;
+            var k2: [ref.experts]i32 = undefined;
+            for (&tp, &k2, 0..) |*t, *h, e| {
+                const i = ref.Fixture.entry(e, @min(mat, m - 1));
+                t.* = pool[i];
+                h.* = ref.halves(i);
+            }
+            self.tp[mat] = try self.put(&tp);
+            self.k2[mat] = try self.put(&k2);
+        }
+        const p = f.pairs();
+        const xs = p * shape.k;
+        self.x[0] = try self.put(f.x[0..xs]);
+        self.x[1] = if (m == 2) try self.put(f.x[xs..]) else self.x[0];
+        var l = try ref.Lists.init(a, f.pick, shape.rows);
+        defer l.deinit(a);
+        self.uids = try self.put(l.uids);
+        self.ucount = try self.put(&[1]i32{l.count});
+        self.members = try self.put(l.members);
+        const items = try a.alloc(i32, 3 * ref.maxItems(p));
+        defer a.free(items);
+        const n = l.items(shape.rows, ref.per(self.form), items);
+        self.items = try self.put(items);
+        const listed = ref.listed(self.form, shape.rows);
+        const short: i32 = @intFromBool(self.fault == .short);
+        self.nitems = try self.put(&[1]i32{(if (listed) n else l.count) - short});
+        self.out = try self.rig.output(f.outputs() * 4);
+        self.base = try self.rig.scratch(f.outputs() * 4);
+        return true;
+    }
+
+    /// experts.zig's launch: WideArgs in its add order, items and their count (rows kernel below 17 rows: the groups).
+    fn launch(self: *Grouped) !void {
+        const sh = self.fix.?.shape;
+        const p = self.fix.?.pairs();
+        const sk = self.fix.?.sk;
+        const listed = ref.listed(self.form, sh.rows);
+        const per = ref.per(self.form);
+        const x0 = if (self.fault == .swapped) self.x[1] else self.x[0];
+        var a: cuda.Args = .{};
+        for ([_]u64{ x0, self.x[1], self.tp[0], self.tp[1], self.k2[0], self.k2[1], self.uids, if (listed) self.items else 0, self.nitems, self.members, self.out }) |v| a.add(v);
+        for ([_]usize{ sh.k, sh.n, p, sk, sh.rows, ref.slots }) |v| a.add(i32s(v));
+        const maxu = @min(p, ref.experts);
+        const gy = if (listed) (p + per - 1) / per + maxu else maxu;
+        const cols: usize = if (self.form == .wide) 64 else 128;
+        const f = if (self.form == .wide) self.k.wide else self.k.rows;
+        try cuda.launch.launch(f, .{ .grid = .{ .x = @intCast(sh.n / cols), .y = @intCast(gy), .z = @intCast(ref.mats(sh) * sk) }, .block = .{ .x = 128 } }, self.rig.s, &a);
+    }
+
+    pub fn run(self: *Grouped) !void {
+        try self.launch();
+        try self.rig.s.synchronize();
+    }
+
+    /// exl3_experts.Experts.run's grouped launch on the same lists: GroupedArgs, one member tile a grid z step.
+    pub fn replaced(self: *Grouped) ![]const u8 {
+        const sh = self.fix.?.shape;
+        const p = self.fix.?.pairs();
+        const sk = self.fix.?.sk;
+        const maxu = @min(p, ref.experts);
+        const m = ref.mats(sh);
+        var a: cuda.Args = .{};
+        for ([_]u64{ self.x[0], self.x[1], self.tp[0], self.tp[1], self.k2[0], self.k2[1], self.uids, self.ucount, self.members, self.base }) |v| a.add(v);
+        for ([_]usize{ sh.k, sh.n, p, sk, sh.rows, ref.slots, maxu, m, 0, 0 }) |v| a.add(i32s(v));
+        a.add(@as(i32, -1));
+        const mt = (sh.rows + 15) / 16;
+        try cuda.launch.launch(self.k.main.grouped[2], .{ .grid = .{ .x = @intCast(maxu), .y = @intCast(sh.n / 128), .z = @intCast(m * sk * mt) }, .block = .{ .x = 128 } }, self.rig.s, &a);
+        return self.rig.bytes(self.base, self.outputs() * 4);
+    }
+
+    /// Gate 1: tf_exl3_grouped_2's bytes, and some output non-finite: the planted values.
+    pub fn check(self: *Grouped, _: g.Gate) !?[]const u8 {
+        const a = self.rig.gpu.gpa;
+        const got = try a.dupe(u8, try self.rig.outputBytes());
+        defer a.free(got);
+        const want = try self.replaced();
+        if (std.mem.indexOfDiff(u8, got, want)) |at| return try std.fmt.bufPrint(&self.msg, "byte {d} of {d} differs from tf_exl3_grouped_2's", .{ at, got.len });
+        for (0..got.len / 4) |i| if (c.classOf(c.read(.f32, got, i)) != .finite) return null;
+        return try std.fmt.bufPrint(&self.msg, "no output is non-finite: the planted values prove nothing", .{});
+    }
+
+    fn outputs(self: *Grouped) usize {
+        return self.fix.?.outputs();
+    }
+
+    pub fn count(self: *Grouped) usize {
+        return self.outputs();
+    }
+
+    pub fn reference(self: *Grouped, want: []f64, mag: []f64) !void {
+        return self.fix.?.reference(want, mag);
+    }
+
+    pub fn simulate(self: *Grouped, acc: c.Accum, order: g.Order, out: []f64) !void {
+        return self.fix.?.simulate(acc, order, out);
+    }
+};
+
+/// Shape: token rows x slots (8) x experts (384); short calls pad members with -1, longer ones list item runs.
+fn groupSpec(control: bool) c.Spec {
+    const served = &[_]c.Shape{ .{ .rows = 8, .n = ref.slots, .k = ref.experts }, .{ .rows = 1, .n = ref.slots, .k = ref.experts }, .{ .rows = 15, .n = ref.slots, .k = ref.experts }, .{ .rows = 16, .n = ref.slots, .k = ref.experts }, .{ .rows = 17, .n = ref.slots, .k = ref.experts }, .{ .rows = 128, .n = ref.slots, .k = ref.experts }, .{ .rows = 511, .n = ref.slots, .k = ref.experts }, .{ .rows = 512, .n = ref.slots, .k = ref.experts }, .{ .rows = 2048, .n = ref.slots, .k = ref.experts } };
+    const name = if (control) "inkling2 experts control: tf_ink2x_group listing 16-member runs for the prompt kernel" else "inkling2 experts tf_ink2x_group (tf_exl3_group's lists, then item runs)";
+    return .{ .name = name, .accum = .none, .depth = noSums, .out = .raw, .replaces = "tf_exl3_group (main's grouping), the runs its counts give", .nan = .{ .stated = "picks outside [0, experts) are left out, as tf_exl3_group leaves them" }, .tiles = .{ .{ .size = 16 }, .{}, .{} }, .served = served };
+}
+
+fn noSums(_: c.Shape) usize {
+    return 0;
+}
+
+/// tf_ink2x_group as experts.run launches it; the baseline runs tf_exl3_group and adds the runs on the host.
+pub const Group = struct {
+    rig: rig_.Rig,
+    k: *const ink.experts.Kernels,
+    wrong_run: bool = false,
+    shape: c.Shape = undefined,
+    pick: []i32 = &.{},
+    dev: u64 = 0,
+    outs: [5]u64 = @splat(0), // uids, count, members, items, item count
+    base: [3]u64 = @splat(0),
+    want: std.ArrayList(u8) = .empty,
+    msg: [160]u8 = undefined,
+
+    pub fn deinit(self: *Group) void {
+        const a = self.rig.gpu.gpa;
+        a.free(self.pick);
+        self.want.deinit(a);
+        self.rig.deinit();
+    }
+
+    pub fn kernel(self: *Group) g.Kernel {
+        return .{ .spec = groupSpec(self.wrong_run), .ctx = self, .vt = &vt, .control = if (self.wrong_run) .shapes else null };
+    }
+
+    const vt = g.hooks(Group);
+
+    fn maxu(self: *const Group) usize {
+        return @min(self.shape.rows * ref.slots, ref.experts);
+    }
+
+    fn sizes(self: *const Group) [5]usize {
+        const p = self.shape.rows * ref.slots;
+        return .{ self.maxu() * 4, 4, self.maxu() * self.shape.rows * 4, 3 * ref.maxItems(p) * 4, 4 };
+    }
+
+    pub fn prepare(self: *Group, shape: c.Shape, fill: g.Fill, seed: u64) !bool {
+        if (shape.rows == 0 or shape.n != ref.slots or shape.k != ref.experts or shape.rows * shape.n * 4 > 64 * 1024) return false;
+        self.rig.reset();
+        const a = self.rig.gpu.gpa;
+        self.shape = shape;
+        a.free(self.pick);
+        self.pick = &.{};
+        self.pick = try a.alloc(i32, shape.rows * ref.slots);
+        var prng = std.Random.DefaultPrng.init(seed);
+        ref.picks(prng.random(), self.pick);
+        if (fill == .nonfinite) {
+            const put = [_]i32{ -1, ref.experts, 1 << 20 };
+            for (put, 0..) |v, i| self.pick[(i * 5 + 1) % self.pick.len] = v;
+        }
+        self.dev = try self.rig.input(std.mem.sliceAsBytes(self.pick));
+        for (&self.outs, self.sizes()) |*o, n| o.* = try self.rig.output(n);
+        for (&self.base, self.sizes()[0..3]) |*o, n| o.* = try self.rig.scratch(n);
+        return true;
+    }
+
+    pub fn run(self: *Group) !void {
+        const rows = self.shape.rows;
+        const listed = rows >= ink.experts.listed_from;
+        const run_: usize = if (rows >= ink.experts.wide_from and !self.wrong_run) 32 else 16;
+        var b: cuda.Args = .{};
+        for ([_]u64{ self.dev, self.outs[0], self.outs[1], self.outs[2], self.outs[3], self.outs[4] }) |v| b.add(v);
+        for ([_]usize{ rows, ref.slots, ref.experts, rows, if (listed) run_ else 0, @intFromBool(!listed) }) |v| b.add(i32s(v));
+        const shared: u32 = @intCast(ref.experts * (32 * 2 + 2 * 4));
+        try cuda.launch.launch(self.k.group, .{ .grid = .{ .x = 1 }, .block = .{ .x = 1024 }, .shared = shared }, self.rig.s, &b);
+        try self.rig.s.synchronize();
+    }
+
+    /// tf_exl3_group's lists as written, words no launch writes as the rig poisons them, and the runs from its counts.
+    pub fn replaced(self: *Group) ![]const u8 {
+        const a = self.rig.gpu.gpa;
+        const rows = self.shape.rows;
+        var m: cuda.Args = .{};
+        for ([_]u64{ self.dev, self.base[0], self.base[1], self.base[2] }) |v| m.add(v);
+        for ([_]usize{ rows, ref.slots, ref.experts, rows }) |v| m.add(i32s(v));
+        try cuda.launch.launch(self.k.main.group, .{ .grid = .{ .x = 1 }, .block = .{ .x = 1024 }, .shared = @intCast(rows * ref.slots * 4) }, self.rig.s, &m);
+        const sz = self.sizes();
+        self.want.clearRetainingCapacity();
+        try self.want.appendNTimes(a, 0xff, sz[0] + sz[1] + sz[2] + sz[3] + sz[4]);
+        const w = self.want.items;
+        const cnt = std.mem.readInt(i32, (try self.rig.bytes(self.base[1], 4))[0..4], .little);
+        if (cnt < 0 or @as(usize, @intCast(cnt)) > self.maxu()) return error.BadBaselineCount;
+        const used: usize = @intCast(cnt);
+        @memcpy(w[0 .. used * 4], (try self.rig.bytes(self.base[0], sz[0]))[0 .. used * 4]);
+        std.mem.writeInt(i32, w[sz[0]..][0..4], cnt, .little);
+        const mem = w[sz[0] + 4 ..][0..sz[2]];
+        @memcpy(mem[0 .. used * rows * 4], (try self.rig.bytes(self.base[2], sz[2]))[0 .. used * rows * 4]);
+        if (rows >= ink.experts.listed_from) {
+            const members = try a.alloc(i32, sz[2] / 4);
+            defer a.free(members);
+            @memcpy(std.mem.sliceAsBytes(members), mem);
+            const l: ref.Lists = .{ .uids = &.{}, .count = cnt, .members = members };
+            const items = try a.alloc(i32, sz[3] / 4);
+            defer a.free(items);
+            const n = l.items(rows, if (rows >= ink.experts.wide_from) 32 else 16, items);
+            const start = sz[0] + 4 + sz[2];
+            for (items, 0..) |v, i| if (v >= 0) std.mem.writeInt(i32, w[start + 4 * i ..][0..4], v, .little);
+            std.mem.writeInt(i32, w[start + sz[3] ..][0..4], n, .little);
+        }
+        return w;
+    }
+
+    /// Gate 1: the baseline's bytes with picks outside the experts planted.
+    pub fn check(self: *Group, _: g.Gate) !?[]const u8 {
+        const a = self.rig.gpu.gpa;
+        const got = try a.dupe(u8, try self.rig.outputBytes());
+        defer a.free(got);
+        const want = try self.replaced();
+        if (std.mem.indexOfDiff(u8, got, want)) |at| return try std.fmt.bufPrint(&self.msg, "byte {d} of {d} differs from tf_exl3_group's lists and their runs", .{ at, got.len });
+        return null;
+    }
+
+    pub fn count(self: *Group) usize {
+        var n: usize = 0;
+        for (self.sizes()) |s| n += s;
+        return n;
+    }
+
+    pub fn reference(_: *Group, want: []f64, mag: []f64) !void {
+        @memset(want, 0);
+        @memset(mag, 0);
+    }
+};
diff --git a/zig/tests/cuda/contract_inkling2_experts_ref.zig b/zig/tests/cuda/contract_inkling2_experts_ref.zig
new file mode 100644
index 000000000..9549c2b11
--- /dev/null
+++ b/zig/tests/cuda/contract_inkling2_experts_ref.zig
@@ -0,0 +1,293 @@
+//! Inkling 2's grouped experts on the host: specs, Inkling's routing and trellises, float64 sums, replays.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const ink = @import("inkling2");
+
+const fmt = core.exl3_format;
+const c = core.contract.spec;
+const rows_ = core.contract.rows;
+
+pub const experts = 384;
+pub const slots = 8; // top 8
+pub const hidden = 4608;
+pub const width = 1152; // a rank's intermediate at TP=2: 2304 cut in 128-column blocks
+const pool = 16; // distinct trellises a shape: expert e's gate takes pool[e % 16], its up pool[(7e + 3) % 16]
+const warps = 4; // wide_body's W
+const step: f32 = 256; // gate 4's x: multiples of 256 to 8,192, so fp16 sums of the products overflow
+
+/// The served kernels: decode rows and short windows (128 columns, 16 members), prompt chunks (64 columns, 32).
+pub const Form = enum { rows, wide };
+/// Gate 3's planted faults, both launch arguments: the call's last item dropped, the up rows read as gate rows.
+pub const Fault = enum { none, short, swapped };
+
+/// Half-bits a value of pool entry i: the release's 2- and 3-bit trellises in turn.
+pub fn halves(i: usize) u16 {
+    return if (i % 2 == 0) 4 else 6;
+}
+
+/// exl3_experts.plan's K splits as experts.run takes them: gate and up where K > N, down otherwise.
+pub fn split(s: c.Shape) usize {
+    return cuda.exl3_experts.plan(s.k, s.n, s.k > s.n) catch 1;
+}
+
+/// Gate and up (two matrices, K > N), or down (one).
+pub fn mats(s: c.Shape) usize {
+    return if (s.k > s.n) 2 else 1;
+}
+
+/// Whether a call takes an item list: the prompt kernel always, the rows kernel from experts.listed_from rows.
+pub fn listed(form: Form, rows: usize) bool {
+    return form == .wide or rows >= ink.experts.listed_from;
+}
+
+/// Members a run: the prompt kernel's 32, the rows kernel's 16.
+pub fn per(form: Form) usize {
+    return if (form == .wide) 32 else 16;
+}
+
+/// Items experts.zig makes room for: runs of 16 members, plus one partial run a distinct expert.
+pub fn maxItems(p: usize) usize {
+    return (p + 15) / 16 + @min(p, experts);
+}
+
+/// A split's 16-input mma steps, the 16 products inside one, then the 4 warps' partials added in warp order.
+fn depth(s: c.Shape) usize {
+    return s.k / split(s) / 16 + 16 + warps;
+}
+
+fn served(rows: []const usize, comptime n: usize) [2 * n]c.Shape {
+    var out: [2 * n]c.Shape = undefined;
+    for (rows[0..n], 0..) |r, i| {
+        out[2 * i] = .{ .rows = r, .n = width, .k = hidden };
+        out[2 * i + 1] = .{ .rows = r, .n = hidden, .k = width };
+    }
+    return out;
+}
+
+const rows_served = served(&.{ 8, 1, 15, 16, 17, 128, 511 }, 7);
+const wide_served = served(&.{ 512, 513, 2048 }, 3);
+const rule = "as tf_exl3_grouped_2 gives them: NaN and infinite inputs";
+
+pub fn spec(form: Form, fault: Fault) c.Spec {
+    const name = switch (fault) {
+        .none => if (form == .rows) "inkling2 experts tf_ink2x_rows (decode rows to 511, 128 columns by 16 members)" else "inkling2 experts tf_ink2x_wide (prompt chunks from 512, 64 columns by 32 members)",
+        .short => "inkling2 experts control: tf_ink2x_rows launched one item short",
+        .swapped => "inkling2 experts control: tf_ink2x_wide reading the up rows as gate rows",
+    };
+    const edge: c.Tile = if (form == .rows) .{ .size = 16 } else .{ .size = ink.experts.wide_from, .min = ink.experts.wide_from };
+    const tiles = [3]c.Tile{ edge, .{ .size = 128, .step = 128, .min = 128 }, .{ .size = 256, .step = 64, .min = 64 } };
+    const list: []const c.Shape = if (form == .rows) &rows_served else &wide_served;
+    return .{ .name = name, .accum = .f32, .depth = depth, .out = .f32, .replaces = "tf_exl3_grouped_2 (main's grouped experts, mul1)", .nan = .{ .stated = rule }, .tiles = tiles, .served = list, .sums = .{ .exact = false } };
+}
+
+/// Each row's 8 distinct experts: expert 0 in every row (long runs and a partial one), the rest at random.
+pub fn picks(rng: std.Random, out: []i32) void {
+    for (0..out.len / slots) |r| {
+        const row = out[r * slots ..][0..slots];
+        row[0] = 0;
+        var i: usize = 1;
+        while (i < slots) {
+            const e: i32 = @intCast(rng.uintLessThan(u32, experts));
+            if (std.mem.indexOfScalar(i32, row[0..i], e) != null) continue;
+            row[i] = e;
+            i += 1;
+        }
+    }
+}
+
+/// One projection's host side: the pool's trellises, the pairs' fp16 rows per matrix, each pair's expert.
+pub const Fixture = struct {
+    a: std.mem.Allocator,
+    shape: c.Shape,
+    sk: usize,
+    trellis: [pool][]i16,
+    x: []u16, // fp16 bits [mats][pairs][k], the rotated rows
+    pick: []i32, // [pairs]: pair p = row * slots + slot
+    w: [pool][]f16 = @splat(@as([]f16, &.{})), // each entry's W_q [k][n], decoded on first use
+
+    /// false: a shape the kernels are not built for (plan() finds no split, N not a whole number of 128s).
+    pub fn valid(s: c.Shape) bool {
+        if (s.rows == 0 or s.n == 0 or s.k == 0 or s.n % 128 != 0) return false;
+        _ = cuda.exl3_experts.plan(s.k, s.n, s.k > s.n) catch return false;
+        return true;
+    }
+
+    pub fn init(a: std.mem.Allocator, s: c.Shape, fill: rows_.Fill, seed: u64) !Fixture {
+        var f: Fixture = .{ .a = a, .shape = s, .sk = split(s), .trellis = @splat(@as([]i16, &.{})), .x = &.{}, .pick = &.{} };
+        errdefer f.deinit();
+        var prng = std.Random.DefaultPrng.init(seed);
+        const rng = prng.random();
+        for (&f.trellis, 0..) |*t, i| {
+            t.* = try a.alloc(i16, s.k / 16 * (s.n / 16) * @as(usize, halves(i)) * 8);
+            for (t.*) |*v| v.* = rng.int(i16);
+        }
+        const p = f.pairs();
+        f.pick = try a.alloc(i32, p);
+        picks(rng, f.pick);
+        f.x = try a.alloc(u16, mats(s) * p * s.k);
+        for (f.x) |*v| v.* = bits(rng.float(f32) * 4 - 2);
+        switch (fill) {
+            .random => {},
+            .nonfinite => {
+                const k = s.k;
+                const at = [_][2]usize{ .{ 0, k / 3 }, .{ 1, k / 2 }, .{ 2, k - 1 }, .{ 3, 0 }, .{ 3, k - 1 } };
+                const put = [_]f32{ std.math.nan(f32), std.math.inf(f32), -std.math.inf(f32), std.math.inf(f32), -std.math.inf(f32) };
+                for (at, put) |q, v| if (q[0] < p) {
+                    f.x[q[0] * k + q[1]] = bits(v);
+                };
+            },
+            .stress => for (f.x) |*v| {
+                v.* = bits(step * @as(f32, @floatFromInt(1 + rng.uintLessThan(u32, 32))));
+            },
+        }
+        return f;
+    }
+
+    pub fn deinit(f: *Fixture) void {
+        for (f.trellis) |t| f.a.free(t);
+        for (f.w) |w| f.a.free(w);
+        f.a.free(f.x);
+        f.a.free(f.pick);
+        f.* = undefined;
+    }
+
+    pub fn pairs(f: *const Fixture) usize {
+        return f.shape.rows * slots;
+    }
+
+    pub fn outputs(f: *const Fixture) usize {
+        return mats(f.shape) * f.sk * f.pairs() * f.shape.n;
+    }
+
+    /// The pool entry matrix `mat` of expert e reads.
+    pub fn entry(e: usize, mat: usize) usize {
+        return if (mat == 0) e % pool else (7 * e + 3) % pool;
+    }
+
+    fn weights(f: *Fixture, i: usize) ![]const f16 {
+        if (f.w[i].len > 0) return f.w[i];
+        const s = f.shape;
+        f.w[i] = try f.a.alloc(f16, s.k * s.n);
+        fmt.unpack(.{ .halves = halves(i) }, .mul1, f.trellis[i], s.k / 16, s.n / 16, f.w[i]);
+        return f.w[i];
+    }
+
+    /// The terms output (mat, split, pair, column) sums: x times W_q over the split's K range, in K order.
+    fn terms(f: *Fixture, mat: usize, sp: usize, p: usize, j: usize, t: []f64) !void {
+        const s = f.shape;
+        const e: usize = @intCast(f.pick[p]);
+        const w = try f.weights(entry(e, mat));
+        const per_split = s.k / f.sk;
+        const x = f.x[(mat * f.pairs() + p) * s.k ..];
+        for (t, sp * per_split..) |*o, i| o.* = value(x[i]) * @as(f64, w[i * s.n + j]);
+    }
+
+    fn each(f: *Fixture, ctx: anytype, comptime body: fn (@TypeOf(ctx), usize, []const f64) void) !void {
+        const t = try f.a.alloc(f64, f.shape.k / f.sk);
+        defer f.a.free(t);
+        for (0..mats(f.shape)) |mat| for (0..f.sk) |sp| for (0..f.pairs()) |p| for (0..f.shape.n) |j| {
+            try f.terms(mat, sp, p, j, t);
+            body(ctx, (((mat * f.sk) + sp) * f.pairs() + p) * f.shape.n + j, t);
+        };
+    }
+
+    pub fn reference(f: *Fixture, want: []f64, mag: []f64) !void {
+        const Ctx = struct { want: []f64, mag: []f64 };
+        try f.each(Ctx{ .want = want, .mag = mag }, struct {
+            fn body(x: Ctx, o: usize, t: []const f64) void {
+                var sum: f64 = 0;
+                var abs: f64 = 0;
+                for (t) |v| {
+                    sum += v;
+                    abs += @abs(v);
+                }
+                x.want[o] = sum;
+                x.mag[o] = abs;
+            }
+        }.body);
+    }
+
+    pub fn simulate(f: *Fixture, acc: c.Accum, order: rows_.Order, out: []f64) !void {
+        const Ctx = struct { acc: c.Accum, order: rows_.Order, out: []f64 };
+        try f.each(Ctx{ .acc = acc, .order = order, .out = out }, struct {
+            fn body(x: Ctx, o: usize, t: []const f64) void {
+                x.out[o] = rows_.sumIn(x.acc, x.order, t);
+            }
+        }.body);
+    }
+};
+
+/// The lists tf_exl3_group writes for `pick`: distinct experts in id order, members row * 32 + slot, -1 after them.
+pub const Lists = struct {
+    uids: []i32,
+    count: i32,
+    members: []i32, // [min(pairs, experts)][rows]
+
+    pub fn init(a: std.mem.Allocator, pick: []const i32, rows: usize) !Lists {
+        const maxu = @min(pick.len, experts);
+        const uids = try a.alloc(i32, maxu);
+        errdefer a.free(uids);
+        const members = try a.alloc(i32, maxu * rows);
+        @memset(members, -1);
+        var used: usize = 0;
+        for (0..experts) |e| {
+            var m: usize = 0;
+            for (pick, 0..) |pe, p| if (pe == e) {
+                members[used * rows + m] = @intCast(p / slots * 32 + p % slots);
+                m += 1;
+            };
+            if (m == 0) continue;
+            uids[used] = @intCast(e);
+            used += 1;
+        }
+        return .{ .uids = uids, .count = @intCast(used), .members = members };
+    }
+
+    pub fn deinit(l: *Lists, a: std.mem.Allocator) void {
+        a.free(l.uids);
+        a.free(l.members);
+    }
+
+    /// tf_ink2x_group's items for runs of `run` members: (u, first, count) in expert order, -1 words after them.
+    pub fn items(l: Lists, rows: usize, run: usize, out: []i32) i32 {
+        @memset(out, -1);
+        var n: usize = 0;
+        for (0..@intCast(l.count)) |u| {
+            const m = l.members[u * rows ..][0..rows];
+            const cnt = std.mem.indexOfScalar(i32, m, -1) orelse rows;
+            var first: usize = 0;
+            while (first < cnt) : (first += run) {
+                out[3 * n ..][0..3].* = .{ @intCast(u), @intCast(first), @intCast(@min(run, cnt - first)) };
+                n += 1;
+            }
+        }
+        return @intCast(n);
+    }
+};
+
+fn bits(v: f32) u16 {
+    return @bitCast(@as(f16, @floatCast(v)));
+}
+
+fn value(h: u16) f64 {
+    return @as(f16, @bitCast(h));
+}
+
+test "inkling2 experts contract: every served shape has a split, items fit experts.zig's room" {
+    for (rows_served ++ wide_served) |s| {
+        try std.testing.expect(Fixture.valid(s));
+        try std.testing.expectEqual(@as(usize, 0), s.k % (split(s) * 16 * warps));
+    }
+    try std.testing.expectEqual(@as(usize, 4), split(rows_served[0]));
+    var prng = std.Random.DefaultPrng.init(1);
+    const pick = try std.testing.allocator.alloc(i32, 2048 * slots);
+    defer std.testing.allocator.free(pick);
+    picks(prng.random(), pick);
+    var l = try Lists.init(std.testing.allocator, pick, 2048);
+    defer l.deinit(std.testing.allocator);
+    const out = try std.testing.allocator.alloc(i32, 3 * maxItems(pick.len));
+    defer std.testing.allocator.free(out);
+    try std.testing.expect(l.items(2048, 16, out) <= maxItems(pick.len));
+    try std.testing.expectEqual(@as(i32, 0), l.uids[0]);
+}
diff --git a/zig/tests/cuda/contract_inkling2_experts_vision.zig b/zig/tests/cuda/contract_inkling2_experts_vision.zig
new file mode 100644
index 000000000..976a8ce74
--- /dev/null
+++ b/zig/tests/cuda/contract_inkling2_experts_vision.zig
@@ -0,0 +1,275 @@
+//! Inkling 2's tower glue (vision.cu) under the contract: patch rows to the sequence, axial rotary, layer-scaled adds.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const ink = @import("inkling2");
+const rig_ = @import("contract_rig.zig");
+const ref = @import("contract_minimax_glue_ref.zig");
+
+const c = core.contract.spec;
+const g = core.contract.gates;
+const Iv = ref.Iv;
+const Sums = ref.Sums;
+const Kernels = ink.vision.Kernels;
+
+const width = ink.vision.width;
+const qkv_width = 3 * width;
+const pairs = ink.vision.head_dim / 2;
+const grid = 1024; // the position table's rows (32 x 32)
+
+/// Sequence rows R = 4 T + 1 (the class row, then four patches a token): 1, 4, 256, 1,024 and 4,096 tokens.
+fn tower(comptime n: usize, comptime k: usize) [5]c.Shape {
+    var out: [5]c.Shape = undefined;
+    for (&out, [_]usize{ 17, 5, 1025, 4097, 16385 }) |*s, r| s.* = .{ .rows = r, .n = n, .k = k };
+    return out;
+}
+
+const embed_served = tower(width, 4);
+const rope_served = tower(qkv_width, 1);
+const add_served = tower(width, 1);
+
+fn four(_: c.Shape) usize {
+    return 4;
+}
+
+fn launch(f: cuda.Function, s: cuda.Stream, blocks: usize, args: []const u64, tail: ?i64) !void {
+    var a: cuda.Args = .{};
+    for (args) |v| a.add(v);
+    if (tail) |t| a.add(t);
+    try cuda.launch.launch(f, .{ .grid = .{ .x = @intCast(blocks) }, .block = .{ .x = 256 } }, s, &a);
+}
+
+/// Row 0 bf16(cls + cls_pos); row r bf16(pe + bf16(sum of four table rows times their bilinear weights, in fp32)).
+pub const Embed = struct {
+    kern: *const Kernels,
+    late: bool = false, // control: each weight read one tap late
+    shape: c.Shape = undefined,
+    pe: []u16 = &.{},
+    table: []u16 = &.{},
+    taps: []u32 = &.{},
+    wts: []f32 = &.{},
+    cls: []u16 = &.{},
+    pos: []u16 = &.{},
+    dev: [6]u64 = @splat(0),
+    out: u64 = 0,
+
+    pub const sums = {};
+
+    pub fn spec(self: *const Embed) c.Spec {
+        const name = if (self.late) "inkling2 experts control: tf_ink2v_embed reading each weight one tap late" else "inkling2 experts vision tf_ink2v_embed (class row, patches plus resampled positions)";
+        return .{ .name = name, .accum = .f32, .depth = four, .out = .bf16, .served = &embed_served, .sums = .{ .f16 = 0, .bf16 = 0, .why = "four taps a value, rounded to bf16: no sum long enough to tell fp32 from half" } };
+    }
+
+    pub fn control(self: *const Embed) ?g.Gate {
+        return if (self.late) .shapes else null;
+    }
+
+    pub fn free(self: *Embed, a: std.mem.Allocator) void {
+        inline for (.{ "pe", "table", "taps", "wts", "cls", "pos" }) |f| {
+            a.free(@field(self, f));
+            @field(self, f) = &.{};
+        }
+    }
+
+    pub fn prepare(self: *Embed, a: std.mem.Allocator, rig: *rig_.Rig, shape: c.Shape, fill: g.Fill, rng: std.Random) !bool {
+        if (shape.rows < 2 or shape.n != width or shape.k != 4) return false;
+        self.free(a);
+        self.shape = shape;
+        const p = shape.rows - 1;
+        const stress = fill == .stress;
+        self.pe = try ref.bfs(a, rng, p * width, -2, 2);
+        self.table = try ref.bfs(a, rng, grid * width, -1, 1);
+        self.cls = try ref.bfs(a, rng, width, -1, 1);
+        self.pos = try ref.bfs(a, rng, width, -1, 1);
+        self.taps = try a.alloc(u32, p * 4);
+        self.wts = try a.alloc(f32, p * 4);
+        for (0..p) |i| {
+            const x = rng.float(f32);
+            const y = rng.float(f32);
+            self.wts[4 * i ..][0..4].* = if (stress) .{ ref.int(rng, 0, 3), ref.int(rng, 0, 3), ref.int(rng, 0, 3), ref.int(rng, 0, 3) } else .{ (1 - x) * (1 - y), x * (1 - y), (1 - x) * y, x * y };
+            for (self.taps[4 * i ..][0..4]) |*t| t.* = rng.uintLessThan(u32, grid);
+        }
+        if (stress) for ([_][]u16{ self.pe, self.table, self.cls, self.pos }) |v| {
+            for (v) |*e| e.* = c.toBf16(ref.int(rng, -8, 8));
+        };
+        if (fill == .nonfinite) {
+            self.pe[3] = c.toBf16(ref.nan); // patch 0
+            self.table[self.taps[4] * width + 5] = c.toBf16(ref.inf); // every patch that taps patch 1's first row
+            self.cls[7] = c.toBf16(-ref.inf);
+            if (p > 2) self.pe[2 * width + 9] = c.toBf16(-ref.inf);
+        }
+        self.dev = .{ try ref.input(rig, self.pe), try ref.input(rig, self.table), try ref.input(rig, self.taps), try ref.input(rig, self.wts), try ref.input(rig, self.cls), try ref.input(rig, self.pos) };
+        self.out = try rig.output(shape.rows * width * 2);
+        return true;
+    }
+
+    pub fn run(self: *Embed, rig: *rig_.Rig) !void {
+        const d = self.dev;
+        try launch(self.kern.embed, rig.s, self.shape.rows, &.{ d[0], d[1], d[2], d[3] + @as(u64, if (self.late) 4 else 0), d[4], d[5], self.out }, null);
+    }
+
+    pub fn count(self: *const Embed) usize {
+        return self.shape.rows * width;
+    }
+
+    pub fn solve(self: *const Embed, _: std.mem.Allocator, s: Sums, out: []Iv) !void {
+        var terms: [4]Iv = undefined;
+        var scratch: [4]f64 = undefined;
+        for (0..width) |e| out[e] = Iv.of(ref.bf(self.cls[e])).add(Iv.of(ref.bf(self.pos[e]))).bf();
+        for (1..self.shape.rows) |r| for (0..width) |e| {
+            const p = r - 1;
+            for (&terms, 0..) |*t, i| t.* = Iv.of(ref.bf(self.table[self.taps[4 * p + i] * width + e])).mul(Iv.of(self.wts[4 * p + i]));
+            const pos = s.sum(&terms, 4, &scratch).bf();
+            out[r * width + e] = Iv.of(ref.bf(self.pe[p * width + e])).add(pos).bf();
+        };
+    }
+};
+
+/// q and k heads of qkv [R, 3 x 1024] turned in place, pair (2j, 2j + 1) of each head by fp32 cos and sin of row r.
+pub const Rope = struct {
+    kern: *const Kernels,
+    swapped: bool = false, // control: cos and sin swapped
+    shape: c.Shape = undefined,
+    qkv: []u16 = &.{},
+    cs: []f32 = &.{},
+    sn: []f32 = &.{},
+    dev: [2]u64 = @splat(0),
+    out: u64 = 0,
+
+    pub fn spec(self: *const Rope) c.Spec {
+        const name = if (self.swapped) "inkling2 experts control: tf_ink2v_rope with cos and sin swapped" else "inkling2 experts vision tf_ink2v_rope (2D rotary of q and k, in place)";
+        return .{ .name = name, .accum = .none, .depth = ref.noSums, .out = .bf16, .in_place = true, .served = &rope_served };
+    }
+
+    pub fn control(self: *const Rope) ?g.Gate {
+        return if (self.swapped) .shapes else null;
+    }
+
+    pub fn free(self: *Rope, a: std.mem.Allocator) void {
+        a.free(self.qkv);
+        a.free(self.cs);
+        a.free(self.sn);
+        self.qkv = &.{};
+        self.cs = &.{};
+        self.sn = &.{};
+    }
+
+    pub fn prepare(self: *Rope, a: std.mem.Allocator, rig: *rig_.Rig, shape: c.Shape, fill: g.Fill, rng: std.Random) !bool {
+        if (shape.rows == 0 or shape.n != qkv_width) return false;
+        self.free(a);
+        self.shape = shape;
+        const r = shape.rows;
+        self.qkv = try ref.bfs(a, rng, r * qkv_width, -3, 3);
+        self.cs = try a.alloc(f32, r * pairs);
+        self.sn = try a.alloc(f32, r * pairs);
+        for (self.cs, self.sn) |*x, *y| {
+            const angle = rng.float(f32) * 64;
+            x.* = @cos(angle);
+            y.* = @sin(angle);
+        }
+        if (fill == .nonfinite) {
+            self.qkv[3] = c.toBf16(ref.nan); // row 0, q head 0, pair 1's second value
+            self.qkv[qkv_width + width + 64 + 10] = c.toBf16(ref.inf); // row 1, k head 1
+            self.qkv[2 * qkv_width + 2 * width + 5] = c.toBf16(-ref.inf); // row 2, v: as it is
+            if (r > 3) self.qkv[3 * qkv_width + 63] = c.toBf16(-ref.inf);
+        }
+        self.dev = .{ try ref.input(rig, self.cs), try ref.input(rig, self.sn) };
+        self.out = try rig.output(self.qkv.len * 2);
+        return true;
+    }
+
+    pub fn run(self: *Rope, rig: *rig_.Rig) !void {
+        try ref.restore(rig, self.out, std.mem.sliceAsBytes(self.qkv)); // in place: every run from the same rows
+        const cs = if (self.swapped) self.dev[1] else self.dev[0];
+        const sn = if (self.swapped) self.dev[0] else self.dev[1];
+        try launch(self.kern.rope, rig.s, self.shape.rows, &.{ self.out, cs, sn }, null);
+    }
+
+    pub fn count(self: *const Rope) usize {
+        return self.qkv.len;
+    }
+
+    pub fn solve(self: *const Rope, _: std.mem.Allocator, _: Sums, out: []Iv) !void {
+        for (out, self.qkv, 0..) |*o, x, at| {
+            const col = at % qkv_width;
+            if (col >= 2 * width) {
+                o.* = Iv.of(ref.bf(x));
+                continue;
+            }
+            const d = col % 64;
+            const first = at - d % 2;
+            const r = at / qkv_width;
+            const cv = Iv.of(self.cs[r * pairs + d / 2]);
+            const sv = Iv.of(self.sn[r * pairs + d / 2]);
+            const av = Iv.of(ref.bf(self.qkv[first]));
+            const bv = Iv.of(ref.bf(self.qkv[first + 1]));
+            o.* = (if (d % 2 == 0) av.mul(cv).add(bv.neg().mul(sv)) else bv.mul(cv).add(av.mul(sv))).bf();
+        }
+    }
+};
+
+/// x = bf16(x + bf16(gamma[i % 1024] y)) over [R, 1024] in place: torch's `residual + lambda * h` in bf16.
+pub const ScaleAdd = struct {
+    kern: *const Kernels,
+    late: bool = false, // control: gamma read one column late
+    shape: c.Shape = undefined,
+    x: []u16 = &.{},
+    y: []u16 = &.{},
+    gamma: []u16 = &.{},
+    dev: [2]u64 = @splat(0),
+    out: u64 = 0,
+
+    pub fn spec(self: *const ScaleAdd) c.Spec {
+        const name = if (self.late) "inkling2 experts control: tf_ink2v_scale_add reading gamma one column late" else "inkling2 experts vision tf_ink2v_scale_add (layer-scaled residual add, in place)";
+        return .{ .name = name, .accum = .none, .depth = ref.noSums, .out = .bf16, .in_place = true, .served = &add_served };
+    }
+
+    pub fn control(self: *const ScaleAdd) ?g.Gate {
+        return if (self.late) .shapes else null;
+    }
+
+    pub fn free(self: *ScaleAdd, a: std.mem.Allocator) void {
+        a.free(self.x);
+        a.free(self.y);
+        a.free(self.gamma);
+        self.x = &.{};
+        self.y = &.{};
+        self.gamma = &.{};
+    }
+
+    pub fn prepare(self: *ScaleAdd, a: std.mem.Allocator, rig: *rig_.Rig, shape: c.Shape, fill: g.Fill, rng: std.Random) !bool {
+        if (shape.rows == 0 or shape.n != width) return false;
+        self.free(a);
+        self.shape = shape;
+        const n = shape.rows * width;
+        self.x = try ref.bfs(a, rng, n, -4, 4);
+        self.y = try ref.bfs(a, rng, n, -4, 4);
+        self.gamma = try ref.bfs(a, rng, width, -0.5, 0.5);
+        if (fill == .nonfinite) {
+            self.x[0] = c.toBf16(ref.nan);
+            self.y[1] = c.toBf16(ref.inf);
+            self.gamma[2] = c.toBf16(-ref.inf); // column 2 of every row
+            self.x[width + 3] = c.toBf16(ref.inf);
+        }
+        self.dev = .{ try ref.input(rig, self.y), try ref.input(rig, self.gamma) };
+        self.out = try rig.output(n * 2);
+        return true;
+    }
+
+    pub fn run(self: *ScaleAdd, rig: *rig_.Rig) !void {
+        try ref.restore(rig, self.out, std.mem.sliceAsBytes(self.x));
+        const n = self.count();
+        try launch(self.kern.scale_add, rig.s, (n + 255) / 256, &.{ self.out, self.dev[0], self.dev[1] + @as(u64, if (self.late) 2 else 0) }, @intCast(n));
+    }
+
+    pub fn count(self: *const ScaleAdd) usize {
+        return self.shape.rows * width;
+    }
+
+    pub fn solve(self: *const ScaleAdd, _: std.mem.Allocator, _: Sums, out: []Iv) !void {
+        for (out, self.x, self.y, 0..) |*o, x, y, i| {
+            const scaled = Iv.of(ref.bf(self.gamma[i % width])).mul(Iv.of(ref.bf(y))).bf();
+            o.* = Iv.of(ref.bf(x)).add(scaled).bf();
+        }
+    }
+};
