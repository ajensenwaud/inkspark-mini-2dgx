--- /dev/null
+++ b/zig/build/inkling2_vision.zig
@@ -0,0 +1,16 @@
+//! Inkling 2's image path in the build: tf-inkling2-vision (processor patches and tower rows for the reference).
+const std = @import("std");
+
+/// tf-inkling2-vision over its own copy of the family module (every import the family may take).
+pub fn tool(b: *std.Build, target: std.Build.ResolvedTarget, optimize: std.builtin.OptimizeMode, strip: bool, cuda: *std.Build.Module, core: *std.Build.Module, lanes: *std.Build.Module) void {
+    const family = b.createModule(.{ .root_source_file = b.path("zig/src/families/inkling2/inkling2.zig"), .target = target, .optimize = optimize, .link_libc = true });
+    family.addImport("cuda", cuda);
+    family.addImport("core", core);
+    family.addImport("lanes", lanes);
+    const m = b.createModule(.{ .root_source_file = b.path("zig/src/families/inkling2/vision_main.zig"), .target = target, .optimize = optimize, .link_libc = true, .strip = strip });
+    m.addImport("cuda", cuda);
+    m.addImport("inkling2", family);
+    const exe = b.addExecutable(.{ .name = "tf-inkling2-vision", .root_module = m });
+    b.installArtifact(exe);
+    b.step("tf-inkling2-vision", "Inkling 2's image processor and vision tower rows for the transformers reference").dependOn(&b.addInstallArtifact(exe, .{}).step);
+}
diff --git a/zig/kernels/cuda/inkling2/dspark.cu b/zig/kernels/cuda/inkling2/dspark.cu
new file mode 100644
index 000000000..67cfd2094
--- /dev/null
+++ b/zig/kernels/cuda/inkling2/dspark.cu
@@ -0,0 +1,326 @@
+// Inkling 2's DSpark drafter: tap mix, q/k norm + RoPE into the draft caches, block attention, the Markov head.
+#include <cstdint>
+#include <cuda_bf16.h>
+
+namespace ink2d {
+
+constexpr int kD = 128;
+constexpr int kMaxQ = 48;
+constexpr int kKT = 32;
+constexpr int kChunk = 1024;
+constexpr int kMaxRows = 8;
+
+__device__ __forceinline__ float bf(uint16_t u) { return __uint_as_float(static_cast<uint32_t>(u) << 16); }
+
+__device__ __forceinline__ uint16_t tobf(float f) { return __bfloat16_as_ushort(__float2bfloat16_rn(f)); }
+
+__device__ __forceinline__ float bfr(float f) { return bf(tobf(f)); }
+
+__device__ __forceinline__ float warpSum(float v) {
+    for (int o = 16; o > 0; o >>= 1) v += __shfl_xor_sync(0xffffffffu, v, o);
+    return v;
+}
+
+// One sum over the block in a fixed order: warp shuffles, then warp 0 over the warps' partials.
+__device__ __forceinline__ float blockSum(float v, float* sh) {
+    const int lane = threadIdx.x & 31, w = threadIdx.x >> 5, nw = blockDim.x >> 5;
+    v = warpSum(v);
+    __syncthreads();
+    if (lane == 0) sh[w] = v;
+    __syncthreads();
+    const float t = lane < nw ? sh[lane] : 0.0f;
+    return __shfl_sync(0xffffffffu, warpSum(t), 0);
+}
+
+}  // namespace ink2d
+
+// out[row] = RMSNorm(sum_t alpha[t] * taps[row][t]) * w, the mix in fp32 in tap order (vLLM's mix_rmsnorm).
+extern "C" __global__ void __launch_bounds__(512) tf_ink2_dsp_mix(const uint16_t* __restrict__ taps, const float* __restrict__ alpha,
+                                                                  const uint16_t* __restrict__ w, uint16_t* __restrict__ out,
+                                                                  int taps_n, int C, float eps) {
+    using namespace ink2d;
+    __shared__ float sh[32];
+    const size_t row = blockIdx.x;
+    const uint16_t* x = taps + row * taps_n * C;
+    float ss = 0.0f;
+    for (int c = threadIdx.x; c < C; c += blockDim.x) {
+        float m = 0.0f;
+        for (int t = 0; t < taps_n; ++t) m += bf(x[t * C + c]) * alpha[t];
+        ss += m * m;
+    }
+    const float r = rsqrtf(blockSum(ss, sh) / C + eps);
+    for (int c = threadIdx.x; c < C; c += blockDim.x) {
+        float m = 0.0f;
+        for (int t = 0; t < taps_n; ++t) m += bf(x[t * C + c]) * alpha[t];
+        out[row * C + c] = tobf(m * r * bf(w[c]));
+    }
+}
+
+// resid (bf16) += the ranks' fp32 partials in rank order (nparts 0: none); out = RMSNorm of the unrounded sum * w.
+extern "C" __global__ void __launch_bounds__(512) tf_ink2_dsp_addnorm(uint16_t* __restrict__ resid, const float* __restrict__ parts,
+                                                                      int nparts, long long part_stride, const uint16_t* __restrict__ w,
+                                                                      uint16_t* __restrict__ out, int C, float eps) {
+    using namespace ink2d;
+    __shared__ float sh[32];
+    const size_t row = blockIdx.x;
+    float ss = 0.0f;
+    for (int c = threadIdx.x; c < C; c += blockDim.x) {
+        float s = 0.0f;
+        for (int p = 0; p < nparts; ++p) s += parts[p * part_stride + row * C + c];
+        const float v = bf(resid[row * C + c]) + s;
+        ss += v * v;
+    }
+    const float r = rsqrtf(blockSum(ss, sh) / C + eps);
+    for (int c = threadIdx.x; c < C; c += blockDim.x) {
+        float s = 0.0f;
+        for (int p = 0; p < nparts; ++p) s += parts[p * part_stride + row * C + c];
+        const float v = bf(resid[row * C + c]) + s;
+        if (nparts > 0) resid[row * C + c] = tobf(v);
+        out[row * C + c] = tobf(v * r * bf(w[c]));
+    }
+}
+
+struct QkArgs {
+    const uint16_t* x;  // bf16 [rows][ld]: q heads, then key heads, then value heads (128 wide each)
+    const uint16_t* qw;
+    const uint16_t* kw;
+    uint16_t* q;   // bf16 [rows][hq][128]
+    uint16_t* kc;  // bf16 [ring][hk][128]
+    uint16_t* vc;
+    long long ld;
+    int hq, hk, ring, pos0;
+    float eps, theta;
+};
+
+// Per (row, head): RMSNorm * weight rounded to bf16, then neox RoPE at pos0 + row; key and value heads to the caches.
+extern "C" __global__ void __launch_bounds__(64) tf_ink2_dsp_qk(QkArgs a) {
+    using namespace ink2d;
+    __shared__ float sh[32];
+    const int row = blockIdx.x, h = blockIdx.y, i = threadIdx.x;
+    const bool isq = h < a.hq;
+    const uint16_t* x = a.x + row * a.ld + static_cast<long long>(h) * kD;
+    const float x0 = bf(x[i]), x1 = bf(x[i + 64]);
+    const float inv = 1.0f / sqrtf(blockSum(x0 * x0 + x1 * x1, sh) / kD + a.eps);
+    const uint16_t* w = isq ? a.qw : a.kw;
+    const float y0 = bfr(x0 * inv * bf(w[i])), y1 = bfr(x1 * inv * bf(w[i + 64]));
+    const int pos = a.pos0 + row;
+    const float f = static_cast<float>(pos) * (1.0f / powf(a.theta, static_cast<float>(2 * i) / kD));
+    const float co = cosf(f), si = sinf(f);
+    const uint16_t o0 = tobf(y0 * co - y1 * si), o1 = tobf(y1 * co + y0 * si);
+    if (isq) {
+        uint16_t* q = a.q + (static_cast<size_t>(row) * a.hq + h) * kD;
+        q[i] = o0;
+        q[i + 64] = o1;
+        return;
+    }
+    const int j = h - a.hq;
+    const size_t at = (static_cast<size_t>(pos % a.ring) * a.hk + j) * kD;
+    a.kc[at + i] = o0;
+    a.kc[at + i + 64] = o1;
+    const uint16_t* v = a.x + row * a.ld + static_cast<long long>(a.hq + a.hk + j) * kD;
+    a.vc[at + i] = v[i];
+    a.vc[at + i + 64] = v[i + 64];
+}
+
+struct AttnArgs {
+    const uint16_t* q;  // bf16 [T][hq][128]
+    const uint16_t* kc;  // bf16 [ring][hk][128]
+    const uint16_t* vc;
+    float* po;   // fp32 [chunks][T * hq][128]: unnormalised sums
+    float* pml;  // fp32 [chunks][T * hq][2]: max, total
+    int T, hq, hk, ring, lo, hi, c0;
+    float scale;
+};
+
+// A block's rows against keys [lo, hi], unmasked (the block sees itself whole); a 1,024-key chunk and key head a block.
+extern "C" __global__ void __launch_bounds__(256) tf_ink2_dsp_attn(AttnArgs a) {
+    using namespace ink2d;
+    __shared__ float sq[kMaxQ][kD];
+    __shared__ uint16_t sk[kKT][kD + 8];
+    __shared__ uint16_t sv[kKT][kD];
+    __shared__ float sp[kMaxQ][kKT];
+    __shared__ float sm[kMaxQ], sl[kMaxQ], sa[kMaxQ];
+    const int j = blockIdx.y, c = a.c0 + blockIdx.x, tid = threadIdx.x;
+    const int g = a.hq / a.hk, nq = a.T * g, nqt = a.T * a.hq;
+    const int k0 = max(a.lo, c * kChunk), k1 = min(a.hi + 1, (c + 1) * kChunk);
+    for (int idx = tid; idx < nq * kD; idx += blockDim.x) {
+        const int qi = idx / kD, d = idx % kD;
+        sq[qi][d] = bf(a.q[(static_cast<size_t>(qi / g) * a.hq + j * g + qi % g) * kD + d]);
+    }
+    for (int qi = tid; qi < nq; qi += blockDim.x) {
+        sm[qi] = -INFINITY;
+        sl[qi] = 0.0f;
+    }
+    const int d = tid & (kD - 1), half = tid >> 7;
+    float o[kMaxQ / 2];
+    for (int r = 0; r < kMaxQ / 2; ++r) o[r] = 0.0f;
+    __syncthreads();
+    for (int kt = k0; kt < k1; kt += kKT) {
+        const int nk = min(kKT, k1 - kt);
+        for (int idx = tid; idx < nk * kD; idx += blockDim.x) {
+            const int kk = idx / kD, dd = idx % kD;
+            const size_t at = (static_cast<size_t>((kt + kk) % a.ring) * a.hk + j) * kD + dd;
+            sk[kk][dd] = a.kc[at];
+            sv[kk][dd] = a.vc[at];
+        }
+        __syncthreads();
+        for (int idx = tid; idx < nq * kKT; idx += blockDim.x) {
+            const int qi = idx / kKT, kk = idx % kKT;
+            float s = -INFINITY;
+            if (kk < nk) {
+                s = 0.0f;
+                for (int dd = 0; dd < kD; ++dd) s += sq[qi][dd] * bf(sk[kk][dd]);
+                s *= a.scale;
+            }
+            sp[qi][kk] = s;
+        }
+        __syncthreads();
+        for (int qi = tid; qi < nq; qi += blockDim.x) {
+            float mx = sm[qi];
+            for (int kk = 0; kk < nk; ++kk) mx = fmaxf(mx, sp[qi][kk]);
+            const float al = expf(sm[qi] - mx);
+            float sum = 0.0f;
+            for (int kk = 0; kk < nk; ++kk) {
+                const float p = expf(sp[qi][kk] - mx);
+                sp[qi][kk] = p;
+                sum += p;
+            }
+            sl[qi] = sl[qi] * al + sum;
+            sm[qi] = mx;
+            sa[qi] = al;
+        }
+        __syncthreads();
+        for (int r = 0; r < kMaxQ / 2; ++r) {
+            const int qi = half * (kMaxQ / 2) + r;
+            if (qi >= nq) break;
+            float acc = o[r] * sa[qi];
+            for (int kk = 0; kk < nk; ++kk) acc += sp[qi][kk] * bf(sv[kk][d]);
+            o[r] = acc;
+        }
+        __syncthreads();
+    }
+    for (int r = 0; r < kMaxQ / 2; ++r) {
+        const int qi = half * (kMaxQ / 2) + r;
+        if (qi >= nq) break;
+        const size_t rh = static_cast<size_t>(blockIdx.x) * nqt + (qi / g) * a.hq + j * g + qi % g;
+        a.po[rh * kD + d] = o[r];
+        if (d == 0) {
+            a.pml[rh * 2] = sm[qi];
+            a.pml[rh * 2 + 1] = sl[qi];
+        }
+    }
+}
+
+// Each (row, head)'s chunks folded in order: out bf16 [T][hq][128].
+extern "C" __global__ void __launch_bounds__(128) tf_ink2_dsp_merge(const float* __restrict__ po, const float* __restrict__ pml,
+                                                                    int chunks, int nqt, uint16_t* __restrict__ out) {
+    using namespace ink2d;
+    const size_t rh = blockIdx.x;
+    const int d = threadIdx.x;
+    float mx = -INFINITY;
+    for (int c = 0; c < chunks; ++c) mx = fmaxf(mx, pml[(c * nqt + rh) * 2]);
+    float l = 0.0f, acc = 0.0f;
+    for (int c = 0; c < chunks; ++c) {
+        const float m = pml[(c * nqt + rh) * 2];
+        const float wt = m == -INFINITY ? 0.0f : expf(m - mx);
+        l += pml[(c * nqt + rh) * 2 + 1] * wt;
+        acc += po[(c * nqt + rh) * kD + d] * wt;
+    }
+    out[rh * kD + d] = tobf(acc / l);
+}
+
+// silu(gate) * up in fp32 (IEEE exp and division), rounded once: gu bf16 [rows][2I] (gates, then ups).
+extern "C" __global__ void __launch_bounds__(256) tf_ink2_dsp_silu(const uint16_t* __restrict__ gu, uint16_t* __restrict__ out, int I) {
+    using namespace ink2d;
+    const size_t row = blockIdx.y;
+    const int c = blockIdx.x * blockDim.x + threadIdx.x;
+    if (c >= I) return;
+    const float g = bf(gu[row * 2 * I + c]), u = bf(gu[row * 2 * I + I + c]);
+    out[row * I + c] = tobf(g / (1.0f + expf(-g)) * u);
+}
+
+// The Markov head's context: out fp32 [rows][3R] = bias + rnn_proj[:, 2R:] . [hidden_row, f_rnn], a warp an output.
+extern "C" __global__ void __launch_bounds__(256) tf_ink2_dsp_ctx(const uint16_t* __restrict__ hidden, const uint16_t* __restrict__ frnn,
+                                                                  const uint16_t* __restrict__ W, const uint16_t* __restrict__ bias,
+                                                                  float* __restrict__ out, int rows, int C, int R) {
+    using namespace ink2d;
+    const int o = blockIdx.x * (blockDim.x >> 5) + (threadIdx.x >> 5), lane = threadIdx.x & 31;
+    if (o >= 3 * R) return;
+    const uint16_t* w = W + static_cast<size_t>(o) * (2 * R + 2 * C) + 2 * R;
+    float acc[kMaxRows];
+    for (int r = 0; r < kMaxRows; ++r) acc[r] = 0.0f;
+    for (int k = lane; k < 2 * C; k += 32) {
+        const float wk = bf(w[k]);
+        if (k < C) {
+            for (int r = 0; r < kMaxRows; ++r)
+                if (r < rows) acc[r] += wk * bf(hidden[static_cast<size_t>(r) * C + k]);
+        } else {
+            const float f = wk * bf(frnn[k - C]);
+            for (int r = 0; r < kMaxRows; ++r) acc[r] += f;
+        }
+    }
+    for (int r = 0; r < kMaxRows; ++r) {
+        const float s = warpSum(acc[r]);
+        if (lane == 0 && r < rows) out[static_cast<size_t>(r) * 3 * R + o] = s + bf(bias[o]);
+    }
+}
+
+// One recurrence step (one block, R threads): raw = ctx + rnn_proj[:, :2R] . [state, w1[prev]]; gated as the bf16 ops.
+extern "C" __global__ void __launch_bounds__(256) tf_ink2_dsp_rnn(const float* __restrict__ ctx, const uint16_t* __restrict__ W,
+                                                                  const uint16_t* __restrict__ w1, const int* __restrict__ walk, int j,
+                                                                  uint16_t* __restrict__ state, uint16_t* __restrict__ latent, int R, int C) {
+    using namespace ink2d;
+    __shared__ float in[512];
+    __shared__ float raw[768];
+    const int c = threadIdx.x, lane = c & 31, wp = c >> 5, nw = blockDim.x >> 5;
+    const size_t prev = static_cast<size_t>(walk[j]);
+    in[c] = bf(state[c]);
+    in[R + c] = bf(w1[prev * R + c]);
+    __syncthreads();
+    const int ld = 2 * R + 2 * C;
+    for (int o = wp; o < 3 * R; o += nw) {
+        float s = 0.0f;
+        for (int k = lane; k < 2 * R; k += 32) s += bf(W[static_cast<size_t>(o) * ld + k]) * in[k];
+        s = warpSum(s);
+        if (lane == 0) raw[o] = s + ctx[o];
+    }
+    __syncthreads();
+    const float gate = bfr(1.0f / (1.0f + expf(-bfr(raw[c]))));
+    const float cand = bfr(tanhf(bfr(raw[R + c])));
+    const float keep = bfr(gate * in[c]);
+    const float upd = bfr(bfr(1.0f - gate) * cand);
+    state[c] = tobf(keep + upd);
+    latent[c] = tobf(tanhf(bfr(raw[2 * R + c])));
+}
+
+// A step's logits over this rank's vocabulary: softcap(bf16(base + bf16(fold_bias + fold . latent))), -inf past valid.
+extern "C" __global__ void __launch_bounds__(256) tf_ink2_dsp_vocab(const uint16_t* __restrict__ base, const uint16_t* __restrict__ latent,
+                                                                    const uint16_t* __restrict__ fold, const uint16_t* __restrict__ fbias,
+                                                                    float cap, int valid, int nv, float* __restrict__ out) {
+    using namespace ink2d;
+    const int v = blockIdx.x * (blockDim.x >> 5) + (threadIdx.x >> 5), lane = threadIdx.x & 31;
+    if (v >= nv) return;
+    const uint16_t* f = fold + static_cast<size_t>(v) * 256;
+    float s = 0.0f;
+    for (int k = lane; k < 256; k += 32) s += bf(latent[k]) * bf(f[k]);
+    s = warpSum(s);
+    if (lane != 0) return;
+    const float b = bfr(s + bf(fbias[v]));
+    const float x = bfr(bf(base[v]) + b);
+    out[v] = v < valid ? bfr(tanhf(x / cap) * cap) : -INFINITY;
+}
+
+// The ranks' (value, id) picks, 16 bytes apart: the largest value, the lowest id among equals, into walk[j + 1].
+extern "C" __global__ void tf_ink2_dsp_pick(const float* __restrict__ picks, int world, int* __restrict__ walk, int j) {
+    float bv = -INFINITY;
+    int bi = 0x7fffffff;
+    for (int q = 0; q < world; ++q) {
+        const float v = picks[q * 4];
+        const int i = reinterpret_cast<const int*>(picks)[q * 4 + 1];
+        if (v > bv || (v == bv && i < bi)) {
+            bv = v;
+            bi = i;
+        }
+    }
+    walk[j + 1] = bi;
+}
diff --git a/zig/kernels/cuda/inkling2/experts.cu b/zig/kernels/cuda/inkling2/experts.cu
new file mode 100644
index 000000000..e5b8afabc
--- /dev/null
+++ b/zig/kernels/cuda/inkling2/experts.cu
@@ -0,0 +1,329 @@
+// Inkling 2's grouped expert projections: exl3_grouped.cuh's arithmetic per output, launched without empty tiles.
+#include <cstdint>
+#include <cuda_fp16.h>
+
+#include "exl3_decode.cuh"
+
+namespace ink2x {
+using namespace tf_exl3;
+
+constexpr int ITEM_THREADS = 1024;
+
+// tf_ink2x_group's arguments: tf_exl3_group's lists, plus items (u, first, count), runs of at most `per` members.
+struct GroupArgs {
+    const int* pick; // int32 [rows * slots]
+    int* uids; // int32 [nexp_max]
+    int* ucount; // int32 [1]
+    int* members; // int32 [nexp_max, maxm]
+    int* items; // int32 [3 * max items] (per > 0)
+    int* nitems; // int32 [1] (per > 0)
+    int rows, slots, experts, maxm, per, pad; // pad: -1 after each expert's members up to maxm
+};
+
+// One projection; z, k, n, p, sk, maxm and slots as GroupedArgs has them.
+struct WideArgs {
+    const half* x0; // fp16 [P, K], the rotated gate (or down) inputs
+    const half* x1; // fp16 [P, K], the rotated up inputs
+    const long long* tp0; // int64 [E], one trellis pointer per expert
+    const long long* tp1;
+    const int* k2_0; // int32 [E], half-bits a value
+    const int* k2_1;
+    const int* uids; // int32 [nexp_max], distinct routed experts in id order
+    const int* items; // int32 [3 * max items], (u, first member, count); null: item u is expert u, maxm <= 16 MT
+    const int* nitems; // int32 [1]: the items, or the group's count when items is null
+    const int* members; // int32 [nexp_max, maxm], row * 32 + slot
+    float* z; // fp32 partials, [(mat * sk + split) * P + p] * N + col
+    int k, n, p, sk, maxm, slots;
+};
+
+// A warp's k tiles for MT member tiles in grouped_body's order per output; words and inputs travel a tile ahead.
+template <int CB, int K2, int NT, int MT>
+struct Tiles {
+    static constexpr int TW = tile_words<K2>(), LW = lane_words<K2>();
+    uint32_t nx[NT][LW];
+
+    __device__ __forceinline__ void first(const uint32_t* tb, int nkt, int lane) {
+        if (nkt > 0)
+#pragma unroll
+            for (int j = 0; j < NT; ++j) ldg_lane_words<K2>(tb + j * TW, lane, nx[j]);
+    }
+
+    __device__ __forceinline__ static void xload(const half* (&xr)[MT][2], const bool (&ok)[MT][2], int mts, int k,
+                                                 uint32_t (&a)[MT][4]) {
+#pragma unroll
+        for (int m = 0; m < MT; ++m) {
+            const bool o0 = m < mts && ok[m][0], o1 = m < mts && ok[m][1];
+            a[m][0] = o0 ? *reinterpret_cast<const uint32_t*>(xr[m][0] + k) : 0u;
+            a[m][1] = o1 ? *reinterpret_cast<const uint32_t*>(xr[m][1] + k) : 0u;
+            a[m][2] = o0 ? *reinterpret_cast<const uint32_t*>(xr[m][0] + k + 8) : 0u;
+            a[m][3] = o1 ? *reinterpret_cast<const uint32_t*>(xr[m][1] + k + 8) : 0u;
+        }
+    }
+
+    __device__ __forceinline__ void run(const uint32_t* tb, size_t kstride, int kt0, int nkt, const half* (&xr)[MT][2],
+                                        const bool (&ok)[MT][2], int mts, int lane, float (&acc)[MT][NT][2][4]) {
+        uint32_t xa[MT][4];
+        if (nkt > 0) xload(xr, ok, mts, kt0 * 16, xa);
+        for (int i = 0; i < nkt; ++i) {
+            uint32_t w[NT][LW], a[MT][4];
+#pragma unroll
+            for (int j = 0; j < NT; ++j)
+#pragma unroll
+                for (int l = 0; l < LW; ++l) w[j][l] = nx[j][l];
+#pragma unroll
+            for (int m = 0; m < MT; ++m)
+#pragma unroll
+                for (int c = 0; c < 4; ++c) a[m][c] = xa[m][c];
+            if (i + 1 < nkt) {
+#pragma unroll
+                for (int j = 0; j < NT; ++j) ldg_lane_words<K2>(tb + (size_t)(i + 1) * kstride + j * TW, lane, nx[j]);
+                xload(xr, ok, mts, (kt0 + i + 1) * 16, xa);
+            }
+#pragma unroll
+            for (int j = 0; j < NT; ++j) {
+                uint32_t b0[2], b1[2];
+                decode_lane<K2, CB>(w[j], lane, b0, b1);
+#pragma unroll
+                for (int m = 0; m < MT; ++m)
+                    if (m < mts) {
+                        mma16816(acc[m][j][0], a[m], b0);
+                        mma16816(acc[m][j][1], a[m], b1);
+                    }
+            }
+        }
+    }
+};
+
+// This lane's member-row input pointers (rows_sh filled and synced).
+template <int MT>
+__device__ __forceinline__ void member_rows(const half* X, int k, const int* rows_sh, int mts, int g, int t,
+                                            const half* (&xr)[MT][2], bool (&ok)[MT][2]) {
+#pragma unroll
+    for (int m = 0; m < MT; ++m) {
+        const int r0 = m < mts ? rows_sh[16 * m + g] : -1, r1 = m < mts ? rows_sh[16 * m + g + 8] : -1;
+        xr[m][0] = X + (size_t)(r0 < 0 ? 0 : r0) * k + 2 * t;
+        xr[m][1] = X + (size_t)(r1 < 0 ? 0 : r1) * k + 2 * t;
+        ok[m][0] = r0 >= 0;
+        ok[m][1] = r1 >= 0;
+    }
+}
+
+// Program (n block, item, mat * sk + split): 16 MT members by W_q over the split's K; SEQ: warps add in turn.
+template <int CB, int NT, int MT, int W, bool SEQ>
+__device__ __forceinline__ void wide_body(const WideArgs a) {
+    const int nblock = blockIdx.x, item = blockIdx.y;
+    if (item >= a.nitems[0]) return;
+    int u = item, first = 0, cnt = a.maxm;
+    if (a.items) {
+        u = a.items[3 * item];
+        first = a.items[3 * item + 1];
+        cnt = a.items[3 * item + 2];
+    }
+    const int split = blockIdx.z % a.sk, mat = blockIdx.z / a.sk;
+    const half* X = mat ? a.x1 : a.x0;
+    const int e = a.uids[u];
+    const uint32_t* T = reinterpret_cast<const uint32_t*>(mat ? a.tp1[e] : a.tp0[e]);
+    const int k2 = mat ? a.k2_1[e] : a.k2_0[e];
+    const int warp = threadIdx.x >> 5, lane = threadIdx.x & 31;
+    const int g = lane >> 2, t = lane & 3;
+    const int ntiles = a.n >> 4;
+    const int per_warp = (a.k >> 4) / a.sk / W;
+    const int kt0 = split * (per_warp * W) + warp * per_warp;
+    const int nt0 = nblock * NT;
+
+    __shared__ int rows_sh[16 * MT];
+    for (int m = threadIdx.x; m < 16 * MT; m += W * 32) {
+        const int code = m < cnt ? a.members[(size_t)u * a.maxm + first + m] : -1;
+        rows_sh[m] = code >= 0 ? (code >> 5) * a.slots + (code & 31) : -1;
+    }
+    float acc[MT][NT][2][4];
+#pragma unroll
+    for (int m = 0; m < MT; ++m)
+#pragma unroll
+        for (int i = 0; i < NT; ++i)
+#pragma unroll
+            for (int h = 0; h < 2; ++h)
+#pragma unroll
+                for (int c = 0; c < 4; ++c) acc[m][i][h][c] = 0.f;
+
+    int mts = 0;
+    switch (k2) {  // the first k tile's words are in flight before the members' rows are read
+#define TF_INK2X_CASE(K2_)                                                                               \
+    case K2_: {                                                                                          \
+        Tiles<CB, K2_, NT, MT> tl;                                                                       \
+        const size_t kstride = (size_t)ntiles * tile_words<K2_>();                                       \
+        const uint32_t* tb = T + (size_t)kt0 * kstride + (size_t)nt0 * tile_words<K2_>();                \
+        tl.first(tb, per_warp, lane);                                                                    \
+        __syncthreads();                                                                                 \
+        if (!a.items)                                                                                    \
+            while (cnt > 0 && rows_sh[cnt - 1] < 0) --cnt;                                               \
+        mts = (cnt + 15) >> 4;                                                                           \
+        if (mts == 0) return;                                                                            \
+        const half* xr[MT][2];                                                                           \
+        bool ok[MT][2];                                                                                  \
+        member_rows<MT>(X, a.k, rows_sh, mts, g, t, xr, ok);                                             \
+        tl.run(tb, kstride, kt0, per_warp, xr, ok, mts, lane, acc);                                      \
+        break;                                                                                           \
+    }
+        TF_INK2X_CASE(2)
+        TF_INK2X_CASE(3)
+        TF_INK2X_CASE(4)
+        TF_INK2X_CASE(5)
+        TF_INK2X_CASE(6)
+        TF_INK2X_CASE(7)
+        TF_INK2X_CASE(8)
+#undef TF_INK2X_CASE
+        default:
+            __trap();
+    }
+
+    __shared__ __align__(16) float red[SEQ ? 1 : W][16][NT * 16];
+#pragma unroll
+    for (int m = 0; m < MT; ++m) {
+        if (m >= mts) break;
+        if (m) __syncthreads();  // the last tile's sums are read
+        for (int w = SEQ ? 0 : warp; w < (SEQ ? W : warp + 1); ++w) {
+            if (w == warp)
+#pragma unroll
+                for (int i = 0; i < NT; ++i)
+#pragma unroll
+                    for (int h = 0; h < 2; ++h) {
+                        const int col = i * 16 + h * 8 + 2 * t;
+                        float* p0 = &red[SEQ ? 0 : warp][g][col];
+                        float* p1 = &red[SEQ ? 0 : warp][g + 8][col];
+                        if (!SEQ || w == 0) {
+                            p0[0] = acc[m][i][h][0];
+                            p0[1] = acc[m][i][h][1];
+                            p1[0] = acc[m][i][h][2];
+                            p1[1] = acc[m][i][h][3];
+                        } else {
+                            p0[0] += acc[m][i][h][0];
+                            p0[1] += acc[m][i][h][1];
+                            p1[0] += acc[m][i][h][2];
+                            p1[1] += acc[m][i][h][3];
+                        }
+                    }
+            if (SEQ) __syncthreads();
+        }
+        if (!SEQ) __syncthreads();
+        for (int idx = threadIdx.x; idx < 16 * NT * 16; idx += W * 32) {
+            const int row = idx / (NT * 16), col = idx % (NT * 16);
+            const int r = rows_sh[16 * m + row];
+            if (r < 0) continue;
+            float s = red[0][row][col];
+#pragma unroll
+            for (int w = 1; w < (SEQ ? 1 : W); ++w) s += red[w][row][col];
+            a.z[(((size_t)mat * a.sk + split) * a.p + r) * a.n + nt0 * 16 + col] = s;
+        }
+    }
+}
+
+// Exclusive sum over the block of one value a thread (ITEM_THREADS threads); `tot` gets the total.
+__device__ __forceinline__ int block_scan(int v, int* part, int& tot) {
+    const int lane = threadIdx.x & 31, warp = threadIdx.x >> 5;
+    int inc = v;
+#pragma unroll
+    for (int o = 1; o < 32; o <<= 1) {
+        const int x = __shfl_up_sync(0xffffffffu, inc, o);
+        if (lane >= o) inc += x;
+    }
+    if (lane == 31) part[warp] = inc;
+    __syncthreads();
+    if (warp == 0) {
+        const int w = part[lane];
+        int sum = w;
+#pragma unroll
+        for (int o = 1; o < 32; o <<= 1) {
+            const int x = __shfl_up_sync(0xffffffffu, sum, o);
+            if (lane >= o) sum += x;
+        }
+        part[lane] = sum - w;
+        if (lane == 31) part[32] = sum;
+    }
+    __syncthreads();
+    tot = part[32];
+    const int r = part[warp] + inc - v;
+    __syncthreads();
+    return r;
+}
+
+}  // namespace ink2x
+
+// tf_exl3_group's lists and the item list in O(pairs): warp w counts, then places, its 32nd of the pairs in order.
+extern "C" __global__ void __launch_bounds__(ink2x::ITEM_THREADS) tf_ink2x_group(const ink2x::GroupArgs a) {
+    extern __shared__ int sh[];
+    __shared__ int part[33];
+    const int E = a.experts, n = a.rows * a.slots;
+    uint16_t* wc = reinterpret_cast<uint16_t*>(sh);  // [32][E]: a warp's pairs of each expert, then its first rank
+    int* cnt = sh + 16 * E;
+    int* uidx = cnt + E;
+    const int lane = threadIdx.x & 31, warp = threadIdx.x >> 5;
+    const int span = (n + 31) / 32, lo = warp * span, hi = min(n, lo + span);
+    const unsigned below = (1u << lane) - 1u;
+    for (int i = threadIdx.x; i < 32 * E; i += ink2x::ITEM_THREADS) wc[i] = 0;
+    __syncthreads();
+    for (int i0 = lo; i0 < hi; i0 += 32) {
+        const int i = i0 + lane;
+        const int e = i < hi ? a.pick[i] : -1;
+        const unsigned m = __match_any_sync(0xffffffffu, e);
+        if (e >= 0 && e < E && (m & below) == 0) wc[warp * E + e] += __popc(m);
+    }
+    __syncthreads();
+    int has = 0, k = 0, c = 0;
+    const int e = threadIdx.x;
+    if (e < E) {
+        for (int w = 0; w < 32; ++w) {
+            const int t = wc[w * E + e];
+            wc[w * E + e] = c;
+            c += t;
+        }
+        cnt[e] = c;
+        has = c > 0;
+        k = a.per > 0 ? (c + a.per - 1) / a.per : 0;
+    }
+    int nu, ni;
+    const int u = ink2x::block_scan(has, part, nu);
+    int it = ink2x::block_scan(k, part, ni);
+    if (e < E) {
+        uidx[e] = u;
+        if (has) {
+            a.uids[u] = e;
+            for (int j = 0; j < k; ++j, ++it) {
+                a.items[3 * it] = u;
+                a.items[3 * it + 1] = j * a.per;
+                a.items[3 * it + 2] = min(a.per, c - j * a.per);
+            }
+        }
+    }
+    if (threadIdx.x == 0) {
+        a.ucount[0] = nu;
+        if (a.per > 0) a.nitems[0] = ni;
+    }
+    __syncthreads();
+    for (int i0 = lo; i0 < hi; i0 += 32) {
+        const int i = i0 + lane;
+        const int pe = i < hi ? a.pick[i] : -1;
+        const unsigned m = __match_any_sync(0xffffffffu, pe);
+        if (pe >= 0 && pe < E) {
+            const int rank = wc[warp * E + pe] + __popc(m & below);
+            a.members[(size_t)uidx[pe] * a.maxm + rank] = (i / a.slots) * 32 + i % a.slots;
+        }
+        __syncwarp();
+        if (pe >= 0 && pe < E && (m & below) == 0) wc[warp * E + pe] += __popc(m);
+        __syncwarp();
+    }
+    if (a.pad)  // -1 after each expert's members, as tf_exl3_group leaves them
+        for (int x = threadIdx.x; x < E; x += ink2x::ITEM_THREADS)
+            if (cnt[x] > 0)
+                for (int j = cnt[x]; j < a.maxm; ++j) a.members[(size_t)uidx[x] * a.maxm + j] = -1;
+}
+
+// Decode rows and short windows: 128 columns and 16 members a block (grouped_body's tile), warp sums apart.
+extern "C" __global__ void __launch_bounds__(128) tf_ink2x_rows(const ink2x::WideArgs a) {
+    ink2x::wide_body<tf_exl3::CB_MUL1, 8, 1, 4, false>(a);
+}
+
+// Prompt chunks: 64 columns and 32 members a block, one sum buffer.
+extern "C" __global__ void __launch_bounds__(128) tf_ink2x_wide(const ink2x::WideArgs a) {
+    ink2x::wide_body<tf_exl3::CB_MUL1, 4, 2, 4, true>(a);
+}
diff --git a/zig/kernels/cuda/inkling2/vision.cu b/zig/kernels/cuda/inkling2/vision.cu
new file mode 100644
index 000000000..5b0468bb4
--- /dev/null
+++ b/zig/kernels/cuda/inkling2/vision.cu
@@ -0,0 +1,203 @@
+// Inkling 2's vision tower glue: patch rows to the sequence, axial rotary, layer-scaled residuals, full attention.
+#include <cuda_bf16.h>
+#include <stdint.h>
+
+#include "prefill_attention.cuh"
+
+namespace ink2v {
+
+using namespace tf_prefill_attention;
+
+constexpr int kWidth = 1024; // the tower's hidden size
+constexpr int kHeads = 16;
+constexpr int kDim = 64;
+constexpr int kPairs = kDim / 2;
+constexpr int kThreads = 256;
+
+__device__ __forceinline__ float bf(__nv_bfloat16 v) { return __bfloat162float(v); }
+
+__device__ __forceinline__ __nv_bfloat16 tobf(float v) { return __float2bfloat16_rn(v); }
+
+// prefill_attention.cu's vision_kernel body (v1.2.7, verbatim): 16 query rows a warp, 64-key tiles, online softmax.
+template <int D, int WARPS>
+__device__ __forceinline__ void attend(const __nv_bfloat16* __restrict__ qkv, __nv_bfloat16* __restrict__ out, int W, int HO,
+                                       float scale) {
+    static_assert(D % 16 == 0, "whole 16-dim steps");
+    constexpr int C = D / 8, RS = C + 1, K16 = D / 16, NT = BN / 8, THREADS = 32 * WARPS;
+    extern __shared__ uint4 smem[];
+    const int warp = threadIdx.x / 32, lane = threadIdx.x % 32, g = lane / 4, qd = lane % 4, mt = lane / 8;
+    const int head = blockIdx.y, wrow = (blockIdx.x * WARPS + warp) * 16, last = W - 1, tiles = (W + BN - 1) / BN;
+    const int64_t stride = 3LL * HO * D;
+    const __nv_bfloat16* __restrict__ q = qkv + head * D;
+    const __nv_bfloat16* __restrict__ kc = qkv + (HO + head) * D;
+    const __nv_bfloat16* __restrict__ vc = qkv + (2 * HO + head) * D;
+    auto stage = [&](int t) {                            // tile t's K rows then V rows into buffer t % 2
+        uint4* dst = smem + (t & 1) * 2 * BN * RS;
+        for (int i = threadIdx.x; i < 2 * BN * C; i += THREADS) {
+            const int kv = i / (BN * C), r = (i / C) % BN, c = i % C, key = t * BN + r;
+            const bool in = key < W;
+            cp16z(dst + (kv * BN + r) * RS + c, (kv ? vc : kc) + (int64_t)(in ? key : 0) * stride + c * 8, in);
+        }
+        commit();
+    };
+    uint32_t qa[K16][4];
+    const int r0 = wrow + g, r1 = r0 + 8;
+    {
+        const uint32_t* q0 = reinterpret_cast<const uint32_t*>(q + (int64_t)min(r0, last) * stride);
+        const uint32_t* q1 = reinterpret_cast<const uint32_t*>(q + (int64_t)min(r1, last) * stride);
+#pragma unroll
+        for (int k = 0; k < K16; ++k) {
+            qa[k][0] = r0 < W ? q0[8 * k + qd] : 0u;
+            qa[k][1] = r1 < W ? q1[8 * k + qd] : 0u;
+            qa[k][2] = r0 < W ? q0[8 * k + qd + 4] : 0u;
+            qa[k][3] = r1 < W ? q1[8 * k + qd + 4] : 0u;
+        }
+    }
+    float o[C][4];
+#pragma unroll
+    for (int i = 0; i < C; ++i) o[i][0] = o[i][1] = o[i][2] = o[i][3] = 0.0f;
+    float m0 = -INFINITY, m1 = -INFINITY, l0 = 0.0f, l1 = 0.0f;
+    stage(0);
+    for (int t = 0; t < tiles; ++t) {
+        cp_wait<0>();
+        __syncthreads();                                 // tile t landed, and every warp is done with tile t - 1
+        if (t + 1 < tiles) stage(t + 1);
+        const uint4* ks = smem + (t & 1) * 2 * BN * RS;
+        const uint4* vs = ks + BN * RS;
+        float sc[NT][4];
+#pragma unroll
+        for (int k = 0; k < K16; ++k) {
+#pragma unroll
+            for (int n = 0; n < NT; n += 2) {
+                uint32_t b[4];
+                ldmatrix4(b, ks + (8 * (n + mt / 2) + lane % 8) * RS + 2 * k + mt % 2);
+                if (k == 0) {
+                    mma0(sc[n], qa[k], b[0], b[1]);
+                    mma0(sc[n + 1], qa[k], b[2], b[3]);
+                } else {
+                    mma(sc[n], qa[k], b[0], b[1]);
+                    mma(sc[n + 1], qa[k], b[2], b[3]);
+                }
+            }
+        }
+        const int kb = t * BN + 2 * qd;
+        float tm0 = -INFINITY, tm1 = -INFINITY;
+#pragma unroll
+        for (int n = 0; n < NT; ++n) {
+            const int c = kb + 8 * n;
+            sc[n][0] = c <= last ? __fmul_rn(sc[n][0], scale) : -INFINITY;
+            sc[n][1] = c + 1 <= last ? __fmul_rn(sc[n][1], scale) : -INFINITY;
+            sc[n][2] = c <= last ? __fmul_rn(sc[n][2], scale) : -INFINITY;
+            sc[n][3] = c + 1 <= last ? __fmul_rn(sc[n][3], scale) : -INFINITY;
+            tm0 = fmaxf(tm0, fmaxf(sc[n][0], sc[n][1]));
+            tm1 = fmaxf(tm1, fmaxf(sc[n][2], sc[n][3]));
+        }
+        for (int x = 1; x <= 2; x *= 2) {
+            tm0 = fmaxf(tm0, __shfl_xor_sync(0xffffffffu, tm0, x));
+            tm1 = fmaxf(tm1, __shfl_xor_sync(0xffffffffu, tm1, x));
+        }
+        const bool act0 = tm0 != -INFINITY, act1 = tm1 != -INFINITY;
+        const float n0 = act0 ? fmaxf(m0, tm0) : m0, n1 = act1 ? fmaxf(m1, tm1) : m1;
+        const float a0 = act0 ? (m0 == -INFINITY ? 0.0f : texp(__fsub_rn(m0, n0))) : 1.0f;
+        const float a1 = act1 ? (m1 == -INFINITY ? 0.0f : texp(__fsub_rn(m1, n1))) : 1.0f;
+        float c0[NT], c1[NT];
+#pragma unroll
+        for (int n = 0; n < NT; ++n) {
+            const int c = kb + 8 * n;
+            sc[n][0] = act0 && c <= last ? texp(__fsub_rn(sc[n][0], n0)) : 0.0f;
+            sc[n][1] = act0 && c + 1 <= last ? texp(__fsub_rn(sc[n][1], n0)) : 0.0f;
+            sc[n][2] = act1 && c <= last ? texp(__fsub_rn(sc[n][2], n1)) : 0.0f;
+            sc[n][3] = act1 && c + 1 <= last ? texp(__fsub_rn(sc[n][3], n1)) : 0.0f;
+            c0[n] = __fadd_rn(sc[n][0], sc[n][1]);
+            c1[n] = __fadd_rn(sc[n][2], sc[n][3]);
+        }
+        l0 = __fmaf_rn(l0, a0, rowsum(c0));
+        l1 = __fmaf_rn(l1, a1, rowsum(c1));
+        m0 = n0;
+        m1 = n1;
+#pragma unroll
+        for (int i = 0; i < C; ++i) {
+            o[i][0] = __fmul_rn(o[i][0], a0);
+            o[i][1] = __fmul_rn(o[i][1], a0);
+            o[i][2] = __fmul_rn(o[i][2], a1);
+            o[i][3] = __fmul_rn(o[i][3], a1);
+        }
+#pragma unroll
+        for (int j = 0; j < NT / 2; ++j) {               // 16-key chunks, in key order for every output tile
+            const uint32_t pa[4] = {pack(sc[2 * j][0], sc[2 * j][1]), pack(sc[2 * j][2], sc[2 * j][3]),
+                                    pack(sc[2 * j + 1][0], sc[2 * j + 1][1]), pack(sc[2 * j + 1][2], sc[2 * j + 1][3])};
+#pragma unroll
+            for (int i = 0; i < C; i += 2) {
+                uint32_t b[4];
+                ldmatrix4t(b, vs + (16 * j + 8 * (mt % 2) + lane % 8) * RS + i + mt / 2);
+                mma(o[i], pa, b[0], b[1]);
+                mma(o[i + 1], pa, b[2], b[3]);
+            }
+        }
+    }
+#pragma unroll
+    for (int i = 0; i < C; ++i) {
+        const int d = 8 * i + 2 * qd;
+        if (r0 < W)
+            *reinterpret_cast<uint32_t*>(out + ((int64_t)r0 * HO + head) * D + d) =
+                pack(tdiv(o[i][0], l0), tdiv(o[i][1], l0));
+        if (r1 < W)
+            *reinterpret_cast<uint32_t*>(out + ((int64_t)r1 * HO + head) * D + d) =
+                pack(tdiv(o[i][2], l1), tdiv(o[i][3], l1));
+    }
+}
+
+}  // namespace ink2v
+
+using namespace ink2v;
+
+// Block a head and 128 rows: every row of one picture over all its rows (no mask), q | k | v heads of qkv [W, 3 H 64].
+extern "C" __global__ void __launch_bounds__(256) tf_ink2v_attention(const __nv_bfloat16* __restrict__ qkv,
+                                                                     __nv_bfloat16* __restrict__ out, int W, int HO,
+                                                                     float scale) {
+    attend<kDim, 8>(qkv, out, W, HO, scale);
+}
+
+// Block a sequence row: row 0 the class token bf16(cls + cls_pos), row r the patch r - 1 plus its resampled position.
+extern "C" __global__ void __launch_bounds__(kThreads) tf_ink2v_embed(const __nv_bfloat16* __restrict__ pe,
+                                                                      const __nv_bfloat16* __restrict__ table,
+                                                                      const uint32_t* __restrict__ taps,
+                                                                      const float* __restrict__ wts,
+                                                                      const __nv_bfloat16* __restrict__ cls,
+                                                                      const __nv_bfloat16* __restrict__ cls_pos,
+                                                                      __nv_bfloat16* __restrict__ x) {
+    const int r = blockIdx.x;
+    for (int c = threadIdx.x; c < kWidth; c += kThreads) {
+        float v;
+        if (r == 0) {
+            v = __fadd_rn(bf(cls[c]), bf(cls_pos[c]));
+        } else {
+            const int p = r - 1;
+            float s = 0.0f;
+            for (int t = 0; t < 4; ++t) s = __fadd_rn(s, __fmul_rn(bf(table[(int64_t)taps[p * 4 + t] * kWidth + c]), wts[p * 4 + t]));
+            v = __fadd_rn(bf(pe[(int64_t)p * kWidth + c]), bf(tobf(s)));
+        }
+        x[(int64_t)r * kWidth + c] = tobf(v);
+    }
+}
+
+// Block a row: q and k of qkv [rows, 3 H 64] turned in place, pair j by cos, sin [rows][32]; fp32 as torch, then bf16.
+extern "C" __global__ void __launch_bounds__(kThreads) tf_ink2v_rope(__nv_bfloat16* __restrict__ qkv, const float* __restrict__ cs,
+                                                                     const float* __restrict__ sn) {
+    const int r = blockIdx.x;
+    for (int i = threadIdx.x; i < 2 * kHeads * kPairs; i += kThreads) {
+        const int j = i % kPairs;
+        __nv_bfloat16* p = qkv + (int64_t)r * 3 * kWidth + (i / kPairs) * kDim + 2 * j;
+        const float c = cs[r * kPairs + j], s = sn[r * kPairs + j], a = bf(p[0]), b = bf(p[1]);
+        p[0] = tobf(__fadd_rn(__fmul_rn(a, c), __fmul_rn(-b, s)));
+        p[1] = tobf(__fadd_rn(__fmul_rn(b, c), __fmul_rn(a, s)));
+    }
+}
+
+// x [count] = bf16(x + bf16(gamma[i % width] y)): the layer-scaled residual add of an attention or MLP output.
+extern "C" __global__ void __launch_bounds__(kThreads) tf_ink2v_scale_add(__nv_bfloat16* __restrict__ x, const __nv_bfloat16* __restrict__ y,
+                                                                          const __nv_bfloat16* __restrict__ gamma, int64_t count) {
+    const int64_t i = (int64_t)blockIdx.x * kThreads + threadIdx.x;
+    if (i >= count) return;
+    x[i] = tobf(__fadd_rn(bf(x[i]), bf(tobf(__fmul_rn(bf(gamma[i % kWidth]), bf(y[i]))))));
+}
