+//! Inkling 2's inkling2_dspark images: every SM's compile records (nvcc 13.0, 13.2, 13.3).
+const registry = @import("registry.zig");
+
+/// nvcc 13.0's usage, the compiler of the release fatbins (nvcc -cubin, five SMs, the image's glue flags).
+pub const cuda = [_]registry.CudaRecord{
+    .{ .launch = .{ .name = "inkling2 dspark tf_ink2_dsp_mix", .symbol = "tf_ink2_dsp_mix", .image = "inkling2_dspark", .threads = 512, .min_sm = 80 }, .usage = .{ .{ .regs = 32, .static = 128, .bound = 512 }, .{ .regs = 40, .static = 128, .bound = 512 }, .{ .regs = 40, .static = 128, .bound = 512 }, .{ .regs = 40, .static = 128, .bound = 512 }, .{ .regs = 40, .static = 128, .bound = 512 } } },
+    .{ .launch = .{ .name = "inkling2 dspark tf_ink2_dsp_addnorm", .symbol = "tf_ink2_dsp_addnorm", .image = "inkling2_dspark", .threads = 512, .min_sm = 80 }, .usage = .{ .{ .regs = 32, .static = 128, .bound = 512 }, .{ .regs = 40, .static = 128, .bound = 512 }, .{ .regs = 40, .static = 128, .bound = 512 }, .{ .regs = 40, .static = 128, .bound = 512 }, .{ .regs = 40, .static = 128, .bound = 512 } } },
+    .{ .launch = .{ .name = "inkling2 dspark tf_ink2_dsp_qk", .symbol = "tf_ink2_dsp_qk", .image = "inkling2_dspark", .threads = 64, .min_sm = 80 }, .usage = .{ .{ .regs = 28, .static = 128, .bound = 64 }, .{ .regs = 28, .static = 128, .bound = 64 }, .{ .regs = 28, .static = 128, .bound = 64 }, .{ .regs = 24, .static = 128, .bound = 64 }, .{ .regs = 26, .static = 128, .bound = 64 } } },
+    .{ .launch = .{ .name = "inkling2 dspark tf_ink2_dsp_attn", .symbol = "tf_ink2_dsp_attn", .image = "inkling2_dspark", .threads = 256, .min_sm = 80 }, .usage = .{ .{ .regs = 67, .static = 48192, .bound = 256 }, .{ .regs = 69, .static = 48192, .bound = 256 }, .{ .regs = 69, .static = 48192, .bound = 256 }, .{ .regs = 46, .static = 48192, .bound = 256 }, .{ .regs = 46, .static = 48192, .bound = 256 } } },
+    .{ .launch = .{ .name = "inkling2 dspark tf_ink2_dsp_merge", .symbol = "tf_ink2_dsp_merge", .image = "inkling2_dspark", .threads = 128, .min_sm = 80 }, .usage = .{ .{ .regs = 32, .static = 0, .bound = 128 }, .{ .regs = 39, .static = 0, .bound = 128 }, .{ .regs = 39, .static = 0, .bound = 128 }, .{ .regs = 33, .static = 0, .bound = 128 }, .{ .regs = 33, .static = 0, .bound = 128 } } },
+    .{ .launch = .{ .name = "inkling2 dspark tf_ink2_dsp_silu", .symbol = "tf_ink2_dsp_silu", .image = "inkling2_dspark", .threads = 256, .min_sm = 80 }, .usage = .{ .{ .regs = 19, .static = 0, .bound = 256 }, .{ .regs = 20, .static = 0, .bound = 256 }, .{ .regs = 20, .static = 0, .bound = 256 }, .{ .regs = 22, .static = 0, .bound = 256 }, .{ .regs = 22, .static = 0, .bound = 256 } } },
+    .{ .launch = .{ .name = "inkling2 dspark tf_ink2_dsp_ctx", .symbol = "tf_ink2_dsp_ctx", .image = "inkling2_dspark", .threads = 256, .min_sm = 80 }, .usage = .{ .{ .regs = 32, .static = 0, .bound = 256 }, .{ .regs = 40, .static = 0, .bound = 256 }, .{ .regs = 40, .static = 0, .bound = 256 }, .{ .regs = 47, .static = 0, .bound = 256 }, .{ .regs = 47, .static = 0, .bound = 256 } } },
+    .{ .launch = .{ .name = "inkling2 dspark tf_ink2_dsp_rnn", .symbol = "tf_ink2_dsp_rnn", .image = "inkling2_dspark", .threads = 256, .min_sm = 80 }, .usage = .{ .{ .regs = 32, .static = 5120, .bound = 256 }, .{ .regs = 39, .static = 5120, .bound = 256 }, .{ .regs = 39, .static = 5120, .bound = 256 }, .{ .regs = 40, .static = 5120, .bound = 256 }, .{ .regs = 40, .static = 5120, .bound = 256 } } },
+    .{ .launch = .{ .name = "inkling2 dspark tf_ink2_dsp_vocab", .symbol = "tf_ink2_dsp_vocab", .image = "inkling2_dspark", .threads = 256, .min_sm = 80 }, .usage = .{ .{ .regs = 21, .static = 0, .bound = 256 }, .{ .regs = 22, .static = 0, .bound = 256 }, .{ .regs = 22, .static = 0, .bound = 256 }, .{ .regs = 15, .static = 0, .bound = 256 }, .{ .regs = 15, .static = 0, .bound = 256 } } },
+    .{ .launch = .{ .name = "inkling2 dspark tf_ink2_dsp_pick", .symbol = "tf_ink2_dsp_pick", .image = "inkling2_dspark", .threads = 1, .min_sm = 80 }, .usage = .{ .{ .regs = 18, .static = 0, .bound = 0 }, .{ .regs = 18, .static = 0, .bound = 0 }, .{ .regs = 18, .static = 0, .bound = 0 }, .{ .regs = 40, .static = 0, .bound = 0 }, .{ .regs = 40, .static = 0, .bound = 0 } } },
+};
+/// nvcc 13.2's, where it differs: none measured (no 13.2 compiler on the fleet).
+pub const cuda_132 = [_]registry.Override{};
