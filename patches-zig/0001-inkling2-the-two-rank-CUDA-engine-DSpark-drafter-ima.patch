@@ -0,0 +1,67 @@
+//! Inkling 2's DSpark drafter glue (inkling2/dspark.cu) under the contract, with controls.
+const std = @import("std");
+const cuda = @import("cuda");
+const check = @import("check.zig");
+const g = @import("core").contract.gates;
+const dk = @import("inkling2").dspark_ops;
+const ref = @import("contract_minimax_glue_ref.zig");
+const norm = @import("contract_inkling2_dspark_norm.zig");
+const attn = @import("contract_inkling2_dspark_attn.zig");
+const head = @import("contract_inkling2_dspark_head.zig");
+const glue = @import("contract_inkling2_dspark_glue.zig");
+
+/// The drafter's registrations, each control after the kernel it breaks (the caller's heap set holds them).
+pub const Set = struct {
+    k: dk.Kernels = undefined,
+    mixes: [2]ref.Gated(norm.Mix) = undefined,
+    adds: [3]ref.Gated(norm.AddNorm) = undefined,
+    qks: [3]ref.Gated(norm.Qk) = undefined,
+    attends: [2]attn.Attend = undefined,
+    merges: [2]ref.Gated(attn.Merge) = undefined,
+    silus: [2]ref.Gated(glue.Silu) = undefined,
+    ctxs: [2]ref.Gated(head.Ctx) = undefined,
+    rnns: [2]ref.Gated(head.Rnn) = undefined,
+    vocabs: [2]head.Banded(head.Vocab) = undefined,
+    picks: [2]ref.Checked(glue.Pick) = undefined,
+
+    pub fn init(set: *Set, gpu: check.Gpu, s: cuda.Stream, a: std.mem.Allocator, list: *std.ArrayList(g.Kernel)) !void {
+        set.k = try dk.Kernels.load(gpu.d);
+        errdefer set.k.unload();
+        const k = &set.k;
+        const rig: @import("contract_rig.zig").Rig = .{ .gpu = gpu, .s = s };
+        for (&set.mixes, 0..) |*x, i| x.* = .{ .rig = rig, .k = .{ .kern = k, .drop = i == 1 } };
+        for (&set.adds, [_]norm.View{ .resid, .normed, .normed }, 0..) |*x, v, i| x.* = .{ .rig = rig, .k = .{ .kern = k, .view = v, .short = i == 2 } };
+        for (&set.qks, [_]norm.Form{ .draft, .absorb, .draft }, 0..) |*x, f, i| x.* = .{ .rig = rig, .k = .{ .kern = k, .form = f, .late = i == 2 } };
+        for (&set.attends, 0..) |*x, i| x.* = .{ .rig = rig, .k = k, .late = i == 1 };
+        for (&set.merges, 0..) |*x, i| x.* = .{ .rig = rig, .k = .{ .kern = k, .short = i == 1 } };
+        for (&set.silus, 0..) |*x, i| x.* = .{ .rig = rig, .k = .{ .kern = k, .swapped = i == 1 } };
+        for (&set.ctxs, 0..) |*x, i| x.* = .{ .rig = rig, .k = .{ .kern = k, .early = i == 1 } };
+        for (&set.rnns, 0..) |*x, i| x.* = .{ .rig = rig, .k = .{ .kern = k, .late = i == 1 } };
+        for (&set.vocabs, 0..) |*x, i| x.* = .{ .inner = .{ .rig = rig, .k = .{ .kern = k, .short = i == 1 } } };
+        for (&set.picks, 0..) |*x, i| x.* = .{ .rig = rig, .k = .{ .kern = k, .alone = i == 1 } };
+        for (&set.mixes) |*x| try list.append(a, x.kernel());
+        for (&set.adds) |*x| try list.append(a, x.kernel());
+        for (&set.qks) |*x| try list.append(a, x.kernel());
+        for (&set.attends) |*x| try list.append(a, x.kernel());
+        for (&set.merges) |*x| try list.append(a, x.kernel());
+        for (&set.silus) |*x| try list.append(a, x.kernel());
+        for (&set.ctxs) |*x| try list.append(a, x.kernel());
+        for (&set.rnns) |*x| try list.append(a, x.kernel());
+        for (&set.vocabs) |*x| try list.append(a, x.kernel());
+        for (&set.picks) |*x| try list.append(a, x.kernel());
+    }
+
+    pub fn deinit(set: *Set) void {
+        for (&set.mixes) |*x| x.deinit();
+        for (&set.adds) |*x| x.deinit();
+        for (&set.qks) |*x| x.deinit();
+        for (&set.attends) |*x| x.deinit();
+        for (&set.merges) |*x| x.deinit();
+        for (&set.silus) |*x| x.deinit();
+        for (&set.ctxs) |*x| x.deinit();
+        for (&set.rnns) |*x| x.deinit();
+        for (&set.vocabs) |*x| x.deinit();
+        for (&set.picks) |*x| x.deinit();
+        set.k.unload();
+    }
+};
diff --git a/zig/tests/cuda/contract_inkling2_dspark_attn.zig b/zig/tests/cuda/contract_inkling2_dspark_attn.zig
new file mode 100644
index 000000000..1978055be
--- /dev/null
+++ b/zig/tests/cuda/contract_inkling2_dspark_attn.zig
@@ -0,0 +1,327 @@
+//! Inkling 2's DSpark block attention under the contract: tf_ink2_dsp_attn with its merge, and the merge alone.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const dk = @import("inkling2").dspark_ops;
+const rig_ = @import("contract_rig.zig");
+const ref = @import("contract_minimax_glue_ref.zig");
+
+const contract = core.contract;
+const c = contract.spec;
+const g = contract.gates;
+const sumIn = contract.rows.sumIn;
+const Iv = ref.Iv;
+const Sums = ref.Sums;
+const D = 128;
+const T = 8; // a block's rows
+const hk = 4; // a TP=2 rank's key heads, 6 query heads each
+const hq = 24;
+const grp = hq / hk;
+const scale: f32 = 1.0 / @sqrt(@as(f32, D)); // as the drafter passes it
+const soft_why = "online softmax over 32-key tiles in fp32 (expf rescales): no input makes its sums exact in fp32";
+
+/// A key's 128 products, then the row's keys, each tile's rescale and the chunks' merge.
+fn attnDepth(s: c.Shape) usize {
+    return D + s.k + s.k / 32 + 16;
+}
+
+/// T rows x 24 heads x 128 dims x the keys every row sees: a first block, a sliding window, a global prefix, 1M's edge.
+pub fn attnSpec(late: bool) c.Spec {
+    const served = &[_]c.Shape{ .{ .rows = T, .n = hq * D, .k = 8 }, .{ .rows = T, .n = hq * D, .k = 1032 }, .{ .rows = T, .n = hq * D, .k = 3000 }, .{ .rows = T, .n = hq * D, .k = 2500 } };
+    const name = if (late) "inkling2 dspark control: block attention starts a key late" else "inkling2 dspark tf_ink2_dsp_attn + tf_ink2_dsp_merge (a block over keys [lo, hi])";
+    return .{ .name = name, .accum = .f32, .depth = attnDepth, .ops = 8, .out = .bf16, .served = served, .sums = .{ .f16 = 0, .bf16 = 0, .exact = false, .why = soft_why } };
+}
+
+/// The window a shape's key count stands for: [lo, hi] and the ring the cache holds its keys in.
+const Window = struct { lo: usize, hi: usize, ring: usize };
+
+fn windowOf(keys: usize) Window {
+    return switch (keys) {
+        1032 => .{ .lo = 68_976, .hi = 70_007, .ring = 4096 }, // a sliding layer at 70,000: the window wraps the ring
+        2500 => .{ .lo = 1_046_076, .hi = 1_048_575, .ring = 8192 }, // the global layer's last chunks at 1M
+        else => .{ .lo = 0, .hi = keys - 1, .ring = 4096 },
+    };
+}
+
+/// One block's queries over a key and value cache (the ring as the draft slot holds it).
+pub const Attend = struct {
+    rig: rig_.Rig,
+    k: *const dk.Kernels,
+    /// control: the window starts one key late on the device (the reference keeps its first key)
+    late: bool = false,
+    shape: c.Shape = undefined,
+    win: Window = undefined,
+    q: []u16 = &.{},
+    keys: []u16 = &.{}, // [ring][hk][D]
+    values: []u16 = &.{},
+    tol: []f64 = &.{},
+    in: [3]u64 = @splat(0),
+    po: u64 = 0,
+    pml: u64 = 0,
+    out: u64 = 0,
+
+    pub fn deinit(self: *Attend) void {
+        self.free();
+        self.rig.deinit();
+    }
+
+    fn free(self: *Attend) void {
+        const a = self.rig.gpu.gpa;
+        inline for (.{ "q", "keys", "values" }) |name| {
+            a.free(@field(self, name));
+            @field(self, name) = &.{};
+        }
+        a.free(self.tol);
+        self.tol = &.{};
+    }
+
+    pub fn kernel(self: *Attend) g.Kernel {
+        return .{ .spec = attnSpec(self.late), .ctx = self, .vt = &vt, .control = if (self.late) .shapes else null };
+    }
+
+    const vt = g.hooks(Attend);
+
+    /// q in [-4, 4) (peaked: a lost key shows), k and v in [-1, 1); stress: 1/8 steps; non-finite: NaN q, inf k.
+    pub fn prepare(self: *Attend, shape: c.Shape, fill: g.Fill, seed: u64) !bool {
+        if (shape.n != hq * D or shape.rows == 0 or shape.rows > T or shape.k == 0) return false;
+        self.free();
+        self.rig.reset();
+        self.shape = shape;
+        self.win = windowOf(shape.k);
+        const a = self.rig.gpu.gpa;
+        var prng = std.Random.DefaultPrng.init(seed);
+        const rng = prng.random();
+        self.q = try a.alloc(u16, shape.rows * hq * D);
+        self.keys = try a.alloc(u16, self.win.ring * hk * D);
+        self.values = try a.alloc(u16, self.win.ring * hk * D);
+        for (self.q) |*v| v.* = c.toBf16(if (fill == .stress) 4 * grid(rng) else (rng.float(f32) * 2 - 1) * 4);
+        for ([_][]u16{ self.keys, self.values }) |x| for (x) |*v| {
+            v.* = c.toBf16(if (fill == .stress) grid(rng) else rng.float(f32) * 2 - 1);
+        };
+        if (fill == .nonfinite) {
+            self.q[3] = c.toBf16(ref.nan); // row 0, head 0
+            self.keys[((self.win.lo + 2) % self.win.ring * hk + 1) * D + 5] = c.toBf16(ref.inf); // key head 1's third key
+        }
+        self.in = .{ try self.rig.input(std.mem.sliceAsBytes(self.q)), try self.rig.input(std.mem.sliceAsBytes(self.keys)), try self.rig.input(std.mem.sliceAsBytes(self.values)) };
+        const n = dk.chunks(self.win.lo, self.win.hi);
+        self.po = try self.rig.scratch(n * shape.rows * hq * D * 4);
+        self.pml = try self.rig.scratch(n * shape.rows * hq * 2 * 4);
+        self.out = try self.rig.output(shape.rows * hq * D * 2);
+        return true;
+    }
+
+    /// A value on a 1/8 grid in [-1, 1]: bf16-exact, so stress sums start from exact inputs.
+    fn grid(rng: std.Random) f32 {
+        return @as(f32, @floatFromInt(@as(i32, @intCast(rng.uintLessThan(u32, 17))) - 8)) / 8;
+    }
+
+    pub fn run(self: *Attend) !void {
+        const w = self.win;
+        try dk.attend(self.k, self.rig.s, .{ .q = self.in[0], .kc = self.in[1], .vc = self.in[2], .po = self.po, .pml = self.pml, .T = @intCast(self.shape.rows), .hq = hq, .hk = hk, .ring = @intCast(w.ring), .lo = @intCast(w.lo + @intFromBool(self.late)), .hi = @intCast(w.hi), .c0 = 0, .scale = scale }, self.out);
+        try self.rig.s.synchronize();
+    }
+
+    pub fn count(self: *Attend) usize {
+        return self.shape.rows * hq * D;
+    }
+
+    fn at(self: *const Attend, x: []const u16, key: usize, h: usize, d: usize) f64 {
+        return c.fromBf16(x[((key % self.win.ring) * hk + h) * D + d]);
+    }
+
+    /// Row r, head h's softmax(q k scale) v over [lo, hi], sums in `acc` (null: f64); `tol`: fp32 dots, exp, rescales.
+    fn attend(self: *Attend, r: usize, h: usize, acc: ?c.Accum, order: g.Order, o: []f64, tol: ?[]f64) !void {
+        const a = self.rig.gpu.gpa;
+        const kv = h / grp;
+        const lo = self.win.lo;
+        const n = self.win.hi + 1 - lo;
+        const s = try a.alloc(f64, 4 * n);
+        defer a.free(s);
+        const ds = s[n .. 2 * n];
+        const p = s[2 * n .. 3 * n];
+        const col = s[3 * n ..];
+        var terms: [D]f64 = undefined;
+        var most = -std.math.inf(f64);
+        const sc: f64 = scale;
+        const qr = self.q[(r * hq + h) * D ..][0..D];
+        for (0..n) |i| {
+            var abs: f64 = 0;
+            for (&terms, qr, 0..) |*x, qv, d| {
+                x.* = @as(f64, c.fromBf16(qv)) * self.at(self.keys, lo + i, kv, d);
+                abs += @abs(x.*);
+            }
+            s[i] = (if (acc) |k| sumIn(k, order, &terms) else sumIn(.none, .sequential, &terms)) * sc;
+            ds[i] = (abs * sc * (D + 2) + @abs(s[i]) * 2) * 0x1p-24 + 0x1p-60;
+            most = maxNan(most, s[i]);
+        }
+        for (p, s[0..n]) |*x, v| x.* = @exp(v - most);
+        const l = if (acc) |k| sumIn(k, order, p) else sumIn(.none, .sequential, p);
+        // fp32 sums of p and p v, a rescale a 32-key tile and one a chunk, each expf (2 ulps) of a rounded gap
+        const chain = @as(f64, @floatFromInt(n + 12 * (n / 32 + 1) + 12 * dk.chunks(lo, self.win.hi) + 32)) * 0x1p-24;
+        for (o, 0..) |*od, d| {
+            var spread: f64 = 0;
+            for (col, p, ds, s[0..n], 0..) |*x, w, e, sv, i| {
+                const v = self.at(self.values, lo + i, kv, d);
+                x.* = w * v;
+                spread += w * @abs(v) * (2 * e + @abs(sv - most) * 0x1p-23 + 0x1p-22 + chain);
+            }
+            od.* = (if (acc) |k| sumIn(k, order, col) else sumIn(.none, .sequential, col)) / l;
+            if (tol) |t| t[d] = @abs(od.*) * (0x1p-8 + chain) + spread / l + 0x1p-120;
+        }
+    }
+
+    /// float64 o = sum p v / sum p, p = exp(s - max), over every key in [lo, hi]; bound as attend states.
+    pub fn reference(self: *Attend, want: []f64, mag: []f64) !void {
+        const a = self.rig.gpu.gpa;
+        a.free(self.tol);
+        self.tol = try a.alloc(f64, want.len);
+        for (0..self.shape.rows) |r| for (0..hq) |h| {
+            const o = (r * hq + h) * D;
+            try self.attend(r, h, null, .sequential, want[o..][0..D], self.tol[o..][0..D]);
+        };
+        for (mag, want) |*m, w| m.* = @abs(w);
+    }
+
+    pub fn bounds(self: *Attend, _: []const f64, _: []const f64, allow: []f64) !void {
+        for (allow, self.tol) |*l, t| l.* = if (std.math.isFinite(t)) t else std.math.floatMax(f64);
+    }
+
+    pub fn simulate(self: *Attend, acc: c.Accum, order: g.Order, out: []f64) !void {
+        for (0..self.shape.rows) |r| for (0..hq) |h| {
+            const o = (r * hq + h) * D;
+            try self.attend(r, h, acc, order, out[o..][0..D], null);
+            for (out[o..][0..D]) |*v| v.* = c.fromBf16(c.toBf16(@floatCast(v.*)));
+        };
+    }
+};
+
+/// max that keeps a NaN, as float64 arithmetic on the formula would.
+fn maxNan(x: f64, y: f64) f64 {
+    return if (std.math.isNan(x) or std.math.isNan(y)) std.math.nan(f64) else @max(x, y);
+}
+
+/// (row, head) pairs x 128 dims x chunks: a block's 192 pairs over 2-3 chunks, a 1M context's 1,025, one chunk.
+pub fn mergeSpec(short: bool) c.Spec {
+    const served = &[_]c.Shape{ .{ .rows = T * hq, .n = D, .k = 2 }, .{ .rows = T * hq, .n = D, .k = 1025 }, .{ .rows = T * hq, .n = D, .k = 3 }, .{ .rows = T * hq, .n = D, .k = 1 } };
+    const name = if (short) "inkling2 dspark control: the merge folds one chunk short" else "inkling2 dspark tf_ink2_dsp_merge (chunks folded in order)";
+    return .{ .name = name, .accum = .f32, .depth = mergeDepth, .out = .bf16, .served = served, .sums = .{} };
+}
+
+fn mergeDepth(s: c.Shape) usize {
+    return s.k + 1;
+}
+
+/// out = bf16(sum_c po_c w_c / sum_c l_c w_c), w_c = exp(m_c - max) (0 for an empty chunk, m -inf), max by fmaxf.
+pub const Merge = struct {
+    kern: *const dk.Kernels,
+    /// control: launched over one chunk fewer
+    short: bool = false,
+    shape: c.Shape = undefined,
+    po: []f32 = &.{},
+    pml: []f32 = &.{},
+    in: [2]u64 = @splat(0),
+    out: u64 = 0,
+
+    pub const sums = {};
+
+    pub fn spec(self: *const Merge) c.Spec {
+        return mergeSpec(self.short);
+    }
+
+    pub fn control(self: *const Merge) ?g.Gate {
+        return if (self.short) .shapes else null;
+    }
+
+    pub fn free(self: *Merge, a: std.mem.Allocator) void {
+        a.free(self.po);
+        a.free(self.pml);
+        self.po = &.{};
+        self.pml = &.{};
+    }
+
+    /// Chunk maxima in [-4, 4) (one chunk in 7 empty), totals in [1, 64), sums within them; stress: maxima 0, integers.
+    pub fn prepare(self: *Merge, a: std.mem.Allocator, rig: *rig_.Rig, shape: c.Shape, fill: g.Fill, rng: std.Random) !bool {
+        if (shape.rows == 0 or shape.n != D or shape.k == 0) return false;
+        self.free(a);
+        self.shape = shape;
+        const nqt = shape.rows;
+        const ch = shape.k;
+        self.po = try a.alloc(f32, ch * nqt * D);
+        self.pml = try a.alloc(f32, ch * nqt * 2);
+        const half = (ch - 1) / 2;
+        for (0..ch) |cc| for (0..nqt) |rh| {
+            const ml = self.pml[(cc * nqt + rh) * 2 ..][0..2];
+            const row = self.po[(cc * nqt + rh) * D ..][0..D];
+            if (fill == .stress) {
+                ml.* = .{ 0, ref.int(rng, 1, 1000) };
+                for (row) |*v| v.* = ref.int(rng, 1, 1000);
+                continue;
+            }
+            const empty = ch > 1 and cc % 7 == 3;
+            ml.* = if (empty) .{ -ref.inf, 0 } else .{ rng.float(f32) * 8 - 4, 1 + rng.float(f32) * 63 };
+            for (row) |*v| v.* = if (empty) 0 else (rng.float(f32) * 2 - 1) * ml[1];
+        };
+        if (fill == .stress) for (0..half) |cc| for (0..nqt) |rh| for (0..D) |d| {
+            const mirror = half + (cc + 1) % half; // one step apart, so no replay cancels exactly
+            self.po[(mirror * nqt + rh) * D + d] = -self.po[(cc * nqt + rh) * D + d] + @as(f32, if (cc == 0 and d % 5 == 1) 1 else 0);
+        };
+        if (fill == .nonfinite) {
+            self.po[3] = ref.nan; // pair 0, chunk 0
+            self.pml[1 * 2] = ref.nan; // pair 1's chunk 0 maximum: its weight NaN
+            if (ch > 1) self.po[(nqt + 2) * D + 5] = ref.inf; // pair 2, chunk 1
+            self.pml[3 * 2 + 1] = ref.inf; // pair 3's chunk 0 total: its every output 0
+        }
+        self.in = .{ try ref.input(rig, self.po), try ref.input(rig, self.pml) };
+        self.out = try rig.output(nqt * D * 2);
+        return true;
+    }
+
+    pub fn run(self: *Merge, rig: *rig_.Rig) !void {
+        var m: cuda.Args = .{};
+        m.add(self.in[0]);
+        m.add(self.in[1]);
+        m.add(@as(i32, @intCast(self.shape.k - @intFromBool(self.short))));
+        m.add(@as(i32, @intCast(self.shape.rows)));
+        m.add(self.out);
+        try cuda.launch.launch(self.kern.merge, .{ .grid = .{ .x = @intCast(self.shape.rows) }, .block = .{ .x = 128 } }, rig.s, &m);
+    }
+
+    pub fn count(self: *const Merge) usize {
+        return self.shape.rows * D;
+    }
+
+    pub fn solve(self: *const Merge, a: std.mem.Allocator, s: Sums, out: []Iv) !void {
+        const nqt = self.shape.rows;
+        const ch = self.shape.k;
+        const buf = try a.alloc(Iv, 3 * ch);
+        defer a.free(buf);
+        const wt = buf[0..ch];
+        const terms = buf[ch .. 2 * ch];
+        const ls = buf[2 * ch ..];
+        const scratch = try a.alloc(f64, ch);
+        defer a.free(scratch);
+        for (0..nqt) |rh| {
+            var mx = -std.math.inf(f64);
+            for (0..ch) |cc| {
+                const m: f64 = self.pml[(cc * nqt + rh) * 2];
+                if (!std.math.isNan(m)) mx = @max(mx, m); // fmaxf: a NaN maximum is passed over
+            }
+            for (wt, 0..) |*w, cc| {
+                const m: f64 = self.pml[(cc * nqt + rh) * 2];
+                w.* = if (m == -std.math.inf(f64)) Iv.of(0) else if (m == mx) Iv.of(1) else Iv.of(m).sub(Iv.of(mx)).exp();
+            }
+            for (ls, wt, 0..) |*t, w, cc| t.* = weigh(Iv.of(self.pml[(cc * nqt + rh) * 2 + 1]), w);
+            const l = s.sum(ls, ch, scratch);
+            for (0..D) |d| {
+                for (terms, wt, 0..) |*t, w, cc| t.* = weigh(Iv.of(self.po[(cc * nqt + rh) * D + d]), w);
+                out[rh * D + d] = s.sum(terms, ch, scratch).div(l).bf();
+            }
+        }
+    }
+
+    /// x w in fp32: exact where w is 0 or 1 (exp(0) and an empty chunk), else one rounding.
+    fn weigh(x: Iv, w: Iv) Iv {
+        if (w.lo == w.hi and (w.m == 0 or w.m == 1)) return Iv.of(x.m * w.m);
+        return x.mul(w);
+    }
+};
diff --git a/zig/tests/cuda/contract_inkling2_dspark_glue.zig b/zig/tests/cuda/contract_inkling2_dspark_glue.zig
new file mode 100644
index 000000000..bd7c7b5a1
--- /dev/null
+++ b/zig/tests/cuda/contract_inkling2_dspark_glue.zig
@@ -0,0 +1,190 @@
+//! Inkling 2's DSpark SiLU and the ranks' pick under the contract: tf_ink2_dsp_silu and tf_ink2_dsp_pick.
+const std = @import("std");
+const core = @import("core");
+const dk = @import("inkling2").dspark_ops;
+const rig_ = @import("contract_rig.zig");
+const ref = @import("contract_minimax_glue_ref.zig");
+
+const c = core.contract.spec;
+const g = core.contract.gates;
+const Iv = ref.Iv;
+const Sums = ref.Sums;
+
+const inter = 9216; // a TP=2 rank's FFN columns (18,432 / 2)
+
+/// A block's 8 rows x this rank's FFN columns: no sums.
+pub fn siluSpec(swapped: bool) c.Spec {
+    const served = &[_]c.Shape{.{ .rows = 8, .n = inter, .k = 1 }};
+    const name = if (swapped) "inkling2 dspark control: SiLU reads up as gate and gate as up" else "inkling2 dspark tf_ink2_dsp_silu (silu(gate) * up in fp32, rounded once)";
+    return .{ .name = name, .accum = .none, .depth = ref.noSums, .out = .bf16, .served = served };
+}
+
+/// out = bf16(g / (1 + expf(-g)) * u), gu bf16 [rows][2I] (gates, then ups).
+pub const Silu = struct {
+    kern: *const dk.Kernels,
+    /// control: the device's rows hold ups then gates (the reference keeps gates first)
+    swapped: bool = false,
+    shape: c.Shape = undefined,
+    gu: []u16 = &.{},
+    in: u64 = 0,
+    out: u64 = 0,
+
+    pub fn spec(self: *const Silu) c.Spec {
+        return siluSpec(self.swapped);
+    }
+
+    pub fn control(self: *const Silu) ?g.Gate {
+        return if (self.swapped) .shapes else null;
+    }
+
+    pub fn free(self: *Silu, a: std.mem.Allocator) void {
+        a.free(self.gu);
+        self.gu = &.{};
+    }
+
+    /// Gates in [-8, 8), ups in [-4, 4); non-finite: a NaN gate, -Inf (silu NaN) and +Inf gates, an infinite up.
+    pub fn prepare(self: *Silu, a: std.mem.Allocator, rig: *rig_.Rig, shape: c.Shape, fill: g.Fill, rng: std.Random) !bool {
+        if (shape.rows == 0 or shape.n == 0) return false;
+        self.free(a);
+        self.shape = shape;
+        const n = shape.n;
+        self.gu = try a.alloc(u16, shape.rows * 2 * n);
+        for (0..shape.rows) |r| for (0..n) |i| {
+            self.gu[r * 2 * n + i] = c.toBf16(rng.float(f32) * 16 - 8);
+            self.gu[r * 2 * n + n + i] = c.toBf16(rng.float(f32) * 8 - 4);
+        };
+        if (fill == .nonfinite) {
+            const at = [_][2]usize{ .{ 0, 3 }, .{ 1, n / 2 }, .{ 2, n - 1 }, .{ 3, 2 * n - 1 } };
+            const put = [_]f32{ ref.nan, -ref.inf, ref.inf, ref.inf };
+            for (at, put) |p, v| if (p[0] < shape.rows) {
+                self.gu[p[0] * 2 * n + p[1]] = c.toBf16(v);
+            };
+        }
+        const dev = try a.dupe(u16, self.gu);
+        defer a.free(dev);
+        if (self.swapped) for (0..shape.rows) |r| for (0..n) |i| {
+            std.mem.swap(u16, &dev[r * 2 * n + i], &dev[r * 2 * n + n + i]);
+        };
+        self.in = try ref.input(rig, dev);
+        self.out = try rig.output(shape.rows * n * 2);
+        return true;
+    }
+
+    pub fn run(self: *Silu, rig: *rig_.Rig) !void {
+        try dk.silu(self.kern, rig.s, self.in, self.out, self.shape.rows, self.shape.n);
+    }
+
+    pub fn count(self: *const Silu) usize {
+        return self.shape.rows * self.shape.n;
+    }
+
+    pub fn solve(self: *const Silu, _: std.mem.Allocator, _: Sums, out: []Iv) !void {
+        const n = self.shape.n;
+        for (0..self.shape.rows) |r| for (0..n) |i| {
+            const x = Iv.of(ref.bf(self.gu[r * 2 * n + i]));
+            const u = Iv.of(ref.bf(self.gu[r * 2 * n + n + i]));
+            out[r * n + i] = x.div(Iv.of(1).add(x.neg().exp())).mul(u).bf();
+        };
+    }
+};
+
+/// The kernel's rule, as the check below applies it independently of the kernel's loop.
+const pick_rule = "walk[j + 1]: the largest value over the ranks, the lowest id among equal values (-Inf included); " ++
+    "a NaN never wins; with every value NaN the id is 0x7fffffff";
+
+/// Drafts (a launch each) x ranks (TP=2) x 1: every rank's (value, id) 16 bytes apart.
+pub fn pickSpec(alone: bool) c.Spec {
+    const name = if (alone) "inkling2 dspark control: the pick reads rank 0's entry alone" else "inkling2 dspark tf_ink2_dsp_pick (the ranks' best into the walk)";
+    return .{ .name = name, .accum = .none, .depth = ref.noSums, .out = .raw, .nan = .{ .stated = pick_rule }, .served = &.{ .{ .rows = 7, .n = 2, .k = 1 }, .{ .rows = 1, .n = 2, .k = 1 } } };
+}
+
+const stride = 16;
+const share = 100_608; // rank 1's ids start here
+
+pub const Pick = struct {
+    kern: *const dk.Kernels,
+    /// control: launched with one rank
+    alone: bool = false,
+    shape: c.Shape = undefined,
+    vals: []f32 = &.{},
+    ids: []i32 = &.{},
+    dev: u64 = 0,
+    out: u64 = 0,
+
+    pub fn spec(self: *const Pick) c.Spec {
+        return pickSpec(self.alone);
+    }
+
+    pub fn control(self: *const Pick) ?g.Gate {
+        return if (self.alone) .shapes else null;
+    }
+
+    pub fn free(self: *Pick, a: std.mem.Allocator) void {
+        a.free(self.vals);
+        a.free(self.ids);
+        self.vals = &.{};
+        self.ids = &.{};
+    }
+
+    /// Values on quarter steps of [-2, 2) (ties between ranks), rank 1 ahead at draft 0; non-finite: each rule's case.
+    pub fn prepare(self: *Pick, a: std.mem.Allocator, rig: *rig_.Rig, shape: c.Shape, fill: g.Fill, rng: std.Random) !bool {
+        if (shape.rows == 0 or shape.n != 2) return false;
+        self.free(a);
+        self.shape = shape;
+        const m = shape.rows * 2;
+        self.vals = try a.alloc(f32, m);
+        self.ids = try a.alloc(i32, m);
+        for (self.vals, self.ids, 0..) |*v, *id, i| {
+            v.* = ref.int(rng, -8, 7) / 4;
+            id.* = @intCast(rng.uintLessThan(u32, 99_450) + (i % 2) * share);
+        }
+        self.vals[1] = self.vals[0] + 0.25;
+        if (fill == .nonfinite) {
+            const put = [_][2]f32{ .{ ref.nan, 1 }, .{ ref.inf, ref.inf }, .{ -ref.inf, -ref.inf }, .{ ref.nan, ref.nan }, .{ 0.5, ref.nan } };
+            for (put, 0..) |p, r| if (r < shape.rows) {
+                self.vals[2 * r] = p[0];
+                self.vals[2 * r + 1] = p[1];
+            };
+            if (shape.rows > 1) self.ids[2] = share + 9; // draft 1: both +Inf, rank 0's id the higher, so the lower is rank 1's
+            if (shape.rows > 1) self.ids[3] = 7;
+        }
+        const bytes = try a.alloc(u8, m * stride);
+        defer a.free(bytes);
+        @memset(bytes, 0x5a);
+        for (self.vals, self.ids, 0..) |v, id, i| {
+            std.mem.writeInt(u32, bytes[i * stride ..][0..4], @bitCast(v), .little);
+            std.mem.writeInt(i32, bytes[i * stride + 4 ..][0..4], id, .little);
+        }
+        self.dev = try rig.input(bytes);
+        self.out = try rig.output((shape.rows + 1) * 4);
+        return true;
+    }
+
+    pub fn run(self: *Pick, rig: *rig_.Rig) !void {
+        const world: usize = if (self.alone) 1 else 2;
+        for (0..self.shape.rows) |j| try dk.pick(self.kern, rig.s, self.dev + j * 2 * stride, world, self.out, j);
+    }
+
+    pub fn count(self: *const Pick) usize {
+        return (self.shape.rows + 1) * 4;
+    }
+
+    pub fn check(self: *const Pick, _: std.mem.Allocator, got: []const u8, msg: []u8) !?[]const u8 {
+        if (ref.readI32(got, 0) != -1) return "walk[0] (the anchor) was written";
+        for (0..self.shape.rows) |j| {
+            const vs = self.vals[2 * j ..][0..2];
+            const is = self.ids[2 * j ..][0..2];
+            var best: ?f32 = null;
+            for (vs) |v| if (!std.math.isNan(v)) {
+                best = if (best) |b| @max(b, v) else v;
+            };
+            var id: i32 = 0x7fffffff;
+            if (best) |b| for (vs, is) |v, k| if (v == b) {
+                id = @min(id, k);
+            };
+            const v = ref.readI32(got, j + 1);
+            if (v != id) return try std.fmt.bufPrint(msg, "draft {d}: id {d} where {d} is due", .{ j, v, id });
+        }
+        return null;
+    }
+};
diff --git a/zig/tests/cuda/contract_inkling2_dspark_head.zig b/zig/tests/cuda/contract_inkling2_dspark_head.zig
new file mode 100644
index 000000000..31572711c
--- /dev/null
+++ b/zig/tests/cuda/contract_inkling2_dspark_head.zig
@@ -0,0 +1,402 @@
+//! Inkling 2's DSpark Markov head under the contract: tf_ink2_dsp_ctx, tf_ink2_dsp_rnn and tf_ink2_dsp_vocab.
+const std = @import("std");
+const core = @import("core");
+const dk = @import("inkling2").dspark_ops;
+const rig_ = @import("contract_rig.zig");
+const ref = @import("contract_minimax_glue_ref.zig");
+
+const c = core.contract.spec;
+const g = core.contract.gates;
+const Iv = ref.Iv;
+const Sums = ref.Sums;
+
+const hidden = 4608;
+const R = 256; // the Markov rank
+const ld = 2 * R + 2 * hidden; // rnn_proj's row: [state, w1[prev], hidden, f_rnn]
+const cap: f32 = 30; // final_logit_softcapping
+const prev_rows = 4096; // w1's rows the walk's ids index (the model's: the whole vocabulary)
+
+/// tanhf (increasing), within libm_ulps.
+fn tanh(a: Iv) Iv {
+    const rel: f64 = ref.libm_ulps * 0x1p-23;
+    const lo = std.math.tanh(a.lo);
+    const hi = std.math.tanh(a.hi);
+    return .{ .m = std.math.tanh(a.m), .lo = lo - @abs(lo) * rel - 0x1p-149, .hi = hi + @abs(hi) * rel + 0x1p-149 };
+}
+
+/// w x for a bf16 w and a range of bf16 values: every product exact in fp32, so no rounding spread.
+fn scaled(x: Iv, w: f64) Iv {
+    const p = [2]f64{ x.lo * w, x.hi * w };
+    return .{ .m = x.m * w, .lo = @min(p[0], p[1]), .hi = @max(p[0], p[1]) };
+}
+
+/// A kernel's outputs in float64 against the range its fp32 steps allow, where an output may be -Inf by its rule.
+pub fn Banded(comptime K: type) type {
+    return struct {
+        const Self = @This();
+        inner: ref.Gated(K),
+        rig: *rig_.Rig = undefined,
+
+        pub fn deinit(self: *Self) void {
+            self.inner.deinit();
+        }
+
+        pub fn kernel(self: *Self) g.Kernel {
+            self.rig = &self.inner.rig;
+            return .{ .spec = self.inner.k.spec(), .ctx = self, .vt = &vt, .control = self.inner.k.control() };
+        }
+
+        const vt = g.hooks(Self);
+
+        pub fn prepare(self: *Self, shape: c.Shape, fill: g.Fill, seed: u64) !bool {
+            return self.inner.prepare(shape, fill, seed);
+        }
+
+        pub fn run(self: *Self) !void {
+            try self.inner.run();
+        }
+
+        pub fn count(self: *Self) usize {
+            return self.inner.count();
+        }
+
+        pub fn reference(self: *Self, want: []f64, mag: []f64) !void {
+            try self.inner.reference(want, mag);
+        }
+
+        pub fn bounds(self: *Self, want: []const f64, mag: []const f64, allow: []f64) !void {
+            try self.inner.bounds(want, mag, allow);
+        }
+
+        pub fn simulate(self: *Self, acc: c.Accum, order: g.Order, out: []f64) !void {
+            try self.inner.simulate(acc, order, out);
+        }
+    };
+}
+
+/// A lane's chain over the 2 x hidden inputs (a warp an output), the warp's 5 shuffles, the bias.
+fn ctxDepth(s: c.Shape) usize {
+    return (s.k + 31) / 32 + 5;
+}
+
+/// Rows (a block's 7 drafting rows) x 3R outputs x 2 hidden inputs: rnn_proj's last columns on [hidden_row, f_rnn].
+pub fn ctxSpec(early: bool) c.Spec {
+    const served = &[_]c.Shape{ .{ .rows = 7, .n = 3 * R, .k = 2 * hidden }, .{ .rows = 1, .n = 3 * R, .k = 2 * hidden }, .{ .rows = 8, .n = 3 * R, .k = 2 * hidden } };
+    const name = if (early) "inkling2 dspark control: the Markov context reads rnn_proj from column 0" else "inkling2 dspark tf_ink2_dsp_ctx (bias + rnn_proj[:, 2R:] . [hidden, f_rnn])";
+    return .{ .name = name, .accum = .f32, .depth = ctxDepth, .out = .f32, .served = served, .sums = .{} };
+}
+
+pub const Ctx = struct {
+    kern: *const dk.Kernels,
+    /// control: the device's weight pointer 2R columns early, so it reads rnn_proj[:, 0:2C]
+    early: bool = false,
+    shape: c.Shape = undefined,
+    h: []u16 = &.{},
+    frnn: []u16 = &.{},
+    w: []u16 = &.{},
+    bias: []u16 = &.{},
+    in: [4]u64 = @splat(0),
+    out: u64 = 0,
+
+    pub const sums = {};
+
+    pub fn spec(self: *const Ctx) c.Spec {
+        return ctxSpec(self.early);
+    }
+
+    pub fn control(self: *const Ctx) ?g.Gate {
+        return if (self.early) .shapes else null;
+    }
+
+    pub fn free(self: *Ctx, a: std.mem.Allocator) void {
+        inline for (.{ "h", "frnn", "w", "bias" }) |f| {
+            a.free(@field(self, f));
+            @field(self, f) = &.{};
+        }
+    }
+
+    /// Weights in [-0.5, 0.5), rows in [-2, 2); stress: integers to 15, f_rnn cancelling the rows one place apart.
+    pub fn prepare(self: *Ctx, a: std.mem.Allocator, rig: *rig_.Rig, shape: c.Shape, fill: g.Fill, rng: std.Random) !bool {
+        if (shape.rows == 0 or shape.rows > 8 or shape.n != 3 * R or shape.k != 2 * hidden) return false;
+        self.free(a);
+        self.shape = shape;
+        const rows = shape.rows;
+        self.h = try ref.bfs(a, rng, rows * hidden, -2, 2);
+        self.frnn = try ref.bfs(a, rng, hidden, -2, 2);
+        self.w = try ref.bfs(a, rng, 3 * R * ld, -0.5, 0.5);
+        self.bias = try ref.bfs(a, rng, 3 * R, -1, 1);
+        if (fill == .stress) {
+            for (0..hidden) |k| {
+                const v = ref.int(rng, 1, 15);
+                for (0..rows) |r| self.h[r * hidden + k] = c.toBf16(v);
+                self.frnn[(k + 1) % hidden] = c.toBf16(-v + @as(f32, if (k < 2) 1 else 0));
+            }
+            for (0..3 * R) |o| for (0..hidden) |k| {
+                const v = ref.int(rng, 1, 15);
+                self.w[o * ld + 2 * R + k] = c.toBf16(v);
+                self.w[o * ld + 2 * R + hidden + (k + 1) % hidden] = c.toBf16(v);
+            };
+        }
+        if (fill == .nonfinite) {
+            self.h[11] = c.toBf16(ref.nan); // row 0: every output NaN
+            self.h[hidden + 7] = c.toBf16(ref.inf);
+            self.h[3 * hidden - 1] = c.toBf16(-ref.inf);
+            self.bias[5] = c.toBf16(ref.nan); // output 5 NaN on every row
+        }
+        self.in = .{ try ref.input(rig, self.h), try ref.input(rig, self.frnn), try ref.input(rig, self.w), try ref.input(rig, self.bias) };
+        self.out = try rig.output(rows * 3 * R * 4);
+        return true;
+    }
+
+    pub fn run(self: *Ctx, rig: *rig_.Rig) !void {
+        const w = self.in[2] - @as(u64, if (self.early) 2 * R * 2 else 0);
+        try dk.ctx(self.kern, rig.s, self.in[0], self.in[1], w, self.in[3], self.out, self.shape.rows, hidden, R);
+    }
+
+    pub fn count(self: *const Ctx) usize {
+        return self.shape.rows * 3 * R;
+    }
+
+    pub fn solve(self: *const Ctx, a: std.mem.Allocator, s: Sums, out: []Iv) !void {
+        const terms = try a.alloc(Iv, 2 * hidden);
+        defer a.free(terms);
+        const scratch = try a.alloc(f64, 2 * hidden);
+        defer a.free(scratch);
+        for (0..self.shape.rows) |r| for (0..3 * R) |o| {
+            const w = self.w[o * ld + 2 * R ..][0 .. 2 * hidden];
+            for (terms[0..hidden], w[0..hidden], self.h[r * hidden ..][0..hidden]) |*t, x, y| t.* = Iv.of(ref.bf(x) * ref.bf(y));
+            for (terms[hidden..], w[hidden..], self.frnn) |*t, x, y| t.* = Iv.of(ref.bf(x) * ref.bf(y));
+            out[r * 3 * R + o] = s.sum(terms, ctxDepth(self.shape), scratch).add(Iv.of(ref.bf(self.bias[o])));
+        };
+    }
+};
+
+/// A lane's 16 products of the 2R inputs, the warp's 5 shuffles, then ctx.
+fn rnnDepth(_: c.Shape) usize {
+    return 16 + 5;
+}
+
+/// Steps (one launch each, the state carried) x R x 2R: one step (gate 4's exact sums), a block's 7.
+pub fn rnnSpec(late: bool) c.Spec {
+    const served = &[_]c.Shape{ .{ .rows = 1, .n = R, .k = 2 * R }, .{ .rows = 7, .n = R, .k = 2 * R } };
+    const name = if (late) "inkling2 dspark control: the recurrence reads the walk one pick late" else "inkling2 dspark tf_ink2_dsp_rnn (a GRU-style step at the bf16 points)";
+    return .{ .name = name, .accum = .f32, .depth = rnnDepth, .out = .bf16, .in_place = true, .served = served, .sums = .{} };
+}
+
+/// Each step: raw = ctx + rnn_proj[:, :2R] . [state, w1[walk[j]]], the gates at bf16, the state in place, the latent.
+pub const Rnn = struct {
+    kern: *const dk.Kernels,
+    /// control: launched on the walk one entry on, so each step reads the next pick's w1 row
+    late: bool = false,
+    shape: c.Shape = undefined,
+    ctx: []f32 = &.{},
+    w: []u16 = &.{},
+    w1: []u16 = &.{},
+    walk: []i32 = &.{},
+    state: []u16 = &.{},
+    in: [4]u64 = @splat(0),
+    st: u64 = 0,
+    out: u64 = 0,
+
+    pub const sums = {};
+
+    pub fn spec(self: *const Rnn) c.Spec {
+        return rnnSpec(self.late);
+    }
+
+    pub fn control(self: *const Rnn) ?g.Gate {
+        return if (self.late) .shapes else null;
+    }
+
+    pub fn free(self: *Rnn, a: std.mem.Allocator) void {
+        inline for (.{ "ctx", "w", "w1", "walk", "state" }) |f| {
+            a.free(@field(self, f));
+            @field(self, f) = &.{};
+        }
+    }
+
+    /// ctx in [-2, 2), weights in [-0.1, 0.1), state and w1 in [-1, 1); stress: integers, w1 cancelling the state.
+    pub fn prepare(self: *Rnn, a: std.mem.Allocator, rig: *rig_.Rig, shape: c.Shape, fill: g.Fill, rng: std.Random) !bool {
+        if (shape.rows == 0 or shape.n != R or shape.k != 2 * R) return false;
+        self.free(a);
+        self.shape = shape;
+        const steps = shape.rows;
+        self.ctx = try ref.f32s(a, rng, steps * 3 * R, -2, 2);
+        self.w = try ref.bfs(a, rng, 3 * R * ld, -0.1, 0.1);
+        self.w1 = try ref.bfs(a, rng, prev_rows * R, -1, 1);
+        self.state = try ref.bfs(a, rng, R, -1, 1);
+        self.walk = try a.alloc(i32, steps + 1);
+        for (self.walk) |*p| p.* = @intCast(rng.uintLessThan(u32, prev_rows));
+        if (fill == .stress) {
+            const prev: usize = @intCast(self.walk[0]);
+            for (0..R) |k| {
+                const v = ref.int(rng, 1, 64);
+                self.state[k] = c.toBf16(v);
+                self.w1[prev * R + (k + 1) % R] = c.toBf16(-v + @as(f32, if (k == 0) 1 else 0));
+            }
+            for (0..3 * R) |o| for (0..R) |k| {
+                const v = if (k == 0) ref.int(rng, 1, 2) else ref.int(rng, 1, 64); // raw = w[o][0] + ctx: unsaturated
+                self.w[o * ld + k] = c.toBf16(v);
+                self.w[o * ld + R + (k + 1) % R] = c.toBf16(v);
+            };
+            for (self.ctx) |*v| v.* = ref.int(rng, -2, 2);
+        }
+        if (fill == .nonfinite) {
+            self.ctx[5] = ref.nan; // step 0's gate 5: the state's element 5 NaN, then every later output
+            self.ctx[R + 9] = -ref.inf; // a candidate tanh(-inf) = -1
+            self.ctx[2 * R + 7] = ref.inf; // a latent tanh(inf) = 1
+        }
+        self.in = .{ try ref.input(rig, self.ctx), try ref.input(rig, self.w), try ref.input(rig, self.w1), try ref.input(rig, self.walk) };
+        self.st = try rig.output(R * 2);
+        self.out = try rig.output(steps * R * 2);
+        return true;
+    }
+
+    pub fn run(self: *Rnn, rig: *rig_.Rig) !void {
+        try ref.restore(rig, self.st, std.mem.sliceAsBytes(self.state)); // read and written in place: every run the same pass
+        const walk = self.in[3] + @as(u64, @intFromBool(self.late)) * 4;
+        for (0..self.shape.rows) |j| try dk.rnn(self.kern, rig.s, self.in[0] + j * 3 * R * 4, self.in[1], self.in[2], walk, j, self.st, self.out + j * R * 2, R, hidden);
+    }
+
+    pub fn count(self: *const Rnn) usize {
+        return (1 + self.shape.rows) * R;
+    }
+
+    pub fn solve(self: *const Rnn, _: std.mem.Allocator, s: Sums, out: []Iv) !void {
+        var st: [R]Iv = undefined;
+        var terms: [2 * R]Iv = undefined;
+        var raw: [3 * R]Iv = undefined;
+        var scratch: [2 * R]f64 = undefined;
+        for (&st, self.state) |*v, x| v.* = Iv.of(ref.bf(x));
+        for (0..self.shape.rows) |j| {
+            const prev: usize = @intCast(self.walk[j]);
+            for (&raw, 0..) |*o, i| {
+                const w = self.w[i * ld ..][0 .. 2 * R];
+                for (terms[0..R], w[0..R], st) |*t, x, y| t.* = scaled(y, ref.bf(x));
+                for (terms[R..], w[R..], self.w1[prev * R ..][0..R]) |*t, x, y| t.* = Iv.of(ref.bf(x) * ref.bf(y));
+                o.* = s.sum(&terms, rnnDepth(self.shape), &scratch).add(Iv.of(self.ctx[j * 3 * R + i]));
+            }
+            const lat = out[R + j * R ..][0..R];
+            for (0..R) |i| {
+                const gate = raw[i].bf().sigmoid().bf();
+                const cand = tanh(raw[R + i].bf()).bf();
+                const keep = gate.mul(st[i]).bf();
+                const upd = Iv.of(1).sub(gate).bf().mul(cand).bf();
+                st[i] = keep.add(upd).bf();
+                lat[i] = tanh(raw[2 * R + i].bf()).bf();
+            }
+        }
+        @memcpy(out[0..R], &st);
+    }
+};
+
+/// A lane's 8 products of the rank-256 dot, the warp's 5 shuffles.
+fn vocabDepth(_: c.Shape) usize {
+    return 8 + 5;
+}
+
+/// TP=2's vocabulary shares: rank 0 holds 100,608 real rows, rank 1 100,480 rows of which 99,450 are real.
+fn validOf(n: usize) usize {
+    return if (n == 100_480) 99_450 else n;
+}
+
+/// Steps (one launch each) x the rank's vocabulary rows x the rank-256 latent.
+pub fn vocabSpec(short: bool) c.Spec {
+    const served = &[_]c.Shape{ .{ .rows = 7, .n = 100_608, .k = R }, .{ .rows = 1, .n = 100_480, .k = R }, .{ .rows = 2, .n = 3000, .k = R } };
+    const name = if (short) "inkling2 dspark control: the vocabulary's last real row taken as padding" else "inkling2 dspark tf_ink2_dsp_vocab (softcap(base + fold . latent), -Inf past the real rows)";
+    return .{ .name = name, .accum = .f32, .depth = vocabDepth, .out = .f32, .served = served, .sums = .{} };
+}
+
+/// out = softcap(bf16(base + bf16(fold_bias + fold . latent))) at bf16, -inf at padding rows.
+pub const Vocab = struct {
+    kern: *const dk.Kernels,
+    /// control: launched with one real row fewer
+    short: bool = false,
+    shape: c.Shape = undefined,
+    base: []u16 = &.{},
+    latent: []u16 = &.{},
+    fold: []u16 = &.{},
+    fbias: []u16 = &.{},
+    in: [4]u64 = @splat(0),
+    out: u64 = 0,
+
+    pub const sums = {};
+
+    pub fn spec(self: *const Vocab) c.Spec {
+        return vocabSpec(self.short);
+    }
+
+    pub fn control(self: *const Vocab) ?g.Gate {
+        return if (self.short) .shapes else null;
+    }
+
+    pub fn free(self: *Vocab, a: std.mem.Allocator) void {
+        inline for (.{ "base", "latent", "fold", "fbias" }) |f| {
+            a.free(@field(self, f));
+            @field(self, f) = &.{};
+        }
+    }
+
+    /// Base logits in [-40, 40) (past the cap), latents and fold in [-1, 1); stress: integers, halves cancelling.
+    pub fn prepare(self: *Vocab, a: std.mem.Allocator, rig: *rig_.Rig, shape: c.Shape, fill: g.Fill, rng: std.Random) !bool {
+        if (shape.rows == 0 or shape.n == 0 or shape.k != R) return false;
+        self.free(a);
+        self.shape = shape;
+        const n = shape.n;
+        const steps = shape.rows;
+        self.base = try ref.bfs(a, rng, steps * n, -40, 40);
+        self.latent = try ref.bfs(a, rng, steps * R, -1, 1);
+        self.fold = try ref.bfs(a, rng, n * R, -1, 1);
+        self.fbias = try ref.bfs(a, rng, n, -2, 2);
+        if (fill == .stress) {
+            for (self.base) |*v| v.* = c.toBf16(ref.int(rng, -4, 4));
+            for (self.fbias) |*v| v.* = c.toBf16(ref.int(rng, -4, 4));
+            for (0..steps) |j| for (0..R / 2) |k| {
+                const v = ref.int(rng, 1, 64);
+                self.latent[j * R + k] = c.toBf16(v);
+                self.latent[j * R + R / 2 + (k + 1) % (R / 2)] = c.toBf16(-v + @as(f32, if (k == 0) 1 else 0));
+            };
+            for (0..n) |v| for (0..R / 2) |k| {
+                const x = if (k == 0) ref.int(rng, 1, 4) else ref.int(rng, 1, 64); // the dot fold[v][0]: below the cap's knee
+                self.fold[v * R + k] = c.toBf16(x);
+                self.fold[v * R + R / 2 + (k + 1) % (R / 2)] = c.toBf16(x);
+            };
+        }
+        if (fill == .nonfinite) {
+            self.fold[3 * R + 17] = c.toBf16(ref.nan); // row 3: NaN at every step
+            self.base[5] = c.toBf16(ref.inf); // step 0, row 5: tanh(inf) cap = 30
+            self.fbias[7] = c.toBf16(-ref.inf); // row 7: -30 at every step
+            if (steps > 1) self.latent[R + 9] = c.toBf16(ref.nan); // step 1: every real row NaN
+        }
+        self.in = .{ try ref.input(rig, self.base), try ref.input(rig, self.latent), try ref.input(rig, self.fold), try ref.input(rig, self.fbias) };
+        self.out = try rig.output(steps * n * 4);
+        return true;
+    }
+
+    pub fn run(self: *Vocab, rig: *rig_.Rig) !void {
+        const n = self.shape.n;
+        const valid = validOf(n) - @intFromBool(self.short);
+        for (0..self.shape.rows) |j| try dk.vocab(self.kern, rig.s, self.in[0] + j * n * 2, self.in[1] + j * R * 2, self.in[2], self.in[3], cap, valid, n, self.out + j * n * 4);
+    }
+
+    pub fn count(self: *const Vocab) usize {
+        return self.shape.rows * self.shape.n;
+    }
+
+    pub fn solve(self: *const Vocab, _: std.mem.Allocator, s: Sums, out: []Iv) !void {
+        const n = self.shape.n;
+        const valid = validOf(n);
+        var terms: [R]Iv = undefined;
+        var scratch: [R]f64 = undefined;
+        for (0..self.shape.rows) |j| for (0..n) |v| {
+            if (v >= valid) {
+                out[j * n + v] = Iv.of(-std.math.inf(f64));
+                continue;
+            }
+            for (&terms, self.latent[j * R ..][0..R], self.fold[v * R ..][0..R]) |*t, x, y| t.* = Iv.of(ref.bf(x) * ref.bf(y));
+            const b = s.sum(&terms, vocabDepth(self.shape), &scratch).add(Iv.of(ref.bf(self.fbias[v]))).bf();
+            const x = Iv.of(ref.bf(self.base[j * n + v])).add(b).bf();
+            out[j * n + v] = tanh(x.div(Iv.of(cap))).mul(Iv.of(cap)).bf();
+        };
+    }
+};
