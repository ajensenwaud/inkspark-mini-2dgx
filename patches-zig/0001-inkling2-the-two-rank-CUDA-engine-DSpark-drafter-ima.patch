+//! Inkling 2's lane backend: a slot per stream, decode windows shared across streams in one forward, chunked prompts.
+const std = @import("std");
+const lanes = @import("lanes");
+const engine = @import("engine.zig");
+const follow = @import("follow.zig");
+const image = @import("image.zig");
+const pictures = @import("pictures.zig");
+
+const be = lanes.backend;
+
+/// First tokens a handle names.
+const ring = 1024;
+pub const max_rows = engine.window_rows;
+
+/// Forward ms of a lone window by rows at TP=2 on two GB10s (graphed, medians of 16).
+const gb10_window_costs = [_]lanes.config.Cost{
+    .{ .width = 1, .ms = 31.8 }, .{ .width = 2, .ms = 38.7 }, .{ .width = 3, .ms = 45.1 }, .{ .width = 4, .ms = 52.0 },
+    .{ .width = 5, .ms = 56.6 }, .{ .width = 6, .ms = 61.0 }, .{ .width = 7, .ms = 66.9 }, .{ .width = 8, .ms = 69.8 },
+};
+/// Shared forwards by total rows, the dearer split where streams x rows differ (interpolated between).
+const gb10_shared_costs = [_]lanes.config.Cost{
+    .{ .width = 1, .ms = 31.8 },   .{ .width = 2, .ms = 41.3 },   .{ .width = 4, .ms = 61.8 },
+    .{ .width = 8, .ms = 81.4 },   .{ .width = 16, .ms = 120.6 }, .{ .width = 32, .ms = 182.3 },
+    .{ .width = 64, .ms = 223.4 },
+};
+
+/// A stream's place in the backend: its slot, the rows its last window left uncommitted, its first token.
+const Lane = struct {
+    slot: u32,
+    pending_rows: ?usize = null,
+    first: ?u64 = null,
+    fill: ?usize = null, // a prompt pass going a chunk at a time: where its next chunk starts
+    held: [max_held]u32 = undefined, // the drafter's block for the next window
+    held_n: usize = 0,
+    pictures: bool = false, // an image prompt: never resumed from or kept in the prompt cache
+};
+
+/// A DSpark block's drafts at most.
+const max_held = engine.window_rows - 1;
+
+pub const Lanes = struct {
+    x: follow.Leader,
+    lanes: std.AutoHashMapUnmanaged(*const lanes.Stream, Lane) = .empty,
+    drawn: [ring]u32 = undefined,
+    next: u64 = 0,
+    shared: u64 = 0, // forwards that held several streams' windows
+
+    pub fn deinit(self: *Lanes) void {
+        self.lanes.deinit(self.x.e.gpa);
+        self.x.deinit();
+    }
+
+    pub fn backend(self: *Lanes) be.Backend {
+        return .{ .ptr = self, .vtable = &vt };
+    }
+
+    const vt: be.Backend.VTable = .{
+        .prefill = prefillFn,
+        .prefill_step = prefillStepFn,
+        .cancel_prefill = cancelPrefillFn,
+        .first = firstFn,
+        .queue = queueFn,
+        .read = readFn,
+        .verify = verifyFn,
+        .keep = keepFn,
+        .draft = draftFn,
+        .held = heldFn,
+        .release = releaseFn,
+    };
+
+    /// Round facts: DSpark's blocks when the pack holds the drafter, several streams' rows in one shared forward.
+    pub fn facts(self: *const Lanes) lanes.Model {
+        const head = self.x.e.drafter != null;
+        return .{
+            .copy_drafts = false,
+            .exact_width = max_rows,
+            .gpu_tokens = false,
+            .mtp = head,
+            .speculate = head, // a block drafts from the rows a verify kept (their taps)
+            .speculate_early = false,
+            .drafts = if (head) max_held else 0,
+            .draft_streams = head,
+            .mtp_step_ms = if (head) 16.4 / @as(f64, max_held) else 0, // a block's 7 drafts in one pass (16.4 ms timed)
+            .draft_step_ms = if (head) 15.9 else 0, // a shared round's block pass, a stream at a time (127.1 ms for 8)
+            .plain_streams = if (head) 2 else 0, // passes run a stream at a time: shared rounds draft none
+            .plain_guard = head, // plain rounds compete: one-row forwards are cheap next to a draft pass
+            .window_costs = if (head) &gb10_window_costs else &.{},
+            .window_costs_lone = true,
+            .shared_costs = if (head) &gb10_shared_costs else &.{},
+            .hidden_rows = true,
+            .batch_rows = engine.shared_rows,
+            .max_streams = engine.max_shared,
+        };
+    }
+
+    fn of(ptr: *anyopaque) *Lanes {
+        return @ptrCast(@alignCast(ptr));
+    }
+
+    fn take(self: *Lanes, token: u32) u64 {
+        const h = self.next;
+        self.drawn[h % ring] = token;
+        self.next += 1;
+        return h;
+    }
+
+    fn taken(self: *const Lanes, slot: usize) bool {
+        var it = self.lanes.valueIterator();
+        while (it.next()) |l| if (l.slot == slot) return true;
+        return false;
+    }
+
+    /// A free slot: the kept state's when it is free, else the free one holding the fewest kept states.
+    fn pick(self: *const Lanes, s: *const lanes.Stream) !u32 {
+        if (s.reuse.saved) |saved| {
+            const k: *const follow.Kept = @ptrCast(@alignCast(saved));
+            if (self.x.e.states.where(k.id)) |w| if (!self.taken(w.slot)) return @intCast(w.slot);
+        }
+        var best: ?u32 = null;
+        var held: usize = std.math.maxInt(usize);
+        for (0..self.x.e.slotCount()) |i| {
+            if (self.taken(i)) continue;
+            const n = self.x.e.states.on(i);
+            if (n < held) {
+                held = n;
+                best = @intCast(i);
+            }
+        }
+        return best orelse error.NoFreeSlot;
+    }
+
+    /// The stream's slot bound, its last window committed (`kept` rows, else all of them).
+    fn bind(self: *Lanes, s: *const lanes.Stream, kept: ?usize) !*Lane {
+        const l = self.lanes.getPtr(s) orelse return error.UnknownStream;
+        try self.x.bind(l.slot);
+        if (l.pending_rows) |rows| try self.x.keep(kept orelse rows);
+        l.pending_rows = null;
+        return l;
+    }
+
+    fn cancelled(ptr: ?*anyopaque) bool {
+        return @as(*lanes.Stream, @ptrCast(@alignCast(ptr.?))).isCancelled();
+    }
+
+    /// A prompt pass begins: the stream's slot claimed and bound; where it resumes (a kept state in this slot).
+    fn opening(self: *Lanes, s: *lanes.Stream) !?follow.Kept {
+        const ids = s.prompt();
+        if (ids.len + s.max_new + max_rows >= self.x.e.capacity) return error.PromptTooLong;
+        if (s.images.len > 0 and self.x.e.vision == null) return error.NoVision;
+        const gop = try self.lanes.getOrPut(self.x.e.gpa, s);
+        if (!gop.found_existing) gop.value_ptr.* = .{ .slot = try self.pick(s) };
+        const l = gop.value_ptr;
+        l.pending_rows = null;
+        l.fill = null;
+        l.first = null;
+        l.held_n = 0;
+        l.pictures = s.images.len > 0;
+        errdefer _ = self.lanes.remove(s);
+        try self.x.bind(l.slot);
+        try self.x.begin(s.sampling);
+        s.cached = 0;
+        if (l.pictures) {
+            // every picture shares the placeholder id, so a kept state cannot tell two pictures apart
+            var pics: [64]image.Prepared = undefined;
+            const spans = try pictures.fromRequest(self.x.e.gpa, ids, s.images, &pics);
+            defer self.x.e.gpa.free(spans);
+            try self.x.images(pics[0..s.images.len], spans);
+            return null;
+        }
+        return if (s.prompt_logprobs != null) null else self.resumeFrom(s, ids.len, l.slot);
+    }
+
+    /// The stream's kept state, where its pass starts (null: none, off the grid, another slot's, or overwritten).
+    fn resumeFrom(self: *Lanes, s: *lanes.Stream, len: usize, slot: u32) ?follow.Kept {
+        const saved = s.reuse.saved orelse return null;
+        const k: *const follow.Kept = @ptrCast(@alignCast(saved));
+        const w = self.x.e.states.where(k.id);
+        if (k.at != s.reuse.at or k.at == 0 or k.at >= len or k.at % engine.prompt_rows != 0 or w == null or w.?.slot != slot) {
+            s.reuse_failed = true;
+            s.reuse_error = if (k.at == 0 or k.at >= len) error.SnapshotNotPrefix else if (k.at != s.reuse.at or k.at % engine.prompt_rows != 0) error.SnapshotOutOfStep else error.SnapshotStale;
+            return null;
+        }
+        s.cached = k.at;
+        return k.*;
+    }
+
+    /// The prompt pass stands at `at` (a chunk start): the store keeps the state there when it marked it.
+    fn mark(s: *lanes.Stream, at: usize) void {
+        if (at == 0) return;
+        const hook = s.reuse.hook orelse return;
+        if (std.mem.indexOfScalar(u32, s.reuse.marks, @intCast(at)) == null) return;
+        hook.at(hook.ptr, s, @intCast(at));
+    }
+
+    fn prefillFn(ptr: *anyopaque, s: *lanes.Stream) anyerror!void {
+        const self = of(ptr);
+        const from = try self.opening(s);
+        var at: usize = if (from) |r| r.at else 0;
+        var resume_id: ?u64 = if (from) |r| r.id else null;
+        const keeps = !self.lanes.getPtr(s).?.pictures;
+        while (true) : (at += engine.prompt_rows) {
+            if (resume_id == null and keeps) mark(s, at);
+            if (try self.x.chunk(s.prompt(), at, resume_id, .{ .ptr = s, .check = cancelled })) |first| {
+                self.lanes.getPtr(s).?.first = self.take(first);
+                return;
+            }
+            resume_id = null;
+        }
+    }
+
+    /// One chunk of the stream's prompt pass (other rounds run between); true once the first token is drawn.
+    fn prefillStepFn(ptr: *anyopaque, s: *lanes.Stream, _: u32) anyerror!bool {
+        const self = of(ptr);
+        const going: ?usize = if (self.lanes.getPtr(s)) |l| l.fill else null;
+        const from = if (going == null) try self.opening(s) else null;
+        const l = self.lanes.getPtr(s).?;
+        if (going != null) try self.x.bind(l.slot);
+        const at = going orelse if (from) |r| r.at else 0;
+        errdefer l.fill = null;
+        if (from == null and !l.pictures) mark(s, at);
+        if (try self.x.chunk(s.prompt(), at, if (from) |r| r.id else null, .{ .ptr = s, .check = cancelled })) |first| {
+            l.first = self.take(first);
+            l.fill = null;
+            return true;
+        }
+        l.fill = at + engine.prompt_rows;
+        return false;
+    }
+
+    fn cancelPrefillFn(ptr: *anyopaque, s: *lanes.Stream) !void {
+        const l = of(ptr).lanes.getPtr(s) orelse return;
+        l.fill = null;
+    }
+
+    fn firstFn(ptr: *anyopaque, s: *lanes.Stream, position: u64) anyerror!u64 {
+        if (position != s.prompt_len) return error.PositionMismatch;
+        const l = of(ptr).lanes.getPtr(s) orelse return error.UnknownStream;
+        return l.first orelse error.NoFirstToken;
+    }
+
+    fn queueFn(ptr: *anyopaque, s: *lanes.Stream, feed: be.Feed, position: u64) anyerror!u64 {
+        _ = ptr;
+        _ = s;
+        _ = feed;
+        _ = position;
+        return error.NotPipelined;
+    }
+
+    fn readFn(ptr: *anyopaque, handle: u64) anyerror!u32 {
+        const self = of(ptr);
+        if (handle >= self.next or self.next - handle > ring) return error.NoSuchToken;
+        return self.drawn[handle % ring];
+    }
+
+    /// A round's windows in one forward (Engine.verifyShared), one window or several.
+    fn verifyFn(ptr: *anyopaque, windows: []const be.Window, out: []be.Verified) anyerror!void {
+        const self = of(ptr);
+        if (windows.len > engine.max_shared) return error.WindowTooWide;
+        var parts: [engine.max_shared]engine.Part = undefined;
+        var ids: [engine.max_shared][max_rows]u32 = undefined;
+        var sampled: [engine.max_shared][max_rows]u32 = undefined;
+        var lane: [engine.max_shared]*Lane = undefined;
+        for (windows, 0..) |w, k| {
+            if (w.parents != null) return error.TreesNotBuilt;
+            if (w.masks.len > 0) return error.Inkling2NoGrammar;
+            const l = try self.bind(w.stream, null);
+            if (w.held > l.held_n) return error.NoHeldDrafts;
+            const rows = w.rows();
+            if (rows > max_rows) return error.WindowTooWide;
+            const pos = self.x.e.pos();
+            for (w.positions, 0..) |p, r| if (p != pos + 1 + r) return error.PositionMismatch;
+            ids[k][0] = w.pending;
+            const drafts = if (w.held > 0) l.held[0..w.held] else w.tokens;
+            @memcpy(ids[k][1..][0..drafts.len], drafts);
+            parts[k] = .{ .slot = l.slot, .ids = ids[k][0..rows], .out = sampled[k][0..rows] };
+            lane[k] = l;
+        }
+        try self.x.verifyShared(parts[0..windows.len]);
+        if (windows.len > 1) self.shared += 1;
+        for (out[0..windows.len], parts[0..windows.len], lane[0..windows.len]) |*o, p, l| {
+            const rows = p.ids.len;
+            @memcpy(o.sampled[0..rows], p.out);
+            @memcpy(o.drafts[0 .. rows - 1], p.ids[1..rows]);
+            l.pending_rows = rows;
+        }
+    }
+
+    fn keepFn(ptr: *anyopaque, windows: []const be.Window, paths: []const []const u32) anyerror!void {
+        const self = of(ptr);
+        for (windows, paths) |w, path| {
+            if (path.len == 0) return error.EmptyPath;
+            for (path, 0..) |r, i| if (r != i) return error.TreesNotBuilt;
+            _ = try self.bind(w.stream, path.len);
+        }
+    }
+
+    /// DSpark: every request's kept rows committed, then one block round for them all (the ranks' block step).
+    fn draftFn(ptr: *anyopaque, requests: []const be.DraftRequest) anyerror!void {
+        const self = of(ptr);
+        if (self.x.e.drafter == null) return error.NoDraftHead;
+        if (requests.len > engine.max_shared) return error.TooManyStreams;
+        var reqs: [engine.max_shared]engine.Req = undefined;
+        var held: [engine.max_shared]*Lane = undefined;
+        for (requests, 0..) |r, i| {
+            const l = try self.bind(r.stream, if (r.rows) |rows| rows.len else null);
+            if (r.position != self.x.e.pos() + 1) return error.PositionMismatch;
+            if (r.lanes != null) return error.TreesNotBuilt;
+            var n: usize = 0;
+            const anchor = if (r.rows) |rows| a: {
+                for (rows, 0..) |row, j| if (row != j) return error.TreesNotBuilt;
+                n = rows.len;
+                break :a r.follow[rows.len - 1];
+            } else self.value(r.first orelse return error.NoFirstToken);
+            const depth = @min(r.depth, max_held);
+            reqs[i] = .{ .slot = l.slot, .n = @intCast(n), .anchor = anchor, .out = l.held[0..depth] };
+            held[i] = l;
+        }
+        if (requests.len == 0) return;
+        try self.x.block(reqs[0..requests.len]);
+        for (requests, held[0..requests.len]) |r, l| l.held_n = @min(r.depth, max_held);
+    }
+
+    fn value(self: *const Lanes, feed: be.Feed) u32 {
+        return switch (feed) {
+            .handle => |h| self.drawn[h % ring],
+            .value => |v| v,
+        };
+    }
+
+    /// The drafter's block for the stream's next window, as held.
+    fn heldFn(ptr: *anyopaque, s: *lanes.Stream, out: []u32) anyerror!void {
+        const l = of(ptr).lanes.getPtr(s) orelse return error.UnknownStream;
+        if (out.len > l.held_n) return error.NoHeldDrafts;
+        @memcpy(out, l.held[0..out.len]);
+    }
+
+    /// The stream left the rounds: its slot is free (its rows stay for the states kept there).
+    fn releaseFn(ptr: *anyopaque, s: *lanes.Stream) void {
+        const self = of(ptr);
+        const kv = self.lanes.fetchRemove(s) orelse return;
+        self.x.release(kv.value.slot) catch |err| std.log.err("releasing slot {d}: {s}", .{ kv.value.slot, @errorName(err) });
+        if (self.lanes.count() == 0) self.x.idle() catch |err| std.log.err("the other ranks' idle step: {s}", .{@errorName(err)});
+    }
+};
diff --git a/zig/src/families/inkling2/native.zig b/zig/src/families/inkling2/native.zig
new file mode 100644
index 000000000..9518b3e35
--- /dev/null
+++ b/zig/src/families/inkling2/native.zig
@@ -0,0 +1,269 @@
+//! Inkling 2 native CUDA at TP=2 (TF_INKLING2_RANK, TF_INKLING2_WORLD, NCCL_COMM_ID): rank 0 serves, rank 1 follows.
+const std = @import("std");
+const cuda = @import("cuda");
+const lanes = @import("lanes");
+const core = @import("core");
+const cfg = @import("shape.zig");
+const admission = @import("admit.zig");
+const shard = @import("shard.zig");
+const engine = @import("engine.zig");
+const follow = @import("follow.zig");
+const ink_lanes = @import("lanes.zig");
+const dspark = @import("dspark.zig");
+const pictures = @import("pictures.zig");
+const tower = @import("vision.zig");
+
+pub const model_type = "inkling2";
+pub const formats: []const []const u8 = &.{"exl3"};
+/// The model's native window: no rope, so 1M is served as trained.
+pub const default_context: i64 = 1048576;
+pub const max_segments: u32 = 1;
+pub const prompt_rows: u32 = engine.prompt_rows;
+/// Kept prompt states are taken where a prompt chunk starts.
+pub const snap_grid: u32 = prompt_rows;
+pub const window_rows: u32 = engine.window_rows;
+pub const explains_open = true;
+
+/// The server's reading of this rank's room after its load (the budget streams are admitted by); null if unreadable.
+pub const Room = struct { ctx: *anyopaque, read: *const fn (*anyopaque) ?u64 };
+pub const Options = struct {
+    context: usize,
+    drafts: bool,
+    segments: usize = 1,
+    slide: bool = false,
+    room: ?Room = null,
+    vision: ?pictures.Limits = null, // --vision on every rank: rank 0's tower, every rank's image rows
+};
+/// A request's visual tokens in all unless --vision-image-tokens says otherwise.
+pub const default_image_tokens: u32 = pictures.default_image_tokens;
+/// The smallest room among the other ranks and whose it is.
+pub const Peer = struct { bytes: u64, rank: usize };
+
+pub const Loaded = struct {
+    backend: lanes.backend.Backend,
+    facts: lanes.Model,
+    rows: u32,
+    stream_bytes: usize,
+    free_streams: u32 = 0, // every slot's caches are made by `reserve`, after admission
+    ctx: *anyopaque,
+    deinit: *const fn (*anyopaque) void,
+    reserve: *const fn (*anyopaque, u32) anyerror!void,
+    peer_room: ?Peer = null,
+    target: *anyopaque, // the prompt cache keeps this rank group's states (snap_*)
+    vision: ?*pictures.Offer = null, // the server's image offer (rank 0's processor and limits)
+};
+
+/// The tower's bytes on this rank: rank 0 holds it, its tensors plus scratch for a picture at the cap.
+pub fn visionBytes(a: std.mem.Allocator, io: std.Io, dir: []const u8) !u64 {
+    const p = admission.place() catch return 0;
+    return if (p.rank == 0) tower.Tower.bytesFor(a, io, dir, pictures.picture_tokens) else 0;
+}
+
+/// The text shards' bytes (the drafter's mtp.safetensors and vision.safetensors are counted beside them).
+pub fn tensorWeightBytes(a: std.mem.Allocator, io: std.Io, dir: []const u8, vision: bool) !u64 {
+    _ = vision;
+    const files = try core.checkpoint.shardFiles(a, io, dir);
+    defer core.checkpoint.freeShardFiles(a, files);
+    var total: u64 = 0;
+    for (files) |f| {
+        const name = std.fs.path.basename(f);
+        if (std.mem.indexOf(u8, name, "vision") != null or std.mem.indexOf(u8, name, "mtp") != null) continue;
+        total += (try std.Io.Dir.cwd().statFile(io, f, .{})).size;
+    }
+    return total;
+}
+
+/// Bytes this rank's weights take: half the split tensors, the embedding and the routers whole, the drafter's share.
+pub fn weightShare(a: std.mem.Allocator, io: std.Io, dir: []const u8, total: u64, drafts: bool) u64 {
+    const p = admission.place() catch return total;
+    if (p.world == 1) return total;
+    const c = cfg.Config.read(a, io, dir) catch return total;
+    const whole = @as(u64, c.vocab) * c.hidden * 2 + @as(u64, c.layers) * (@as(u64, c.experts) * c.hidden * 2 + c.experts * 4);
+    if (total < whole) return total;
+    var draft: u64 = 0;
+    if (drafts and dspark.present(io, a, dir)) {
+        if (dspark.Config.read(a, io, dir, &c) catch null) |dc| draft = dspark.rankBytes(&dc, &c, p.world, c.vocab);
+    }
+    return (total - whole) / p.world + whole + draft;
+}
+
+/// Positions a stream holds: `context` plus a window, in whole 64-key tiles.
+pub fn capacity(context: usize) usize {
+    return std.mem.alignForward(usize, context + engine.window_rows, 64);
+}
+
+const Owned = struct {
+    gpa: std.mem.Allocator,
+    lib: ?cuda.nccl.Library = null,
+    comm: cuda.nccl.Comm = null,
+    group: ?cuda.tp_group.Group = null, // lib and comm (owned above) with RoCE writes for two ranks' small gathers
+    e: *engine.Engine,
+    link: ?follow.Link = null,
+    lanes: ink_lanes.Lanes,
+    offer: ?*pictures.Offer = null,
+};
+
+pub fn open(gpa: std.mem.Allocator, io: std.Io, ctx: *const cuda.Context, dir: []const u8, kernels: ?[]const u8, o: Options) !Loaded {
+    _ = kernels;
+    try @import("sys").environment.checkScope(.inkling2, @import("sys").environment.Process{});
+    const p = try admission.place();
+    try admission.check(ctx, p.world);
+    if (std.c.getenv("NCCL_COMM_ID") == null) return error.NoCommId;
+    try cuda.tp_watch.start(io, p.rank, p.world);
+    return openRank(gpa, io, ctx, dir, o, p) catch |err| {
+        cuda.tp_watch.fail(@errorName(err));
+        return err;
+    };
+}
+
+fn openRank(gpa: std.mem.Allocator, io: std.Io, ctx: *const cuda.Context, dir: []const u8, o: Options, p: admission.Place) !Loaded {
+    var load_cache = core.checkpoint.cache.Load.begin(io, true);
+    defer load_cache.deinit();
+    const own = try gpa.create(Owned);
+    errdefer gpa.destroy(own);
+    own.* = .{ .gpa = gpa, .e = undefined, .lanes = undefined };
+    var lib = try cuda.nccl.Library.open();
+    errdefer lib.close();
+    var id: cuda.nccl.UniqueId = undefined;
+    if (p.rank == 0) {
+        try lib.check(lib.api.ncclGetUniqueId(&id), "ncclGetUniqueId");
+        cuda.tp_watch.sendId(&id.internal);
+    } else id.internal = try cuda.tp_watch.takeId(io);
+    var comm: cuda.nccl.Comm = null;
+    try lib.check(lib.api.ncclCommInitRank(&comm, @intCast(p.world), id, @intCast(p.rank)), "ncclCommInitRank");
+    own.lib = lib;
+    own.comm = comm;
+    errdefer _ = own.lib.?.api.ncclCommDestroy(own.comm);
+    const cap = capacity(o.context);
+    const lim: ?pictures.Limits = if (o.vision) |v| .{ .image_tokens = v.image_tokens, .max_images = @min(v.max_images, 64) } else null;
+    own.e = try engine.Engine.init(gpa, io, ctx.d, dir, p.rank, p.world, .{ .capacity = cap, .drafts = o.drafts, .vision = lim });
+    errdefer own.e.deinit();
+    own.link = try follow.Link.init(gpa, ctx.d, &own.lib.?, own.comm, own.e.stream, @max(cap, engine.prompt_rows));
+    errdefer own.link.?.deinit();
+    // gathers up to a prompt call's partial by RoCE writes, both ranks or neither (TF_ROCE=0: NCCL); plan word on NCCL
+    own.group = .{ .lib = own.lib.?, .comm = own.comm, .rank = p.rank, .world = p.world };
+    try own.group.?.openRoce(gpa, io, ctx.d, own.e.stream, own.e.roceBytes());
+    errdefer if (own.group.?.fast) |f| f.deinit();
+    own.e.exchange = .{ .nccl = .{ .lib = &own.lib.?, .comm = own.comm, .group = &own.group.? } };
+    try load_cache.finishAfter(.{ io, own.e.checkpoint_digest }, cuda.tp_watch.ready);
+    // rank 0 admits by the smallest room of the ranks
+    var peer: ?Peer = null;
+    {
+        const mine: u64 = if (o.room) |r| r.read(r.ctx) orelse 0 else std.math.maxInt(u64);
+        var rooms = try cuda.DeviceBuffer.alloc(ctx.d, 8 * p.world);
+        defer rooms.free();
+        try rooms.upload(p.rank * 8, std.mem.asBytes(&mine));
+        try own.lib.?.check(own.lib.?.api.ncclAllGather(rooms.ptr + p.rank * 8, rooms.ptr, 8, .u8, own.comm, own.e.stream.handle), "ncclAllGather");
+        try own.e.stream.synchronize();
+        var all: [2]u64 = undefined;
+        try rooms.download(0, std.mem.sliceAsBytes(all[0..p.world]));
+        for (all[1..p.world], 1..) |r, q| if (peer == null or r < peer.?.bytes) {
+            peer = .{ .bytes = r, .rank = q };
+        };
+    }
+    if (p.rank != 0) {
+        follow.follow(own.e, &own.link.?) catch |err| {
+            std.log.err("rank {d}: following rank 0 stopped ({s})", .{ p.rank, @errorName(err) });
+            cuda.tp_watch.fail(@errorName(err));
+            std.c._exit(1);
+        };
+        cuda.tp_watch.ended();
+        std.log.info("rank {d}: rank 0 ended; leaving", .{p.rank});
+        release(own);
+        std.process.exit(0);
+    }
+    own.link.?.asleep = cuda.tp_watch.open();
+    own.lanes = .{ .x = .{ .e = own.e, .link = &own.link.? } };
+    if (lim) |l| own.offer = try pictures.Offer.init(gpa, io, l);
+    return .{
+        .backend = own.lanes.backend(),
+        .facts = own.lanes.facts(),
+        .rows = ink_lanes.max_rows,
+        .stream_bytes = own.e.seqBytes(),
+        .ctx = own,
+        .deinit = close,
+        .reserve = reserveFn,
+        .peer_room = peer,
+        .target = own,
+        .vision = own.offer,
+    };
+}
+
+/// The host's admitted stream count: every rank's slots made at once.
+fn reserveFn(ptr: *anyopaque, streams: u32) anyerror!void {
+    const own: *Owned = @ptrCast(@alignCast(ptr));
+    try own.lanes.x.reserve(streams);
+}
+
+/// A state kept at `at`: its bytes on this rank (rings and conv states; the global rows stay in their slot).
+pub fn snap_bytes(ptr: *anyopaque, at: u32) u64 {
+    _ = at;
+    const own: *Owned = @ptrCast(@alignCast(ptr));
+    return own.e.stateBytes();
+}
+
+/// The prompt pass stands at `at` (a mark at a chunk start): every rank copies the state there under one new id.
+pub fn snap_save(ptr: *anyopaque, owner: ?*anyopaque, at: u32) anyerror!*anyopaque {
+    _ = owner;
+    const own: *Owned = @ptrCast(@alignCast(ptr));
+    if (own.e.pos() != at) return error.NotAtMark;
+    const k = try own.gpa.create(follow.Kept);
+    errdefer own.gpa.destroy(k);
+    k.* = try own.lanes.x.save(at);
+    return k;
+}
+
+/// A restore outside a prompt pass would leave the other rank behind: states resume inside it (Lanes.resumeFrom).
+pub fn snap_restore(ptr: *anyopaque, owner: ?*anyopaque, saved: *anyopaque) anyerror!void {
+    _ = ptr;
+    _ = owner;
+    _ = saved;
+    return error.RestoredInPromptPass;
+}
+
+pub fn snap_drop(ptr: *anyopaque, saved: *anyopaque) void {
+    const own: *Owned = @ptrCast(@alignCast(ptr));
+    const k: *follow.Kept = @ptrCast(@alignCast(saved));
+    own.lanes.x.drop(k.id);
+    own.gpa.destroy(k);
+}
+
+fn close(ptr: *anyopaque) void {
+    const own: *Owned = @ptrCast(@alignCast(ptr));
+    cuda.tp_watch.ended();
+    own.lanes.x.end() catch {};
+    own.lanes.deinit();
+    release(own);
+}
+
+fn release(own: *Owned) void {
+    if (own.offer) |v| v.deinit();
+    if (own.link) |*l| l.deinit();
+    own.e.deinit();
+    if (own.group) |*g| if (g.fast) |f| f.deinit();
+    if (own.lib) |*lib| {
+        _ = lib.api.ncclCommDestroy(own.comm);
+        lib.close();
+    }
+    own.gpa.destroy(own);
+}
+
+/// The server's words for this family's refusals.
+pub fn explain(_: ?*anyopaque, err: anyerror) ?[]const u8 {
+    return admission.explain(err) orelse switch (err) {
+        error.NoCommId => "Inkling 2's ranks meet over NCCL: set NCCL_COMM_ID to rank 0's address:port on both hosts",
+        error.UnexpectedInkling2Tensor => "a tensor is not stored as the Inkling 2 EXL3 pack stores it (the log names it)",
+        error.NoVision => "images need --vision on both ranks (rank 0 runs the tower from the pack's vision.safetensors)",
+        error.ImagePlaceholders => "the prompt's image placeholders do not match its pictures",
+        error.ImageTooLarge => pictures.Offer.explain(error.ImageTooLarge).?,
+        else => null,
+    };
+}
+
+test "native: refusals explain themselves; a stream's capacity holds the context and a window in whole tiles" {
+    try std.testing.expect(explain(null, error.Inkling2RequiresSm121) != null);
+    try std.testing.expect(explain(null, error.Inkling2RequiresTwoRanks) != null);
+    try std.testing.expect(explain(null, error.NoCommId) != null);
+    try std.testing.expectEqual(@as(usize, 1048576 + 64), capacity(1048576));
+    try std.testing.expectEqual(@as(usize, 131072 + 64), capacity(131072));
+}
diff --git a/zig/src/families/inkling2/pictures.zig b/zig/src/families/inkling2/pictures.zig
new file mode 100644
index 000000000..a36efb12c
--- /dev/null
+++ b/zig/src/families/inkling2/pictures.zig
@@ -0,0 +1,172 @@
+//! Served pictures: the server's image offer, each slot's image rows and spans, the rows' trip to every rank.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const image = @import("image.zig");
+const vision = @import("vision.zig");
+
+/// Visual tokens one picture may take: 2560 x 2560 pixels (the processor never resizes, so larger ones are refused).
+pub const picture_tokens: u32 = 4096;
+/// A request's visual tokens in all unless --vision-image-tokens says otherwise (one picture at the cap).
+pub const default_image_tokens: u32 = 4096;
+/// The chat template's tokens around an image: `<|content_image|>`, the placeholder, `<|end_message|>`.
+pub const content_image: u32 = 200005;
+pub const end_message: u32 = 200010;
+
+/// A request's image limits (--vision): visual tokens in all and pictures.
+pub const Limits = struct { image_tokens: u32, max_images: u32 };
+
+/// What rank 0 offers the server: the processor, the template's tokens, the limits.
+pub const Offer = struct {
+    gpa: std.mem.Allocator,
+    io: std.Io,
+    limits: Limits,
+    marks: struct { image: u32, open: u32, close: u32 } = .{ .image = image.image_token, .open = content_image, .close = end_message },
+    mark_ids: [3]u32 = .{ content_image, image.image_token, end_message },
+
+    /// The template writes `<|content_image|>` and `<|end_message|>` itself: the server expands the placeholder alone.
+    pub const template_wraps = true;
+
+    pub fn init(gpa: std.mem.Allocator, io: std.Io, limits: Limits) !*Offer {
+        const v = try gpa.create(Offer);
+        v.* = .{ .gpa = gpa, .io = io, .limits = limits };
+        return v;
+    }
+
+    pub fn deinit(v: *Offer) void {
+        v.gpa.destroy(v);
+    }
+
+    /// The server's processor (on the HTTP thread): one token per 40 x 40 cell, refused past the cap or the budget.
+    pub fn prepare(v: *const Offer, a: std.mem.Allocator, bytes: []const u8, max: u32) !Prepared {
+        const cap = @min(max, picture_tokens);
+        if (cap == 0) return error.ImageTooSmall;
+        const p = try image.prepare(v.io, a, bytes, cap);
+        const g = [2]u32{ p.rows, p.cols };
+        return .{ .pixels = p.pixels, .gh = p.rows, .gw = p.cols, .tokens = p.tokens(), .hash = core.picture.identity.withGrid(core.picture.identity.ofBytes(0x1a2b, bytes), g) };
+    }
+
+    pub fn explain(err: anyerror) ?[]const u8 {
+        return switch (err) {
+            error.ImageTooLarge => "too large: Inkling 2 reads one visual token per 40 x 40 pixels with no resize, at most 4096 a " ++
+                "picture (2560 x 2560) and the request's --vision-image-tokens shared by its pictures; send it smaller",
+            else => image.explain(err),
+        };
+    }
+};
+
+/// prepare's answer, in the fields the server's offer reads.
+pub const Prepared = struct { pixels: []f32, gh: u32, gw: u32, tokens: u32, hash: u64 };
+
+/// One slot's pictures for its prompt pass: their rows (bf16 [tokens][hidden]) and where they go.
+pub const Rows = struct {
+    buf: cuda.DeviceBuffer,
+    spans: std.ArrayList(vision.Span) = .empty,
+};
+
+/// Bytes a slot's image rows take at a request's limit.
+pub fn slotBytes(l: Limits) u64 {
+    return @as(u64, l.image_tokens) * vision.hidden * 2;
+}
+
+/// Every slot's rows buffer, made with the slots.
+pub fn makeRows(gpa: std.mem.Allocator, d: *const cuda.Driver, l: Limits, slots: usize) ![]Rows {
+    const rows = try gpa.alloc(Rows, slots);
+    var made: usize = 0;
+    errdefer {
+        for (rows[0..made]) |*r| r.buf.free();
+        gpa.free(rows);
+    }
+    for (rows) |*r| {
+        r.* = .{ .buf = try cuda.DeviceBuffer.alloc(d, slotBytes(l)) };
+        made += 1;
+    }
+    return rows;
+}
+
+pub fn freeRows(gpa: std.mem.Allocator, rows: []Rows) void {
+    for (rows) |*r| {
+        r.buf.free();
+        r.spans.deinit(gpa);
+    }
+    gpa.free(rows);
+}
+
+/// The request's pictures as the tower reads them, and their spans: each at its first placeholder, rows in order.
+pub fn fromRequest(a: std.mem.Allocator, ids: []const u32, imgs: anytype, pics: []image.Prepared) ![]vision.Span {
+    if (imgs.len > pics.len) return error.ImageCount;
+    const list = try vision.spans(a, ids);
+    errdefer a.free(list);
+    if (list.len != imgs.len) return error.ImagePlaceholders;
+    for (imgs, pics[0..imgs.len], list) |im, *p, sp| {
+        if (im.at != sp.at or im.tokens != sp.n or im.tokens != im.gh * im.gw) return error.ImagePlaceholders;
+        p.* = .{ .pixels = @constCast(im.pixels), .rows = im.gh, .cols = im.gw };
+    }
+    try vision.check(list, pics[0..imgs.len]);
+    return list;
+}
+
+/// Spans checked against a slot's rows (a follower's step, or rank 0's before it goes out): rows in order, in room.
+pub fn checkSpans(list: []const vision.Span, l: Limits) !u32 {
+    var row: u32 = 0;
+    var end: u32 = 0;
+    for (list) |sp| {
+        if (sp.n == 0 or sp.row != row or sp.at < end) return error.ImagePlaceholders;
+        row += sp.n;
+        end = sp.at + sp.n;
+    }
+    if (row > l.image_tokens or list.len > l.max_images) return error.ImageTooLarge;
+    return row;
+}
+
+/// Spans as a step's words (at, n, row each) and back.
+pub fn toWords(list: []const vision.Span, out: []u32) ![]u32 {
+    if (out.len < 3 * list.len) return error.TooManyImages;
+    for (list, 0..) |sp, i| out[3 * i ..][0..3].* = .{ sp.at, sp.n, sp.row };
+    return out[0 .. 3 * list.len];
+}
+
+pub fn fromWords(words: []const u32, out: []vision.Span) ![]vision.Span {
+    if (words.len % 3 != 0 or words.len / 3 > out.len) return error.BadStep;
+    for (out[0 .. words.len / 3], 0..) |*sp, i| sp.* = .{ .at = words[3 * i], .n = words[3 * i + 1], .row = words[3 * i + 2] };
+    return out[0 .. words.len / 3];
+}
+
+test "spans cross as words and back; a slot's spans are checked against its limits" {
+    const list = [_]vision.Span{ .{ .at = 3, .n = 15, .row = 0 }, .{ .at = 40, .n = 4, .row = 15 } };
+    var w: [6]u32 = undefined;
+    var back: [4]vision.Span = undefined;
+    const got = try fromWords(try toWords(&list, &w), &back);
+    try std.testing.expectEqualSlices(vision.Span, &list, got);
+    try std.testing.expectEqual(@as(u32, 19), try checkSpans(&list, .{ .image_tokens = 19, .max_images = 2 }));
+    try std.testing.expectError(error.ImageTooLarge, checkSpans(&list, .{ .image_tokens = 18, .max_images = 2 }));
+    try std.testing.expectError(error.ImageTooLarge, checkSpans(&list, .{ .image_tokens = 64, .max_images = 1 }));
+    const gap = [_]vision.Span{.{ .at = 3, .n = 15, .row = 1 }};
+    try std.testing.expectError(error.ImagePlaceholders, checkSpans(&gap, .{ .image_tokens = 64, .max_images = 2 }));
+    try std.testing.expectError(error.BadStep, fromWords(w[0..5], &back));
+}
+
+test "a request's pictures map to their placeholder runs; a count or place that differs is refused" {
+    const a = std.testing.allocator;
+    const t = image.image_token;
+    const Img = struct { pixels: []const f32, gh: u32, gw: u32, at: u32, tokens: u32 };
+    var px: [6 * image.side * image.side * 3]f32 = undefined;
+    const ids = [_]u32{ 9, content_image, t, t, t, t, end_message, 5, content_image, t, t, end_message };
+    var pics: [4]image.Prepared = undefined;
+    const two = [_]Img{ .{ .pixels = px[0..], .gh = 2, .gw = 2, .at = 2, .tokens = 4 }, .{ .pixels = px[0..], .gh = 1, .gw = 2, .at = 9, .tokens = 2 } };
+    const got = try fromRequest(a, &ids, &two, &pics);
+    defer a.free(got);
+    try std.testing.expectEqual(vision.Span{ .at = 9, .n = 2, .row = 4 }, got[1]);
+    try std.testing.expectEqual(@as(u32, 2), pics[1].cols);
+    const moved = [_]Img{ two[0], .{ .pixels = px[0..], .gh = 1, .gw = 2, .at = 8, .tokens = 2 } };
+    try std.testing.expectError(error.ImagePlaceholders, fromRequest(a, &ids, &moved, &pics));
+    try std.testing.expectError(error.ImagePlaceholders, fromRequest(a, &ids, two[0..1], &pics));
+}
+
+test "the cap: a picture past 4096 tokens is refused with words naming the limit; the slot rows fit the default" {
+    try std.testing.expect(image.tokensFor(2560, 2560) == picture_tokens);
+    try std.testing.expect(image.tokensFor(2561, 2560) > picture_tokens);
+    try std.testing.expect(std.mem.indexOf(u8, Offer.explain(error.ImageTooLarge).?, "4096") != null);
+    try std.testing.expectEqual(@as(u64, 4096 * 4608 * 2), slotBytes(.{ .image_tokens = default_image_tokens, .max_images = 4 }));
+    try std.testing.expect(vision.scratchBytes(picture_tokens) < 1 << 30);
+}
diff --git a/zig/src/families/inkling2/prompt_dense.zig b/zig/src/families/inkling2/prompt_dense.zig
new file mode 100644
index 000000000..073437140
--- /dev/null
+++ b/zig/src/families/inkling2/prompt_dense.zig
@@ -0,0 +1,110 @@
+//! Prompt rows' dense EXL3 projections (exl3.md, Prompts): W decoded once into fp16, a cuBLASLt GEMM, the rotation.
+const std = @import("std");
+const cuda = @import("cuda");
+
+const lt_ = cuda.cublaslt;
+const Buf = cuda.DeviceBuffer;
+
+/// Calls of fewer rows keep exl3.Dense (decode rows, short prompts: the same bits as decode).
+pub const min_rows = 256;
+const workspace_bytes = 32 << 20;
+
+const Plan = struct { rows: usize, k: usize, n: usize, g: lt_.Gemm };
+
+pub const Prompt = struct {
+    gpa: std.mem.Allocator,
+    d: *const cuda.Driver,
+    lt: lt_.Library,
+    handle: lt_.Handle,
+    mod: cuda.Module,
+    rotate: cuda.Function,
+    unpack: cuda.Function,
+    tail: cuda.Function,
+    xh: Buf, // fp16 [rows][k]: (x * suh) H 2^-4
+    w: Buf, // fp16 [k][n]: W_q in the rotated domain
+    z: Buf, // fp32 [rows][n]: the GEMM's sums
+    ws: Buf,
+    plans: std.ArrayList(Plan) = .empty,
+    rows_max: usize,
+
+    pub fn init(gpa: std.mem.Allocator, d: *const cuda.Driver, tail: cuda.Function, rows_max: usize, k_max: usize, n_max: usize) !Prompt {
+        var lt = try lt_.Library.open();
+        errdefer lt.close();
+        const handle = try lt_.createHandle(&lt);
+        errdefer _ = lt.api.cublasLtDestroy(handle);
+        var mod = try cuda.Module.load(d, cuda.kernels.exl3_candidate);
+        errdefer mod.unload();
+        var xh = try Buf.alloc(d, rows_max * k_max * 2);
+        errdefer xh.free();
+        var w = try Buf.alloc(d, k_max * n_max * 2);
+        errdefer w.free();
+        var z = try Buf.alloc(d, rows_max * n_max * 4);
+        errdefer z.free();
+        const ws = try Buf.alloc(d, workspace_bytes);
+        return .{ .gpa = gpa, .d = d, .lt = lt, .handle = handle, .mod = mod, .rotate = try mod.function("tf_exl3_rotate_h"), .unpack = try mod.function("tf_exl3_unpack"), .tail = tail, .xh = xh, .w = w, .z = z, .ws = ws, .rows_max = rows_max };
+    }
+
+    /// Scratch for the widest attention projection of `layers` at `rows` rows.
+    pub fn of(gpa: std.mem.Allocator, d: *const cuda.Driver, tail: cuda.Function, rows: usize, layers: anytype) !Prompt {
+        var k: usize = 0;
+        var n: usize = 0;
+        for (layers) |l| for ([_]cuda.exl3.Weight{ l.attn.q, l.attn.k, l.attn.v, l.attn.r, l.attn.gate, l.attn.o }) |x| {
+            k = @max(k, x.k);
+            n = @max(n, x.n);
+        };
+        return init(gpa, d, tail, rows, k, n);
+    }
+
+    pub fn deinit(p: *Prompt) void {
+        for (p.plans.items) |*x| x.g.deinit();
+        p.plans.deinit(p.gpa);
+        for ([_]*Buf{ &p.xh, &p.w, &p.z, &p.ws }) |b| b.free();
+        p.mod.unload();
+        _ = p.lt.api.cublasLtDestroy(p.handle);
+        p.lt.close();
+    }
+
+    /// Whether `w` takes this path: whole bits (the unpack's widths), no bias, the stored layout, within the scratch.
+    pub fn takes(p: *const Prompt, w: cuda.exl3.Weight, rows: usize) bool {
+        const st = cuda.exl3.strides(w.k, w.n, w.halves, false);
+        return rows >= min_rows and rows <= p.rows_max and w.halves % 2 == 0 and w.halves <= 16 and w.bias == 0 and
+            w.stride_k == st.k and w.stride_nb == st.nb and @as(usize, w.k) * 2 * rows <= p.xh.len and
+            @as(usize, w.k) * w.n * 2 <= p.w.len and rows * w.n * 4 <= p.z.len;
+    }
+
+    fn plan(p: *Prompt, rows: usize, k: usize, n: usize) !*const lt_.Gemm {
+        for (p.plans.items) |*x| if (x.rows == rows and x.k == k and x.n == n) return &x.g;
+        // column-major: Z^T [n, rows] = W^T [n, k] . Xh^T [k, rows]
+        const g = try lt_.Gemm.init(&p.lt, p.handle, .{ .m = n, .n = rows, .k = k, .a = .f16, .b = .f16, .c = .f32, .lda = n, .ldb = k, .ldc = n }, workspace_bytes);
+        try p.plans.append(p.gpa, .{ .rows = rows, .k = k, .n = n, .g = g });
+        return &p.plans.items[p.plans.items.len - 1].g;
+    }
+
+    /// y [rows][n] (bf16 or fp32) = x [rows][k] (bf16) through `w`, on `s`.
+    pub fn run(p: *Prompt, s: cuda.Stream, w: cuda.exl3.Weight, x: u64, rows: usize, y: u64, y_f32: bool) !void {
+        const g = try p.plan(rows, w.k, w.n);
+        var a: cuda.Args = .{};
+        a.add(x);
+        a.add(@as(u32, w.k));
+        a.add(w.suh);
+        a.add(p.xh.ptr);
+        a.add(@as(u32, w.k));
+        try cuda.launch.launch(p.rotate, .{ .grid = .{ .x = w.k / 128, .y = @intCast(rows) }, .block = .{ .x = 32 } }, s, &a);
+        var b: cuda.Args = .{};
+        b.add(w.trellis);
+        b.add(MatrixArgs{ .k = w.k, .n = w.n, .bits = w.halves / 2, .tiles_n = w.n / 16, .split = 1 });
+        b.add(@as(u32, @backingInt(w.codebook)));
+        b.add(p.w.ptr);
+        try cuda.launch.launch(p.unpack, .{ .grid = .{ .x = w.n / 16, .y = w.k / 16 }, .block = .{ .x = 32 } }, s, &b);
+        try g.run(1.0, p.w.ptr, p.xh.ptr, 0.0, p.z.ptr, p.ws.ptr, p.ws.len, s.handle);
+        var c: cuda.Args = .{};
+        for ([_]u64{ p.z.ptr, w.svh }) |v| c.add(v);
+        c.add(@as(u32, w.n));
+        c.add(y);
+        c.add(@as(u32, @intFromBool(y_f32)));
+        try cuda.launch.launch(p.tail, .{ .grid = .{ .x = w.n / 128, .y = @intCast(rows) }, .block = .{ .x = 32 } }, s, &c);
+    }
+};
+
+/// exl3_candidate.cu's TfExl3Matrix, by value.
+const MatrixArgs = extern struct { k: u32, n: u32, bits: u32, tiles_n: u32, split: u32 };
diff --git a/zig/src/families/inkling2/sampler.zig b/zig/src/families/inkling2/sampler.zig
new file mode 100644
index 000000000..7260d85df
--- /dev/null
+++ b/zig/src/families/inkling2/sampler.zig
@@ -0,0 +1,107 @@
+//! Sampled draws on main's sample.cu: each rank's bf16 columns broadcast into whole rows, every rank draws the same.
+const std = @import("std");
+const cuda = @import("cuda");
+const lanes = @import("lanes");
+const Span = @import("shard.zig").Span;
+const Exchange = @import("forward.zig").Exchange;
+
+pub const Sampling = lanes.Sampling;
+
+/// The request's rule as the engine runs it: null (or temperature 0) decodes greedily.
+pub fn check(s: ?Sampling) ?Sampling {
+    const x = s orelse return null;
+    return if (x.temperature > 0) x else null;
+}
+
+pub const Rule = cuda.sample.Rule;
+
+pub fn rule(s: Sampling) Rule {
+    return cuda.sample.rule(s);
+}
+
+pub const Sampler = struct {
+    d: *const cuda.Driver,
+    module: cuda.Module,
+    tf_draw: cuda.Function,
+    vocab: usize, // a whole row's columns: every rank's padded span
+    rows: usize,
+    full: cuda.DeviceBuffer, // bf16 [rows][vocab]: every rank's columns in place
+    rule: cuda.DeviceBuffer,
+    meta: cuda.DeviceBuffer,
+    tok: cuda.DeviceBuffer,
+    prob: cuda.DeviceBuffer,
+
+    pub fn init(d: *const cuda.Driver, vocab: usize, rows: usize) !Sampler {
+        var m = try cuda.Module.load(d, cuda.kernels.sample);
+        errdefer m.unload();
+        const f = try m.function("tf_draw");
+        var full = try cuda.DeviceBuffer.alloc(d, rows * vocab * 2);
+        errdefer full.free();
+        var r = try cuda.DeviceBuffer.alloc(d, @sizeOf(Rule));
+        errdefer r.free();
+        var meta = try cuda.DeviceBuffer.alloc(d, 16);
+        errdefer meta.free();
+        var tok = try cuda.DeviceBuffer.alloc(d, rows * 4);
+        errdefer tok.free();
+        const prob = try cuda.DeviceBuffer.alloc(d, rows * 4);
+        return .{ .d = d, .module = m, .tf_draw = f, .vocab = vocab, .rows = rows, .full = full, .rule = r, .meta = meta, .tok = tok, .prob = prob };
+    }
+
+    pub fn deinit(s: *Sampler) void {
+        s.prob.free();
+        s.tok.free();
+        s.meta.free();
+        s.rule.free();
+        s.full.free();
+        s.module.unload();
+    }
+
+    /// `rows` rows of `full` (this rank's columns written) made whole, then drawn: tokens at first, first + 1, ...
+    pub fn draw(s: *Sampler, stream: cuda.Stream, exchange: Exchange, spans: []const Span, rows: usize, first: u64, r: Rule, out: []u32) !void {
+        std.debug.assert(rows <= s.rows and out.len >= rows and first >= 1);
+        switch (exchange) {
+            .local => {},
+            .nccl => |x| try x.lib.group(Spread{ .lib = x.lib, .comm = x.comm, .stream = stream, .full = s.full.ptr, .vocab = s.vocab, .spans = spans, .rows = rows }, Spread.post),
+        }
+        try s.rule.uploadAsync(0, std.mem.asBytes(&r), stream.handle);
+        const meta = [4]i32{ @intCast(first - 1), 0, 0, 0 }; // row r keys meta[0] + r + 1
+        try s.meta.uploadAsync(0, std.mem.asBytes(&meta), stream.handle);
+        var args: cuda.Args = .{};
+        args.add(s.full.ptr);
+        args.add(@as(u32, @intCast(s.vocab)));
+        args.add(s.rule.ptr);
+        args.add(s.meta.ptr);
+        args.add(@as(i32, 0));
+        args.add(s.tok.ptr);
+        args.add(s.prob.ptr);
+        try cuda.launch.launch(s.tf_draw, .{ .grid = .{ .x = @intCast(rows) }, .block = .{ .x = 1024 } }, stream, &args);
+        try stream.synchronize();
+        try s.tok.download(0, std.mem.sliceAsBytes(out[0..rows]));
+    }
+};
+
+/// Each rank's columns of each row from that rank, in one NCCL group.
+const Spread = struct {
+    lib: *const cuda.nccl.Library,
+    comm: cuda.nccl.Comm,
+    stream: cuda.Stream,
+    full: u64,
+    vocab: usize,
+    spans: []const Span,
+    rows: usize,
+
+    fn post(t: Spread) anyerror!void {
+        for (0..t.rows) |row| for (t.spans, 0..) |span, q| {
+            const at = t.full + (row * t.vocab + span.lo) * 2;
+            try t.lib.check(t.lib.api.ncclBroadcast(at, at, span.len(), .bf16, @intCast(q), t.comm, t.stream.handle), "ncclBroadcast");
+        };
+    }
+};
+
+test "sampler: temperature 0 is greedy, a sampled rule keeps its settings" {
+    const s: Sampling = .{ .seed = 1234, .temperature = 0.5, .top_k = 20, .top_p = 0.95 };
+    const r = rule(check(s).?);
+    try std.testing.expectEqual(@as(f32, 2.0), r.inv_t);
+    try std.testing.expectEqual(@as(u32, 20), r.top_k);
+    try std.testing.expectEqual(@as(?Sampling, null), check(.{ .seed = 0, .temperature = 0 }));
+}
diff --git a/zig/src/families/inkling2/shape.zig b/zig/src/families/inkling2/shape.zig
new file mode 100644
index 000000000..ec90708b8
--- /dev/null
+++ b/zig/src/families/inkling2/shape.zig
@@ -0,0 +1,179 @@
+//! The engine's view of Inkling 2 Small: the shared config (config.zig) narrowed to what the CUDA kernels run.
+const std = @import("std");
+const shared = @import("config.zig");
+
+pub const max_layers = 64;
+
+/// A layer's attention: sliding (window, static short convolutions) or global (log scaling, dynamic convolutions).
+pub const Kind = enum { sliding, global };
+
+pub const Config = struct {
+    hidden: u32 = 4608,
+    layers: u32 = 48,
+    vocab: u32 = 201024,
+    /// Rows of the head that are real tokens; the rest of `vocab` is padding.
+    real_vocab: u32 = 200058,
+    eps: f32 = 1e-6,
+    heads: u32 = 48,
+    kv_heads: u32 = 8,
+    head_dim: u32 = 128,
+    /// Width of each head's relative-position vector and the distances its bias profile covers.
+    d_rel: u32 = 16,
+    rel_extent: u32 = 1024,
+    window: u32 = 1024,
+    qk_clip: f32 = 22.627416997969522,
+    rel_clip: f32 = 8.0,
+    log_floor: f32 = 128000,
+    log_alpha: f32 = 0.1,
+    conv: u32 = 4,
+    block_layers: u32 = 6,
+    experts: u32 = 384,
+    topk: u32 = 8,
+    intermediate: u32 = 2304,
+    gate_softcap: f32 = 4.0,
+    up_softcap: f32 = 25.0,
+    route_scale: f32 = 8.0,
+    logit_softcap: f32 = 30.0,
+    context: u32 = 1048576,
+    eos: [4]u32 = .{ 200006, 0, 0, 0 },
+    eos_count: u32 = 1,
+    layer: [max_layers]Kind = undefined,
+
+    pub fn read(gpa: std.mem.Allocator, io: std.Io, dir: []const u8) !Config {
+        const path = try std.fs.path.join(gpa, &.{ dir, "config.json" });
+        defer gpa.free(path);
+        const bytes = try std.Io.Dir.cwd().readFileAlloc(io, path, gpa, .limited(1 << 22));
+        defer gpa.free(bytes);
+        return parse(gpa, bytes);
+    }
+
+    /// Query heads that share one key head.
+    pub fn group(c: *const Config) u32 {
+        return c.heads / c.kv_heads;
+    }
+
+    pub fn globals(c: *const Config) u32 {
+        var n: u32 = 0;
+        for (c.layer[0..c.layers]) |k| n += @intFromBool(k == .global);
+        return n;
+    }
+
+    /// Key and value bytes one token takes on a rank holding `kv` key heads: the global layers' bf16 keys and values.
+    pub fn tokenBytes(c: *const Config, kv: u32) u64 {
+        return @as(u64, c.globals()) * kv * c.head_dim * 2 * 2;
+    }
+
+    /// The end-of-reply ids config.json names.
+    pub fn stops(c: *const Config) []const u32 {
+        return c.eos[0..c.eos_count];
+    }
+};
+
+pub const Error = error{ BadInkling2Config, UnsupportedInkling2Attention, UnsupportedInkling2Experts };
+
+/// config.json through the family's shared parser, then the kernels' limits; a refusal logs the parser's reason.
+pub fn parse(gpa: std.mem.Allocator, bytes: []const u8) !Config {
+    var why: shared.Why = .{};
+    const s = shared.parse(gpa, bytes, &why) catch |err| {
+        std.log.err("inkling2: {s}", .{why.text()});
+        return err;
+    };
+    return from(&s);
+}
+
+/// The shared config as the kernels read it; one attention shape serves sliding and global layers.
+pub fn from(s: *const shared.Config) Error!Config {
+    const t = &s.text;
+    if (t.layers > max_layers) return error.BadInkling2Config;
+    if (!std.meta.eql(t.local, t.global)) return error.UnsupportedInkling2Attention;
+    var c: Config = .{
+        .hidden = t.hidden,
+        .layers = t.layers,
+        .vocab = t.vocab,
+        .real_vocab = t.unpadded_vocab,
+        .eps = t.eps,
+        .heads = t.global.q,
+        .kv_heads = t.global.kv,
+        .head_dim = t.global.dim,
+        .d_rel = t.d_rel,
+        .rel_extent = t.rel_extent,
+        .window = t.window,
+        .qk_clip = t.qk_clip,
+        .rel_clip = t.rel_clip,
+        .log_floor = @floatFromInt(t.log_floor),
+        .log_alpha = t.log_alpha,
+        .conv = shared.conv_taps,
+        .block_layers = t.block,
+        .experts = t.experts,
+        .topk = t.topk,
+        .intermediate = t.expert_inter,
+        .gate_softcap = t.gate_cap,
+        .up_softcap = t.up_cap,
+        .route_scale = t.route_scale,
+        .logit_softcap = t.logit_cap,
+        .context = t.max_context,
+        .eos = .{ s.eos, 0, 0, 0 },
+        .eos_count = 1,
+    };
+    for (c.layer[0..c.layers], 0..) |*k, i| k.* = if (shared.isGlobal(@intCast(i))) .global else .sliding;
+    try validate(&c);
+    return c;
+}
+
+/// What tf_ink2_* and the plan cover: 128-wide heads, a 16-wide rel vector over 1,024 distances, whole key groups.
+pub fn validate(c: *const Config) Error!void {
+    if (c.head_dim != 128 or c.d_rel != 16 or c.rel_extent != 1024 or c.window != 1024 or c.kv_heads == 0 or
+        c.heads % c.kv_heads != 0 or c.kv_heads % 2 != 0 or c.qk_clip <= 0 or c.rel_clip <= 0 or c.log_floor < 1 or
+        c.conv != 4 or c.block_layers == 0) return error.UnsupportedInkling2Attention;
+    if (c.globals() == c.layers) return error.UnsupportedInkling2Attention; // truncated checks may hold no global layer
+    if (c.experts == 0 or c.experts % 8 != 0 or c.topk == 0 or c.topk > 8 or c.intermediate % 128 != 0 or
+        c.hidden % 128 != 0) return error.UnsupportedInkling2Experts;
+    if (c.real_vocab == 0 or c.real_vocab > c.vocab or c.context == 0) return error.BadInkling2Config;
+}
+
+const fixture = @embedFile("fixtures/config.json");
+
+test "inkling2 shape: the release's shape, 40 sliding and 8 global layers, eos from config.json" {
+    const c = try parse(std.testing.allocator, fixture);
+    try std.testing.expectEqual(@as(u32, 48), c.layers);
+    try std.testing.expectEqual(@as(u32, 8), c.globals());
+    for ([_]usize{ 5, 11, 17, 23, 29, 35, 41, 47 }) |i| try std.testing.expectEqual(Kind.global, c.layer[i]);
+    try std.testing.expectEqual(Kind.sliding, c.layer[0]);
+    try std.testing.expectEqual(Kind.sliding, c.layer[46]);
+    try std.testing.expectEqual(@as(u32, 6), c.group());
+    try std.testing.expectEqual(@as(u32, 1048576), c.context);
+    try std.testing.expectEqualSlices(u32, &.{200006}, c.stops());
+    try std.testing.expectEqual(@as(f32, 128000), c.log_floor);
+    try std.testing.expectEqual(@as(f32, 22.627416997969522), c.qk_clip);
+    // at TP=2 a rank holds 4 key heads: 16 KiB a token, 16 GiB at 1M
+    try std.testing.expectEqual(@as(u64, 16384), c.tokenBytes(4));
+}
+
+test "inkling2 shape: an EXL3 pack's config reads as the release's" {
+    const modelopt = "\"quant_method\": \"modelopt\",\n    \"quant_algo\": \"NVFP4\"";
+    const exl3 = "\"quant_method\": \"exl3\",\n    \"version\": \"1.6.6\", \"bits\": 2.2";
+    const bytes = try std.mem.replaceOwned(u8, std.testing.allocator, fixture, modelopt, exl3);
+    defer std.testing.allocator.free(bytes);
+    try std.testing.expect(!std.mem.eql(u8, bytes, fixture));
+    const a = try parse(std.testing.allocator, fixture);
+    const b = try parse(std.testing.allocator, bytes);
+    try std.testing.expect(std.meta.eql(a, b));
+}
+
+test "inkling2 shape: shapes the kernels do not run are refused" {
+    const Case = struct { from: []const u8, to: []const u8, err: anyerror };
+    const cases = [_]Case{
+        .{ .from = "\"head_dim\": 128", .to = "\"head_dim\": 96", .err = error.UnsupportedInkling2Attention },
+        .{ .from = "\"swa_head_dim\": 128", .to = "\"swa_head_dim\": 64", .err = error.UnsupportedInkling2Attention },
+        .{ .from = "\"rel_extent\": 1024", .to = "\"rel_extent\": 2048", .err = error.UnsupportedInkling2Attention },
+        .{ .from = "\"d_rel\": 16", .to = "\"d_rel\": 32", .err = error.UnsupportedInkling2Attention },
+        .{ .from = "\"sliding_window_size\": 1024", .to = "\"sliding_window_size\": 4096", .err = error.UnsupportedInkling2Attention },
+        .{ .from = "\"num_experts_per_tok\": 8", .to = "\"num_experts_per_tok\": 9", .err = error.UnsupportedInkling2Experts },
+    };
+    for (cases) |x| {
+        const bytes = try std.mem.replaceOwned(u8, std.testing.allocator, fixture, x.from, x.to);
+        defer std.testing.allocator.free(bytes);
+        try std.testing.expect(!std.mem.eql(u8, bytes, fixture));
+        try std.testing.expectError(x.err, parse(std.testing.allocator, bytes));
+    }
+}
