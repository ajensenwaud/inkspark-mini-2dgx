+++ b/zig/src/families/inkling2/dspark_run.zig
@@ -0,0 +1,281 @@
+//! The DSpark drafter at TP: target taps as each draft layer's context, then a block of 8 rows and a Markov walk.
+const std = @import("std");
+const cuda = @import("cuda");
+const fw = @import("forward.zig");
+const ops = @import("ops.zig");
+const ds = @import("dspark.zig");
+const dk = @import("dspark_ops.zig");
+
+const Buf = cuda.DeviceBuffer;
+const T = ds.block;
+
+/// A sliding draft layer's key ring: its window and a block past a prompt chunk's rows.
+pub const local_ring = 4096;
+
+/// A slot's drafter state: layer caches (rings; the global layer at capacity), stash, f_rnn, positions [from, to).
+pub const Slot = struct {
+    buf: Buf,
+    off: [ds.max_layers + 1]usize = @splat(0),
+    stash: u64 = 0,
+    frnn: u64 = 0,
+    from: usize = 0,
+    to: usize = 0,
+
+    pub fn keys(s: *const Slot, l: usize) u64 {
+        return s.buf.ptr + s.off[l];
+    }
+
+    pub fn values(s: *const Slot, l: usize) u64 {
+        return s.keys(l) + (s.off[l + 1] - s.off[l]) / 2;
+    }
+};
+
+/// Bytes a slot takes: `kv` key heads a rank, the global layer's keys at `capacity` positions.
+pub fn slotBytes(c: *const ds.Config, kv: usize, capacity: usize, hidden: usize) usize {
+    var n: usize = 0;
+    for (0..c.layers) |l| n += 2 * ring(c, l, capacity) * kv * 128 * 2;
+    return n + T * ds.taps_n * hidden * 2 + hidden * 2;
+}
+
+fn ring(c: *const ds.Config, l: usize, capacity: usize) usize {
+    return if (c.local[l]) local_ring else capacity;
+}
+
+pub fn initSlot(d: *const cuda.Driver, c: *const ds.Config, kv: usize, capacity: usize, hidden: usize) !Slot {
+    var buf = try Buf.alloc(d, slotBytes(c, kv, capacity, hidden));
+    errdefer buf.free();
+    try buf.fill8(0, null);
+    var s: Slot = .{ .buf = buf };
+    for (0..c.layers) |l| s.off[l + 1] = s.off[l] + 2 * ring(c, l, capacity) * kv * 128 * 2;
+    s.stash = buf.ptr + s.off[c.layers];
+    s.frnn = s.stash + T * ds.taps_n * hidden * 2;
+    return s;
+}
+
+/// A sampled stream's keys (sample.cu's seed and 1 / T): its drafts race as its target draws will, not greedily.
+pub const Race = struct { seed: u64, inv_t: f32 };
+
+pub const Drafter = struct {
+    gpa: std.mem.Allocator,
+    d: *const cuda.Driver,
+    w: ds.Weights,
+    k: dk.Kernels,
+    lane: cuda.qmmf.Lane,
+    bufs: std.ArrayList(Buf) = .empty,
+    hidden: usize,
+    hq: usize,
+    hk: usize,
+    inter: usize, // this rank's FFN columns
+    nv: usize, // this rank's vocabulary rows
+    valid: usize, // of them, real tokens
+    vlo: usize,
+    rank: usize,
+    world: usize,
+    cap: f32,
+    capacity: usize,
+    ctx_rows: usize, // rows an absorb takes at most
+    part: u64 = 0,
+    fold: u64 = 0, // bf16 [nv][rank]: the head times hidden_out
+    fbias: u64 = 0, // bf16 [nv]: the head times hidden_out's bias
+    resid: u64 = 0,
+    x: u64 = 0,
+    qkv: u64 = 0,
+    q: u64 = 0,
+    att: u64 = 0,
+    gu: u64 = 0,
+    act: u64 = 0,
+    gath: u64 = 0, // fp32 [world][T][hidden]
+    po: u64 = 0,
+    pml: u64 = 0,
+    base: u64 = 0, // bf16 [T - 1][nv]
+    mctx: u64 = 0, // fp32 [T - 1][3 rank]
+    state: u64 = 0,
+    latent: u64 = 0,
+    scores: u64 = 0, // fp32 [nv]
+    picks: u64 = 0, // every rank's (value, id), padded to 16 bytes so the RoCE gather takes it
+    walk: u64 = 0, // int32 [T]: the anchor, then each step's pick
+    ids: u64 = 0,
+    mixed: u64 = 0, // bf16 [ctx_rows][hidden]
+    ckv: u64 = 0, // bf16 [ctx_rows][2 kv * 128]
+    keep_logits: u64 = 0, // a check's fp32 [T - 1][nv] of each step's logits (0: none)
+
+    /// Scratch for blocks and absorbs of up to `ctx_rows` rows; the Markov head folded into this rank's head rows.
+    pub fn init(gpa: std.mem.Allocator, d: *const cuda.Driver, m: *fw.Modules, s: cuda.Stream, w: ds.Weights, t: anytype, capacity: usize, ctx_rows: usize) !*Drafter {
+        const dr = try gpa.create(Drafter);
+        errdefer gpa.destroy(dr);
+        const sh = t.share;
+        const c = &t.config;
+        dr.* = .{ .gpa = gpa, .d = d, .w = w, .k = try dk.Kernels.load(d), .lane = undefined, .hidden = c.hidden, .hq = sh.heads.len(), .hk = sh.kv.len(), .inter = w.c.inter / sh.world, .nv = sh.vocab.len(), .valid = @min(sh.vocab.len(), @as(usize, c.real_vocab) -| sh.vocab.lo), .vlo = sh.vocab.lo, .rank = sh.rank, .world = sh.world, .cap = c.logit_softcap, .capacity = capacity, .ctx_rows = ctx_rows };
+        errdefer dr.k.unload();
+        dr.lane = try cuda.qmmf.Lane.load(d, 12);
+        errdefer dr.lane.unload();
+        errdefer for (dr.bufs.items) |*b| b.free();
+        const h = dr.hidden;
+        var part: usize = 0;
+        for (w.layers[0..w.c.layers]) |l| for ([_]cuda.qmmf.Weight{ l.qkv, l.o, l.gu, l.down }) |x| {
+            part = @max(part, dr.lane.partBytes(T, x));
+        };
+        for (w.layers[0..w.c.layers]) |l| part = @max(part, dr.lane.partBytes(ctx_rows, l.kv));
+        const R: usize = w.c.rank;
+        const qkvw = (dr.hq + 2 * dr.hk) * 128;
+        const sizes = [_]usize{ part, dr.nv * R * 2, dr.nv * 2, T * h * 2, T * h * 2, T * qkvw * 2, T * dr.hq * 128 * 2, T * dr.hq * 128 * 2, T * 2 * dr.inter * 2, T * dr.inter * 2, dr.world * T * h * 4, dk.chunks(0, capacity) * T * dr.hq * 128 * 4, dk.chunks(0, capacity) * T * dr.hq * 8, T * dr.nv * 2, T * 3 * R * 4, R * 2, R * 2, dr.nv * 4, dr.world * 16, T * 4, T * 4, ctx_rows * h * 2, ctx_rows * 2 * dr.hk * 128 * 2 };
+        var ptrs: [sizes.len]u64 = undefined;
+        for (sizes, &ptrs) |n, *p| {
+            var b = try Buf.alloc(d, @max(n, 256));
+            errdefer b.free();
+            try b.fill8(0, null);
+            try dr.bufs.append(gpa, b);
+            p.* = b.ptr;
+        }
+        inline for (.{ "part", "fold", "fbias", "resid", "x", "qkv", "q", "att", "gu", "act", "gath", "po", "pml", "base", "mctx", "state", "latent", "scores", "picks", "walk", "ids", "mixed", "ckv" }, 0..) |name, i| @field(dr, name) = ptrs[i];
+        try dr.foldHead(m, s, t);
+        return dr;
+    }
+
+    pub fn deinit(dr: *Drafter) void {
+        for (dr.bufs.items) |*b| b.free();
+        dr.bufs.deinit(dr.gpa);
+        dr.lane.unload();
+        dr.k.unload();
+        dr.w.deinit(dr.gpa);
+        dr.gpa.destroy(dr);
+    }
+
+    /// fold = head . hidden_out and fbias = head . bias (vLLM folds the bf16 head in fp64; ours is the pack's head).
+    fn foldHead(dr: *Drafter, m: *fw.Modules, s: cuda.Stream, t: anytype) !void {
+        const h = dr.hidden;
+        const R: usize = dr.w.c.rank;
+        const rows = R + 1;
+        const x = try dr.gpa.alloc(u16, rows * h);
+        defer dr.gpa.free(x);
+        for (0..h) |i| for (0..R) |j| {
+            x[j * h + i] = dr.w.hidden_out[i * R + j];
+        };
+        @memcpy(x[R * h ..][0..h], dr.w.hidden_bias);
+        var xb = try Buf.fromHost(dr.d, std.mem.sliceAsBytes(x));
+        defer xb.free();
+        var y = try Buf.alloc(dr.d, rows * dr.nv * 4);
+        defer y.free();
+        try m.dense.decode(s, t.head, xb.ptr, .bf16, rows, y.ptr, .f32);
+        try s.synchronize();
+        const host = try dr.gpa.alloc(f32, rows * dr.nv);
+        defer dr.gpa.free(host);
+        try y.download(0, std.mem.sliceAsBytes(host));
+        const fold = try dr.gpa.alloc(u16, dr.nv * R);
+        defer dr.gpa.free(fold);
+        const fb = try dr.gpa.alloc(u16, dr.nv);
+        defer dr.gpa.free(fb);
+        for (0..dr.nv) |v| {
+            for (0..R) |j| fold[v * R + j] = ds.tobf(host[j * dr.nv + v]);
+            fb[v] = ds.tobf(host[R * dr.nv + v]);
+        }
+        try (Buf{ .d = dr.d, .ptr = dr.fold, .len = fold.len * 2, .borrowed = true }).upload(0, std.mem.sliceAsBytes(fold));
+        try (Buf{ .d = dr.d, .ptr = dr.fbias, .len = fb.len * 2, .borrowed = true }).upload(0, std.mem.sliceAsBytes(fb));
+    }
+
+    fn mm(dr: *Drafter, s: cuda.Stream, wt: cuda.qmmf.Weight, x: u64, rows: usize, y: u64, out: cuda.qmmf.Out) !void {
+        try dr.lane.matmulOut(s, x, wt.k, rows, wt, y, out, dr.part);
+    }
+
+    /// This rank's fp32 partial (`rows` rows at its slot of gath) to every rank; then the ranks' sum adds in order.
+    fn gather(dr: *Drafter, s: cuda.Stream, ex: fw.Exchange, rows: usize) !void {
+        const n = rows * dr.hidden * 4;
+        switch (ex) {
+            .local => {},
+            .nccl => |x| if (x.group) |g| try g.allGather(s, dr.gath + dr.rank * n, dr.gath, n) else try x.lib.check(x.lib.api.ncclAllGather(dr.gath + dr.rank * n, dr.gath, n, .u8, x.comm, s.handle), "ncclAllGather"),
+        }
+    }
+
+    fn mySlot(dr: *const Drafter, rows: usize) u64 {
+        return dr.gath + dr.rank * rows * dr.hidden * 4;
+    }
+
+    /// Context rows at positions p0.. from their taps (bf16 [rows][8][hidden]): each layer's keys and values, f_rnn.
+    pub fn absorb(dr: *Drafter, s: cuda.Stream, slot: *Slot, taps: u64, rows: usize, p0: usize) !void {
+        if (rows == 0 or rows > dr.ctx_rows) return error.Inkling2DraftShape;
+        const c = &dr.w.c;
+        const h = dr.hidden;
+        for (dr.w.layers[0..c.layers], 0..) |l, i| {
+            try dk.mix(&dr.k, s, taps, dr.w.alpha + i * ds.taps_n * 4, l.dflare, dr.mixed, rows, ds.taps_n, h, c.eps);
+            try dr.mm(s, l.kv, dr.mixed, rows, dr.ckv, .bf16);
+            const r = ring(c, i, dr.capacity);
+            try dk.qk(&dr.k, s, .{ .x = dr.ckv, .qw = 0, .kw = l.k_norm_ctx, .q = 0, .kc = slot.keys(i), .vc = slot.values(i), .ld = @intCast(2 * dr.hk * 128), .hq = 0, .hk = @intCast(dr.hk), .ring = @intCast(r), .pos0 = @intCast(p0), .eps = c.eps, .theta = c.theta }, rows);
+        }
+        const last = taps + (rows - 1) * ds.taps_n * h * 2;
+        try dk.mix(&dr.k, s, last, dr.w.alpha + c.layers * ds.taps_n * 4, dr.w.m_norm, slot.frnn, 1, ds.taps_n, h, c.eps);
+        if (slot.to != p0) slot.from = p0; // a gap: the context starts again here
+        slot.to = p0 + rows;
+    }
+
+    /// A block at anchor `p` (context absorbed below p): `n` drafts, greedy or raced as the verify draws (`race`).
+    pub fn draft(dr: *Drafter, m: *fw.Modules, s: cuda.Stream, ex: fw.Exchange, t: anytype, slot: *Slot, anchor: u32, p: usize, race: ?Race, out: []u32) !void {
+        const c = &dr.w.c;
+        const h = dr.hidden;
+        const n = out.len;
+        if (n == 0 or n > T - 1 or p + T > dr.capacity) return error.Inkling2DraftShape;
+        if (slot.to != p) slot.* = .{ .buf = slot.buf, .off = slot.off, .stash = slot.stash, .frnn = slot.frnn, .from = p, .to = p };
+        const one = [1]i32{@intCast(anchor)};
+        try cuda.copy_source.enqueue(dr.d, dr.ids, std.mem.sliceAsBytes(&one), s);
+        try cuda.copy_source.enqueue(dr.d, dr.walk, std.mem.sliceAsBytes(&one), s);
+        try ops.embed(&m.ops, s, dr.ids, 1, t.embed, t.embed_norm, dr.resid, h, t.config.eps);
+        for (1..T) |r| try dr.copy(s, dr.resid + r * h * 2, dr.w.mask, h * 2);
+        try dk.addNorm(&dr.k, s, dr.resid, 0, 0, 0, dr.w.layers[0].in_norm, dr.x, T, h, c.eps);
+        const L = dr.w.layers[0..c.layers];
+        const scale: f32 = 1.0 / @sqrt(128.0);
+        for (L, 0..) |l, i| {
+            try dr.mm(s, l.qkv, dr.x, T, dr.qkv, .bf16);
+            const r = ring(c, i, dr.capacity);
+            try dk.qk(&dr.k, s, .{ .x = dr.qkv, .qw = l.q_norm, .kw = l.k_norm, .q = dr.q, .kc = slot.keys(i), .vc = slot.values(i), .ld = @intCast((dr.hq + 2 * dr.hk) * 128), .hq = @intCast(dr.hq), .hk = @intCast(dr.hk), .ring = @intCast(r), .pos0 = @intCast(p), .eps = c.eps, .theta = c.theta }, T);
+            const lo = if (c.local[i]) @max(slot.from, p -| c.window) else slot.from;
+            try dk.attend(&dr.k, s, .{ .q = dr.q, .kc = slot.keys(i), .vc = slot.values(i), .po = dr.po, .pml = dr.pml, .T = T, .hq = @intCast(dr.hq), .hk = @intCast(dr.hk), .ring = @intCast(r), .lo = @intCast(lo), .hi = @intCast(p + T - 1), .c0 = 0, .scale = scale }, dr.att);
+            try dr.mm(s, l.o, dr.att, T, dr.mySlot(T), .f32);
+            try dr.gather(s, ex, T);
+            try dk.addNorm(&dr.k, s, dr.resid, dr.gath, dr.world, T * h, l.post_norm, dr.x, T, h, c.eps);
+            try dr.mm(s, l.gu, dr.x, T, dr.gu, .bf16);
+            try dk.silu(&dr.k, s, dr.gu, dr.act, T, dr.inter);
+            try dr.mm(s, l.down, dr.act, T, dr.mySlot(T), .f32);
+            try dr.gather(s, ex, T);
+            const next = if (i + 1 < L.len) L[i + 1].in_norm else dr.w.norm;
+            try dk.addNorm(&dr.k, s, dr.resid, dr.gath, dr.world, T * h, next, dr.x, T, h, c.eps);
+        }
+        // rows 1..7: the head's base logits, the Markov context, then the walk from the anchor
+        const hid = dr.x + h * 2;
+        try m.dense.decode(s, t.head, hid, .bf16, T - 1, dr.base, .bf16);
+        const R: usize = c.rank;
+        try dk.ctx(&dr.k, s, hid, slot.frnn, dr.w.rnn, dr.w.rnn_bias, dr.mctx, T - 1, h, R);
+        try dr.d.check(dr.d.api.cuMemsetD8Async(dr.state, 0, R * 2, s.handle), "cuMemsetD8Async");
+        for (0..n) |j| {
+            try dk.rnn(&dr.k, s, dr.mctx + j * 3 * R * 4, dr.w.rnn, dr.w.w1, dr.walk, j, dr.state, dr.latent, R, h);
+            try dk.vocab(&dr.k, s, dr.base + j * dr.nv * 2, dr.latent, dr.fold, dr.fbias, dr.cap, dr.valid, dr.nv, dr.scores);
+            if (dr.keep_logits != 0) try dr.copy(s, dr.keep_logits + j * dr.nv * 4, dr.scores, dr.nv * 4);
+            const mine = dr.picks + dr.rank * 16;
+            if (race) |r| {
+                try ops.race1(&m.ops, s, dr.scores, dr.valid, dr.vlo, r.seed, r.inv_t, p + 1 + j, mine, mine + 4);
+            } else try ops.top1(&m.ops, s, dr.scores, 1, dr.nv, dr.nv, dr.vlo, mine, mine + 4);
+            switch (ex) {
+                .local => {},
+                .nccl => |x| if (x.group) |g| try g.allGather(s, mine, dr.picks, 16) else try x.lib.check(x.lib.api.ncclAllGather(mine, dr.picks, 16, .u8, x.comm, s.handle), "ncclAllGather"),
+            }
+            try dk.pick(&dr.k, s, dr.picks, dr.world, dr.walk, j);
+        }
+        try s.synchronize();
+        switch (ex) {
+            .local => {},
+            .nccl => |x| if (x.group) |g| try g.check(),
+        }
+        var got: [T]i32 = undefined;
+        try (Buf{ .d = dr.d, .ptr = dr.walk, .len = T * 4, .borrowed = true }).download(0, std.mem.sliceAsBytes(got[0 .. n + 1]));
+        for (out, got[1 .. n + 1]) |*o, g| o.* = @intCast(g);
+    }
+
+    fn copy(dr: *const Drafter, s: cuda.Stream, dst: u64, src: u64, bytes: usize) !void {
+        try dr.d.check(dr.d.api.cuMemcpyDtoDAsync_v2(dst, src, bytes, s.handle), "cuMemcpyDtoDAsync");
+    }
+};
+
+test "dspark slots: rings for the sliding layers, the global layer at capacity, stash and f_rnn after" {
+    var c: ds.Config = .{};
+    c.local = .{ true, true, false, true, true, false, false, false };
+    const n = slotBytes(&c, 4, 65536, 4608);
+    try std.testing.expectEqual(@as(usize, 4 * 2 * 4096 * 4 * 256 + 2 * 65536 * 4 * 256 + 8 * 8 * 4608 * 2 + 4608 * 2), n);
+}
diff --git a/zig/src/families/inkling2/dump_main.zig b/zig/src/families/inkling2/dump_main.zig
new file mode 100644
index 000000000..e37b191f6
--- /dev/null
+++ b/zig/src/families/inkling2/dump_main.zig
@@ -0,0 +1,145 @@
+//! tf-inkling2-cuda: every row's logits of each text on one GPU, as one prompt pass (in chunks) and as decode rows.
+
+const std = @import("std");
+const cuda = @import("cuda");
+const ink = @import("inkling2");
+
+const usage = "usage: tf-inkling2-cuda <model dir> <ids.json> <out dir> [prompt chunk rows]\n" ++
+    "  ids.json maps text names to token ids; writes <name>.<path>.f32 ([rows][real vocab]) for paths prompt, decode\n" ++
+    "  (each text alone) and streams-prompt, streams-decode (all texts at once, a slot each);\n" ++
+    "  at two ranks set TF_INKLING2_RANK, TF_INKLING2_WORLD and NCCL_COMM_ID: each writes its vocab rows (.r<rank>.f32)\n";
+
+pub fn main(init: std.process.Init) !u8 {
+    const a = init.arena.allocator();
+    const gpa = init.gpa;
+    const io = init.io;
+    const args = try init.minimal.args.toSlice(a);
+    if (args.len != 4 and args.len != 5) {
+        std.debug.print("{s}", .{usage});
+        return 2;
+    }
+    const text = try std.Io.Dir.cwd().readFileAlloc(io, args[2], a, .limited(1 << 26));
+    var doc = try std.json.parseFromSlice(std.json.Value, a, text, .{});
+    defer doc.deinit();
+    if (doc.value != .object) return error.BadIds;
+    const Text = struct { name: []const u8, ids: []i32 };
+    var list: std.ArrayList(Text) = .empty;
+    var longest: usize = 0;
+    var total: usize = 0;
+    var it = doc.value.object.iterator();
+    while (it.next()) |e| {
+        const v = e.value_ptr.array.items;
+        const ids = try a.alloc(i32, v.len);
+        for (v, ids) |x, *id| id.* = @intCast(x.integer);
+        if (ids.len == 0) return error.BadIds;
+        try list.append(a, .{ .name = e.key_ptr.*, .ids = ids });
+        longest = @max(longest, ids.len);
+        total += ids.len;
+    }
+    const texts = list.items;
+    if (texts.len == 0 or texts.len > ink.forward.max_items) return error.BadIds;
+    const chunk = if (args.len == 5) try std.fmt.parseInt(usize, args[4], 10) else longest;
+
+    var driver = try cuda.Driver.open();
+    defer driver.close();
+    var ctx = try cuda.Context.init(&driver, 0);
+    defer ctx.deinit();
+    if (try ctx.capability() != 121) return error.Inkling2RequiresSm121; // a one-GPU check tool: sm_121 as served
+    var stream = try cuda.Stream.init(&driver, false);
+    defer stream.deinit();
+    var m = try ink.forward.Modules.load(&driver);
+    defer m.deinit();
+    const place = try ink.admit.place();
+    var lib: ?cuda.nccl.Library = null;
+    var comm: cuda.nccl.Comm = null;
+    if (place.world > 1) {
+        if (std.c.getenv("NCCL_COMM_ID") == null) return error.NoCommId;
+        lib = try cuda.nccl.Library.open();
+        var id: cuda.nccl.UniqueId = undefined;
+        // NCCL_COMM_ID names rank 0's bootstrap root: every rank's id is that address
+        try lib.?.check(lib.?.api.ncclGetUniqueId(&id), "ncclGetUniqueId");
+        try lib.?.check(lib.?.api.ncclCommInitRank(&comm, @intCast(place.world), id, @intCast(place.rank)), "ncclCommInitRank");
+    }
+    defer if (lib) |*l| {
+        _ = l.api.ncclCommDestroy(comm);
+        l.close();
+    };
+    const c = try ink.config.Config.read(gpa, io, args[1]);
+    var t0 = std.Io.Clock.awake.now(io).toNanoseconds();
+    var w = try ink.weights.load(gpa, io, &driver, &m.dense, stream, args[1], c, place.rank, place.world);
+    defer w.deinit();
+    std.debug.print("rank {d}/{d}: loaded {d} layers, {d:.2} GiB in {d:.1} s, vocab [{d}, {d})\n", .{ place.rank, place.world, c.layers, gib(w.bytes), secs(io, t0), w.share.vocab.lo, w.share.vocab.hi });
+    const shape: ink.forward.Shape = .{ .rows = @max(@min(chunk, longest), total), .context = std.mem.alignForward(usize, longest + 1, 64), .heads = w.share.heads.len(), .kv = w.share.kv.len() };
+    var b = try ink.forward.Buffers.init(gpa, &driver, &w, shape, null);
+    defer b.deinit();
+    var st = try ink.forward.State.init(gpa, &driver, &w.config, shape, texts.len);
+    defer st.deinit();
+    // prompt rows' projections by the GEMM, as the engine runs them (without cuBLASLt: the decode kernels)
+    m.prompt = ink.prompt_dense.Prompt.of(gpa, &driver, m.ops.prompt_tail, shape.rows, w.layers) catch null;
+    var f: ink.forward.Forward = .{ .d = &driver, .m = &m, .w = &w, .b = &b, .shape = shape, .stream = stream };
+    if (lib) |*l| f.exchange = .{ .nccl = .{ .lib = l, .comm = comm } };
+    try std.Io.Dir.cwd().createDirPath(io, args[3]);
+    var out = try std.Io.Dir.cwd().openDir(io, args[3], .{});
+    defer out.close(io);
+    const nv = w.share.vocab.len();
+    const real: usize = if (place.world == 1) c.real_vocab else nv; // a rank's rows: the check joins and trims them
+    const row = try gpa.alloc(f32, shape.rows * nv);
+    defer gpa.free(row);
+    const all = try a.alloc([]f32, texts.len);
+    for (all, texts) |*x, t| x.* = try a.alloc(f32, t.ids.len * real);
+    // each text alone (slot 0), as one prompt pass in chunks and as decode rows; then all texts at once, one slot each
+    for ([_][]const u8{ "prompt", "decode", "streams-prompt", "streams-decode" }) |path| {
+        const together = std.mem.startsWith(u8, path, "streams");
+        const step = if (std.mem.endsWith(u8, path, "prompt")) @min(chunk, longest) else 1;
+        t0 = std.Io.Clock.awake.now(io).toNanoseconds();
+        if (together) try st.reset();
+        var items: [ink.forward.max_items]ink.forward.Item = undefined;
+        for (texts, 0..) |t, k| {
+            if (!together) try st.reset();
+            var at: usize = 0;
+            while (true) {
+                // together: one call per step over every text with rows left (its own slot), else this text in slot 0
+                var ni: usize = 0;
+                if (together) {
+                    if (k != 0) break;
+                    for (texts, 0..) |u, j| if (at < u.ids.len) {
+                        items[ni] = .{ .slot = j, .ids = u.ids[at..][0..@min(step, u.ids.len - at)] };
+                        ni += 1;
+                    };
+                } else if (at < t.ids.len) {
+                    items[0] = .{ .slot = 0, .ids = t.ids[at..][0..@min(step, t.ids.len - at)] };
+                    ni = 1;
+                }
+                if (ni == 0) break;
+                try f.run(&st, items[0..ni]);
+                try stream.synchronize();
+                var rows: usize = 0;
+                for (items[0..ni]) |x| rows += x.ids.len;
+                try b.logits.download(0, std.mem.sliceAsBytes(row[0 .. rows * nv]));
+                var r0: usize = 0;
+                for (items[0..ni]) |x| {
+                    const dst = all[if (together) x.slot else k];
+                    for (0..x.ids.len) |r| @memcpy(dst[(at + r) * real ..][0..real], row[(r0 + r) * nv ..][0..real]);
+                    r0 += x.ids.len;
+                }
+                at += step;
+            }
+        }
+        for (texts, all) |t, x| {
+            var name: [128]u8 = undefined;
+            const file = if (place.world == 1) try std.fmt.bufPrint(&name, "{s}.{s}.f32", .{ t.name, path }) else try std.fmt.bufPrint(&name, "{s}.{s}.r{d}.f32", .{ t.name, path, place.rank });
+            try out.writeFile(io, .{ .sub_path = file, .data = std.mem.sliceAsBytes(x) });
+            std.debug.print("{s} {s}: {d} rows, last row argmax {d}\n", .{ t.name, path, t.ids.len, std.mem.indexOfMax(f32, x[(t.ids.len - 1) * real ..][0..real]) });
+        }
+        std.debug.print("{s}: {d:.2} s\n", .{ path, secs(io, t0) });
+    }
+    return 0;
+}
+
+fn gib(x: u64) f64 {
+    return @as(f64, @floatFromInt(x)) / (1 << 30);
+}
+
+fn secs(io: std.Io, t0: anytype) f64 {
+    return @as(f64, @floatFromInt(std.Io.Clock.awake.now(io).toNanoseconds() - t0)) * 1e-9;
+}
diff --git a/zig/src/families/inkling2/engine.zig b/zig/src/families/inkling2/engine.zig
new file mode 100644
index 000000000..67a6ba204
--- /dev/null
+++ b/zig/src/families/inkling2/engine.zig
@@ -0,0 +1,500 @@
+//! One TP rank's Inkling 2 engine: streams by slot, prompt chunks, decode windows (shared, graphed) and their draws.
+const std = @import("std");
+const cuda = @import("cuda");
+const cfg = @import("shape.zig");
+const shard = @import("shard.zig");
+const weights = @import("weights.zig");
+const fw = @import("forward.zig");
+const ops = @import("ops.zig");
+const sampler = @import("sampler.zig");
+const kept = @import("kept.zig");
+const ds = @import("dspark.zig");
+const drun = @import("dspark_run.zig");
+const vision = @import("vision.zig");
+const image = @import("image.zig");
+const pictures = @import("pictures.zig");
+
+/// Rows a prompt chunk holds (the prompt cache's mark grid) and a stream's window at most.
+pub const prompt_rows = 2048;
+pub const window_rows = 8;
+/// A shared decode forward's rows and streams at most.
+pub const shared_rows = 64;
+pub const max_shared = 16;
+/// Partial slots a prompt call writes at most: 2,048 rows over 8 global chunks (deeper calls take fewer rows).
+const prompt_parts = 8;
+
+/// Rank 0's own word on its request (cancelled or not); the other ranks have none and hear rank 0's.
+pub const Cancel = struct { ptr: ?*anyopaque, check: *const fn (?*anyopaque) bool };
+
+/// One stream's window in a shared forward: its slot, its ids (pending token, then drafts), its draws.
+pub const Part = struct { slot: u32, ids: []const u32, out: []u32 };
+
+/// A slot's request state: sampling, and its last window (rows, ids, start) for a keep shorter than the window.
+const Seq = struct {
+    sampling: ?sampler.Sampling = null,
+    rows: usize = 0, // rows of the last window still uncommitted
+    at: usize = 0, // where that window started
+    ids: [window_rows]i32 = undefined,
+    row0: usize = 0, // its first row in that decode call
+    call: u64 = 0, // the decode call it ran in (its conv inputs stay in bd.hist until the next one)
+};
+
+pub const Options = struct { capacity: usize, drafts: bool = true, vision: ?pictures.Limits = null };
+
+/// A stream's draft request: its slot, the rows of its last window it kept (0: the prompt's), the token after them.
+pub const Req = struct { slot: u32, n: u32, anchor: u32, out: []u32 };
+
+/// A graph's key: a decode call's rows, streams, attention tiles and partial stride (its global chunks).
+const Key = struct { n: u32, ni: u32, nt: u32, stride: u32 };
+
+pub const Engine = struct {
+    gpa: std.mem.Allocator,
+    io: std.Io,
+    d: *const cuda.Driver,
+    c: cfg.Config,
+    m: fw.Modules,
+    stream: cuda.Stream,
+    w: weights.Weights,
+    shape_p: fw.Shape,
+    shape_d: fw.Shape,
+    bp: fw.Buffers,
+    bd: fw.Buffers,
+    parts: std.ArrayList(cuda.DeviceBuffer) = .empty, // the partials bp and bd share (one stream runs both in order)
+    st: ?fw.State = null, // every slot's caches, made by reserve
+    backup: ?cuda.DeviceBuffer = null, // each slot's conv states before a window of several rows
+    seqs: []Seq = &.{},
+    slot: u32 = 0,
+    capacity: usize,
+    exchange: fw.Exchange = .local,
+    picks: cuda.DeviceBuffer, // every rank's (value, id) of each row's greedy pick: fp32 then i32, [world][rows]
+    picks_host: []u8,
+    smp: sampler.Sampler,
+    spans: []shard.Span, // every rank's vocabulary span
+    graphs: cuda.graph_cache.Cache(Key),
+    gengine: cuda.graph_cache.CudaEngine,
+    states: kept.Store,
+    checkpoint_digest: [32]u8 = @splat(0),
+    drafter: ?*drun.Drafter = null, // mtp.safetensors beside the pack: each stream's next block
+    dslots: []drun.Slot = &.{},
+    tap_at: [7]u32 = undefined,
+    tap_bufs: [2]?cuda.DeviceBuffer = .{ null, null },
+    vision: ?pictures.Limits = null, // images on (--vision): every rank's rows a slot, rank 0's tower
+    tower: ?*vision.Tower = null,
+    rows: []pictures.Rows = &.{},
+    calls: u64 = 0, // decode calls on bd so far
+    sites: ?cuda.DeviceBuffer = null, // every conv site's ops.RewindSite (keep without a forward)
+
+    pub fn init(gpa: std.mem.Allocator, io: std.Io, d: *const cuda.Driver, dir: []const u8, rank: usize, world: usize, o: Options) !*Engine {
+        const e = try gpa.create(Engine);
+        errdefer gpa.destroy(e);
+        const c = try cfg.Config.read(gpa, io, dir);
+        var stream = try cuda.Stream.init(d, false);
+        errdefer stream.deinit();
+        var m = try fw.Modules.load(d);
+        errdefer m.deinit();
+        e.* = .{ .gpa = gpa, .io = io, .d = d, .c = c, .m = m, .stream = stream, .w = undefined, .shape_p = undefined, .shape_d = undefined, .bp = undefined, .bd = undefined, .capacity = o.capacity, .picks = undefined, .picks_host = &.{}, .smp = undefined, .spans = &.{}, .graphs = undefined, .gengine = .{ .d = d }, .states = .{ .gpa = gpa } };
+        e.w = try weights.load(gpa, io, d, &e.m.dense, stream, dir, c, rank, world);
+        errdefer e.w.deinit();
+        const heads = e.w.share.heads.len();
+        const kv = e.w.share.kv.len();
+        e.shape_p = .{ .rows = prompt_rows, .context = o.capacity, .heads = heads, .kv = kv };
+        e.shape_d = .{ .rows = shared_rows, .context = o.capacity, .heads = heads, .kv = kv, .ring_rows = prompt_rows, .hist = true };
+        errdefer for (e.parts.items) |*b| b.free();
+        const slots = @max(prompt_rows * heads * prompt_parts, shared_rows * heads * fw.stride(&e.c, o.capacity - 1));
+        const shared = try fw.partialsFor(d, &e.parts, gpa, slots);
+        e.bp = try fw.Buffers.init(gpa, d, &e.w, e.shape_p, shared);
+        errdefer e.bp.deinit();
+        e.bd = try fw.Buffers.init(gpa, d, &e.w, e.shape_d, shared);
+        errdefer e.bd.deinit();
+        for (e.w.layers) |l| for ([_]cuda.exl3.Weight{ l.attn.q, l.attn.k, l.attn.v, l.attn.r, l.attn.gate, l.attn.o }) |x| try e.m.dense.reserve(stream, x);
+        try e.m.dense.reserve(stream, e.w.head); // scratch grown now, so nothing allocates inside a graph capture
+        e.m.prompt = @import("prompt_dense.zig").Prompt.of(gpa, d, e.m.ops.prompt_tail, prompt_rows, e.w.layers) catch |err| blk: { // without cuBLASLt, prompt rows keep the decode kernels
+            std.log.warn("inkling2: prompt projections on the decode kernels ({s})", .{@errorName(err)});
+            break :blk null;
+        };
+        for (e.w.layers) |l| for ([_]cuda.exl3.Weight{ l.attn.k, l.attn.v, l.attn.r }) |x| try e.m.side.dense.reserve(stream, x);
+        if (o.drafts and ds.present(io, gpa, dir)) try e.loadDrafter(dir, o.capacity);
+        errdefer e.freeDrafter();
+        e.vision = o.vision;
+        if (o.vision != null and rank == 0) e.tower = try vision.Tower.load(gpa, io, d, dir, pictures.picture_tokens);
+        errdefer if (e.tower) |t| t.deinit();
+        e.picks = try cuda.DeviceBuffer.alloc(d, world * pickStride(shared_rows));
+        errdefer e.picks.free();
+        e.picks_host = try gpa.alloc(u8, world * pickStride(shared_rows));
+        errdefer gpa.free(e.picks_host);
+        e.smp = try sampler.Sampler.init(d, e.w.padded_vocab, shared_rows);
+        errdefer e.smp.deinit();
+        e.spans = try gpa.alloc(shard.Span, world);
+        for (e.spans, 0..) |*sp, q| sp.* = (try shard.Share.of(&e.c, e.w.padded_vocab, q, world)).vocab;
+        e.graphs = .init(gpa, e.gengine.engine(), .{});
+        e.graphs.name = "inkling2 decode";
+        try e.stream.synchronize();
+        return e;
+    }
+
+    pub fn deinit(e: *Engine) void {
+        e.stream.synchronize() catch {};
+        e.graphs.deinit();
+        e.states.deinit();
+        e.freeDrafter();
+        if (e.tower) |t| t.deinit();
+        pictures.freeRows(e.gpa, e.rows);
+        if (e.st) |*s| s.deinit();
+        if (e.backup) |*b| b.free();
+        if (e.sites) |*b| b.free();
+        e.gpa.free(e.seqs);
+        e.gpa.free(e.spans);
+        e.smp.deinit();
+        e.gpa.free(e.picks_host);
+        e.picks.free();
+        e.bd.deinit();
+        e.bp.deinit();
+        for (e.parts.items) |*b| b.free();
+        e.parts.deinit(e.gpa);
+        e.w.deinit();
+        e.m.deinit();
+        e.stream.deinit();
+        const gpa = e.gpa;
+        gpa.destroy(e);
+    }
+
+    /// Bytes one more stream takes on this rank: its slot's rings and conv states, their backup, its drafter caches.
+    pub fn seqBytes(e: *const Engine) u64 {
+        const draft: u64 = if (e.drafter) |dr| drun.slotBytes(&dr.w.c, e.shape_d.kv, e.capacity, e.c.hidden) else 0;
+        const rows: u64 = if (e.vision) |l| pictures.slotBytes(l) else 0;
+        return fw.slotBytes(&e.c, e.shape_d) + e.convBytes() + draft + rows;
+    }
+
+    /// The drafter's weights, scratch and the forwards' tap rows (rows x 8 taps x hidden, bf16).
+    fn loadDrafter(e: *Engine, dir: []const u8, capacity: usize) !void {
+        var dw = try ds.load(e.gpa, e.io, e.d, dir, &e.w);
+        e.tap_at = dw.c.tapLayers(e.c.layers);
+        e.drafter = drun.Drafter.init(e.gpa, e.d, &e.m, e.stream, dw, &e.w, capacity, prompt_rows) catch |err| {
+            dw.deinit(e.gpa);
+            return err;
+        };
+        errdefer e.freeDrafter();
+        for (&e.tap_bufs, [_]*fw.Buffers{ &e.bp, &e.bd }, [_]usize{ prompt_rows, shared_rows }) |*tb, b, rows| {
+            tb.* = try cuda.DeviceBuffer.alloc(e.d, rows * ds.taps_n * @as(usize, e.c.hidden) * 2);
+            b.taps = tb.*.?.ptr;
+        }
+    }
+
+    fn freeDrafter(e: *Engine) void {
+        for (e.dslots) |*s| s.buf.free();
+        e.gpa.free(e.dslots);
+        e.dslots = &.{};
+        for (&e.tap_bufs) |*tb| if (tb.*) |*b| {
+            b.free();
+            tb.* = null;
+        };
+        if (e.drafter) |dr| dr.deinit();
+        e.drafter = null;
+    }
+
+    /// The largest all-gather a rank sends (a prompt call's fp32 partial): RoCE writes take every gather up to it.
+    pub fn roceBytes(e: *const Engine) usize {
+        return prompt_rows * @as(usize, e.c.hidden) * 4;
+    }
+
+    fn convBytes(e: *const Engine) usize {
+        return @as(usize, e.c.layers) * 2 * 3 * (e.shape_d.kv * e.c.head_dim + e.c.hidden) * 4;
+    }
+
+    /// Every slot's caches for `slots` streams, made once (the host's admission decides how many).
+    pub fn reserve(e: *Engine, slots: usize) !void {
+        if (e.st != null) return if (e.seqs.len == slots) {} else error.Inkling2Reserved;
+        e.st = try fw.State.init(e.gpa, e.d, &e.c, e.shape_d, slots);
+        errdefer {
+            e.st.?.deinit();
+            e.st = null;
+        }
+        e.backup = try cuda.DeviceBuffer.alloc(e.d, slots * e.convBytes());
+        errdefer e.backup.?.free();
+        e.sites = try e.siteTable();
+        errdefer {
+            e.sites.?.free();
+            e.sites = null;
+        }
+        if (e.vision) |l| e.rows = try pictures.makeRows(e.gpa, e.d, l, slots);
+        e.seqs = try e.gpa.alloc(Seq, slots);
+        @memset(e.seqs, .{});
+        if (e.drafter) |dr| {
+            e.dslots = try e.gpa.alloc(drun.Slot, slots);
+            for (e.dslots, 0..) |*s, i| s.* = drun.initSlot(e.d, &dr.w.c, e.shape_d.kv, e.capacity, e.c.hidden) catch |err| {
+                for (e.dslots[0..i]) |*x| x.buf.free();
+                e.gpa.free(e.dslots);
+                e.dslots = &.{};
+                return err;
+            };
+        }
+    }
+
+    pub fn slotCount(e: *const Engine) usize {
+        return e.seqs.len;
+    }
+
+    pub fn bind(e: *Engine, slot: u32) !void {
+        if (slot >= e.seqs.len) return error.Inkling2NoSlot;
+        e.slot = slot;
+    }
+
+    /// The bound slot's committed length: the pending token sits there, a window's row r draws position pos + 1 + r.
+    pub fn pos(e: *const Engine) usize {
+        return e.st.?.pos[e.slot];
+    }
+
+    /// A new request on the bound slot with `sampling` (null or temperature 0: greedy).
+    pub fn begin(e: *Engine, s: ?sampler.Sampling) void {
+        e.seqs[e.slot] = .{ .sampling = sampler.check(s) };
+        if (e.rows.len > 0) e.rows[e.slot].spans.clearRetainingCapacity(); // a new request splices nothing until told
+    }
+
+    /// The bound slot's pictures for its next prompt pass: rank 0 encodes them (`pics`), every rank gets the rows.
+    pub fn images(e: *Engine, pics: ?[]const image.Prepared, spans: []const vision.Span) !void {
+        const l = e.vision orelse return error.NoVision;
+        if (e.rows.len == 0) return error.Inkling2Reserved;
+        const total = try pictures.checkSpans(spans, l);
+        const r = &e.rows[e.slot];
+        r.spans.clearRetainingCapacity();
+        if (e.tower) |t| {
+            const ps = pics orelse return error.ImagePlaceholders;
+            if (ps.len != spans.len) return error.ImagePlaceholders;
+            for (ps, spans) |p, sp| try t.encode(e.stream, p, r.buf.ptr + @as(u64, sp.row) * vision.hidden * 2);
+        } else if (e.exchange == .local) return error.NoVision;
+        switch (e.exchange) {
+            .local => {},
+            .nccl => |x| try x.lib.check(x.lib.api.ncclBroadcast(r.buf.ptr, r.buf.ptr, @as(usize, total) * vision.hidden * 2, .u8, 0, x.comm, e.stream.handle), "ncclBroadcast"),
+        }
+        try r.spans.appendSlice(e.gpa, spans);
+    }
+
+    fn forward(e: *Engine, b: *fw.Buffers, shape: fw.Shape) fw.Forward {
+        return .{ .d = e.d, .m = &e.m, .w = &e.w, .b = b, .shape = shape, .stream = e.stream, .exchange = e.exchange, .tap_at = if (b.taps != 0) e.tap_at else null };
+    }
+
+    /// One chunk of the bound slot's prompt from `start` (0: a fresh pass); the first token once it ends the prompt.
+    pub fn prefillChunk(e: *Engine, ids: []const u32, start: usize) !?u32 {
+        const st = &e.st.?;
+        if (ids.len == 0 or ids.len + window_rows >= e.capacity) return error.PromptTooLong;
+        if (start >= ids.len or start % prompt_rows != 0) return error.BadChunk;
+        if (start == 0) try st.clearSlot(&e.c, e.d, e.slot, e.stream) else if (start != st.pos[e.slot]) return error.BadChunk;
+        e.states.overwrite(e.slot, start); // states on this slot past `start` lose their rows to this pass
+        const end = @min(ids.len, start + prompt_rows);
+        var f = e.forward(&e.bp, e.shape_p);
+        f.last_logits = true;
+        // a deep call writes partials for every global chunk: fewer rows a call, the same bits a row
+        const most = @max(1, e.bp.parts.slots / (e.shape_p.heads * fw.stride(&e.c, end - 1)));
+        var at = start;
+        var n: usize = 0;
+        while (at < end) : (at += n) {
+            n = @min(end - at, most);
+            const item = [_]fw.Item{.{ .slot = e.slot, .ids = @ptrCast(ids[at..][0..n]) }};
+            var g = f;
+            if (e.rows.len > 0 and e.rows[e.slot].spans.items.len > 0) g.images = .{ .rows = e.rows[e.slot].buf.ptr, .spans = e.rows[e.slot].spans.items, .lo = at };
+            try g.run(st, &item);
+            if (e.drafter) |dr| try dr.absorb(e.stream, &e.dslots[e.slot], e.bp.taps, n, at);
+        }
+        if (end < ids.len) return null;
+        var t: [1]u32 = undefined;
+        try e.draw(&e.bp, n - 1, 1, ids.len, e.seqs[e.slot].sampling, &t);
+        return t[0];
+    }
+
+    /// Several streams' windows in one forward (each on its own slot), graphed when no window holds several rows.
+    pub fn verifyShared(e: *Engine, parts: []const Part) !void {
+        const st = &e.st.?;
+        if (parts.len == 0 or parts.len > max_shared) return error.WindowTooWide;
+        var items: [max_shared]fw.Item = undefined;
+        var ids: [shared_rows]i32 = undefined;
+        var rows: usize = 0;
+        for (parts, 0..) |p, i| {
+            if (p.ids.len == 0 or p.ids.len > window_rows or rows + p.ids.len > shared_rows) return error.WindowTooWide;
+            for (parts[0..i]) |q| if (q.slot == p.slot) return error.SlotTwice;
+            if (p.slot >= e.seqs.len) return error.Inkling2NoSlot;
+            if (st.pos[p.slot] + p.ids.len + 1 > e.capacity) return error.ContextFull;
+            for (p.ids, 0..) |t, r| ids[rows + r] = @intCast(t);
+            items[i] = .{ .slot = p.slot, .ids = ids[rows..][0..p.ids.len] };
+            const q = &e.seqs[p.slot];
+            q.rows = p.ids.len;
+            q.at = st.pos[p.slot];
+            q.row0 = rows;
+            q.call = e.calls + 1;
+            @memcpy(q.ids[0..p.ids.len], ids[rows..][0..p.ids.len]);
+            if (p.ids.len > 1) try e.convCopy(p.slot, true);
+            rows += p.ids.len;
+        }
+        const f = e.forward(&e.bd, e.shape_d);
+        const plan = try f.stage(st, items[0..parts.len]);
+        const Body = struct {
+            f: fw.Forward,
+            st: *const fw.State,
+            p: fw.Plan,
+            fn run(ctx: *anyopaque, _: cuda.Stream) anyerror!void {
+                const b: *@This() = @ptrCast(@alignCast(ctx));
+                try b.f.launch(b.st, b.p);
+            }
+        };
+        var body: Body = .{ .f = f, .st = st, .p = plan };
+        const key: Key = .{ .n = @intCast(plan.n), .ni = @intCast(plan.ni), .nt = @intCast(plan.nt), .stride = plan.stride };
+        const print = cuda.graph_cache.fingerprintOf(&.{ st.kc[0], e.bd.ids.ptr, e.bd.parts.o });
+        _ = try e.graphs.run(key, e.stream, print, .{ .ctx = &body, .run = Body.run });
+        e.calls += 1;
+        fw.Forward.advance(st, items[0..parts.len]);
+        var row: usize = 0;
+        for (parts) |p| {
+            e.slot = p.slot;
+            if (e.drafter != null) {
+                const tb = ds.taps_n * @as(usize, e.c.hidden) * 2;
+                try e.copy(e.dslots[p.slot].stash, e.bd.taps + row * tb, p.ids.len * tb); // the next draft absorbs the kept
+            }
+            try e.draw(&e.bd, row, p.ids.len, st.pos[p.slot] - p.ids.len + 1, e.seqs[p.slot].sampling, p.out[0..p.ids.len]);
+            row += p.ids.len;
+        }
+    }
+
+    /// The bound slot's last window keeps its first `n` rows: past them its conv states and length go back.
+    pub fn keep(e: *Engine, n: usize) !void {
+        const st = &e.st.?;
+        const q = &e.seqs[e.slot];
+        if (n == 0 or n > q.rows) return error.BadKeep;
+        if (n < q.rows and q.call == e.calls and e.sites != null) {
+            // the window's conv states ran over every row: the kept rows' inputs (kept in bd.hist) after the backup's
+            const sites = @as(usize, e.c.layers) * 4;
+            const backup = e.backup.?.ptr + e.slot * e.convBytes();
+            try ops.rewind(&e.m.ops, e.stream, e.sites.?.ptr, sites, e.c.hidden, backup, e.bd.hist, e.slot, q.row0, n);
+            st.pos[e.slot] = q.at + n;
+        } else if (n < q.rows) {
+            // bd.hist holds a later call's rows: restore the states and run the kept rows again (same bits)
+            try e.convCopy(e.slot, false);
+            st.pos[e.slot] = q.at;
+            const item = [_]fw.Item{.{ .slot = e.slot, .ids = q.ids[0..n] }};
+            try e.forward(&e.bd, e.shape_d).run(st, &item);
+            e.calls += 1;
+        }
+        q.rows = 0;
+    }
+
+    /// Every conv site's slot-0 state, hist offset (bd's rows), backup offset (convCopy's order), width: on the device.
+    fn siteTable(e: *Engine) !cuda.DeviceBuffer {
+        const st = &e.st.?;
+        const sites = try e.gpa.alloc(ops.RewindSite, @as(usize, e.c.layers) * 4);
+        defer e.gpa.free(sites);
+        var off: usize = 0;
+        for (st.conv, 0..) |cv, i| for (cv, 0..) |base, j| {
+            const c = if (j < 2) st.kv * e.c.head_dim else @as(usize, e.c.hidden);
+            const h = fw.histAt(&e.c, e.shape_d.kv, e.shape_d.rows, i, j);
+            sites[i * 4 + j] = .{ .state = base, .hist = @intCast(h), .backup = @intCast(off), .c = @intCast(c) };
+            off += 3 * c * 4;
+        };
+        return cuda.DeviceBuffer.fromHost(e.d, std.mem.sliceAsBytes(sites));
+    }
+
+    /// The slot's conv states to (out) or from its backup.
+    fn convCopy(e: *Engine, slot: usize, out: bool) !void {
+        const st = &e.st.?;
+        var off: usize = slot * e.convBytes();
+        for (st.conv) |cv| for (cv, 0..) |base, j| {
+            const n = 3 * (if (j < 2) st.kv * e.c.head_dim else @as(usize, e.c.hidden)) * 4;
+            const src = base + slot * n;
+            try e.copy(if (out) e.backup.?.ptr + off else src, if (out) src else e.backup.?.ptr + off, n);
+            off += n;
+        };
+    }
+
+    fn copy(e: *const Engine, dst: u64, src: u64, bytes: usize) !void {
+        try e.d.check(e.d.api.cuMemcpyDtoDAsync_v2(dst, src, bytes, e.stream.handle), "cuMemcpyDtoDAsync");
+    }
+
+    /// Rows of this rank's logits (from row `row0` of `b`) to tokens at first, first + 1, ...: sampled or greedy.
+    fn draw(e: *Engine, b: *fw.Buffers, row0: usize, rows: usize, first: u64, sm: ?sampler.Sampling, out: []u32) !void {
+        const sh = e.w.share;
+        const n = sh.vocab.len();
+        const real = @min(n, @as(usize, e.c.real_vocab) -| sh.vocab.lo);
+        const logits = b.logits.ptr + row0 * n * 4;
+        if (sm) |s| {
+            try ops.tobf(&e.m.ops, e.stream, logits, rows, n, real, e.smp.full.ptr, e.smp.vocab, sh.vocab.lo, n);
+            try e.smp.draw(e.stream, e.exchange, e.spans, rows, first, sampler.rule(s), out);
+            return e.gathered();
+        }
+        const stride = pickStride(rows);
+        const vals = e.picks.ptr + sh.rank * stride;
+        try ops.top1(&e.m.ops, e.stream, logits, rows, n, real, sh.vocab.lo, vals, vals + rows * 4);
+        switch (e.exchange) {
+            .local => {},
+            .nccl => |x| if (x.group) |g| try g.allGather(e.stream, vals, e.picks.ptr, stride) else try x.lib.check(x.lib.api.ncclAllGather(vals, e.picks.ptr, stride, .u8, x.comm, e.stream.handle), "ncclAllGather"),
+        }
+        try e.stream.synchronize();
+        try e.gathered();
+        const bytes = e.picks_host[0 .. sh.world * stride];
+        try e.picks.download(0, bytes);
+        for (0..rows) |r| {
+            var best: f32 = -std.math.inf(f32);
+            var id: u32 = 0;
+            for (0..sh.world) |q| {
+                const at = q * stride;
+                const v: f32 = @bitCast(std.mem.readInt(u32, bytes[at + r * 4 ..][0..4], .little));
+                const i = std.mem.readInt(u32, bytes[at + rows * 4 + r * 4 ..][0..4], .little);
+                if (v > best or (v == best and i < id)) {
+                    best = v;
+                    id = i;
+                }
+            }
+            out[r] = id;
+        }
+    }
+
+    /// After a synchronize: a RoCE gather that failed since the last one (its rows hold nothing valid) is an error.
+    fn gathered(e: *const Engine) !void {
+        switch (e.exchange) {
+            .local => {},
+            .nccl => |x| if (x.group) |g| try g.check(),
+        }
+    }
+
+    /// Bytes a kept state takes on this rank: the slot's sliding rings and conv states (global rows stay in place).
+    pub fn stateBytes(e: *const Engine) u64 {
+        return kept.bytes(&e.c, &e.st.?, e.convBytes());
+    }
+
+    /// The bound slot's state at its length kept under `id` (every rank keeps the same id).
+    pub fn keepAs(e: *Engine, id: u64, at: usize) !void {
+        if (at == 0 or at != e.pos()) return error.BadKeep;
+        try e.states.save(e.d, e.stream, &e.c, &e.st.?, e.slot, id, at, e.convBytes());
+    }
+
+    /// The bound slot restored to state `id` (it must be the state's slot, still holding its rows).
+    pub fn restoreState(e: *Engine, id: u64) !void {
+        try e.states.restore(e.d, e.stream, &e.c, &e.st.?, e.slot, id);
+        e.seqs[e.slot].rows = 0;
+        if (e.dslots.len > 0) {
+            const s = &e.dslots[e.slot];
+            s.from = e.pos(); // a kept state holds no drafter rows: the drafter's context starts again here
+            s.to = s.from;
+        }
+    }
+
+    /// Each request's kept rows absorbed (positions just below its committed length), then its block's drafts.
+    pub fn draftBlock(e: *Engine, reqs: []const Req) !void {
+        const dr = e.drafter orelse return error.NoDraftHead;
+        for (reqs) |r| {
+            try e.bind(r.slot);
+            const s = &e.dslots[r.slot];
+            const at = e.pos();
+            if (r.n > 0) try dr.absorb(e.stream, s, s.stash, r.n, at - r.n);
+            // a sampled stream's drafts race with its own keys: drafts its verify will draw, the output unchanged
+            const race: ?drun.Race = if (e.seqs[r.slot].sampling) |sm| .{ .seed = sampler.rule(sm).seed, .inv_t = sampler.rule(sm).inv_t } else null;
+            if (r.out.len > 0) try dr.draft(&e.m, e.stream, e.exchange, &e.w, s, r.anchor, at, race, r.out);
+        }
+    }
+
+    pub fn dropState(e: *Engine, id: u64) void {
+        e.stream.synchronize() catch {};
+        e.states.drop(id);
+    }
+};
+
+/// A rank's greedy picks of `rows` rows (fp32 values, then i32 ids) padded to 16 bytes: the RoCE gather takes them.
+fn pickStride(rows: usize) usize {
+    return std.mem.alignForward(usize, rows * 8, 16);
+}
diff --git a/zig/src/families/inkling2/engine_images.zig b/zig/src/families/inkling2/engine_images.zig
new file mode 100644
index 000000000..aeb887821
--- /dev/null
+++ b/zig/src/families/inkling2/engine_images.zig
@@ -0,0 +1,144 @@
+//! tf-inkling2-engine images: image prompts through the serving engine (rank 0 encodes, every rank splices).
+const std = @import("std");
+const cuda = @import("cuda");
+const ink = @import("inkling2");
+const main = @import("engine_main.zig");
+
+const Engine = ink.engine.Engine;
+const dump_slot = 15; // the slot the rows dumps run in (its drafter context is never used)
+
+/// One picture's prompt: its ids (the chat template's, placeholders expanded), the processor's patches, its spans.
+const Prompt = struct { name: []const u8, ids: []u32, pic: ink.image.Prepared, spans: []ink.vision.Span };
+
+/// Each NAME.png + NAME.ids.u32 in `dir`: spliced rows, then greedy solo, drafted and beside a text prompt (1: a miss).
+pub fn run(e: *Engine, a: std.mem.Allocator, io: std.Io, dir: []const u8, out: std.Io.Dir, new: usize, r0: bool) !u8 {
+    var list: std.ArrayList(Prompt) = .empty;
+    var d = try std.Io.Dir.cwd().openDir(io, dir, .{ .iterate = true });
+    defer d.close(io);
+    var it = d.iterate();
+    while (try it.next(io)) |ent| {
+        if (!std.mem.endsWith(u8, ent.name, ".png")) continue;
+        const name = try a.dupe(u8, ent.name[0 .. ent.name.len - 4]);
+        const bytes = try d.readFileAlloc(io, ent.name, a, .limited(64 << 20));
+        const raw = try d.readFileAlloc(io, try std.fmt.allocPrint(a, "{s}.ids.u32", .{name}), a, .limited(1 << 20));
+        const ids = try a.alloc(u32, raw.len / 4);
+        @memcpy(std.mem.sliceAsBytes(ids), raw[0 .. ids.len * 4]);
+        const pic = ink.image.prepare(io, a, bytes, ink.pictures.picture_tokens) catch |err| {
+            if (r0) std.debug.print("{s}: refused, {s}: {s}\n", .{ name, @errorName(err), ink.pictures.Offer.explain(err) orelse "" });
+            continue;
+        };
+        const spans = try ink.vision.spans(a, ids);
+        try ink.vision.check(spans, &.{pic});
+        try list.append(a, .{ .name = name, .ids = ids, .pic = pic, .spans = spans });
+    }
+    std.mem.sort(Prompt, list.items, {}, struct {
+        fn lt(_: void, x: Prompt, y: Prompt) bool {
+            return std.mem.lessThan(u8, x.name, y.name);
+        }
+    }.lt);
+    e.graphs.settings.on = false;
+    var bad: usize = 0;
+    const row = @as(usize, e.c.hidden) * 2;
+    for (list.items) |p| {
+        const img: main.Img = .{ .pics = &.{p.pic}, .spans = p.spans };
+        const spliced = try embedRows(e, a, p.ids, img);
+        const tower = try a.alloc(u8, p.pic.tokens() * row);
+        try e.rows[dump_slot].buf.download(0, tower);
+        const plain = try embedRows(e, a, p.ids, null);
+        var k: usize = 0;
+        var same = true;
+        for (p.ids, 0..) |id, i| {
+            const want = if (id == ink.image.image_token) tower[k * row ..][0..row] else plain[i * row ..][0..row];
+            k += @intFromBool(id == ink.image.image_token);
+            same = same and std.mem.eql(u8, spliced[i * row ..][0..row], want);
+        }
+        bad += @intFromBool(!same);
+        if (r0) {
+            try out.writeFile(io, .{ .sub_path = try std.fmt.allocPrint(a, "{s}.spliced.bf16", .{p.name}), .data = spliced });
+            try out.writeFile(io, .{ .sub_path = try std.fmt.allocPrint(a, "{s}.rows.bf16", .{p.name}), .data = tower });
+            std.debug.print("{s}: {d} rows, {d} image rows; spliced == text rows + tower rows {s}\n", .{ p.name, p.ids.len, k, if (same) "PASS" else "FAIL" });
+        }
+        const solo = try main.greedy(e, a, p.ids, new + 8, img);
+        if (r0) try writeIds(a, io, out, p.name, solo[0..new]);
+        if (e.drafter != null) {
+            const dr = try main.draftedGreedy(e, a, p.ids, new, null, img);
+            const ok = std.mem.eql(u32, solo[0..new], dr.toks[0..new]);
+            bad += @intFromBool(!ok);
+            if (r0) std.debug.print("{s}: drafted == plain {s}; accepted {d}/{d}\n", .{ p.name, if (ok) "PASS" else "FAIL", dr.acc, dr.drafted });
+        }
+        bad += try beside(e, a, p, img, solo[0..new], r0);
+    }
+    if (r0) std.debug.print("images: {d} prompts, {s}\n", .{ list.items.len, if (bad == 0) "PASS" else "FAIL" });
+    return if (bad == 0) 0 else 1;
+}
+
+/// A prompt pass's rows right after the embedding and splice (the forward's layer-0 input), bf16 [rows][hidden].
+fn embedRows(e: *Engine, a: std.mem.Allocator, ids: []const u32, img: ?main.Img) ![]u8 {
+    if (ids.len > ink.engine.prompt_rows) return error.PromptTooLong;
+    try e.bind(dump_slot);
+    e.begin(null);
+    if (img) |im| try e.images(im.pics, im.spans);
+    const taps_n = ink.dspark.taps_n;
+    const h = @as(usize, e.c.hidden);
+    var own: ?cuda.DeviceBuffer = if (e.bp.taps == 0) try cuda.DeviceBuffer.alloc(e.d, ink.engine.prompt_rows * taps_n * h * 2) else null;
+    defer if (own) |*b| b.free();
+    const keep_at = e.tap_at;
+    const keep_taps = e.bp.taps;
+    defer {
+        e.tap_at = keep_at;
+        e.bp.taps = keep_taps;
+    }
+    if (own) |b| e.bp.taps = b.ptr;
+    e.tap_at = .{ 0, std.math.maxInt(u32), std.math.maxInt(u32), std.math.maxInt(u32), std.math.maxInt(u32), std.math.maxInt(u32), std.math.maxInt(u32) };
+    _ = try e.prefillChunk(ids, 0);
+    try e.stream.synchronize();
+    const all = try a.alloc(u8, ids.len * taps_n * h * 2);
+    try (cuda.DeviceBuffer{ .d = e.d, .ptr = e.bp.taps, .len = all.len, .borrowed = true }).download(0, all);
+    const rows = try a.alloc(u8, ids.len * h * 2);
+    for (0..ids.len) |i| @memcpy(rows[i * h * 2 ..][0 .. h * 2], all[i * taps_n * h * 2 ..][0 .. h * 2]);
+    return rows;
+}
+
+/// The image prompt (slot 1) and a text prompt (its ids without the pictures, slot 2) decoded in shared windows.
+fn beside(e: *Engine, a: std.mem.Allocator, p: Prompt, img: main.Img, solo: []const u32, r0: bool) !usize {
+    var text: std.ArrayList(u32) = .empty;
+    for (p.ids) |id| if (id != ink.image.image_token) try text.append(a, id);
+    const text_solo = try main.greedy(e, a, text.items, solo.len, null);
+    var pend: [2]u32 = undefined;
+    for ([_]u32{ 1, 2 }, 0..) |slot, i| {
+        try e.bind(slot);
+        e.begin(null);
+        if (i == 0) try e.images(img.pics, img.spans);
+        const ids = if (i == 0) p.ids else text.items;
+        var at: usize = 0;
+        pend[i] = while (true) : (at += ink.engine.prompt_rows) {
+            if (try e.prefillChunk(ids, at)) |t| break t;
+        };
+    }
+    var got: [2][]u32 = .{ try a.alloc(u32, solo.len), try a.alloc(u32, solo.len) };
+    for (0..solo.len) |j| {
+        var o: [2][1]u32 = undefined;
+        for (0..2) |i| got[i][j] = pend[i];
+        try e.verifyShared(&.{ .{ .slot = 1, .ids = got[0][j..][0..1], .out = &o[0] }, .{ .slot = 2, .ids = got[1][j..][0..1], .out = &o[1] } });
+        for ([_]u32{ 1, 2 }, 0..) |slot, i| {
+            try e.bind(slot);
+            try e.keep(1);
+            pend[i] = o[i][0];
+        }
+    }
+    const ok = [2]bool{ std.mem.eql(u32, got[0], solo), std.mem.eql(u32, got[1], text_solo) };
+    if (r0) std.debug.print("{s}: concurrent image == solo {s}, text == solo {s}\n", .{ p.name, pf(ok[0]), pf(ok[1]) });
+    return @intFromBool(!ok[0]) + @intFromBool(!ok[1]);
+}
+
+fn pf(ok: bool) []const u8 {
+    return if (ok) "PASS" else "FAIL";
+}
+
+fn writeIds(a: std.mem.Allocator, io: std.Io, out: std.Io.Dir, name: []const u8, toks: []const u32) !void {
+    var json: std.ArrayList(u8) = .empty;
+    try json.appendSlice(a, "[");
+    for (toks, 0..) |t, j| try json.print(a, "{s}{d}", .{ if (j > 0) ", " else "", t });
+    try json.appendSlice(a, "]\n");
+    try out.writeFile(io, .{ .sub_path = try std.fmt.allocPrint(a, "{s}.greedy.json", .{name}), .data = json.items });
+}
diff --git a/zig/src/families/inkling2/engine_main.zig b/zig/src/families/inkling2/engine_main.zig
new file mode 100644
index 000000000..f48a374e5
--- /dev/null
+++ b/zig/src/families/inkling2/engine_main.zig
@@ -0,0 +1,281 @@
+//! tf-inkling2-engine: the serving engine's checks on one or two ranks (both run the same loop, no plan words).
+const std = @import("std");
+const cuda = @import("cuda");
+const ink = @import("inkling2");
+
+const usage = "usage: tf-inkling2-engine graphs|greedy|drafted|drafts|images <model dir> <ids.json> <out dir> [context] [new]\n" ++
+    "  graphs: decode windows eager in some slots and graphed in others on the same rows; logits must match bit for bit\n" ++
+    "  greedy: each text's prompt pass then greedy decode rows, eager (writes greedy.json: name -> tokens)\n" ++
+    "  drafts: the drafter at ~12 anchors a text after a prompt pass to each (drafts.json, drafts-r<rank>.bin)\n" ++
+    "  images: <ids.json> is a directory of NAME.png + NAME.ids.u32; spliced rows, solo/drafted/concurrent greedy\n" ++
+    "  two ranks: TF_INKLING2_RANK, TF_INKLING2_WORLD and NCCL_COMM_ID on both\n";
+
+const Text = struct { name: []const u8, ids: []u32 };
+/// A prompt's pictures (rank 0 encodes them) and their placeholder spans.
+pub const Img = struct { pics: []const ink.image.Prepared, spans: []const ink.vision.Span };
+
+pub fn main(init: std.process.Init) !u8 {
+    const a = init.arena.allocator();
+    const gpa = init.gpa;
+    const io = init.io;
+    const args = try init.minimal.args.toSlice(a);
+    if (args.len < 5) {
+        std.debug.print("{s}", .{usage});
+        return 2;
+    }
+    const graphs = std.mem.eql(u8, args[1], "graphs");
+    const pics = std.mem.eql(u8, args[1], "images");
+    const text: []const u8 = if (pics) "{}" else try std.Io.Dir.cwd().readFileAlloc(io, args[3], a, .limited(1 << 26));
+    var doc = try std.json.parseFromSlice(std.json.Value, a, text, .{});
+    defer doc.deinit();
+    var list: std.ArrayList(Text) = .empty;
+    var it = doc.value.object.iterator();
+    while (it.next()) |e| {
+        const v = e.value_ptr.array.items;
+        const ids = try a.alloc(u32, v.len);
+        for (v, ids) |x, *id| id.* = @intCast(x.integer);
+        try list.append(a, .{ .name = e.key_ptr.*, .ids = ids });
+    }
+    const context = if (args.len > 5) try std.fmt.parseInt(usize, args[5], 10) else 32768;
+    const new = if (args.len > 6) try std.fmt.parseInt(usize, args[6], 10) else 64;
+
+    var driver = try cuda.Driver.open();
+    defer driver.close();
+    var ctx = try cuda.Context.init(&driver, 0);
+    defer ctx.deinit();
+    if (try ctx.capability() != 121) return error.Inkling2RequiresSm121;
+    const place = try ink.admit.place();
+    var group: ?cuda.tp_group.Group = null;
+    defer if (group) |*g| g.close(); // after the engine (its graphs hold the comm's kernels), as the server closes
+    const e = try ink.engine.Engine.init(gpa, io, &driver, args[2], place.rank, place.world, .{ .capacity = ink.native.capacity(context), .vision = if (pics) .{ .image_tokens = ink.pictures.default_image_tokens, .max_images = 4 } else null });
+    defer e.deinit();
+    if (place.world > 1) {
+        group = try cuda.tp_group.Group.open(&driver, place.rank, place.world);
+        try group.?.openRoce(gpa, io, &driver, e.stream, e.roceBytes());
+        e.exchange = .{ .nccl = .{ .lib = &group.?.lib, .comm = group.?.comm, .group = &group.? } };
+    }
+    try e.reserve(16);
+    try std.Io.Dir.cwd().createDirPath(io, args[4]);
+    var out = try std.Io.Dir.cwd().openDir(io, args[4], .{});
+    defer out.close(io);
+    const r0 = place.rank == 0;
+    if (std.mem.eql(u8, args[1], "drafts")) return drafts(e, a, io, out, list.items, place.rank);
+    if (pics) return @import("engine_images.zig").run(e, a, io, args[3], out, new, r0);
+    if (std.mem.eql(u8, args[1], "drafted")) {
+        var bad: usize = 0;
+        // drafted.json: each text's plain tokens and, from the eager arm, how many rows each window kept (1-8)
+        var json: std.ArrayList(u8) = .empty;
+        try json.appendSlice(a, "{");
+        for (list.items, 0..) |t, ti| {
+            e.graphs.settings.on = false;
+            const plain = try greedy(e, a, t.ids, new + 8, null);
+            for ([_]u8{ 0, 1, 2 }) |arm| {
+                e.graphs.settings.on = arm == 1;
+                const d = try draftedGreedy(e, a, t.ids, new, if (arm == 2) plain else null, null);
+                if (arm == 0) {
+                    try json.print(a, "{s}\"{s}\": {{\"plain\": [", .{ if (ti > 0) ", " else "", t.name });
+                    for (plain[0..new], 0..) |x, j| try json.print(a, "{s}{d}", .{ if (j > 0) "," else "", x });
+                    try json.appendSlice(a, "], \"kept\": [");
+                    for (d.kept, 0..) |x, j| try json.print(a, "{s}{d}", .{ if (j > 0) "," else "", x });
+                    try json.appendSlice(a, "]}");
+                }
+                const same = std.mem.eql(u32, plain[0..new], d.toks[0..new]);
+                bad += @intFromBool(!same);
+                const what = [_][]const u8{ "eager", "graphed", "oracle drafts" };
+                if (r0) std.debug.print("{s} {s}: drafted == plain {s}; accepted {d}/{d} drafts in {d} windows\n", .{ t.name, what[arm], if (same) "PASS" else "FAIL", d.acc, d.drafted, d.windows });
+            }
+        }
+        try json.appendSlice(a, "}\n");
+        if (r0) try out.writeFile(io, .{ .sub_path = "drafted.json", .data = json.items });
+        return if (bad == 0) 0 else 1;
+    }
+    if (!graphs) {
+        e.graphs.settings.on = false;
+        var json: std.ArrayList(u8) = .empty;
+        try json.appendSlice(a, "{");
+        for (list.items, 0..) |t, i| {
+            const toks = try greedy(e, a, t.ids, new, null);
+            try json.print(a, "{s}\"{s}\": [", .{ if (i > 0) ", " else "", t.name });
+            for (toks, 0..) |x, j| try json.print(a, "{s}{d}", .{ if (j > 0) ", " else "", x });
+            try json.appendSlice(a, "]");
+            if (r0) std.debug.print("{s}: {d} prompt tokens, {d} greedy tokens\n", .{ t.name, t.ids.len, toks.len });
+        }
+        try json.appendSlice(a, "}\n");
+        if (r0) try out.writeFile(io, .{ .sub_path = "greedy.json", .data = json.items });
+        return 0;
+    }
+    // cases: k streams of `rows` rows each, `steps` windows; a text of 16,380+ tokens also crosses a global chunk
+    const Case = struct { k: usize, rows: usize, steps: usize, at: usize };
+    var cases: std.ArrayList(Case) = .empty;
+    for ([_]usize{ 1, 2, 3, 4, 8 }) |k| try cases.append(a, .{ .k = k, .rows = 1, .steps = 6, .at = 0 });
+    try cases.append(a, .{ .k = 1, .rows = 4, .steps = 3, .at = 0 });
+    try cases.append(a, .{ .k = 2, .rows = 4, .steps = 3, .at = 0 });
+    for (list.items) |t| if (t.ids.len >= 16390) {
+        try cases.append(a, .{ .k = 1, .rows = 1, .steps = 8, .at = 16380 });
+        try cases.append(a, .{ .k = 2, .rows = 1, .steps = 8, .at = 16380 });
+        break;
+    };
+    var pass: usize = 0;
+    var total: usize = 0;
+    for (cases.items) |cs| {
+        const diff = try graphCase(e, a, list.items, cs.k, cs.rows, cs.steps, cs.at);
+        total += cs.steps;
+        pass += cs.steps - diff;
+        if (r0) std.debug.print("case {d} streams x {d} rows from {s}: {d}/{d} windows equal\n", .{ cs.k, cs.rows, if (cs.at > 0) "16380" else "prompt end", cs.steps - diff, cs.steps });
+    }
+    const st = e.graphs.stats;
+    if (r0) std.debug.print("graphs: {d}/{d} windows bit-identical; captured {d}, replayed {d}, eager {d}\n", .{ pass, total, st.captured, st.replayed, st.eager });
+    return if (pass == total) 0 else 1;
+}
+
+/// Greedy with a 7-draft block before each 8-row window, agreeing rows kept; `oracle`: plain's tokens, one spoiled.
+pub fn draftedGreedy(e: *ink.engine.Engine, a: std.mem.Allocator, ids: []const u32, n: usize, oracle: ?[]const u32, img: ?Img) !struct { toks: []u32, acc: usize, drafted: usize, windows: usize, kept: []u8 } {
+    try e.bind(0);
+    e.begin(null);
+    if (img) |im| try e.images(im.pics, im.spans);
+    var at: usize = 0;
+    var tok: u32 = while (true) : (at += ink.engine.prompt_rows) {
+        if (try e.prefillChunk(ids, at)) |t| break t;
+    };
+    var toks: std.ArrayList(u32) = .empty;
+    var ks: std.ArrayList(u8) = .empty;
+    var kept: u32 = 0;
+    var acc: usize = 0;
+    var windows: usize = 0;
+    while (toks.items.len < n) : (windows += 1) {
+        var w: [8]u32 = undefined;
+        w[0] = tok;
+        try e.draftBlock(&.{.{ .slot = 0, .n = kept, .anchor = tok, .out = w[1..8] }});
+        if (oracle) |orc| {
+            const m = toks.items.len;
+            for (1..8) |j| w[j] = orc[m + j];
+            const c = windows % 8;
+            if (c < 7) w[1 + c] ^= 1;
+        }
+        var o: [8]u32 = undefined;
+        try e.verifyShared(&.{.{ .slot = 0, .ids = &w, .out = &o }});
+        var k: usize = 1;
+        while (k < 8 and w[k] == o[k - 1]) k += 1;
+        try e.keep(k);
+        try toks.appendSlice(a, w[0..k]);
+        try ks.append(a, @intCast(k));
+        acc += k - 1;
+        kept = @intCast(k);
+        tok = o[k - 1];
+    }
+    return .{ .toks = toks.items, .acc = acc, .drafted = 7 * windows, .windows = windows, .kept = ks.items };
+}
+
+/// A text's prompt pass on the bound slot then `n` greedy tokens, one decode row at a time.
+pub fn greedy(e: *ink.engine.Engine, a: std.mem.Allocator, ids: []const u32, n: usize, img: ?Img) ![]u32 {
+    try e.bind(0);
+    e.begin(null);
+    if (img) |im| try e.images(im.pics, im.spans);
+    var at: usize = 0;
+    var tok: u32 = while (true) : (at += ink.engine.prompt_rows) {
+        if (try e.prefillChunk(ids, at)) |t| break t;
+    };
+    const toks = try a.alloc(u32, n);
+    for (toks) |*x| {
+        x.* = tok;
+        var o: [1]u32 = undefined;
+        try e.verifyShared(&.{.{ .slot = 0, .ids = &.{tok}, .out = &o }});
+        try e.keep(1);
+        tok = o[0];
+    }
+    return toks;
+}
+
+/// One case: the same streams in slots 0..k (eager) and k..2k (graphed); returns the windows whose logits differ.
+fn graphCase(e: *ink.engine.Engine, a: std.mem.Allocator, texts: []const Text, k: usize, rows: usize, steps: usize, at: usize) !usize {
+    var pend: [8]u32 = undefined;
+    var src: [8][]const u32 = undefined;
+    var long: ?[]const u32 = null;
+    for (texts) |t| if (t.ids.len >= 16390) {
+        long = t.ids;
+    };
+    for (0..k) |i| {
+        src[i] = if (at > 0) long.?[0..at] else texts[i % texts.len].ids;
+        for ([_]usize{ i, k + i }) |slot| {
+            try e.bind(@intCast(slot));
+            e.begin(null);
+            var p: usize = 0;
+            pend[i] = while (true) : (p += ink.engine.prompt_rows) {
+                if (try e.prefillChunk(src[i], p)) |t| break t;
+            };
+        }
+    }
+    const nv = e.w.share.vocab.len();
+    var diff: usize = 0;
+    for (0..steps) |step| {
+        var ids: [8][8]u32 = undefined;
+        var outs: [2][8][8]u32 = undefined;
+        var logits: [2][]u8 = undefined;
+        for (0..k) |i| {
+            ids[i][0] = pend[i];
+            for (1..rows) |r| ids[i][r] = src[i][(step * rows + r) % src[i].len]; // fixed rows after the pending one
+        }
+        for (0..2) |arm| {
+            var parts: [8]ink.engine.Part = undefined;
+            for (0..k) |i| parts[i] = .{ .slot = @intCast(arm * k + i), .ids = ids[i][0..rows], .out = outs[arm][i][0..rows] };
+            e.graphs.settings.on = arm == 1;
+            try e.verifyShared(parts[0..k]);
+            try e.stream.synchronize();
+            logits[arm] = try a.alloc(u8, k * rows * nv * 4);
+            try e.bd.logits.download(0, logits[arm]);
+            for (0..k) |i| {
+                try e.bind(@intCast(arm * k + i));
+                try e.keep(rows);
+            }
+        }
+        if (!std.mem.eql(u8, logits[0], logits[1])) diff += 1;
+        for (0..k) |i| pend[i] = outs[0][i][rows - 1];
+    }
+    return diff;
+}
+
+/// Each text's prefix before ~12 anchors: a prompt pass to the anchor, then one block; each step's logits and picks.
+fn drafts(e: *ink.engine.Engine, a: std.mem.Allocator, io: std.Io, out: std.Io.Dir, texts: []const Text, rank: usize) !u8 {
+    const dr = e.drafter orelse return error.NoDraftHead;
+    e.graphs.settings.on = false;
+    const nv = dr.nv;
+    var keep = try cuda.DeviceBuffer.alloc(e.d, 7 * nv * 4);
+    defer keep.free();
+    dr.keep_logits = keep.ptr;
+    defer dr.keep_logits = 0;
+    var bin: std.ArrayList(u8) = .empty;
+    var json: std.ArrayList(u8) = .empty;
+    try json.print(a, "{{\"rank\": {d}, \"vocab_lo\": {d}, \"vocab_n\": {d}, \"anchors\": [", .{ rank, dr.vlo, nv });
+    var count: usize = 0;
+    for (texts) |t| {
+        if (t.ids.len <= ink.engine.prompt_rows) {
+            // the prompt's taps (a row never depends on later rows), for the reference run on our own taps
+            try e.bind(0);
+            e.begin(null);
+            _ = try e.prefillChunk(t.ids, 0);
+            const tb = try a.alloc(u8, t.ids.len * ink.dspark.taps_n * e.c.hidden * 2);
+            try (cuda.DeviceBuffer{ .d = e.d, .ptr = e.bp.taps, .len = tb.len, .borrowed = true }).download(0, tb);
+            if (rank == 0) try out.writeFile(io, .{ .sub_path = try std.fmt.allocPrint(a, "taps-{s}.bin", .{t.name}), .data = tb });
+        }
+        const step = @max(16, t.ids.len / 12);
+        var p: usize = 16;
+        while (p + 8 < t.ids.len) : (p += step) {
+            try e.bind(0);
+            e.begin(null);
+            var at: usize = 0;
+            while (try e.prefillChunk(t.ids[0..p], at) == null) at += ink.engine.prompt_rows;
+            var o: [7]u32 = undefined;
+            try e.draftBlock(&.{.{ .slot = 0, .n = 0, .anchor = t.ids[p], .out = &o }});
+            const host = try a.alloc(u8, 7 * nv * 4);
+            try keep.download(0, host);
+            try bin.appendSlice(a, host);
+            try json.print(a, "{s}{{\"text\": \"{s}\", \"p\": {d}, \"walk\": [{d}, {d}, {d}, {d}, {d}, {d}, {d}]}}", .{ if (count > 0) ", " else "", t.name, p, o[0], o[1], o[2], o[3], o[4], o[5], o[6] });
+            count += 1;
+        }
+    }
+    try json.appendSlice(a, "]}\n");
+    try out.writeFile(io, .{ .sub_path = try std.fmt.allocPrint(a, "drafts-r{d}.bin", .{rank}), .data = bin.items });
+    try out.writeFile(io, .{ .sub_path = try std.fmt.allocPrint(a, "drafts-r{d}.json", .{rank}), .data = json.items });
+    if (rank == 0) std.debug.print("drafts: {d} anchors, {d} rows of {d} logits a rank\n", .{ count, 7 * count, nv });
+    return 0;
+}
diff --git a/zig/src/families/inkling2/exl3.zig b/zig/src/families/inkling2/exl3.zig
new file mode 100644
index 000000000..58e928ff3
--- /dev/null
+++ b/zig/src/families/inkling2/exl3.zig
@@ -0,0 +1,216 @@
+//! Inkling 2's EXL3 tensors (exllamav3 1.x, mul1, an inkling2 architecture added to it): rank cuts, grouped experts.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const shard = @import("shard.zig");
+
+const Tensor = core.checkpoint.Tensor;
+
+/// The mul1 codebook marker's value.
+const mul1_magic: u32 = 0x83DCD12D;
+
+/// What a rank takes of a projection: all of it, its output columns, or its input rows (each a multiple of 128).
+pub const Cut = union(enum) { whole, cols: shard.Span, rows: shard.Span };
+
+/// The device side of a load: uploads go through `put`, dense weights reserve their scratch on `dense`.
+pub const Sink = struct {
+    ctx: *anyopaque,
+    put: *const fn (ctx: *anyopaque, bytes: []const u8) anyerror!u64,
+    dense: *cuda.exl3.Dense,
+    stream: cuda.Stream,
+};
+
+/// config.json's quantization_config: EXL3 from exllamav3 1.x on mul1 (each tensor's width is checked as it loads).
+pub fn admit(gpa: std.mem.Allocator, config_json: []const u8) !void {
+    const doc = try std.json.parseFromSlice(std.json.Value, gpa, config_json, .{});
+    defer doc.deinit();
+    if (doc.value != .object) return error.NotExl3;
+    const q = doc.value.object.get("quantization_config") orelse return error.NotExl3;
+    if (q != .object) return error.NotExl3;
+    const method = q.object.get("quant_method") orelse return error.NotExl3;
+    if (method != .string or !std.mem.eql(u8, method.string, "exl3")) return error.NotExl3;
+    const book = q.object.get("codebook") orelse return error.UnsupportedExl3;
+    if (book != .string or !std.mem.eql(u8, book.string, "mul1")) return error.UnsupportedExl3;
+    const version = q.object.get("version") orelse return error.UnsupportedExl3;
+    if (version != .string or !std.mem.startsWith(u8, version.string, "1.")) return error.UnsupportedExl3;
+}
+
+/// One stored projection's tensors, checked: trellis [k/16][n/16][16 * bits] i16, the mul1 marker, fp16 suh and svh.
+pub const Group = struct {
+    trellis: Tensor,
+    suh: Tensor,
+    svh: Tensor,
+    halves: u32,
+
+    fn tile(g: Group) usize {
+        return g.halves * 16;
+    }
+};
+
+pub fn group(ck: *core.Checkpoint, base: []const u8, n: usize, k: usize) !Group {
+    var buf: [192]u8 = undefined;
+    const t = try ck.get(try std.fmt.bufPrint(&buf, "{s}.trellis", .{base}));
+    if (t.dtype != .i16 or t.rank != 3 or t.dim(0) != k / 16 or t.dim(1) != n / 16 or t.dim(2) % 8 != 0) {
+        std.log.err("inkling2: {s}.trellis is not [{d}, {d}, 16 * bits]", .{ base, k / 16, n / 16 });
+        return error.UnexpectedInkling2Tensor;
+    }
+    const halves = t.dim(2) / 8;
+    if (halves < 2 or halves > 16) return error.UnsupportedExl3;
+    const marker = try ck.get(try std.fmt.bufPrint(&buf, "{s}.mul1", .{base}));
+    if (marker.dtype != .i32 or marker.bytes.len != 4 or std.mem.readInt(u32, marker.bytes[0..4], .little) != mul1_magic) return error.UnsupportedExl3;
+    const suh = try ck.get(try std.fmt.bufPrint(&buf, "{s}.suh", .{base}));
+    const svh = try ck.get(try std.fmt.bufPrint(&buf, "{s}.svh", .{base}));
+    if (!suh.is(.f16, &.{k}) or !svh.is(.f16, &.{n})) return error.UnexpectedInkling2Tensor;
+    return .{ .trellis = t, .suh = suh, .svh = svh, .halves = @intCast(halves) };
+}
+
+/// The cut's shape (k, n) and, appended to `out`, its trellis words, suh and svh in the stored layout.
+pub fn cut(gpa: std.mem.Allocator, g: Group, n: usize, k: usize, c: Cut, out: *std.ArrayList(u8), suh: *std.ArrayList(u8), svh: *std.ArrayList(u8)) ![2]usize {
+    const tb = g.tile();
+    const nt = n / 16;
+    const tr = g.trellis.bytes;
+    switch (c) {
+        .whole => {
+            try out.appendSlice(gpa, tr);
+            try suh.appendSlice(gpa, g.suh.bytes);
+            try svh.appendSlice(gpa, g.svh.bytes);
+            return .{ k, n };
+        },
+        .cols => |s| {
+            if (s.lo % 128 != 0 or s.len() % 128 != 0 or s.hi > n or s.len() == 0) return error.BadSplit;
+            for (0..k / 16) |kt| try out.appendSlice(gpa, tr[(kt * nt + s.lo / 16) * tb ..][0 .. s.len() / 16 * tb]);
+            try suh.appendSlice(gpa, g.suh.bytes);
+            try svh.appendSlice(gpa, g.svh.bytes[2 * s.lo .. 2 * s.hi]);
+            return .{ k, s.len() };
+        },
+        .rows => |s| {
+            if (s.lo % 128 != 0 or s.len() % 128 != 0 or s.hi > k or s.len() == 0) return error.BadSplit;
+            try out.appendSlice(gpa, tr[s.lo / 16 * nt * tb .. s.hi / 16 * nt * tb]);
+            try suh.appendSlice(gpa, g.suh.bytes[2 * s.lo .. 2 * s.hi]);
+            try svh.appendSlice(gpa, g.svh.bytes);
+            return .{ s.len(), n };
+        },
+    }
+}
+
+/// The stored [n][k] projection under `base`, cut to the rank, on the device for cuda.exl3.Dense.
+pub fn linear(gpa: std.mem.Allocator, ck: *core.Checkpoint, sink: Sink, base: []const u8, n: usize, k: usize, c: Cut) !cuda.exl3.Weight {
+    const g = try group(ck, base, n, k);
+    if (cuda.exl3.variantIndex(g.halves, .mul1, 4) == null) return error.UnsupportedExl3;
+    var tr: std.ArrayList(u8) = .empty;
+    defer tr.deinit(gpa);
+    var su: std.ArrayList(u8) = .empty;
+    defer su.deinit(gpa);
+    var sv: std.ArrayList(u8) = .empty;
+    defer sv.deinit(gpa);
+    const kn = try cut(gpa, g, n, k, c, &tr, &su, &sv);
+    const st = cuda.exl3.strides(kn[0], kn[1], g.halves, false);
+    const w: cuda.exl3.Weight = .{
+        .trellis = try sink.put(sink.ctx, tr.items),
+        .suh = try sink.put(sink.ctx, su.items),
+        .svh = try sink.put(sink.ctx, sv.items),
+        .k = @intCast(kn[0]),
+        .n = @intCast(kn[1]),
+        .halves = g.halves,
+        .codebook = .mul1,
+        .stride_k = st.k,
+        .stride_nb = st.nb,
+    };
+    try sink.dense.reserve(sink.stream, w);
+    return w;
+}
+
+/// Layer `i`'s 384 routed experts as one grouped EXL3 layer: gate and up by the rank's columns, down by its rows.
+pub fn experts(gpa: std.mem.Allocator, ck: *core.Checkpoint, sink: Sink, prefix: []const u8, i: u32, count: usize, d: usize, inter: usize, span: shard.Span) !cuda.exl3_experts.Layer {
+    const mods = [3][]const u8{ "gate_proj", "up_proj", "down_proj" };
+    var ptrs: [3]u64 = undefined;
+    var k2: [3]u64 = undefined;
+    var suh: [3]u64 = undefined;
+    var svh: [3]u64 = undefined;
+    var base_buf: [160]u8 = undefined;
+    for (mods, 0..) |mod, m| {
+        const down = m == 2;
+        const n = if (down) d else inter;
+        const k = if (down) inter else d;
+        var tr: std.ArrayList(u8) = .empty;
+        defer tr.deinit(gpa);
+        var su: std.ArrayList(u8) = .empty;
+        defer su.deinit(gpa);
+        var sv: std.ArrayList(u8) = .empty;
+        defer sv.deinit(gpa);
+        const at = try gpa.alloc(usize, count);
+        defer gpa.free(at);
+        const widths = try gpa.alloc(i32, count);
+        defer gpa.free(widths);
+        for (0..count) |e| {
+            const base = try std.fmt.bufPrint(&base_buf, "{s}layers.{d}.mlp.experts.{d}.{s}", .{ prefix, i, e, mod });
+            const g = try group(ck, base, n, k);
+            at[e] = tr.items.len;
+            widths[e] = @intCast(g.halves);
+            _ = try cut(gpa, g, n, k, if (down) .{ .rows = span } else .{ .cols = span }, &tr, &su, &sv);
+        }
+        const words = try sink.put(sink.ctx, tr.items);
+        const table = try gpa.alloc(u64, count);
+        defer gpa.free(table);
+        for (table, at) |*t, off| t.* = words + off;
+        ptrs[m] = try sink.put(sink.ctx, std.mem.sliceAsBytes(table));
+        k2[m] = try sink.put(sink.ctx, std.mem.sliceAsBytes(widths));
+        suh[m] = try sink.put(sink.ctx, su.items);
+        svh[m] = try sink.put(sink.ctx, sv.items);
+        ck.release();
+    }
+    return .{
+        .gate = ptrs[0],
+        .up = ptrs[1],
+        .down = ptrs[2],
+        .gate_k2 = k2[0],
+        .up_k2 = k2[1],
+        .down_k2 = k2[2],
+        .suh_g = suh[0],
+        .suh_u = suh[1],
+        .svh_g = svh[0],
+        .svh_u = svh[1],
+        .suh_d = suh[2],
+        .svh_d = svh[2],
+        .experts = count,
+        .dims = d,
+        .width = span.len(),
+        .codebook = .mul1,
+    };
+}
+
+test "exl3: admit takes exllamav3 1.x on mul1 and refuses other codebooks, versions and formats" {
+    const a = std.testing.allocator;
+    try admit(a, "{\"quantization_config\":{\"quant_method\":\"exl3\",\"version\":\"1.6.6\",\"codebook\":\"mul1\"}}");
+    try std.testing.expectError(error.UnsupportedExl3, admit(a, "{\"quantization_config\":{\"quant_method\":\"exl3\",\"version\":\"1.6.6\",\"codebook\":\"mcg\"}}"));
+    try std.testing.expectError(error.UnsupportedExl3, admit(a, "{\"quantization_config\":{\"quant_method\":\"exl3\",\"version\":\"0.9\",\"codebook\":\"mul1\"}}"));
+    try std.testing.expectError(error.NotExl3, admit(a, "{\"text_config\":{}}"));
+}
+
+test "exl3: a cut takes a rank's tile columns of every k row, or its whole tile rows, with the matching scales" {
+    const a = std.testing.allocator;
+    var words: [16 * 16 * 32]u8 = undefined;
+    for (0..16) |kt| for (0..16) |nt| @memset(words[(kt * 16 + nt) * 32 ..][0..32], @intCast(kt * 16 + nt));
+    var scales: [512]u8 = undefined;
+    for (&scales, 0..) |*s, j| s.* = @intCast(j / 2 % 256);
+    const t: Tensor = .{ .dtype = .i16, .rank = 3, .shape = .{ 16, 16, 16, 1, 1 }, .bytes = &words };
+    const v: Tensor = .{ .dtype = .f16, .rank = 1, .shape = .{ 256, 1, 1, 1, 1 }, .bytes = &scales };
+    const g: Group = .{ .trellis = t, .suh = v, .svh = v, .halves = 2 };
+    var tr: std.ArrayList(u8) = .empty;
+    defer tr.deinit(a);
+    var su: std.ArrayList(u8) = .empty;
+    defer su.deinit(a);
+    var sv: std.ArrayList(u8) = .empty;
+    defer sv.deinit(a);
+    try std.testing.expectEqual([2]usize{ 256, 128 }, try cut(a, g, 256, 256, .{ .cols = .{ .lo = 128, .hi = 256 } }, &tr, &su, &sv));
+    try std.testing.expectEqual(@as(u8, 8), tr.items[0]);
+    try std.testing.expectEqual(@as(u8, 16 + 8), tr.items[8 * 32]);
+    try std.testing.expectEqualSlices(u8, scales[256..], sv.items);
+    tr.clearRetainingCapacity();
+    su.clearRetainingCapacity();
+    sv.clearRetainingCapacity();
+    try std.testing.expectEqual([2]usize{ 128, 256 }, try cut(a, g, 256, 256, .{ .rows = .{ .lo = 128, .hi = 256 } }, &tr, &su, &sv));
+    try std.testing.expectEqual(@as(u8, 8 * 16), tr.items[0]);
+    try std.testing.expectEqualSlices(u8, scales[256..], su.items);
+    try std.testing.expectError(error.BadSplit, cut(a, g, 256, 256, .{ .cols = .{ .lo = 64, .hi = 192 } }, &tr, &su, &sv));
+}
diff --git a/zig/src/families/inkling2/experts.zig b/zig/src/families/inkling2/experts.zig
new file mode 100644
index 000000000..2d0d017d9
--- /dev/null
+++ b/zig/src/families/inkling2/experts.zig
@@ -0,0 +1,148 @@
+//! Inkling 2's routed experts: the family's grouping and grouped projections, main's rotation and combine.
+const std = @import("std");
+const cuda = @import("cuda");
+const ops = @import("ops.zig");
+
+const ex = cuda.exl3_experts;
+
+/// The two SwiGLU softcaps (config.json mlp_gate_softcap, mlp_up_softcap).
+pub const Caps = struct { gate: f32, up: f32 };
+
+/// Calls of at least this many rows take an item list (runs of one expert's members), not one item an expert.
+pub const listed_from = 17;
+/// Calls of at least this many rows take the prompt kernel (32 members by 64 columns a block).
+pub const wide_from = 512;
+
+/// main's experts module beside the family's grouped projections.
+pub const Kernels = struct {
+    main: ex.Experts,
+    mod: cuda.Module,
+    group: cuda.Function,
+    rows: cuda.Function,
+    wide: cuda.Function,
+
+    pub fn load(d: *const cuda.Driver) !Kernels {
+        var main = try ex.Experts.load(d);
+        errdefer main.unload();
+        var mod = try cuda.Module.load(d, cuda.kernels.inkling2_experts);
+        errdefer mod.unload();
+        return .{
+            .main = main,
+            .mod = mod,
+            .group = try mod.function("tf_ink2x_group"),
+            .rows = try mod.function("tf_ink2x_rows"),
+            .wide = try mod.function("tf_ink2x_wide"),
+        };
+    }
+
+    pub fn unload(k: *Kernels) void {
+        k.mod.unload();
+        k.main.unload();
+    }
+};
+
+fn i32d(v: usize) i32 {
+    return @intCast(v);
+}
+
+fn align256(n: usize) usize {
+    return (n + 255) / 256 * 256;
+}
+
+/// Items at most a call of `rows` rows lists: runs of 16 members, plus one partial run a distinct expert.
+fn maxItems(l: ex.Layer, rows: usize, slots: usize) usize {
+    const p = rows * slots;
+    return (p + 15) / 16 + @min(p, l.experts);
+}
+
+/// main's scratch, then the item count and the item list (three int32 an item).
+pub fn scratchBytes(l: ex.Layer, rows: usize, slots: usize) !usize {
+    return try ex.scratchBytes(l, rows, slots) + 256 + align256(maxItems(l, rows, slots) * 12);
+}
+
+/// Where the item count sits in scratch laid out by ex.scratch over scratchBytes(); the list follows 256 bytes on.
+fn itemsAt(l: ex.Layer, sc: ex.Scratch) u64 {
+    return sc.members + align256(@min(sc.rows * sc.slots, l.experts) * sc.rows * 4);
+}
+
+/// exl3_experts.Experts.run's launches in its order: the family's grouped projections, ops.cu's tf_ink2_gateup.
+pub fn run(e: *const Kernels, k: *const ops.Kernels, s: cuda.Stream, l: ex.Layer, caps: Caps, x: u64, x_stride: usize, x_dtype: ex.DType, pick: u64, wts: u64, rows: usize, out: u64, sc: ex.Scratch) !void {
+    const d = l.dims;
+    const w = l.width;
+    const slots = sc.slots;
+    if (rows < 1 or rows > sc.rows or slots < 1 or slots > 32) return error.BadExperts;
+    if (l.experts < 1 or l.experts > 512 or l.codebook != .mul1 or l.gu_stride != 0) return error.BadExperts;
+    const g_sk = try ex.plan(d, w, true);
+    const d_sk = try ex.plan(w, d, false);
+    const p = rows * slots;
+    const maxu = @min(p, l.experts);
+
+    const listed = rows >= listed_from;
+    const wide = rows >= wide_from;
+    const per: usize = if (wide) 32 else 16;
+    const at = itemsAt(l, sc);
+    var a: cuda.Args = .{};
+    for ([_]u64{ pick, sc.ids, sc.count, sc.members, at + 256, at }) |v| a.add(v);
+    for ([_]usize{ rows, slots, l.experts, rows, if (listed) per else 0, @intFromBool(!listed) }) |v| a.add(i32d(v));
+    const shared: u32 = @intCast(l.experts * (32 * 2 + 2 * 4)); // per-warp uint16 counts, then counts and places
+    try cuda.launch.launch(e.group, .{ .grid = .{ .x = 1 }, .block = .{ .x = 1024 }, .shared = shared }, s, &a);
+    const items: u64 = if (listed) at + 256 else 0;
+    const count: u64 = if (listed) at else sc.count;
+    const gy: u32 = @intCast(if (listed) (p + per - 1) / per + maxu else maxu);
+    const f = if (wide) e.wide else e.rows;
+    const cols: usize = if (wide) 64 else 128;
+
+    var r: cuda.Args = .{};
+    r.add(x);
+    r.add(i32d(x_stride));
+    r.add(@as(i32, @backingInt(x_dtype)));
+    for ([_]u64{ pick, l.suh_g, l.suh_u, sc.xg, sc.xu }) |v| r.add(v);
+    for ([_]usize{ d, slots, l.experts }) |v| r.add(i32d(v));
+    const rot: cuda.Dim3 = .{ .x = @intCast(p), .y = @intCast(d / 128), .z = 2 };
+    try cuda.launch.launch(e.main.rot_in, .{ .grid = rot, .block = .{ .x = 32 } }, s, &r);
+
+    var g: cuda.Args = .{};
+    for ([_]u64{ sc.xg, sc.xu, l.gate, l.up, l.gate_k2, l.up_k2, sc.ids }) |v| g.add(v);
+    for ([_]u64{ items, count, sc.members, sc.z }) |v| g.add(v);
+    for ([_]usize{ d, w, p, g_sk, rows, slots }) |v| g.add(i32d(v));
+    const gu: cuda.Dim3 = .{ .x = @intCast(w / cols), .y = gy, .z = @intCast(2 * g_sk) };
+    try cuda.launch.launch(f, .{ .grid = gu, .block = .{ .x = 128 } }, s, &g);
+
+    try ops.gateup(k, s, .{ .z = sc.z, .pick = pick, .svh_g = l.svh_g, .svh_u = l.svh_u, .suh_d = l.suh_d, .xd = sc.xd, .p = i32d(p), .n = i32d(w), .sk = i32d(g_sk), .experts = i32d(l.experts), .gate_cap = caps.gate, .up_cap = caps.up });
+
+    var dn: cuda.Args = .{};
+    for ([_]u64{ sc.xd, sc.xd, l.down, l.down, l.down_k2, l.down_k2, sc.ids }) |v| dn.add(v);
+    for ([_]u64{ items, count, sc.members, sc.z }) |v| dn.add(v);
+    for ([_]usize{ w, d, p, d_sk, rows, slots }) |v| dn.add(i32d(v));
+    const down: cuda.Dim3 = .{ .x = @intCast(d / cols), .y = gy, .z = @intCast(d_sk) };
+    try cuda.launch.launch(f, .{ .grid = down, .block = .{ .x = 128 } }, s, &dn);
+
+    var cb: cuda.Args = .{};
+    for ([_]u64{ sc.z, pick, l.svh_d, sc.y, wts, out }) |v| cb.add(v);
+    for ([_]usize{ p, d, d_sk, l.experts, slots }) |v| cb.add(i32d(v));
+    const comb: cuda.Dim3 = .{ .x = @intCast(rows), .y = @intCast(d / 128) };
+    try cuda.launch.launch(e.main.down_combine, .{ .grid = comb, .block = .{ .x = @intCast(32 * slots) } }, s, &cb);
+}
+
+test "experts: Inkling's expert shapes have built tiles (gate/up 4608 -> 2304 whole and a rank's 1152, down back)" {
+    try std.testing.expectEqual(@as(u32, 4), try ex.plan(4608, 2304, true));
+    try std.testing.expectEqual(@as(u32, 4), try ex.plan(4608, 1152, true));
+    _ = try ex.plan(2304, 4608, false);
+    _ = try ex.plan(1152, 4608, false);
+}
+
+test "experts: the item list sits past main's scratch and holds a 2,048-row call's items" {
+    var l = std.mem.zeroes(ex.Layer);
+    l.experts = 384;
+    l.dims = 4608;
+    l.width = 1152;
+    l.codebook = .mul1;
+    const bytes = try scratchBytes(l, 2048, 8);
+    const sc = try ex.scratch(0, l, 2048, 8);
+    const at = itemsAt(l, sc);
+    try std.testing.expectEqual(@as(u64, try ex.scratchBytes(l, 2048, 8)), at);
+    try std.testing.expectEqual(@as(usize, 16384 / 16 + 384), maxItems(l, 2048, 8));
+    try std.testing.expect(at + 256 + maxItems(l, 2048, 8) * 12 <= bytes);
+    // the kernels' column blocks: the rows kernel 128 columns, the wide one 64, of a rank's 1152 and the 4608 width
+    try std.testing.expect(1152 % 128 == 0 and 4608 % 128 == 0);
+}
