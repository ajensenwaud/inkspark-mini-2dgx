new file mode 100644
index 000000000..8ecd9f16e
--- /dev/null
+++ b/zig/src/server/chat_inkling.zig
@@ -0,0 +1,55 @@
+//! Inkling 2's reply blocks (inkling_reply.zig) as reasoning, content and calls, in whole and streamed replies.
+const std = @import("std");
+const json = @import("json");
+const reply_text = @import("reply_text.zig");
+const split = @import("inkling_reply.zig");
+const chat = @import("chat.zig");
+const Value = json.Value;
+
+/// Inkling 2's replies end their sampling with this marker; a tokenizer that holds it speaks the block format.
+pub fn is(text: anytype) bool {
+    return text.vtable.token_id(text.ctx, split.markers.end_sampling) != null and text.vtable.token_id(text.ctx, split.markers.model) != null;
+}
+
+/// The reply so far (ids past the prompt, specials spelled out) split as vLLM's Inkling parser splits it.
+pub fn read(g: anytype, ids: []const u32, finished: bool) std.mem.Allocator.Error!@import("kimi_reply.zig").Result {
+    const raw = try g.srv.text.decode(g.a, ids);
+    const r = split.split(g.a, raw, finished) catch |e| return e;
+    var calls: ?[]Value = null;
+    if (g.tools.len > 0 and r.calls.len > 0) {
+        const list = try g.a.alloc(Value, r.calls.len); // no ids: the model writes none (openai_calls.zig keys them)
+        for (r.calls, list) |c, *v| {
+            const f = try json.newObject(g.a);
+            try f.put(g.a, "name", .{ .string = c.name });
+            try f.put(g.a, "arguments", .{ .string = c.arguments });
+            const o = try json.newObject(g.a);
+            try o.put(g.a, "type", .{ .string = "function" });
+            try o.put(g.a, "function", .{ .object = f });
+            v.* = .{ .object = o };
+        }
+        calls = list;
+    }
+    return .{
+        .content = g.stops.visible(r.content, !finished),
+        .reasoning = g.stops.visible(r.reasoning, !finished),
+        .calls = calls,
+        .reasoning_tokens = 0,
+    };
+}
+
+/// A streamed reply's new reasoning and content; calls wait for the finished split.
+pub fn stream(g: anytype, sink: chat.Sink) chat.Failure!void {
+    const ids = reply_text.stripTrailing(g.collected.items, g.srv.eos);
+    const r = try read(g, ids, false);
+    const thought = reply_text.pyStrip(r.reasoning);
+    const reason = g.streamed_reasoning.after(thought, false);
+    if (reason.len > 0) {
+        try g.streamed_reasoning.set(g.a, thought, reason);
+        try g.emit(sink, try reply_text.deltaOf(g.a, "reasoning_content", reason));
+    }
+    const delta = g.streamed.after(r.content, false);
+    if (delta.len > 0) {
+        try g.streamed.set(g.a, r.content, delta);
+        try g.emit(sink, .{ .string = delta });
+    }
+}
diff --git a/zig/src/server/inkling_reply.zig b/zig/src/server/inkling_reply.zig
new file mode 100644
index 000000000..bb8704d03
--- /dev/null
+++ b/zig/src/server/inkling_reply.zig
@@ -0,0 +1,240 @@
+//! Inkling 2's reply blocks split into reasoning, visible text and tool calls, as vLLM's Inkling parser reads them.
+const std = @import("std");
+
+/// The release's block markers (special tokens in tokenizer_config.json).
+pub const markers = struct {
+    pub const model = "<|message_model|>";
+    pub const text = "<|content_text|>";
+    pub const thinking = "<|content_thinking|>";
+    pub const end = "<|end_message|>";
+    pub const end_sampling = "<|content_model_end_sampling|>";
+    pub const tool_json = "<|content_invoke_tool_json|>";
+    pub const tool_text = "<|content_invoke_tool_text|>";
+    pub const tool_error = "<|content_tool_error|>";
+};
+
+const Marker = enum { model, text, thinking, end, end_sampling, tool_json, tool_text, tool_error };
+const State = enum { header, content, reasoning, tool };
+
+pub const Call = struct { name: []const u8, arguments: []const u8 };
+
+pub const Reply = struct {
+    reasoning: []const u8,
+    content: []const u8,
+    calls: []const Call,
+    /// A tool block the reply ended inside (max_tokens): its name when the payload got that far, never raw markup.
+    cut: ?[]const u8 = null,
+};
+
+fn markerAt(s: []const u8) ?struct { m: Marker, len: usize } {
+    inline for (comptime std.enums.values(Marker)) |m| {
+        const text = @field(markers, @tagName(m));
+        if (std.mem.startsWith(u8, s, text)) return .{ .m = m, .len = text.len };
+    }
+    return null;
+}
+
+/// The next state for a marker in a state, or null where vLLM's table has no entry (the marker is then plain text).
+fn next(s: State, m: Marker) ?State {
+    return switch (m) {
+        .end, .end_sampling => .content,
+        .model => if (s == .content or s == .header) .header else null,
+        .text, .tool_text, .tool_error => if (s == .content or s == .header) .content else null,
+        .thinking => if (s == .tool) null else .reasoning,
+        .tool_json => if (s == .tool) null else .tool,
+    };
+}
+
+/// Split one reply (specials spelled out) into `a`; unfinished, it holds back an open header that may name a tool.
+pub fn split(a: std.mem.Allocator, reply: []const u8, finished: bool) !Reply {
+    var reasoning: std.ArrayList(u8) = .empty;
+    var content: std.ArrayList(u8) = .empty;
+    var header: std.ArrayList(u8) = .empty;
+    var payload: std.ArrayList(u8) = .empty;
+    var calls: std.ArrayList(Call) = .empty;
+    var state: State = .header;
+    var i: usize = 0;
+    while (i < reply.len) {
+        if (reply[i] == '<') if (markerAt(reply[i..])) |hit| if (next(state, hit.m)) |to| {
+            i += hit.len;
+            if (state == .tool and to == .content) try calls.append(a, try call(a, payload.items));
+            if (state == .header and (hit.m == .end or hit.m == .end_sampling)) try content.appendSlice(a, header.items);
+            if (to == .header or state == .header) header.clearRetainingCapacity();
+            if (to == .tool) payload.clearRetainingCapacity();
+            state = to;
+            continue;
+        };
+        const stop = std.mem.indexOfScalarPos(u8, reply, i + 1, '<') orelse reply.len;
+        const piece = reply[i..stop];
+        switch (state) {
+            .header => try header.appendSlice(a, piece),
+            .content => try content.appendSlice(a, piece),
+            .reasoning => try reasoning.appendSlice(a, piece),
+            .tool => try payload.appendSlice(a, piece),
+        }
+        i = stop;
+    }
+    var out: Reply = .{
+        .reasoning = std.mem.trimEnd(u8, reasoning.items, " \t\r\n"),
+        .content = content.items,
+        .calls = calls.items,
+    };
+    if (state == .tool) out.cut = name(payload.items);
+    if (finished and state == .header and header.items.len > 0) out.content = try std.mem.concat(a, u8, &.{ content.items, header.items });
+    const blank = std.mem.trim(u8, out.content, " \t\r\n").len == 0;
+    if (blank and (out.calls.len > 0 or out.cut != null)) out.content = "";
+    return out;
+}
+
+/// A finished tool block: `{"name": ..., "args": {...}}`; the arguments are the args member as written, or {}.
+fn call(a: std.mem.Allocator, payload: []const u8) !Call {
+    var doc = std.json.parseFromSlice(std.json.Value, a, payload, .{}) catch return .{ .name = "", .arguments = "{}" };
+    defer doc.deinit();
+    if (doc.value != .object) return .{ .name = "", .arguments = "{}" };
+    const n = doc.value.object.get("name") orelse std.json.Value{ .null = {} };
+    const own = if (n == .string) try a.dupe(u8, n.string) else "";
+    return .{ .name = own, .arguments = try a.dupe(u8, member(payload, "args") orelse "{}") };
+}
+
+/// The verbatim value of a top-level member of a JSON object known to parse.
+fn member(raw: []const u8, key: []const u8) ?[]const u8 {
+    var depth: usize = 0;
+    var i: usize = 0;
+    while (i < raw.len) : (i += 1) {
+        switch (raw[i]) {
+            '{', '[' => depth += 1,
+            '}', ']' => depth -|= 1,
+            '"' => {
+                const close = stringEnd(raw, i) orelse return null;
+                const s = raw[i + 1 .. close];
+                i = close;
+                if (depth != 1 or !std.mem.eql(u8, s, key)) continue;
+                var j = close + 1;
+                while (j < raw.len and (raw[j] == ' ' or raw[j] == ':' or raw[j] == '\n' or raw[j] == '\t')) j += 1;
+                return valueSpan(raw, j);
+            },
+            else => {},
+        }
+    }
+    return null;
+}
+
+fn stringEnd(raw: []const u8, open: usize) ?usize {
+    var j = open + 1;
+    while (j < raw.len) : (j += 1) {
+        if (raw[j] == '\\') j += 1 else if (raw[j] == '"') return j;
+    }
+    return null;
+}
+
+fn valueSpan(raw: []const u8, start: usize) ?[]const u8 {
+    if (start >= raw.len) return null;
+    if (raw[start] != '{' and raw[start] != '[') {
+        var j = start;
+        if (raw[j] == '"') return raw[start .. (stringEnd(raw, j) orelse return null) + 1];
+        while (j < raw.len and raw[j] != ',' and raw[j] != '}') j += 1;
+        return std.mem.trimEnd(u8, raw[start..j], " \t\r\n");
+    }
+    var depth: usize = 0;
+    var j = start;
+    while (j < raw.len) : (j += 1) {
+        switch (raw[j]) {
+            '{', '[' => depth += 1,
+            '}', ']' => {
+                depth -= 1;
+                if (depth == 0) return raw[start .. j + 1];
+            },
+            '"' => j = stringEnd(raw, j) orelse return null,
+            else => {},
+        }
+    }
+    return null;
+}
+
+/// The name of a cut tool block, when its payload already holds a whole "name" string.
+fn name(payload: []const u8) ?[]const u8 {
+    const at = std.mem.indexOf(u8, payload, "\"name\"") orelse return null;
+    var j = at + 6;
+    while (j < payload.len and (payload[j] == ' ' or payload[j] == ':')) j += 1;
+    if (j >= payload.len or payload[j] != '"') return null;
+    const close = stringEnd(payload, j) orelse return null;
+    return payload[j + 1 .. close];
+}
+
+const t = std.testing;
+
+fn splitT(arena: *std.heap.ArenaAllocator, text: []const u8) !Reply {
+    return split(arena.allocator(), text, true);
+}
+
+test "inkling2 reply: a chat turn gives its reasoning and its answer" {
+    var arena = std.heap.ArenaAllocator.init(t.allocator);
+    defer arena.deinit();
+    const r = try splitT(&arena, "<|message_model|><|content_thinking|>The user says hello. \n<|end_message|>" ++
+        "<|message_model|><|content_text|>Hello! How can I help?<|end_message|><|content_model_end_sampling|>");
+    try t.expectEqualStrings("The user says hello.", r.reasoning);
+    try t.expectEqualStrings("Hello! How can I help?", r.content);
+    try t.expectEqual(@as(usize, 0), r.calls.len);
+    try t.expect(r.cut == null);
+}
+
+test "inkling2 reply: a tool call takes its name from the payload and its arguments verbatim" {
+    var arena = std.heap.ArenaAllocator.init(t.allocator);
+    defer arena.deinit();
+    const r = try splitT(&arena, "<|message_model|><|content_thinking|>Need the weather.<|end_message|>" ++
+        "<|message_model|>get_weather<|content_invoke_tool_json|>{\"name\":\"get_weather\",\"args\":{\"city\":\"S<F>\",\"days\":2}}" ++
+        "<|end_message|><|content_model_end_sampling|>");
+    try t.expectEqualStrings("Need the weather.", r.reasoning);
+    try t.expectEqualStrings("", r.content);
+    try t.expectEqual(@as(usize, 1), r.calls.len);
+    try t.expectEqualStrings("get_weather", r.calls[0].name);
+    try t.expectEqualStrings("{\"city\":\"S<F>\",\"days\":2}", r.calls[0].arguments);
+}
+
+test "inkling2 reply: two calls, a call without args, and text between blocks" {
+    var arena = std.heap.ArenaAllocator.init(t.allocator);
+    defer arena.deinit();
+    const r = try splitT(&arena, "<|message_model|><|content_text|>Checking both.<|end_message|>" ++
+        "<|message_model|>a<|content_invoke_tool_json|>{\"name\":\"a\",\"args\":{\"x\":[1,{\"y\":\"}\"}]}}<|end_message|>" ++
+        "<|message_model|>b<|content_invoke_tool_json|>{\"name\":\"b\"}<|end_message|>");
+    try t.expectEqualStrings("Checking both.", r.content);
+    try t.expectEqual(@as(usize, 2), r.calls.len);
+    try t.expectEqualStrings("{\"x\":[1,{\"y\":\"}\"}]}", r.calls[0].arguments);
+    try t.expectEqualStrings("b", r.calls[1].name);
+    try t.expectEqualStrings("{}", r.calls[1].arguments);
+}
+
+test "inkling2 reply: thinking off, a header with no block, and a cut call" {
+    var arena = std.heap.ArenaAllocator.init(t.allocator);
+    defer arena.deinit();
+    const plain = try splitT(&arena, "<|message_model|><|content_text|>4<|end_message|><|content_model_end_sampling|>");
+    try t.expectEqualStrings("", plain.reasoning);
+    try t.expectEqualStrings("4", plain.content);
+    const bare = try splitT(&arena, "Hi there<|end_message|>");
+    try t.expectEqualStrings("Hi there", bare.content);
+    const cut = try splitT(&arena, "<|message_model|><|content_thinking|>x<|end_message|><|message_model|>get_weather" ++
+        "<|content_invoke_tool_json|>{\"name\":\"get_weather\",\"args\":{\"ci");
+    try t.expectEqualStrings("get_weather", cut.cut.?);
+    try t.expectEqualStrings("", cut.content);
+    try t.expectEqual(@as(usize, 0), cut.calls.len);
+}
+
+test "inkling2 reply: a marker vLLM's table does not take in a state stays text" {
+    var arena = std.heap.ArenaAllocator.init(t.allocator);
+    defer arena.deinit();
+    const r = try splitT(&arena, "<|message_model|><|content_thinking|>a<|content_text|>b<|end_message|>");
+    try t.expectEqualStrings("a<|content_text|>b", r.reasoning);
+    try t.expectEqualStrings("", r.content);
+}
+
+test "inkling2 reply: a stream holds back a header until its block says what it is" {
+    var arena = std.heap.ArenaAllocator.init(t.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const so_far = "<|message_model|><|content_thinking|>List /tmp.<|end_message|><|message_model|>run_shell";
+    try t.expectEqualStrings("", (try split(a, so_far, false)).content);
+    const named = try split(a, so_far ++ "_command<|content_invoke_tool_json|>{\"name\":\"run_shell_command\"}<|end_message|>", false);
+    try t.expectEqualStrings("", named.content);
+    try t.expectEqualStrings("run_shell_command", named.calls[0].name);
+    try t.expectEqualStrings("Hi", (try split(a, "<|message_model|>Hi", true)).content);
+}
diff --git a/zig/src/server/inkling_route_test.zig b/zig/src/server/inkling_route_test.zig
new file mode 100644
index 000000000..14f530f42
--- /dev/null
+++ b/zig/src/server/inkling_route_test.zig
@@ -0,0 +1,195 @@
+//! Inkling 2 tool calls through /v1/chat/completions, whole and streamed: one keyed call, no header shown as text.
+const std = @import("std");
+const api = @import("engine_api");
+const server = @import("root.zig");
+const json = server.json;
+const model_text = @import("model_text.zig");
+const openai = @import("openai.zig");
+const preflight = @import("stream_preflight_test.zig");
+const Conn = @import("http_conn.zig").Conn;
+const call_ids = @import("ids.zig");
+const markers = @import("inkling_reply.zig").markers;
+const A = std.mem.Allocator;
+const t = std.testing;
+
+/// Ids 256.. in this order; below 256 an id is its byte.
+const specials = [_][]const u8{ markers.model, markers.text, markers.thinking, markers.end, markers.end_sampling, markers.tool_json };
+
+/// Bytes as tokens plus Inkling 2's markers as whole tokens, so ``chat_inkling.is`` holds.
+const Text = struct {
+    fn text(x: *Text) model_text.Text {
+        return .{ .ctx = x, .vtable = &.{ .encode = preflight.TestText.encode, .decode = decode, .token_id = tokenId, .token_string = tokenString, .vocab_size = vocabSize, .eos_ids = eosIds, .render = render, .template_source = templateSource } };
+    }
+    fn decode(_: *anyopaque, a: A, ids: []const u32) A.Error![]u8 {
+        var out: std.ArrayList(u8) = .empty;
+        for (ids) |id| try out.appendSlice(a, if (id < 256) &[_]u8{@intCast(id)} else specials[id - 256]);
+        return out.toOwnedSlice(a);
+    }
+    fn tokenId(_: *anyopaque, piece: []const u8) ?u32 {
+        for (specials, 0..) |s, i| if (std.mem.eql(u8, s, piece)) return @intCast(256 + i);
+        return null;
+    }
+    fn tokenString(_: *anyopaque, a: A, id: u32) A.Error![]u8 {
+        return if (id >= 256) a.dupe(u8, specials[id - 256]) else std.fmt.allocPrint(a, "{d}", .{id});
+    }
+    fn vocabSize(_: *anyopaque) u32 {
+        return 256 + specials.len;
+    }
+    fn eosIds(_: *anyopaque) []const u32 {
+        return &.{};
+    }
+    fn render(_: *anyopaque, a: A, _: json.Value, _: model_text.RenderOptions, _: *[]const u8) model_text.Error!model_text.Rendered {
+        return .{ .text = try a.dupe(u8, "prompt") };
+    }
+    fn templateSource(_: *anyopaque) []const u8 {
+        return "";
+    }
+};
+
+const payload = "{\"name\":\"run_shell_command\",\"args\":{\"command\":\"ls /tmp\"}}";
+const reply_parts = [_][]const u8{ markers.thinking, "Need the files.", markers.end, markers.model, "run_shell_command", markers.tool_json, payload, markers.end, markers.end_sampling };
+
+/// The scripted reply as ids: each marker one token, every other byte its own.
+fn script(a: A) ![]const u32 {
+    var out: std.ArrayList(u32) = .empty;
+    for (reply_parts) |p| if (Text.tokenId(undefined, p)) |id| try out.append(a, id) else for (p) |b| try out.append(a, b);
+    return out.items;
+}
+
+/// Sends its tokens one per event, then stops.
+const OneByOne = struct {
+    tokens: []const u32,
+
+    fn engine(e: *OneByOne) api.Engine {
+        return .{ .ctx = e, .vtable = &.{ .info = info, .submit = submit, .cancel = cancel, .status = status, .memory = memory } };
+    }
+    fn info(_: *anyopaque) api.Info {
+        return .{ .context_window = 4096 };
+    }
+    fn submit(ctx: *anyopaque, id: api.Id, _: *const api.Request, sink: api.Sink) api.SubmitError!void {
+        const e: *OneByOne = @ptrCast(@alignCast(ctx));
+        sink.event(sink.ctx, id, &.{ .prefilled = 0 });
+        for (0..e.tokens.len) |i| sink.event(sink.ctx, id, &.{ .tokens = e.tokens[i..][0..1] });
+        sink.event(sink.ctx, id, &.{ .finished = .{ .reason = .stop } });
+    }
+    fn cancel(_: *anyopaque, _: api.Id) void {}
+    fn status(_: *anyopaque, out: *api.Status, _: []u32) void {
+        out.* = .{};
+    }
+    fn memory(_: *anyopaque, _: bool) ?api.Memory {
+        return null;
+    }
+};
+
+const Wire = struct {
+    a: A,
+    bytes: std.ArrayList(u8) = .empty,
+    fn write(p: *anyopaque, bytes: []const u8) error{Closed}!void {
+        const w: *@This() = @ptrCast(@alignCast(p));
+        w.bytes.appendSlice(w.a, bytes) catch return error.Closed;
+    }
+};
+
+/// What a chat client read: its calls (id, name, arguments), reasoning, content and last finish_reason.
+const Got = struct {
+    ids: std.ArrayList([]const u8) = .empty,
+    names: std.ArrayList(u8) = .empty,
+    arguments: std.ArrayList(u8) = .empty,
+    reasoning: std.ArrayList(u8) = .empty,
+    content: std.ArrayList(u8) = .empty,
+    finish: []const u8 = "",
+
+    fn keep(g: *Got, a: A, choice: json.Value, part: []const u8) !void {
+        if (choice.strField("finish_reason")) |f| g.finish = f;
+        const m = choice.get(part) orelse return;
+        if (m.strField("reasoning_content")) |r| try g.reasoning.appendSlice(a, r);
+        if (m.strField("content")) |c| try g.content.appendSlice(a, c);
+        for ((m.get("tool_calls") orelse return).items() orelse return) |c| {
+            if (c.strField("id")) |id| try g.ids.append(a, id);
+            const f = c.get("function") orelse continue;
+            if (f.strField("name")) |n| try g.names.appendSlice(a, n);
+            if (f.strField("arguments")) |x| try g.arguments.appendSlice(a, x);
+        }
+    }
+};
+
+const tools = ",\"tools\":[{\"type\":\"function\",\"function\":{\"name\":\"run_shell_command\",\"parameters\":{\"type\":\"object\"}}}]";
+
+fn request(a: A, word: []const u8, stream: bool) ![]const u8 {
+    return std.mem.concat(a, u8, &.{ "{\"model\":\"test-model\",\"max_tokens\":400,\"messages\":[{\"role\":\"user\",\"content\":\"", word, "\"}]", tools, ",\"stream\":", if (stream) "true" else "false", "}" });
+}
+
+/// ``body`` to the chat route of a fresh server under the fixed test key, read as a whole reply or a stream.
+fn post(a: A, body: []const u8, stream: bool) !Got {
+    var backend: OneByOne = .{ .tokens = try script(a) };
+    var text: Text = .{};
+    var key: call_ids.Key = .of(call_ids.test_key_text);
+    const srv = try server.Server.init(t.allocator, t.io, backend.engine(), text.text(), .{ .served_name = "test-model", .model_ids = &.{"test-model"}, .enable_thinking = false, .use_drafts = false, .tool_id_key = &key }, null);
+    defer srv.deinit();
+    var wire: Wire = .{ .a = a };
+    var headers = [_]@import("http_conn.zig").Header{.{ .name = "Content-Length", .value = try std.fmt.allocPrint(a, "{d}", .{body.len}) }};
+    var c: Conn = .{ .fd = -1, .peer = "", .buf = try a.dupe(u8, body), .end = body.len, .gpa = a, .version = "HTTP/1.1", .method = "POST", .path = "", .headers = &headers, .write_hooks = .{ .ctx = &wire, .write = Wire.write } };
+    openai.post(srv, &c, a, true);
+    const bytes = wire.bytes.items;
+    try t.expect(std.mem.startsWith(u8, bytes, "HTTP/1.1 200 "));
+    var got: Got = .{};
+    var frames: std.ArrayList([]const u8) = .empty;
+    if (stream) {
+        var at: usize = 0;
+        while (std.mem.indexOfPos(u8, bytes, at, "data: ")) |d| {
+            const end = std.mem.indexOfPos(u8, bytes, d, "\n\n") orelse bytes.len;
+            if (!std.mem.eql(u8, bytes[d + 6 .. end], "[DONE]")) try frames.append(a, bytes[d + 6 .. end]);
+            at = end;
+        }
+    } else try frames.append(a, bytes[(std.mem.indexOf(u8, bytes, "\r\n\r\n") orelse return error.NoBody) + 4 ..]);
+    for (frames.items) |f| {
+        const choices = ((try json.parse(a, f)).ok.get("choices") orelse continue).items() orelse continue;
+        if (choices.len > 0) try got.keep(a, choices[0], if (stream) "delta" else "message");
+    }
+    return got;
+}
+
+fn expectCallId(id: []const u8) !void {
+    try t.expect(std.mem.startsWith(u8, id, "call_"));
+    try t.expectEqual(@as(usize, 5 + 24), id.len);
+    for (id[5..]) |ch| try t.expect(std.ascii.isDigit(ch) or (ch >= 'a' and ch <= 'f'));
+}
+
+test "an Inkling 2 tool call reaches the chat route as one call with its arguments and reasoning, whole and streamed" {
+    var arena = std.heap.ArenaAllocator.init(t.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    for ([_]bool{ false, true }) |stream| {
+        const got = try post(a, try request(a, "x", stream), stream);
+        try t.expectEqual(@as(usize, 1), got.ids.items.len);
+        try t.expectEqualStrings("run_shell_command", got.names.items);
+        try t.expectEqualStrings("{\"command\":\"ls /tmp\"}", got.arguments.items);
+        try t.expectEqualStrings("tool_calls", got.finish);
+        try t.expectEqualStrings("Need the files.", got.reasoning.items);
+    }
+}
+
+test "an Inkling 2 reply never shows a tool block's header as content, whole or streamed" {
+    var arena = std.heap.ArenaAllocator.init(t.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    for ([_]bool{ false, true }) |stream| {
+        const got = try post(a, try request(a, "x", stream), stream);
+        try t.expect(std.mem.indexOf(u8, got.content.items, "run_shell") == null);
+    }
+}
+
+test "an Inkling 2 call id is the request's own: call_ and 24 hex, whole as streamed, apart for another request" {
+    var arena = std.heap.ArenaAllocator.init(t.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var ids: [3][]const u8 = undefined;
+    for (&ids, [_][]const u8{ "x", "x", "y" }, [_]bool{ false, true, false }) |*id, word, stream| {
+        const got = try post(a, try request(a, word, stream), stream);
+        try t.expectEqual(@as(usize, 1), got.ids.items.len);
+        try expectCallId(got.ids.items[0]);
+        id.* = got.ids.items[0];
+    }
+    try t.expectEqualStrings(ids[0], ids[1]);
+    try t.expect(!std.mem.eql(u8, ids[0], ids[2]));
+}
