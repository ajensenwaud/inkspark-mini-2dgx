diff --git a/zig/tests/cuda/contract_inkling2_attn_widen.zig b/zig/tests/cuda/contract_inkling2_attn_widen.zig
new file mode 100644
index 000000000..87db3771f
--- /dev/null
+++ b/zig/tests/cuda/contract_inkling2_attn_widen.zig
@@ -0,0 +1,114 @@
+//! Inkling 2 Mini's fp8 key widening (prompt_attention.cu tf_ink2_kv_widen) under the contract, with its control.
+const std = @import("std");
+const core = @import("core");
+const K = @import("inkling2").kernels;
+const rig_ = @import("contract_rig.zig");
+const ref = @import("contract_minimax_glue_ref.zig");
+
+const c = core.contract.spec;
+const g = core.contract.gates;
+const Iv = ref.Iv;
+const Sums = ref.Sums;
+const dim = K.head_dim;
+
+/// A slot's keys (rows) x a rank's key heads (n, 4 at TP=2): the first prompt chunk, and keys past a 64-key tile edge.
+pub fn specFor(swapped: bool) c.Spec {
+    const served = &[_]c.Shape{ .{ .rows = 2048, .n = 4, .k = 1 }, .{ .rows = 4161, .n = 4, .k = 1 } };
+    const name = if (swapped) "inkling2_pattn control: widening reads V's scales for K and K's for V" else "inkling2_pattn tf_ink2_kv_widen (e4m3 to f16, times the fp32 scale, to bf16)";
+    return .{ .name = name, .accum = .none, .depth = ref.noSums, .out = .bf16, .served = served };
+}
+
+/// e4m3fn code to its value (no infinities; 0x7f and 0xff are NaN).
+pub fn e4m3(code: u8) f64 {
+    const e: i32 = (code >> 3) & 15;
+    const m: f64 = @floatFromInt(code & 7);
+    if (e == 15 and code & 7 == 7) return std.math.nan(f64);
+    const v = if (e == 0) m / 8 * 0x1p-6 else (1 + m / 8) * std.math.pow(f64, 2, @floatFromInt(e - 7));
+    return if (code & 0x80 != 0) -v else v;
+}
+
+/// Out: K then V, each bf16 [kv_head][ring = rows][128]; inputs hold two slots and the launch reads slot 1.
+pub const Widen = struct {
+    kern: *const K.Kernels,
+    /// control: the device's scale arrays are passed the other way round
+    swapped: bool = false,
+    shape: c.Shape = undefined,
+    codes: [2][]u8 = .{ &.{}, &.{} },
+    scales: [2][]f32 = .{ &.{}, &.{} },
+    dev: [4]u64 = @splat(0),
+    out: u64 = 0,
+
+    pub fn spec(self: *const Widen) c.Spec {
+        return specFor(self.swapped);
+    }
+
+    pub fn control(self: *const Widen) ?g.Gate {
+        return if (self.swapped) .shapes else null;
+    }
+
+    pub fn free(self: *Widen, a: std.mem.Allocator) void {
+        for (&self.codes) |*x| a.free(x.*);
+        for (&self.scales) |*x| a.free(x.*);
+        self.codes = .{ &.{}, &.{} };
+        self.scales = .{ &.{}, &.{} };
+    }
+
+    /// Slot 0 NaN codes, slot 1 finite codes and scales; non-finite: NaN codes, an infinite scale over zero codes.
+    pub fn prepare(self: *Widen, a: std.mem.Allocator, rig: *rig_.Rig, shape: c.Shape, fill: g.Fill, rng: std.Random) !bool {
+        if (shape.rows == 0 or shape.n == 0) return false;
+        self.free(a);
+        self.shape = shape;
+        const per = shape.rows * shape.n;
+        for (&self.codes, &self.scales, 0..) |*cs, *ss, side| {
+            cs.* = try a.alloc(u8, 2 * per * dim);
+            ss.* = try a.alloc(f32, 2 * per);
+            @memset(cs.*[0 .. per * dim], 0x7f);
+            for (cs.*[per * dim ..]) |*x| {
+                var v = rng.int(u8);
+                while (v & 0x7f == 0x7f) v = rng.int(u8);
+                x.* = v;
+            }
+            const lo: f32, const hi: f32 = if (side == 0) .{ 0x1p-6, 0.5 } else .{ 0.6, 1.2 };
+            for (ss.*) |*x| x.* = lo + rng.float(f32) * (hi - lo);
+        }
+        if (fill == .nonfinite) {
+            self.codes[0][per * dim + 5] = 0x7f;
+            self.codes[1][per * dim + per * dim / 2] = 0xff;
+            const row = per - 1; // the last key's last head: zero codes times an infinite scale
+            @memset(self.codes[0][(per + row) * dim ..][0 .. dim / 2], 0);
+            self.scales[0][per + row] = ref.inf;
+        }
+        for (0..2) |i| self.dev[i] = try ref.input(rig, self.codes[i]);
+        const ks: usize = if (self.swapped) 1 else 0;
+        self.dev[2] = try ref.input(rig, self.scales[ks]);
+        self.dev[3] = try ref.input(rig, self.scales[1 - ks]);
+        self.out = try rig.output(2 * per * dim * 2);
+        return true;
+    }
+
+    pub fn run(self: *Widen, rig: *rig_.Rig) !void {
+        const per = self.shape.rows * self.shape.n;
+        const half: u64 = per * dim * 2;
+        const kv: K.Cache = .{ .k = self.dev[0], .v = self.dev[1], .ks = self.dev[2], .vs = self.dev[3], .wide = self.out, .wide_half = half };
+        const rows: u32 = @intCast(self.shape.rows);
+        try K.widen(self.kern, rig.s, kv, @intCast(per * dim), @intCast(self.shape.n), rows, rows - 1);
+    }
+
+    pub fn count(self: *const Widen) usize {
+        return 2 * self.shape.rows * self.shape.n * dim;
+    }
+
+    pub fn solve(self: *const Widen, _: std.mem.Allocator, _: Sums, out: []Iv) !void {
+        const rows = self.shape.rows;
+        const n = self.shape.n;
+        const per = rows * n;
+        for (0..2) |side| for (0..n) |h| for (0..rows) |key| {
+            const src = per + key * n + h;
+            const sc = Iv.of(self.scales[side][src]);
+            for (0..dim) |d| {
+                const at = ((side * n + h) * rows + key) * dim + d;
+                out[at] = Iv.of(e4m3(self.codes[side][src * dim + d])).mul(sc).bf();
+            }
+        };
+    }
+};
