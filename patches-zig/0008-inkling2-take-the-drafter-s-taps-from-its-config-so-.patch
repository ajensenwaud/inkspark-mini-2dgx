 zig/src/families/inkling2/dspark_run.zig    | 13 ++++----
 zig/src/families/inkling2/engine.zig        | 12 ++++----
 zig/src/families/inkling2/engine_images.zig |  4 +--
 zig/src/families/inkling2/engine_main.zig   |  2 +-
 zig/src/families/inkling2/forward.zig       | 13 +++++---
 6 files changed, 45 insertions(+), 33 deletions(-)

