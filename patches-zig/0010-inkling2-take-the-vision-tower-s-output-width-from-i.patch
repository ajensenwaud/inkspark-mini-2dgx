 zig/src/families/inkling2/forward.zig     |  2 +-
 zig/src/families/inkling2/pictures.zig    | 10 +++++-----
 zig/src/families/inkling2/vision.zig      | 12 +++++++-----
 zig/src/families/inkling2/vision_main.zig | 14 +++++++-------
 5 files changed, 25 insertions(+), 22 deletions(-)

