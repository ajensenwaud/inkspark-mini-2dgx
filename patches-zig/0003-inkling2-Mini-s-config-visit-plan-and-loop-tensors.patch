@@ -337,6 +363,46 @@ fn quantization(o: std.json.ObjectMap, why: *Why) !void {
     }
 }
 
+/// Mini's loop_config: a fixed pass count over a core that opens an attention-residual block, at the kernels' rank.
+fn parseLoop(o: std.json.ObjectMap, t: *const Text, why: *Why) !Loop {
+    const lo = try object(o, "loop_config", why);
+    if (lo.get("is_varloop")) |v| if (v != .bool or v.bool) {
+        why.set("loop_config.is_varloop must be false: the engine runs a fixed number of passes", .{});
+        return error.Unsupported;
+    };
+    const l: Loop = .{
+        .start = try int(lo, "core_start", why),
+        .end = try int(lo, "core_end", why),
+        .passes = try int(lo, "num_passes", why),
+        .rank = try int(lo, "gate_rank", why),
+    };
+    if (l.start >= l.end or l.end > t.layers) {
+        why.set("loop_config: core layers [{d}, {d}) are not inside the {d} layers", .{ l.start, l.end, t.layers });
+        return error.Layout;
+    }
+    // the messages read the previous pass's blocks after the one the pass opens, as the reference slices them
+    if (l.start % t.block != 0) {
+        why.set("loop_config.core_start {d} must open an attention-residual block of {d}", .{ l.start, t.block });
+        return error.Layout;
+    }
+    if (l.rank != gate_rank) {
+        why.set("loop_config.gate_rank must be {d}: the message gate kernels' width", .{gate_rank});
+        return error.Unsupported;
+    }
+    if (@as(u64, t.layers) + @as(u64, l.passes - 1) * l.core() > max_visits) {
+        why.set("loop_config: {d} passes make more than {d} layer visits", .{ l.passes, max_visits });
+        return error.Layout;
+    }
+    return l;
+}
+
+/// One architecture name with its model_type: Small (no loop) or Mini (loop_config in text_config).
+fn arch(o: std.json.ObjectMap, name: []const u8, model_type: []const u8) bool {
+    const a = o.get("architectures") orelse return false;
+    const one = a == .array and a.array.items.len == 1 and a.array.items[0] == .string;
+    return one and std.mem.eql(u8, a.array.items[0].string, name) and std.mem.eql(u8, text(o, "model_type") orelse "", model_type);
+}
+
