+    /// Layer visits a forward makes: every layer once, plus the core again for each pass after the first.
+    pub fn visits(c: *const Text) u32 {
+        const l = c.loop orelse return c.layers;
+        return c.layers + (l.passes - 1) * l.core();
+    }
 
     pub fn heads(c: *const Text, i: u32) Heads {
         return if (isGlobal(i)) c.global else c.local;
@@ -72,7 +85,19 @@ pub const Text = struct {
