+//! Mini (inkling2_loop): the published config, the loop's refusals, the visit plan and the weight map's loop tensors.
+const std = @import("std");
+const config = @import("config.zig");
+const names = @import("names.zig");
+const names_test = @import("names_test.zig");
+const plan = @import("plan.zig");
+const visits = @import("visits.zig");
+
+const t = std.testing;
+pub const mini = @embedFile("fixtures/mini_config.json");
+const mini_header = @embedFile("fixtures/mini_model_header.txt");
+
+fn load() !config.Config {
+    var why: config.Why = .{};
+    return config.parse(t.allocator, mini, &why);
+}
+
+fn refused(from: []const u8, to: []const u8, want: anyerror, says: []const u8) !void {
+    if (std.mem.count(u8, mini, from) != 1) return error.EditAnchor;
+    const edited = try std.mem.replaceOwned(u8, t.allocator, mini, from, to);
+    defer t.allocator.free(edited);
+    var why: config.Why = .{};
+    try t.expectError(want, config.parse(t.allocator, edited, &why));
+    try t.expect(std.mem.indexOf(u8, why.text(), says) != null);
+}
+
+test "Mini's config.json parses: 24 layers, core 6 to 17 three times, 48 visits, taps by visit" {
+    const c = try load();
+    try t.expectEqual(@as(u32, 2304), c.text.hidden);
+    try t.expectEqual(@as(u32, 24), c.text.layers);
+    try t.expectEqual(@as(u32, 128), c.text.experts);
