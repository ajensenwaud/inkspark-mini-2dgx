+/// Each message gate's name in the checkpoint, in `visits.Stream` order (q's gate is stored as attn).
+pub const gate_names = [_][]const u8{ "attn", "k", "v", "mlp" };
+
+/// Mini's loop: two cross-pass query tables and, on every core layer, a rank-r gate per stream.
+fn loop(c: *const Text, l: config.Loop, sink: anytype) !void {
+    const h: u64 = c.hidden;
+    const r: u64 = l.rank;
+    try put(sink, "model.llm.middle_cycle_cross_pass_queries", .{}, .f32, &.{ 2 * @as(u64, l.core()), h });
+    try put(sink, "model.llm.middle_cycle_cross_pass_kv_queries", .{}, .f32, &.{ 2 * @as(u64, l.core()), h });
+    for (l.start..l.end) |i| inline for (gate_names) |s| {
+        const pre = "model.llm.layers.{d}.controllers." ++ s;
+        try put(sink, pre ++ ".down_weight", .{i}, .bf16, &.{ r, 2 * h });
+        try put(sink, pre ++ ".forget_weight", .{i}, .bf16, &.{ h, r });
+        try put(sink, pre ++ ".gain_weight", .{i}, .bf16, &.{ h, r });
+    };
 }
 
