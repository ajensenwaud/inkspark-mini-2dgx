-        why.set("not an Inkling 2 checkpoint: architectures Inkling2ForConditionalGeneration, model_type inkling2", .{});
+    const mini = arch(o, "Inkling2LoopForConditionalGeneration", "inkling2_loop");
+    if (!mini and !arch(o, "Inkling2ForConditionalGeneration", "inkling2")) {
+        why.set("not an Inkling 2 checkpoint: architectures Inkling2ForConditionalGeneration, model_type inkling2 " ++
