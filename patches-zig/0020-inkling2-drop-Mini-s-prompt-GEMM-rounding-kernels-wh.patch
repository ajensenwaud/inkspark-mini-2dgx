 .../core/contract/inkling2_loop_records.zig   |  4 +--
 .../contract/measurements/pending_133.zig     |  2 --
 zig/src/families/inkling2/dump_main.zig       |  2 +-
 zig/src/families/inkling2/engine.zig          |  2 +-
 zig/src/families/inkling2/forward.zig         |  5 ---
 zig/src/families/inkling2/loop.zig            |  4 ---
 zig/src/families/inkling2/prompt_dense.zig    | 13 +++-----
 8 files changed, 8 insertions(+), 55 deletions(-)

