--- a/zig/kernels/cuda/inkling2/loop.cu
+++ b/zig/kernels/cuda/inkling2/loop.cu
@@ -7,9 +7,6 @@
 #include "common/qmm_frag.cuh"
 #include "common/reduce.cuh"
 #include "common/vec.cuh"
-#include "exl3_candidate.cuh"
-
-constexpr float kHad = 0.08838834764831845f;  // 1/sqrt(128), the decode kernels' HAD_SCALE
 
 namespace ink2_loop {
 
@@ -386,31 +383,3 @@ extern "C" __global__ void __launch_bounds__(256) tf_ink2_loop_bank(const uint16
     const size_t row = blockIdx.x;
     for (int c = threadIdx.x; c < C; c += blockDim.x) bank[(row * sources + s) * C + c] = bf(x[row * C + c]);
 }
-
-// Mini's prompt GEMM input: tf_exl3_rotate_h's transform rounded to fp16 at the decode kernels' 1/sqrt(128).
-extern "C" __global__ void __launch_bounds__(32) tf_ink2_loop_rotate(const __nv_bfloat16* X, unsigned x_stride,
-                                                                     const __half* suh, __half* R, unsigned r_stride) {
-    const unsigned lane = threadIdx.x, row = blockIdx.y, base = blockIdx.x * 128;
-    float v[4];
-    for (int q = 0; q < 4; ++q) {
-        const unsigned c = base + lane + 32 * q;
-        v[q] = __fmul_rn(__bfloat162float(X[(uint64_t)row * x_stride + c]), __half2float(suh[c]));
-    }
-    tf_exl3_fwht(v, lane);
-    for (int q = 0; q < 4; ++q)
-        R[(uint64_t)row * r_stride + base + lane + 32 * q] = __float2half_rn(__fmul_rn(v[q], kHad));
-}
-
-// Mini's prompt GEMM epilogue: tf_ink2_prompt_tail with the other 1/sqrt(128) in place of 2^-3.
-extern "C" __global__ void __launch_bounds__(32) tf_ink2_loop_tail(const float* __restrict__ z, const __half* svh,
-                                                                   unsigned n, uint8_t* y, unsigned y_f32) {
-    const unsigned lane = threadIdx.x, row = blockIdx.y, ob = blockIdx.x;
-    float v[4];
-    for (int q = 0; q < 4; ++q) v[q] = z[static_cast<uint64_t>(row) * n + ob * 128 + lane + 32 * q];
-    tf_exl3_fwht(v, lane);
-    for (int q = 0; q < 4; ++q) {
-        const unsigned c = ob * 128 + lane + 32 * q;
-        const float t = __fmul_rn(v[q], __fmul_rn(__half2float(svh[c]), kHad));
-        tf_exl3_store(y, static_cast<uint64_t>(row) * n + c, t, y_f32);
-    }
-}
