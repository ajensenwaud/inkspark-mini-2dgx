+
+    /// The prompt GEMM's rounding for `c`: Mini's (loop_config, model_type inkling2_loop) or Small's as released.
+    pub fn rounding(m: *const Modules, c: *const cfg.Config) prompt_dense.Rounding {
+        return if (c.loop != null) .{ .rotate = m.loop.rotate, .tail = m.loop.tail } else .{ .tail = m.ops.prompt_tail };
+    }
 };
 
 /// A layer's narrow projections (r, k, v, row dots) run here beside q and the gate, on their own EXL3 scratch.
