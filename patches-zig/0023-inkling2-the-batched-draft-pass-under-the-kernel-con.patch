 .../cuda/contract_inkling2_dspark_norm.zig    | 28 +++++++--
 zig/tests/cuda/contract_inkling2_ops_pick.zig | 62 +++++++++++++++----
 7 files changed, 144 insertions(+), 25 deletions(-)

